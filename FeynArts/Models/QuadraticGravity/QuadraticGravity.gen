QuadraticGravityModel`Private`tensor[n_Integer,s_Integer,QuadraticGravityModel`Private`legs[ls__List]] /; !FreeQ[{ls},_FourMomentum] := QuadraticGravityModel`Private`value[n,s,{ls}];
M$GenericPropagators=With[{
 w=Function[{a,b},FAFourVector[mom,a] FAFourVector[mom,b] FAPropagatorDenominator[mom,0]],
 t=Function[{a,b},FAMetricTensor[a,b]-FAFourVector[mom,a] FAFourVector[mom,b] FAPropagatorDenominator[mom,0]],
 z=FAPropagatorDenominator[mom,0], v=FAPropagatorDenominator[mom,QuadraticGravityModel`M2],
 s=FAPropagatorDenominator[mom,Sqrt[3(D-2)QuadraticGravityModel`M0^2 QuadraticGravityModel`M2^2/((D-4)QuadraticGravityModel`M0^2+2(D-1)QuadraticGravityModel`M2^2)]]},
 {AnalyticalPropagator[External][s1 T[j1,mom,{li1,li2}]]==Global`FAPolarizationTensor[T[j1],mom,li1,li2],
 AnalyticalPropagator[Internal][s1 T[j1,mom,{li1,li2}->{li3,li4}]]==I(
 (z-v)((t[li1,li3]t[li2,li4]+t[li1,li4]t[li2,li3])/2-t[li1,li2]t[li3,li4]/(D-1))
 +z (2 FAGaugeXi[T[1]]) (t[li1,li3]w[li2,li4]+t[li1,li4]w[li2,li3]+t[li2,li3]w[li1,li4]+t[li2,li4]w[li1,li3])/4
 +(s-z)/(D-2) (t[li1,li2]+(D-1)w[li1,li2])(t[li3,li4]+(D-1)w[li3,li4])/(D-1)
 +z (2 FAGaugeXi[T[1]]) w[li1,li2]w[li3,li4]),AnalyticalPropagator[External][s1 U[j1,mom,{li1}]]==1,
AnalyticalPropagator[Internal][s1 U[j1,mom,{li1}->{li2}]]==-I Global`FAMetricTensor[li1,li2] FAPropagatorDenominator[mom,0]}];
M$GenericCouplings={AnalyticalCoupling[s1 T[j1,mom1,{li1,li2}],s2 T[j2,mom2,{li3,li4}],s3 T[j3,mom3,{li5,li6}]]==G[1][s1 T[j1],s2 T[j2],s3 T[j3]].{QuadraticGravityModel`Private`tensor[3,0,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6}]],QuadraticGravityModel`Private`tensor[3,1,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6}]],QuadraticGravityModel`Private`tensor[3,2,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6}]]},
AnalyticalCoupling[s1 T[j1,mom1,{li1,li2}],s2 T[j2,mom2,{li3,li4}],s3 T[j3,mom3,{li5,li6}],s4 T[j4,mom4,{li7,li8}]]==G[1][s1 T[j1],s2 T[j2],s3 T[j3],s4 T[j4]].{QuadraticGravityModel`Private`tensor[4,0,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6},{mom4,li7,li8}]],QuadraticGravityModel`Private`tensor[4,1,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6},{mom4,li7,li8}]],QuadraticGravityModel`Private`tensor[4,2,QuadraticGravityModel`Private`legs[{mom1,li1,li2},{mom2,li3,li4},{mom3,li5,li6},{mom4,li7,li8}]]},
AnalyticalCoupling[s1 T[j1,mom1,{li1,li2}],s2 U[j2,mom2,{li3}],s3 U[j3,mom3,{li4}]]==G[1][s1 T[j1],s2 U[j2],s3 U[j3]].{Global`FAFourVector[mom2, li3]*Global`FAFourVector[mom3, li1]*Global`FAMetricTensor[li2, li4], Global`FAFourVector[mom2, li3]*Global`FAFourVector[mom3, li2]*Global`FAMetricTensor[li1, li4], Global`FAFourVector[mom2, li1]*Global`FAFourVector[mom3, li3]*Global`FAMetricTensor[li2, li4], Global`FAFourVector[mom2, li2]*Global`FAFourVector[mom3, li3]*Global`FAMetricTensor[li1, li4], Global`FAFourVector[mom1, li4]*Global`FAFourVector[mom2, li1]*Global`FAMetricTensor[li2, li3], Global`FAFourVector[mom1, li4]*Global`FAFourVector[mom2, li2]*Global`FAMetricTensor[li1, li3], Global`FAFourVector[mom1, li4]*Global`FAFourVector[mom2, li3]*Global`FAMetricTensor[li1, li2], Global`FAMetricTensor[li1, li4]*Global`FAMetricTensor[li2, li3]*Global`FAScalarProduct[mom2, mom3], Global`FAMetricTensor[li1, li3]*Global`FAMetricTensor[li2, li4]*Global`FAScalarProduct[mom2, mom3]}};
