#-
* CalcFormConverter format @FORMATVERSION@. Generated file; mapping is stored separately.
* Lorentz algebra and configured Dirac processing; no integration or on-shell substitutions.
Off Statistics;
@SCALARS@
Dimension @DIMENSION@;
@VECTORS@
@INDICES@
@FUNCTIONS@

* Reusable factors. Expansion takes place in FORM, not in Mathematica.
@FACTORS@
@PREPARATIONS@
Local cfcResult = @EXPRESSION@;
@MULTIPLICATIONS@

* Processing stage: FORM contracts native Lorentz objects during normalization.
* Future denominator and one-loop reduction procedures belong at this boundary.
.sort

* Dedicated, overwritten result file. The first line identifies its mapping.
Format nospaces;
#create <@RESULT@>
#write <@RESULT@> "@RESULTMARKER@ @DIGEST@"
#write <@RESULT@> "%E",cfcResult
#close <@RESULT@>
.end
