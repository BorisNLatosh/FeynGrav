* Emit one coefficient term at a time as an ordinary quotient. The private
* rational function and temporary dollar variables never enter saved output.
* Native term iteration takes one snapshot instead of repeatedly copying and
* subtracting from a shrinking dollar expression. Zero coefficients iterate zero times.
#write <@RESULT@> "+%$*(0",$cfcKey`cfcSlot'
#do cfcDimItem=cfcDimWork`cfcSlot'
#$cfcDimTerm=`cfcDimItem';
#$cfcDimNumerator=1;
#$cfcDimDenominator=1;
#inside $cfcDimTerm
id cfcDimRat(cfcDimNum?$cfcDimNumerator,cfcDimDen?$cfcDimDenominator)=1;
#endinside
#write <@RESULT@> "+(%$)*((%$)/(%$))",$cfcDimTerm,$cfcDimNumerator,$cfcDimDenominator
#enddo
#write <@RESULT@> ")"
Drop cfcDimWork`cfcSlot';
#$cfcDimTerm=0;
#$cfcDimNumerator=0;
#$cfcDimDenominator=0;
