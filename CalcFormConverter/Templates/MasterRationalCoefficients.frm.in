* Estimate expanded work without multiplying the actual shared polynomials.
* A metadata entry is an upper term count times z^(upper total degree), with
* one marker for each scalar variable. Child entries overestimate unions and
* degrees deliberately. Unknown objects/forward references reject the candidate.
#procedure cfcMRInspect(source)
#$cfcMRLimit=@LIMIT@;
#$cfcMRDegreeLimit=@DEGREE@;
#ifdef `cfcCGComplete'
#$cfcMRLimit=@CG_TERMS@;
#$cfcMRDegreeLimit=@CG_DEGREE@;
#endif
#$cfcMROK=0;
#$cfcMRCost=$cfcMRLimit+1;
#$cfcMRMax=$cfcMRDegreeLimit+1;
#$cfcMRCount=0;
#$cfcMRMeta=(@LIMIT@+1)*cfcMRDegree^(@DEGREE@+1);
#if termsin(`source') <= `$cfcMRLimit'
Skip;
Local cfcMREstimate=`source';
DropCoefficient;
@NATIVE_DEN_INSPECT@
id i_=1;
@DOTS@
@INSPECT@
id cfcShare(cfcMRIndex?)=cfcMRMeta(cfcMRIndex);
id cfcPolyN(cfcMRIndex?)=cfcMRMeta(cfcMRIndex);
id cfcPolyD(cfcMRIndex?)=cfcMRMeta(cfcMRIndex);
.sort
* Skip is module-local; renew it after each sort to protect the source.
Skip;
NSkip cfcMREstimate;
#$cfcMRMax=0;
#$cfcMRVars=1;
#$cfcMRCount=0;
#do v={@VARIABLES@}
#$cfcMRUsed`v'=0;
#enddo
$cfcMRMax=max_($cfcMRMax,count_(cfcMRDegree,1));
#do v={@VARIABLES@}
if (occurs(`v')); $cfcMRUsed`v'=1; endif;
id `v'=1;
#enddo
id cfcMRDegree=1;
ModuleOption noparallel;
.sort
#do v={@VARIABLES@}
#if `$cfcMRUsed`v'' != 0
#$cfcMRCount=$cfcMRCount+1;
#$cfcMRVars=$cfcMRVars*`v';
#endif
#enddo
#ifdef `cfcCGComplete'
* Coupling-only admission measures the immutable named input. The estimate is
* still evaluated above for degree, variables and unsupported-object rejection.
#$cfcMRCost=termsin_(`source');
#else
#$cfcMRCost=cfcMREstimate;
#endif
#if isnumerical($cfcMRCost)
#if ( `$cfcMRCost' <= `$cfcMRLimit' ) && ( `$cfcMRMax' <= `$cfcMRDegreeLimit' ) && ( `$cfcMRCount' <= @VARIABLE_LIMIT@ )
#$cfcMROK=1;
#$cfcMRMeta=$cfcMRCost*cfcMRDegree^$cfcMRMax*$cfcMRVars;
#endif
#endif
Drop cfcMREstimate;
.sort
NSkip;
.sort
#endif
#endprocedure

* Complete coupling coefficients may exceed a PolyRatFun argument while still
* having a small final answer. Keep numerator/denominator as named expressions.
* Expose and sort one shared factor per layer; a single recursive substitution
* expands enormous products before cancellations can be collected.
#procedure cfcCGCombine(source)
#$cfcCGOK=1;
* The caller reserved one pass. Charge the four additional native operations
* (two exact quotients and two remainder checks); no refund after rejection.
#if {`$cfcPGWorkUsed'+4} > `$cfcPGWorkLimit'
#$cfcCGOK=0;
#$cfcPGWorkExhausted=1;
#else
#$cfcPGWorkUsed=$cfcPGWorkUsed+4;
#do cfcCGCharge=1,4
#call cfcReserveRational
#if `$cfcCWGranted' == 0
#$cfcCGOK=0;
#$cfcPGWorkExhausted=1;
#endif
#enddo
#endif
Skip;
Local cfcCGWork=`source';
.sort
#if `$cfcCGOK' == 1
* Expand definitions individually before multiplying them in the coefficient.
* The registered transitive reference set is ordered by immutable definition id.
#call cfcPGMeasure(cfcCGWork)
#do cfcCGKey=cfcPGLinks
#$cfcCGIndex=0;
Skip;
Local cfcCGKeyWork=`cfcCGKey';
id cfcPGRef(cfcMRIndex?$cfcCGIndex)=1;
ModuleOption noparallel;
.sort
Drop cfcCGKeyWork;
.sort
#$cfcCGKnown=cfcCGExpandedReady(`$cfcCGIndex');
#if isnumerical($cfcCGKnown) == 0
Skip;
Local cfcCGDefinition=extrasymbol_(`$cfcCGIndex');
id cfcShare(cfcMRIndex?)=cfcCGExpanded(cfcMRIndex);
id cfcPolyN(cfcMRIndex?)=cfcCGExpanded(cfcMRIndex);
.sort
* An unavailable dependency keeps the candidate ineligible. Never interpret a
* missing table entry as zero or leave it in an output expression.
#$cfcCGMissing=0;
Skip;
NSkip cfcCGDefinition;
if (occurs(cfcCGExpanded)); $cfcCGMissing=1; endif;
ModuleOption noparallel;
.sort
#if (`$cfcCGMissing' == 0) && (termsin(cfcCGDefinition) <= @CG_TERMS@)
#$cfcCGValue=cfcCGDefinition;
Fill cfcCGExpanded(`$cfcCGIndex')=`$cfcCGValue';
Fill cfcCGExpandedReady(`$cfcCGIndex')=1;
#else
#$cfcCGOK=0;
#endif
Drop cfcCGDefinition;
.sort
#endif
#enddo
Drop cfcPGLinks;
.sort
#endif
#if `$cfcCGOK' == 1
* Polynomial denominator definitions are already small argument-sized blocks.
Skip;
NSkip cfcCGWork;
id cfcPolyD(cfcMRIndex?)=cfcMRDenProbe(cfcCGExpanded(cfcMRIndex));
.sort
#do cfcCGLayer=1,48
#$cfcCGMore=0;
Skip;
NSkip cfcCGWork;
id once cfcShare(cfcMRIndex?)=cfcCGExpanded(cfcMRIndex);
id once cfcPolyN(cfcMRIndex?)=cfcCGExpanded(cfcMRIndex);
if (occurs(cfcShare,cfcPolyN)); $cfcCGMore=1; endif;
ModuleOption noparallel;
.sort
#if (termsin(cfcCGWork) > 100000)
#$cfcCGOK=0;
#breakdo
#endif
#if `$cfcCGMore' == 0
#breakdo
#endif
#enddo
#if `$cfcCGMore' != 0
#$cfcCGOK=0;
#endif
#endif
#if `$cfcCGOK' == 1
Skip;
NSkip cfcCGWork;
@DOTS@
id i_=cfcMRImag;
id denom_(?a)=cfcMRDenProbe(?a);
Argument cfcMRDenProbe;
id i_=cfcMRImag;
@DOTS@
EndArgument;
* Intern inverse factors first. Do NOT use ToPolynomial here: it would hide
* negative powers, which content_ needs to construct the common denominator.
ArgToExtraSymbol cfcMRDenProbe;
id cfcMRDenProbe(cfcMRN?symbol_)=1/cfcMRN;
.sort
#if termsin(cfcCGWork) == 0
Skip;
Local cfcMRWork=0;
.sort
#else
#$cfcCGContent=content_(cfcCGWork);
Skip;
Local cfcCGInverse=$cfcCGContent;
DropCoefficient;
repeat id cfcMRN?symbol_^cfcRPower?pos_=1;
.sort
#$cfcCGInverse=cfcCGInverse;
Drop cfcCGInverse;
.sort
Skip;
Local cfcCGNumerator=cfcCGWork/$cfcCGInverse;
Local cfcCGDenominator=1/$cfcCGInverse;
.sort
Skip;
NSkip cfcCGNumerator,cfcCGDenominator;
FromPolynomial;
.sort
* Only polynomials enter the native GCD. Reject nested inverse definitions and
* unresolved references rather than treating them as independent scalar atoms.
#$cfcCGBad=0;
Skip;
NSkip cfcCGNumerator,cfcCGDenominator;
if (occurs(denom_,cfcPolyD,cfcShare,cfcPolyN,cfcCGExpanded,cfcMRDenProbe)); $cfcCGBad=1; endif;
#do v={@VARIABLES@,cfcMRImag}
if (count(`v',1)<0); $cfcCGBad=1; endif;
#enddo
ModuleOption noparallel;
.sort
#if (`$cfcCGBad' == 0) && (termsin(cfcCGDenominator) != 0)
Skip;
Local cfcCGCommon=gcd_(cfcCGNumerator,cfcCGDenominator);
.sort
Skip;
Local cfcCGN=div_(cfcCGNumerator,cfcCGCommon);
Local cfcCGD=div_(cfcCGDenominator,cfcCGCommon);
Local cfcCGRemN=rem_(cfcCGNumerator,cfcCGCommon);
Local cfcCGRemD=rem_(cfcCGDenominator,cfcCGCommon);
.sort
#if (termsin(cfcCGRemN) != 0) || (termsin(cfcCGRemD) != 0)
#message CFC complete-group exact division failed
#terminate 1
#endif
Skip;
NSkip cfcCGN,cfcCGD;
id cfcMRImag=i_;
@RESTORE@
.sort
* A large numerator may be a sum of shared chunks. The denominator stays one
* complete polynomial argument; reject it predictably before wrapping if large.
#$cfcCGDenWords=sizeof_(cfcCGD);
#if (`$cfcCGDenWords' < 4096)
Skip;
NSkip cfcCGN;
* Collect requires an explicit bracket, even for the complete expression.
Bracket cfcCGPart;
.sort
Skip;
NSkip cfcCGN;
Collect cfcLRNum,cfcCGPart,50;
id cfcCGPart(?a)=cfcLRNum(?a);
ArgToExtraSymbol tonumber,cfcLRNum;
id cfcLRNum(cfcMRIndex?)=cfcPolyN(cfcMRIndex);
.sort
Skip;
Local cfcMRWork=cfcCGN*cfcLRDen(cfcCGD);
.sort
#else
#$cfcCGOK=0;
#endif
Drop cfcCGCommon,cfcCGN,cfcCGD,cfcCGRemN,cfcCGRemD;
.sort
#else
#$cfcCGOK=0;
#endif
Drop cfcCGNumerator,cfcCGDenominator;
.sort
#endif
#endif
Drop cfcCGWork;
.sort
#if `$cfcCGOK' == 0
* The caller retains the complete immutable source and may use its old fallback.
#$cfcMROK=0;
#endif
#endprocedure

* Rationalise one fully assembled commuting multiplier. The original remains
* intact until the candidate succeeds. Treat i_ as a temporary polynomial
* variable, then restore i_^2=-1 in numerator and denominator before writing.
#procedure cfcMRFinal(source)
* Both the local polarisation guard and common job allowance must admit a
* pass. Preserve legacy accounting of cached inspections/algebra at this hook;
* group-result cache hits bypass the hook entirely. Never reset on rollback.
#define cfcMRRun "1"
#ifdef `cfcPGActive'
#if `$cfcPGWorkUsed' >= `$cfcPGWorkLimit'
#redefine cfcMRRun "0"
#$cfcPGWorkExhausted=1;
#$cfcMROK=0;
#endif
#endif
#if `cfcMRRun' == 1
#call cfcReserveRational
#if `$cfcCWGranted' == 0
#redefine cfcMRRun "0"
#$cfcMROK=0;
#ifdef `cfcPGActive'
#$cfcPGWorkExhausted=1;
#endif
#else
#ifdef `cfcPGActive'
#$cfcPGWorkUsed=$cfcPGWorkUsed+1;
#endif
#endif
#endif
#if `cfcMRRun' == 1
#ifdef `cfcPGActive'
#$cfcPGRationalStart=`timer_';
#$cfcPGFactorBefore=$cfcPGFactorMS;
#endif
#ifdef `cfcPGActive'
#ifdef `cfcCGComplete'
#call cfcCGInspect(`source')
#else
#call cfcPGInspectRational(`source')
#endif
#else
#call cfcMRInspect(`source')
#endif
#if `$cfcMROK' == 1
#define cfcMRCompute "1"
#ifdef `cfcPGActive'
* The inspection supplied the immutable input key. Keep it across factor
* inspections, which use the same key helper. Mode 1 includes full factoring.
#$cfcPGAlgebraIndex=$cfcPGRejectIndex;
#define cfcPGAlgebraMode "0"
#ifdef `cfcPGFactorEnabled'
#redefine cfcPGAlgebraMode "1"
#endif
#$cfcPGAlgebraKnown=cfcPGAlgebraReady(`$cfcPGAlgebraIndex',`cfcPGAlgebraMode');
#if (`$cfcPGAlgebraIndex' > 0) && (isnumerical($cfcPGAlgebraKnown))
Drop `source';
.sort
Skip;
Local `source'=cfcPGAlgebra(`$cfcPGAlgebraIndex',`cfcPGAlgebraMode');
.sort
#redefine cfcMRCompute "0"
#endif
#endif
#if `cfcMRCompute' == 1
#ifdef `cfcCGComplete'
#call cfcCGCombine(`source')
#else
Skip;
Local cfcMRWork=`source';
repeat;
id cfcShare(cfcMRIndex?)=extrasymbol_(cfcMRIndex);
id cfcPolyN(cfcMRIndex?)=extrasymbol_(cfcMRIndex);
endrepeat;
id cfcPolyD(cfcMRIndex?)=cfcMRat(1,extrasymbol_(cfcMRIndex));
@NATIVE_DEN_RATIONAL@
id i_=cfcMRImag;
@DOTS@
Argument cfcMRat;
id i_=cfcMRImag;
@DOTS@
EndArgument;
.sort
PolyRatFun cfcMRat;
Skip;
NSkip cfcMRWork;
@POWERS@
Multiply cfcMRat(1,1);
.sort
PolyRatFun;
Skip;
NSkip cfcMRWork;
id cfcMRat(cfcMRN?,cfcMRD?)=cfcLRNum(cfcMRN)*cfcLRDen(cfcMRD);
.sort
#endif
#if `$cfcMROK' == 1
Skip;
NSkip cfcMRWork;
Argument cfcLRNum,cfcLRDen;
id cfcMRImag=i_;
@RESTORE@
EndArgument;
@FACTOR@
id cfcLRDen(1)=1;
id cfcLRNum(cfcMRN?number_)=cfcMRN;
.sort
Skip;
NSkip cfcMRWork;
ArgToExtraSymbol tonumber,cfcLRNum,cfcLRDen;
id cfcLRNum(cfcMRIndex?)=cfcPolyN(cfcMRIndex);
id cfcLRDen(cfcMRIndex?)=cfcPolyD(cfcMRIndex);
.sort
#ifdef `cfcPGActive'
#if (`$cfcPGAlgebraIndex' > 0) && (`$cfcPGWorkExhausted' == 0)
#$cfcPGAlgebraValue=cfcMRWork;
Fill cfcPGAlgebra(`$cfcPGAlgebraIndex',`cfcPGAlgebraMode')=`$cfcPGAlgebraValue';
Fill cfcPGAlgebraReady(`$cfcPGAlgebraIndex',`cfcPGAlgebraMode')=1;
#endif
#endif
Drop `source';
.sort
Drop cfcMRWork;
Local `source'=cfcMRWork;
.sort
NSkip;
.sort
#endif
#endif
#ifdef `cfcPGActive'
#undefine cfcPGAlgebraMode
#endif
#undefine cfcMRCompute
#endif
#ifdef `cfcPGActive'
#$cfcPGRationalMS=$cfcPGRationalMS+`timer_'-$cfcPGRationalStart-($cfcPGFactorMS-$cfcPGFactorBefore);
#endif
#endif
#undefine cfcMRRun
#endprocedure
