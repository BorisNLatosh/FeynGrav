#enddo
.sort
#do cfcSlot=1,`$cfcBatchCount'
Drop cfcCoefficient`cfcSlot';
#enddo
* Compute each common monomial once. Strip scalar functions from the content:
* FORM does not cancel a function against its formal reciprocal. Direct monomial
* division preserves Laurent powers; polynomial div_ is unsuitable here.
#do cfcSlot=1,`$cfcBatchCount'
#$cfcContent`cfcSlot'=1;
#$cfcTerms=termsin_(cfcCoefficient`cfcSlot');
#if ( `$cfcTerms' > 0 ) && ( `$cfcTerms' <= 20000 ) && ( `$cfcIndexed`cfcSlot'' == 0 )
#$cfcContent`cfcSlot'=content_(cfcCoefficient`cfcSlot');
#inside $cfcContent`cfcSlot'
id cfA0(?a)=1;
id cfB0(?a)=1;
id cfC0(?a)=1;
id cfD0(?a)=1;
#endinside
#endif
Local cfcPrimitive`cfcSlot'=cfcCoefficient`cfcSlot'/($cfcContent`cfcSlot');
#enddo
* Only coefficient normalisation is scheduled here; no polynomial factor search.
* A second bracket level groups repeated momentum monomials inside each
* denominator coefficient. Native output preserves the nested sums without
* wrapping a large coefficient inside a single FORM function argument.
Bracket cfv1,cfv2,cfv3;
ModuleOption inparallel;
.sort
* Preserve the common monomial outside the residual sum in ordinary syntax.
#do cfcSlot=1,`$cfcBatchCount'
#write <baseline.out> "+%$*((%$)*(",$cfcKey`cfcSlot',$cfcContent`cfcSlot'
#write <baseline.out> "%E",cfcPrimitive`cfcSlot'
#write <baseline.out> "))"
Drop cfcPrimitive`cfcSlot';
#$cfcContent`cfcSlot'=0;
#$cfcKey`cfcSlot'=0;
#$cfcIndexed`cfcSlot'=0;
#enddo
.sort
#redefine cfcBatch "0"
#endif
#enddo
#close <baseline.out>
.end