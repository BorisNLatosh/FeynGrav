$HistoryLength=0;$LoadFeynArts=True;
Get["/home/latosh/.Wolfram/Applications/FeynGrav/FeynGrav.wl"];
FeynArts`$FAVerbose=0;FeynGrav`importGravitons[1];
name="fgfa_basis_cubic_v4_20261014";
FeynArts`$ModelPath=Prepend[FeynArts`$ModelPath,"/tmp"];
Print["init=",TimeConstrained[FeynArts`InitializeModel[name,FeynArts`GenericModel->name],15,$TimedOut]];
options={FeynArts`Model->name,FeynArts`GenericModel->name,FeynArts`InsertionLevel->{FeynArts`Classes}};
ins=FeynArts`InsertFields[FeynArts`CreateTopologies[0,1->2,FeynArts`Adjacencies->{3}],{FeynArts`T[1]}->{FeynArts`T[1],FeynArts`T[1]},Sequence@@options];
amp=FeynArts`CreateFeynAmp[ins,FeynArts`PreFactor->1,FeynArts`GaugeRules->{},FeynArts`Truncated->True];
Print["ampBytes=",ByteCount[amp]];
fc=TimeConstrained[FCFAConvert[amp,IncomingMomenta->{p},OutgoingMomenta->{q1,q2},Contract->False,ChangeDimension->D,List->True,Prefactor->1],25,$TimedOut];
Print["fcHead=",Head[fc]," count=",Length[fc]," bytes=",ByteCount[fc]];
If[fc===$TimedOut,Quit[2]];
Print["fcStart=",StringTake[ToString[fc[[1]],InputForm],UpTo[2000]]];
Print["fcIndices=",Take[DeleteDuplicates[Cases[fc[[1]],FeynCalc`LorentzIndex[i_,___]:>i,Infinity]],UpTo[20]]];
Print["fcResidualFA=",Count[fc[[1]],_Global`FAFourVector|_Global`FAMetricTensor|_Global`FAScalarProduct,Infinity]];
a=FeynGrav`GravitonVertex[Lor1,Lor2,p,Lor3,Lor4,-q1,Lor5,Lor6,-q2];
b=FeynGrav`GravitonVertex[Lor5,Lor6,-q2,Lor3,Lor4,-q1,Lor1,Lor2,p];
raw=TimeConstrained[Expand[fc[[1]]-a],12,$TimedOut];
perm=TimeConstrained[Expand[a-b],12,$TimedOut];
Print["exactFCvsRule=",raw===0," residualBytes=",ByteCount[raw]," timedOut=",raw===$TimedOut];
Print["exactLegPermutation=",perm===0," residualBytes=",ByteCount[perm]," timedOut=",perm===$TimedOut];
Quit[];
