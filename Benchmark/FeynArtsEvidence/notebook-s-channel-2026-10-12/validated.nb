Notebook[{Cell["Tree-level graviton scattering with FeynArts", "Title"], 
  Cell["FeynArts version of Graviton_Scattering_Tree_Level.nb: generate and \
calculate the massless s-channel four-graviton tree contribution with the \
same helicity conventions. The other exchange channels and quartic contact \
are not included yet.", "Text"], Cell["1. Initialisation", "Section"], 
  Cell["Start with a fresh kernel and evaluate the cell below with \
Shift+Enter. FeynGrav loads FeynCalc and CalcFormConverter; setting \
$LoadFeynArts first also loads the installed FeynCalc-patched FeynArts. The \
saved pure-GR model uses gauge parameter 2 and contains the cubic and quartic \
graviton interactions and gravitational ghosts. No diagrams are generated and \
FORM is not executed here. Opening this notebook executes nothing.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"$LoadFeynArts", "=", "True"}], ";", "\n", 
      RowBox[{"feynGravDirectory", "=", RowBox[{"ExpandFileName", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                 {"NotebookDirectory", "[", "]"}], ",", "\"..\""}], "}"}], 
            "]"}], "]"}]}], ";", "\n", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"feynGravDirectory", ",", "\"FeynGrav.wl\""}], 
            "}"}], "]"}], "]"}], ";", "\n", 
      RowBox[{"FeynGrav`importGravitons", "[", "2", "]"}], ";", "\n", "\n", 
      RowBox[{"grModelDirectory", "=", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"feynGravDirectory", ",", "\"Benchmark\"", 
              ",", "\"FeynArtsEvidence\"", ",", "\"model-first-2026-10-12\"", 
              ",", "\"model\""}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"grModel", "=", "\"FGPureGR5a149c98161e2b2e\""}], ";", "\n", 
      RowBox[{"FeynArts`$ModelPath", "=", RowBox[{"Prepend", "[", 
          RowBox[{RowBox[{"DeleteCases", "[", RowBox[{"FeynArts`$ModelPath", 
                ",", "grModelDirectory"}], "]"}], ",", "grModelDirectory"}], 
          "]"}]}], ";", "\n", RowBox[{"If", "[", 
        RowBox[{RowBox[{RowBox[{"FeynArts`InitializeModel", "[", 
              RowBox[{"grModel", ",", RowBox[{"FeynArts`GenericModel", "->", 
                  "grModel"}], ",", RowBox[{"FeynArts`Reinitialize", "->", 
                  "False"}]}], "]"}], "=!=", "True"}], ",", "\n", 
          RowBox[{RowBox[{"Print", "[", "\"The pure-GR model could not be \
loaded. Check grModelDirectory and restart with a fresh kernel.\"", "]"}], 
            ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], "Input", 
   InitializationCell -> True], Cell["2. Generate and select the s-channel", 
   "Section"], Cell["Generate cubic 2 -> 2 tree topologies and select the one \
whose two incoming external lines meet at the same vertex. This identifies \
the s-channel by connectivity, not diagram-list position. FeynArts supplies \
the two cubic vertices, propagator and graph factor; no additional symmetry \
factor is applied. All p1,...,p4 below are incoming, so the physical outgoing \
momenta passed to FCFAConvert are -p3 and -p4.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"treeTopologies", "=", 
        RowBox[{"FeynArts`CreateTopologies", "[", 
          RowBox[{"0", ",", RowBox[{"2", "\[Rule]", "2"}], ",", 
            RowBox[{"FeynArts`Adjacencies", "\[Rule]", RowBox[{"{", "3", 
                "}"}]}]}], "]"}]}], ";", RowBox[{"sTopologies", "=", 
        RowBox[{"Select", "[", RowBox[{"treeTopologies", ",", 
            RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                     {"incomingVertices", "=", RowBox[{"Cases", "[", 
                        RowBox[{"#1", ",", RowBox[{RowBox[{RowBox[
                          {"FeynArts`Propagator", "[", "FeynArts`Incoming", 
                          "]"}], "[", RowBox[{"_", ",", "vertex_"}], "]"}], 
                          "\[RuleDelayed]", "vertex"}], ",", "\[Infinity]"}], 
                        "]"}]}], "}"}], ",", RowBox[{RowBox[{RowBox[
                       {"Length", "[", "incomingVertices", "]"}], "===", 
                      "2"}], "&&", RowBox[{"SameQ", "@@", 
                      "incomingVertices"}]}]}], "]"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"Length", "[", "sTopologies", "]"}], "=!=", "1"}], 
          ",", RowBox[{RowBox[{"Print", "[", 
              "\"Expected exactly one s-channel topology.\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
      RowBox[{"sInsertions", "=", RowBox[{"FeynArts`InsertFields", "[", 
          RowBox[{"sTopologies", ",", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"FeynArts`T", "[", "1", "]"}], ",", RowBox[
                   {"FeynArts`T", "[", "1", "]"}]}], "}"}], "\[Rule]", 
              RowBox[{"{", RowBox[{RowBox[{"FeynArts`T", "[", "1", "]"}], 
                  ",", RowBox[{"FeynArts`T", "[", "1", "]"}]}], "}"}]}], ",", 
            RowBox[{"FeynArts`Model", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`GenericModel", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`InsertionLevel", "\[Rule]", RowBox[{"{", 
                "FeynArts`Classes", "}"}]}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell["Optional drawing: evaluate \
FeynArts`Paint[sInsertions]. The calculation below does not require a \
graphical front end.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sRawAmplitude", "=", 
        RowBox[{"FeynArts`CreateFeynAmp", "[", RowBox[{"sInsertions", ",", 
            RowBox[{"FeynArts`PreFactor", "\[Rule]", "1"}], ",", 
            RowBox[{"FeynArts`GaugeRules", "\[Rule]", RowBox[{"{", "}"}]}], 
            ",", RowBox[{"FeynArts`MomentumConservation", "\[Rule]", 
              "True"}], ",", RowBox[{"FeynArts`Truncated", "\[Rule]", 
              "True"}]}], "]"}]}], ";", RowBox[{"sConverted", "=", 
        RowBox[{"FeynCalc`FCFAConvert", "[", RowBox[{"sRawAmplitude", ",", 
            RowBox[{"FeynCalc`IncomingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
            RowBox[{"FeynCalc`OutgoingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{RowBox[{"-", "p3"}], ",", RowBox[{"-", "p4"}]}], 
                "}"}]}], ",", RowBox[{"FeynCalc`LorentzIndexNames", 
              "\[Rule]", RowBox[{"{", RowBox[{"mu1", ",", "nu1", ",", "mu2", 
                  ",", "nu2", ",", "mu3", ",", "nu3", ",", "mu4", ",", "nu4", 
                  ",", "alpha1", ",", "beta1", ",", "alpha2", ",", "beta2"}], 
                "}"}]}], ",", RowBox[{"FeynCalc`ChangeDimension", "\[Rule]", 
              "D"}], ",", RowBox[{"FeynCalc`Contract", "\[Rule]", "False"}], 
            ",", RowBox[{"List", "\[Rule]", "True"}], ",", 
            RowBox[{"FeynCalc`Prefactor", "\[Rule]", "1"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"!", RowBox[{"ListQ", "[", "sConverted", "]"}]}], 
            "||", RowBox[{RowBox[{"Length", "[", "sConverted", "]"}], "=!=", 
              "1"}]}], ",", RowBox[{RowBox[{"Print", "[", 
              "\"Expected one converted s-channel diagram.\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
      RowBox[{"sChannelTensor", "=", RowBox[{"First", "[", "sConverted", 
          "]"}]}], ";", RowBox[{"sChannelRouting", "=", 
        RowBox[{"Cases", "[", RowBox[{"sChannelTensor", ",", 
            RowBox[{RowBox[{"FeynCalc`PropagatorDenominator", "[", 
                RowBox[{RowBox[{"FeynCalc`Momentum", "[", RowBox[{"q_", ",", 
                      "___"}], "]"}], ",", "0"}], "]"}], "\[RuleDelayed]", 
              "q"}], ",", "\[Infinity]"}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell[BoxData["sChannelRouting"], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"-", "p3"}], "-", "p4"}], "}"}]], 
   "Output"], Cell["MomentumConservation -> True determines internal routing \
at each vertex; it does not put external legs on shell. In the all-incoming \
convention, the exchanged momentum is -(p3+p4) = p1+p2 and its pole is 1/s. \
The tensor is amputated: external helicity tensors are supplied explicitly \
below.", "Text"], Cell["3. Apply the original massless helicity conventions", 
   "Section"], Cell["Use the same polarisation scalar products as \
Graviton_Scattering_Tree_Level.nb. The labels h1,...,h4 take values +/-1 and \
represent graviton helicities +/-2; I and -I select incoming tensors and \
conjugated outgoing tensors, not helicity signs. These are four-dimensional \
helicity kinematics, with symbolic D retained as in the original tensor \
calculation. SetMandelstam and the Pair assignments change this kernel's \
kinematics: use a fresh kernel for unrelated examples.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"FeynCalc`SetMandelstam", "[", 
        RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", "p3", 
          ",", "p4", ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], ";", 
      RowBox[{"momenta", "=", RowBox[{"{", RowBox[{"p1", ",", "p2", ",", 
            "p3", ",", "p4"}], "}"}]}], ";", 
      RowBox[{"polarisationMomenta", "=", RowBox[{"MapThread", "[", 
          RowBox[{RowBox[{RowBox[{"FeynCalc`Momentum", "[", RowBox[
                 {RowBox[{"FeynCalc`Polarization", "[", RowBox[{"#1", ",", 
                      "#2"}], "]"}], ",", "D"}], "]"}], "&"}], ",", 
            RowBox[{"{", RowBox[{"momenta", ",", RowBox[{"{", RowBox[
                   {"\[ImaginaryI]", ",", "\[ImaginaryI]", ",", RowBox[
                     {"-", "\[ImaginaryI]"}], ",", RowBox[{"-", 
                      "\[ImaginaryI]"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"helicityAssumptions", "=", 
        RowBox[{RowBox[{SuperscriptBox["h1", "2"], "\[Equal]", "1"}], "&&", 
          RowBox[{SuperscriptBox["h2", "2"], "\[Equal]", "1"}], "&&", 
          RowBox[{SuperscriptBox["h3", "2"], "\[Equal]", "1"}], "&&", 
          RowBox[{SuperscriptBox["h4", "2"], "\[Equal]", "1"}], "&&", 
          RowBox[{RowBox[{"s", "+", "t", "+", "u"}], "\[Equal]", "0"}], "&&", 
          RowBox[{RowBox[{"{", RowBox[{"h1", ",", "h2", ",", "h3", ",", "h4", 
                ",", "s", ",", "t", ",", "u"}], "}"}], "\[Element]", 
            TemplateBox[{}, "Reals"]}], "&&", RowBox[{"s", ">", "0"}], "&&", 
          RowBox[{"t", "<", "0"}], "&&", RowBox[{"u", "<", "0"}]}]}], ";"}]], 
   "Input", InitializationCell -> False], Cell["The symmetric table below is \
epsilon_i . epsilon_j. Its zero diagonal imposes traceless factorised \
helicity tensors. It reproduces the original notebook's six mixed \
polarisation products.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"polarisationProducts", "=", 
        RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", RowBox[
                 {FractionBox["1", "2"], " ", RowBox[{"(", RowBox[{"1", "+", 
                      RowBox[{"h1", " ", "h2"}]}], ")"}]}], ",", 
                FractionBox[RowBox[{"s", "+", RowBox[{"h1", " ", "h3", " ", 
                     RowBox[{"(", RowBox[{"s", "+", RowBox[{"2", " ", 
                          "t"}]}], ")"}]}]}], RowBox[{"2", " ", "s"}]], ",", 
                FractionBox[RowBox[{"h1", " ", "h4", " ", RowBox[{"(", 
                     RowBox[{RowBox[{"h1", " ", "h4", " ", "s"}], "-", "t", 
                       "+", "u"}], ")"}]}], RowBox[{"2", " ", "s"}]]}], 
              "}"}], ",", RowBox[{"{", RowBox[{RowBox[{FractionBox["1", "2"], 
                  " ", RowBox[{"(", RowBox[{"1", "+", RowBox[{"h1", " ", 
                        "h2"}]}], ")"}]}], ",", "0", ",", FractionBox[
                 RowBox[{"h2", " ", "h3", " ", RowBox[{"(", RowBox[
                      {RowBox[{"h2", " ", "h3", " ", "s"}], "-", "t", "+", 
                       "u"}], ")"}]}], RowBox[{"2", " ", "s"}]], ",", 
                FractionBox[RowBox[{"s", "+", RowBox[{"h2", " ", "h4", " ", 
                     RowBox[{"(", RowBox[{"s", "+", RowBox[{"2", " ", 
                          "t"}]}], ")"}]}]}], RowBox[{"2", " ", "s"}]]}], 
              "}"}], ",", RowBox[{"{", RowBox[{FractionBox[RowBox[{"s", "+", 
                   RowBox[{"h1", " ", "h3", " ", RowBox[{"(", RowBox[
                        {"s", "+", RowBox[{"2", " ", "t"}]}], ")"}]}]}], 
                 RowBox[{"2", " ", "s"}]], ",", FractionBox[RowBox[
                  {"h2", " ", "h3", " ", RowBox[{"(", RowBox[{RowBox[
                        {"h2", " ", "h3", " ", "s"}], "-", "t", "+", "u"}], 
                     ")"}]}], RowBox[{"2", " ", "s"}]], ",", "0", ",", 
                RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                     {"1", "+", RowBox[{"h3", " ", "h4"}]}], ")"}]}]}], 
              "}"}], ",", RowBox[{"{", RowBox[{FractionBox[RowBox[{"h1", " ", 
                   "h4", " ", RowBox[{"(", RowBox[{RowBox[{"h1", " ", "h4", 
                         " ", "s"}], "-", "t", "+", "u"}], ")"}]}], 
                 RowBox[{"2", " ", "s"}]], ",", FractionBox[RowBox[
                  {"s", "+", RowBox[{"h2", " ", "h4", " ", RowBox[{"(", 
                       RowBox[{"s", "+", RowBox[{"2", " ", "t"}]}], 
                       ")"}]}]}], RowBox[{"2", " ", "s"}]], ",", 
                RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                     {"1", "+", RowBox[{"h3", " ", "h4"}]}], ")"}]}], ",", 
                "0"}], "}"}]}], "}"}]}], ";", 
      RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"FeynCalc`Pair", "[", 
              RowBox[{RowBox[{"polarisationMomenta", "\[LeftDoubleBracket]", 
                  "i", "\[RightDoubleBracket]"}], ",", RowBox[
                 {"polarisationMomenta", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}]}], "]"}], "=", 
            RowBox[{"polarisationProducts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"{", RowBox[{"i", ",", "4"}], "}"}], ",", 
          RowBox[{"{", RowBox[{"j", ",", "4"}], "}"}]}], "]"}], ";"}]], 
   "Input", InitializationCell -> False], Cell["Rows in the next table \
correspond to p1,...,p4; columns to epsilon1,...,epsilon4. Its diagonal gives \
transversality; its remaining entries fix the same reference-vector \
convention as the original example.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"momentumPolarisationProducts", "=", 
        RowBox[{SqrtBox[FractionBox[RowBox[{"t", " ", "u"}], 
            RowBox[{"2", " ", "s"}]]], " ", RowBox[
           {"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", "h3", ",", 
                  RowBox[{"-", "h4"}]}], "}"}], ",", RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", RowBox[{"-", "h3"}], ",", "h4"}], 
                "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", "h1"}], ",", 
                  "h2", ",", "0", ",", "0"}], "}"}], ",", RowBox[{"{", 
                RowBox[{"h1", ",", RowBox[{"-", "h2"}], ",", "0", ",", "0"}], 
                "}"}]}], "}"}]}]}], ";", 
      RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"FeynCalc`Pair", "[", 
              RowBox[{RowBox[{"FeynCalc`Momentum", "[", RowBox[
                   {RowBox[{"momenta", "\[LeftDoubleBracket]", "i", 
                      "\[RightDoubleBracket]"}], ",", "D"}], "]"}], ",", 
                RowBox[{"polarisationMomenta", "\[LeftDoubleBracket]", "j", 
                  "\[RightDoubleBracket]"}]}], "]"}], "=", 
            RowBox[{"momentumPolarisationProducts", "\[LeftDoubleBracket]", 
              RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ",", 
          RowBox[{"{", RowBox[{"i", ",", "4"}], "}"}], ",", 
          RowBox[{"{", RowBox[{"j", ",", "4"}], "}"}]}], "]"}], ";", 
      RowBox[{"sChannelPole", "=", RowBox[{"FeynCalc`ExpandScalarProduct", 
          "[", RowBox[{"FeynCalc`FeynAmpDenominatorExplicit", "[", 
            RowBox[{"First", "[", RowBox[{"Cases", "[", RowBox[
                 {"sChannelTensor", ",", "_FeynCalc`FeynAmpDenominator", ",", 
                  "\[Infinity]"}], "]"}], "]"}], "]"}], "]"}]}], ";"}]], 
   "Input", InitializationCell -> False], Cell[BoxData["sChannelPole"], 
   "Input", InitializationCell -> False], 
  Cell[BoxData[FractionBox["1", "s"]], "Output"], 
  Cell["4. Contract the s-channel with the external helicity tensors", 
   "Section"], Cell["CalcFormCalculate performs the tensor algebra using real \
FORM, with one worker and a 60-second per-stage time limit. The input stays \
factored; it is not expanded into a large open-index exchange tensor first. \
FORM job files are retained under sChannelWorkDirectory. This is one \
gauge-dependent channel, not the full gauge-invariant scattering amplitude or \
a cross section. No extra factor of i, graph factor, spin sum or loop measure \
is inserted.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sExternalTensors", "=", 
        RowBox[{RowBox[{"FeynGrav`PolarizationTensorD", "[", 
            RowBox[{"p1", ",", "mu1", ",", "nu1", ",", "\[ImaginaryI]"}], 
            "]"}], " ", RowBox[{"FeynGrav`PolarizationTensorD", "[", 
            RowBox[{"p2", ",", "mu2", ",", "nu2", ",", "\[ImaginaryI]"}], 
            "]"}], " ", RowBox[{"FeynGrav`PolarizationTensorD", "[", 
            RowBox[{"p3", ",", "mu3", ",", "nu3", ",", RowBox[{"-", 
                "\[ImaginaryI]"}]}], "]"}], " ", 
          RowBox[{"FeynGrav`PolarizationTensorD", "[", 
            RowBox[{"p4", ",", "mu4", ",", "nu4", ",", RowBox[{"-", 
                "\[ImaginaryI]"}]}], "]"}]}]}], ";", 
      RowBox[{"sChannelWorkDirectory", "=", RowBox[{"CreateDirectory", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{
                "$TemporaryDirectory", ",", RowBox[{"\"fgfa-s-channel-\"", 
                  "<>", RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], 
          "]"}]}], ";", RowBox[{"sChannelFORM", "=", 
        RowBox[{"CalcFormConverter`CalcFormCalculate", "[", 
          RowBox[{RowBox[{RowBox[{"FeynCalc`FeynAmpDenominatorExplicit", "[", 
                "sChannelTensor", "]"}], " ", "sExternalTensors"}], ",", 
            RowBox[{"FeynCalc`Dimension", "\[Rule]", "D"}], ",", 
            RowBox[{"CalcFormConverter`FORMThreads", "\[Rule]", "1"}], ",", 
            RowBox[{"TimeConstraint", "\[Rule]", "60"}], ",", 
            RowBox[{"CalcFormConverter`WorkingDirectory", "\[Rule]", 
              "sChannelWorkDirectory"}], ",", RowBox[
             {"CalcFormConverter`KeepFiles", "\[Rule]", "True"}], ",", 
            RowBox[{"CalcFormConverter`ShowProgress", "\[Rule]", "False"}]}], 
          "]"}]}], ";", RowBox[{"If", "[", 
        RowBox[{RowBox[{RowBox[{"FailureQ", "[", "sChannelFORM", "]"}], "||", 
            RowBox[{"MemberQ", "[", RowBox[{RowBox[{"{", RowBox[{"$Failed", 
                    ",", "$Aborted"}], "}"}], ",", "sChannelFORM"}], "]"}], 
            "||", RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"sChannelFORM", 
                  ",", RowBox[{"_FeynCalc`LorentzIndex", "|", 
                    "_FeynCalc`Pair", "|", 
                    "_CalcFormConverter`CalcFormCalculate"}]}], "]"}]}]}], 
          ",", RowBox[{RowBox[{"Print", "[", "\"The FORM contraction did not \
return a scalar. Inspect sChannelFORM and sChannelWorkDirectory.\"", "]"}], 
            ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
      RowBox[{"AmplitudeSChannel", "=", RowBox[{"FeynCalc`TrickMandelstam", 
          "[", RowBox[{RowBox[{"Simplify", "[", RowBox[{"sChannelFORM", ",", 
                RowBox[{"Assumptions", "\[Rule]", "helicityAssumptions"}]}], 
              "]"}], ",", RowBox[{"{", RowBox[{"s", ",", "t", ",", "u", ",", 
                "0"}], "}"}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell[BoxData["AmplitudeSChannel"], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[FractionBox[RowBox[{"9", " ", "\[ImaginaryI]", " ", 
       RowBox[{"(", RowBox[{"1", "+", RowBox[{"h1", " ", "h2"}]}], ")"}], 
       " ", RowBox[{"(", RowBox[{"1", "+", RowBox[{"h3", " ", "h4"}]}], 
         ")"}], " ", "t", " ", "u", " ", SuperscriptBox["\[Kappa]", "2"]}], 
     RowBox[{"16", " ", "s"}]]], "Output"], 
  Cell["5. Check against the original notebook", "Section"], 
  Cell["The expression below is the saved s-channel reference in the original \
notebook, including its FeynGrav normalisation. It is used only after the \
FeynArts/FORM calculation, never as an input or replacement for the \
calculated amplitude. The residual must vanish; this tests the s-channel \
only, not a Ward identity for the full amplitude.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sChannelReference", "=", 
        FractionBox[RowBox[{"9", " ", "\[ImaginaryI]", " ", 
           SuperscriptBox["FeynGrav`\[Kappa]", "2"], " ", "t", " ", "u", " ", 
           RowBox[{"(", RowBox[{"1", "+", RowBox[{"h1", " ", "h2"}]}], ")"}], 
           " ", RowBox[{"(", RowBox[{"1", "+", RowBox[{"h3", " ", "h4"}]}], 
             ")"}]}], RowBox[{"16", " ", "s"}]]}], ";", 
      RowBox[{"sChannelReferenceResidual", "=", 
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"AmplitudeSChannel", "-", 
              "sChannelReference"}], ",", RowBox[{"Assumptions", "\[Rule]", 
              "helicityAssumptions"}]}], "]"}]}], ";", 
      RowBox[{"sChannelMatchesReference", "=", 
        RowBox[{"TrueQ", "[", RowBox[{"sChannelReferenceResidual", "===", 
            "0"}], "]"}]}], ";"}]], "Input", InitializationCell -> False], 
  Cell[BoxData["sChannelMatchesReference"], "Input", 
   InitializationCell -> False], Cell[BoxData["True"], "Output"]}, 
 WindowTitle -> "Tree-level graviton scattering with FeynArts", 
 InitializationCellEvaluation -> False, StyleDefinitions -> "Default.nb"]
