(*** Wolfram Notebook File ***)
(* CreatedBy='Wolfram 15.0' *)

Notebook[{
 Cell["Tree-level graviton scattering with FeynArts", "Title"],
 Cell["FeynArts version of Graviton_Scattering_Tree_Level.nb. This notebook currently contains only initialisation; diagram generation, on-shell kinematics and amplitude calculation will be added later.", "Text"],
 Cell["1. Initialisation", "Section"],
 Cell["Start with a fresh kernel and evaluate the cell below with Shift+Enter. FeynGrav loads FeynCalc and CalcFormConverter; setting $LoadFeynArts first also loads the installed FeynCalc-patched FeynArts. The saved pure-GR model uses gauge parameter 2 and contains the cubic and quartic graviton interactions and gravitational ghosts. No diagrams are generated and FORM is not executed here. Opening this notebook executes nothing.", "Text"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"$LoadFeynArts", "=", "True"}], ";", "\n",
   RowBox[{"feynGravDirectory", "=", RowBox[{"ExpandFileName", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"..\""}], "}"}], "]"}], "]"}]}], ";", "\n",
   RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"feynGravDirectory", ",", "\"FeynGrav.wl\""}], "}"}], "]"}], "]"}], ";", "\n",
   RowBox[{"FeynGrav`importGravitons", "[", "2", "]"}], ";", "\n", "\n",
   RowBox[{"grModelDirectory", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{
    "feynGravDirectory", ",", "\"Benchmark\"", ",", "\"FeynArtsEvidence\"", ",",
    "\"model-first-2026-10-12\"", ",", "\"model\""}], "}"}], "]"}]}], ";", "\n",
   RowBox[{"grModel", "=", "\"FGPureGR5a149c98161e2b2e\""}], ";", "\n",
   RowBox[{"FeynArts`$ModelPath", "=", RowBox[{"Prepend", "[", RowBox[{
    RowBox[{"DeleteCases", "[", RowBox[{"FeynArts`$ModelPath", ",", "grModelDirectory"}], "]"}], ",", "grModelDirectory"}], "]"}]}], ";", "\n",
   RowBox[{"If", "[", RowBox[{
    RowBox[{RowBox[{"FeynArts`InitializeModel", "[", RowBox[{
     "grModel", ",", RowBox[{"FeynArts`GenericModel", "->", "grModel"}], ",",
     RowBox[{"FeynArts`Reinitialize", "->", "False"}]}], "]"}], "=!=", "True"}], ",", "\n",
    RowBox[{
     RowBox[{"Print", "[", "\"The pure-GR model could not be loaded. Check grModelDirectory and restart with a fresh kernel.\"", "]"}], ";",
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"
  }]], "Input", InitializationCell -> True]
},
 WindowTitle -> "Tree-level graviton scattering with FeynArts",
 InitializationCellEvaluation -> False,
 StyleDefinitions -> "Default.nb"
]
