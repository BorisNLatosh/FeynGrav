(* End-to-end finite pure-GR tree API, no contraction, spin sums or FORM. *)
$HistoryLength=0;$LoadFeynArts=True;
Get["/home/latosh/.Wolfram/Applications/FeynGrav/FeynGrav.wl"];
Get["/home/latosh/.Wolfram/Applications/FeynGrav/FeynArtsIntegration/FeynArtsIntegration.wl"];
dir="/tmp/fgfa_puregr_finite_public_20261014";name="FGPureGR5a149c98161e2b2e";
model=<|"Directory"->dir,"ModelName"->name,"Manifest"->FileNameJoin[{dir,"manifest.json"}]|>;
gravField=FeynArts`T[1];
three=<|"Model"->"PureGR","Incoming"->{gravField},"Outgoing"->{gravField,gravField},"LoopOrder"->0|>;
four=<|"Model"->"PureGR","Incoming"->{gravField,gravField},"Outgoing"->{gravField,gravField},"LoopOrder"->0|>;
block=Join[three,<|"Outgoing"->{gravField},"LoopOrder"->1,"OneParticleIrreducible"->True|>];
check=FeynGrav`FeynArtsIntegration`FeynGravCreateAmplitude[model,block,{p},{q}];
Print["PREINIT_LOOP_REJECT=",FailureQ[check]," FAILURE_TAG=",If[FailureQ[check],check[[1]],None]];
check=FeynGrav`FeynArtsIntegration`FeynGravCreateAmplitude[model,Join[three,<|"Outgoing"->{gravField,FeynArts`U[1]}|>],{p},{q1,q2}];
Print["PREINIT_GHOST_EXTERNAL_REJECT=",FailureQ[check]];
check=FeynGrav`FeynArtsIntegration`FeynGravCreateAmplitude[model,three,{p,p},{q1,q2}];
Print["MOMENTUM_REJECT=",FailureQ[check]];
r3=FeynGrav`FeynArtsIntegration`FeynGravCreateAmplitude[model,three,{p},{q1,q2}];
Print["THREE_RESULT=",If[AssociationQ[r3],"Constructed",ToString[InputForm[r3]]]];
If[!AssociationQ[r3],Quit[2]];
s3=FeynGrav`GravitonVertex[Lor1,Lor2,p,Lor3,Lor4,-q1,Lor5,Lor6,-q2];
x3=TimeConstrained[Expand[r3["Diagrams"][[1,"Expression"]]-s3],12,$TimedOut];
Print["THREE_COUNT=",Length[r3["Diagrams"]]," THREE_EXACT=",TrueQ[x3===0]," THREE_NO_EXT_LEGS=",TrueQ[r3["ExternalWavefunctionsAdded"]===False]];
r4=FeynGrav`FeynArtsIntegration`FeynGravCreateAmplitude[model,four,{p1,p2},{q1,q2}];
Print["FOUR_RESULT=",If[AssociationQ[r4],"Constructed",ToString[InputForm[r4]]]];
If[!AssociationQ[r4],Quit[3]];
cts=Pick[Lookup[r4["Diagrams"],"Expression"],Lookup[r4["Diagrams"],"DenominatorCount"],0];
s4=FeynGrav`GravitonVertex[Lor1,Lor2,p1,Lor3,Lor4,p2,Lor5,Lor6,-q1,Lor7,Lor8,-q2];
x4=If[Length[cts]===1,TimeConstrained[Expand[First[cts]-s4],18,$TimedOut],$Failed];
Print["FOUR_COUNTS=",InputForm[Lookup[r4["Diagrams"],"DenominatorCount"]]," CONTACT_EXACT=",TrueQ[x4===0]," RAW_AVAILABLE=",KeyExistsQ[r4,"Insertions"]&&KeyExistsQ[r4,"RawAmplitude"]];
Quit[If[TrueQ[x3===0]&&TrueQ[x4===0]&&Length[r4["Diagrams"]]===4,0,4]];
