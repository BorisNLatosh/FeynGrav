                       "\"model-first-2026-10-12\"", ",", "\"model\"", ",", 
                       "\"FGPureGR5a149c98161e2b2e\""}], "}"}], "]"}]}], ";", 
               RowBox[{"InitializeModel", "[", RowBox[{"grModel", ",", 
                   RowBox[{"GenericModel", "\[Rule]", "grModel"}]}], "]"}], 
               ";"}]], "Input", InitializationCell -> True, 
