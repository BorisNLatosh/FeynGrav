Notebook[{Cell["Tree-level graviton scattering with FeynArts", "Title"], 
  Cell["Construct the off-shell s-channel four-graviton tree contribution \
using FeynArts, attach external polarisation tensors and contract their \
indices. No mass-shell, transversality, tracelessness or helicity conditions \
are imposed. The other channels and quartic contact are not included yet.", 
   "Text"], Cell["1. Initialisation", "Section"], 
  Cell["Start with a fresh kernel (especially after running the previous \
on-shell version) and evaluate the cell below with Shift+Enter. FeynGrav \
loads FeynCalc and CalcFormConverter; setting $LoadFeynArts first also loads \
the installed FeynCalc-patched FeynArts. The saved pure-GR model uses gauge \
parameter 2 and contains the cubic and quartic graviton interactions and \
gravitational ghosts. No diagrams are generated and FORM is not executed \
here. Opening this notebook executes nothing.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"$LoadFeynArts", "=", "True"}], ";", "\n", 
      RowBox[{"feynGravDirectory", "=", RowBox[{"ExpandFileName", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                 {"NotebookDirectory", "[", "]"}], ",", "\"..\""}], "}"}], 
            "]"}], "]"}]}], ";", "\n", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"feynGravDirectory", ",", "\"FeynGrav.wl\""}], 
            "}"}], "]"}], "]"}], ";", "\n", 
      RowBox[{"FeynGrav`importGravitons", "[", "2", "]"}], ";", "\n", "\n", 
      RowBox[{"grModelDirectory", "=", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"feynGravDirectory", ",", "\"Benchmark\"", 
              ",", "\"FeynArtsEvidence\"", ",", "\"model-first-2026-10-12\"", 
              ",", "\"model\""}], "}"}], "]"}]}], ";", "\n", 
      RowBox[{"grModel", "=", "\"FGPureGR5a149c98161e2b2e\""}], ";", "\n", 
      RowBox[{"FeynArts`$ModelPath", "=", RowBox[{"Prepend", "[", 
          RowBox[{RowBox[{"DeleteCases", "[", RowBox[{"FeynArts`$ModelPath", 
                ",", "grModelDirectory"}], "]"}], ",", "grModelDirectory"}], 
          "]"}]}], ";", "\n", RowBox[{"If", "[", 
        RowBox[{RowBox[{RowBox[{"FeynArts`InitializeModel", "[", 
              RowBox[{"grModel", ",", RowBox[{"FeynArts`GenericModel", "->", 
                  "grModel"}], ",", RowBox[{"FeynArts`Reinitialize", "->", 
                  "False"}]}], "]"}], "=!=", "True"}], ",", "\n", 
          RowBox[{RowBox[{"Print", "[", "\"The pure-GR model could not be \
loaded. Check grModelDirectory and restart with a fresh kernel.\"", "]"}], 
            ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], "Input", 
   InitializationCell -> True], Cell["2. Generate and select the s-channel", 
   "Section"], Cell["Generate cubic 2 -> 2 tree topologies and select the one \
whose two incoming external lines meet at the same vertex. This identifies \
the s-channel by connectivity, not diagram-list position. FeynArts supplies \
the two cubic vertices, propagator and graph factor; no additional symmetry \
factor is applied. Use incoming momenta p1, p2 and outgoing momenta p3, p4. \
Their virtualities and scalar products remain symbolic; FeynArts supplies the \
signs of momenta entering individual vertices.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"treeTopologies", "=", 
        RowBox[{"FeynArts`CreateTopologies", "[", 
          RowBox[{"0", ",", RowBox[{"2", "\[Rule]", "2"}], ",", 
            RowBox[{"FeynArts`Adjacencies", "\[Rule]", RowBox[{"{", "3", 
                "}"}]}]}], "]"}]}], ";", RowBox[{"sTopologies", "=", 
        RowBox[{"Select", "[", RowBox[{"treeTopologies", ",", 
            RowBox[{RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                     {"incomingVertices", "=", RowBox[{"Cases", "[", 
                        RowBox[{"#1", ",", RowBox[{RowBox[{RowBox[
                          {"FeynArts`Propagator", "[", "FeynArts`Incoming", 
                          "]"}], "[", RowBox[{"_", ",", "vertex_"}], "]"}], 
                          "\[RuleDelayed]", "vertex"}], ",", "\[Infinity]"}], 
                        "]"}]}], "}"}], ",", RowBox[{RowBox[{RowBox[
                       {"Length", "[", "incomingVertices", "]"}], "===", 
                      "2"}], "&&", RowBox[{"SameQ", "@@", 
                      "incomingVertices"}]}]}], "]"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"Length", "[", "sTopologies", "]"}], "=!=", "1"}], 
          ",", RowBox[{RowBox[{"Print", "[", 
              "\"Expected exactly one s-channel topology.\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
      RowBox[{"sInsertions", "=", RowBox[{"FeynArts`InsertFields", "[", 
          RowBox[{"sTopologies", ",", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"FeynArts`T", "[", "1", "]"}], ",", RowBox[
                   {"FeynArts`T", "[", "1", "]"}]}], "}"}], "\[Rule]", 
              RowBox[{"{", RowBox[{RowBox[{"FeynArts`T", "[", "1", "]"}], 
                  ",", RowBox[{"FeynArts`T", "[", "1", "]"}]}], "}"}]}], ",", 
            RowBox[{"FeynArts`Model", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`GenericModel", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`InsertionLevel", "\[Rule]", RowBox[{"{", 
                "FeynArts`Classes", "}"}]}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell["Optional drawing: evaluate \
FeynArts`Paint[sInsertions]. The calculation below does not require a \
graphical front end.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sRawAmplitude", "=", 
        RowBox[{"FeynArts`CreateFeynAmp", "[", RowBox[{"sInsertions", ",", 
            RowBox[{"FeynArts`PreFactor", "\[Rule]", "1"}], ",", 
            RowBox[{"FeynArts`GaugeRules", "\[Rule]", RowBox[{"{", "}"}]}], 
            ",", RowBox[{"FeynArts`MomentumConservation", "\[Rule]", 
              "True"}], ",", RowBox[{"FeynArts`Truncated", "\[Rule]", 
              "True"}]}], "]"}]}], ";", RowBox[{"sConverted", "=", 
        RowBox[{"FCFAConvert", "[", RowBox[{"sRawAmplitude", ",", 
            RowBox[{"IncomingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
            RowBox[{"OutgoingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
            RowBox[{"LorentzIndexNames", "\[Rule]", RowBox[{"{", 
                RowBox[{"mu1", ",", "nu1", ",", "mu2", ",", "nu2", ",", 
                  "mu3", ",", "nu3", ",", "mu4", ",", "nu4", ",", "alpha1", 
                  ",", "beta1", ",", "alpha2", ",", "beta2"}], "}"}]}], ",", 
            RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
            RowBox[{"Contract", "\[Rule]", "False"}], ",", 
            RowBox[{"List", "\[Rule]", "True"}], ",", 
            RowBox[{"Prefactor", "\[Rule]", "1"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"!", RowBox[{"ListQ", "[", "sConverted", "]"}]}], 
            "||", RowBox[{RowBox[{"Length", "[", "sConverted", "]"}], "=!=", 
              "1"}]}], ",", RowBox[{RowBox[{"Print", "[", 
              "\"Expected one converted s-channel diagram.\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
      RowBox[{"sChannelTensor", "=", RowBox[{"First", "[", "sConverted", 
          "]"}]}], ";", RowBox[{"sChannelRouting", "=", 
        RowBox[{"Cases", "[", RowBox[{"sChannelTensor", ",", 
            RowBox[{RowBox[{"PropagatorDenominator", "[", RowBox[
                 {RowBox[{"Momentum", "[", RowBox[{"q_", ",", "___"}], "]"}], 
                  ",", "0"}], "]"}], "\[RuleDelayed]", "q"}], ",", 
            "\[Infinity]"}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell[BoxData["sChannelRouting"], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[RowBox[{"{", RowBox[{"p3", "+", "p4"}], "}"}]], "Output"], 
  Cell["MomentumConservation -> True determines internal routing at each \
vertex; it does not put external legs on shell. The exchanged momentum is \
p3+p4 = p1+p2 by overall momentum conservation. Its propagator is kept as \
1/(p3+p4)^2, not replaced by a Mandelstam variable. The tensor is amputated; \
external polarisation tensors are attached below. No external momentum is \
eliminated or put on shell.", "Text"], 
  Cell["3. Attach unconstrained external polarisations", "Section"], 
  Cell["PolarizationTensorD represents a factorised tensor epsilon^mu \
epsilon^nu. Keep these polarisation vectors formal: neither p.epsilon nor \
epsilon.epsilon is set to zero, and no normalisation or helicity is chosen. \
Transversality -> False is explicit on every leg. I and -I select incoming \
polarisations and conjugated outgoing polarisations; they do not choose \
helicities. This is an off-shell contracted Green-function contribution, not \
yet a physical on-shell scattering amplitude.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sExternalTensors", "=", 
        RowBox[{RowBox[{"PolarizationTensorD", "[", RowBox[{"p1", ",", "mu1", 
              ",", "nu1", ",", "\[ImaginaryI]", ",", RowBox[{
                "Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p2", ",", "mu2", ",", 
              "nu2", ",", "\[ImaginaryI]", ",", RowBox[{"Transversality", 
                "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p3", ",", "mu3", ",", 
              "nu3", ",", RowBox[{"-", "\[ImaginaryI]"}], ",", 
              RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p4", ",", "mu4", ",", 
              "nu4", ",", RowBox[{"-", "\[ImaginaryI]"}], ",", 
              RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}]}]}], 
      ";", RowBox[{"sChannelWithPolarisations", "=", 
        RowBox[{"sChannelTensor", " ", "sExternalTensors"}]}], ";", 
      RowBox[{"sChannelPole", "=", RowBox[{"FeynAmpDenominatorExplicit", "[", 
          RowBox[{"First", "[", RowBox[{"Cases", "[", RowBox[{
                "sChannelTensor", ",", "_FeynAmpDenominator", ",", 
                "\[Infinity]"}], "]"}], "]"}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell[BoxData["sChannelPole"], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[FractionBox["1", 
     RowBox[{RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
             RowBox[{"p3", ",", "D"}], "]"}], ",", 
           RowBox[{"Momentum", "[", RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], 
       "+", RowBox[{"2", " ", RowBox[{"Pair", "[", 
           RowBox[{RowBox[{"Momentum", "[", RowBox[{"p3", ",", "D"}], "]"}], 
             ",", RowBox[{"Momentum", "[", RowBox[{"p4", ",", "D"}], "]"}]}], 
           "]"}]}], "+", RowBox[{"Pair", "[", 
         RowBox[{RowBox[{"Momentum", "[", RowBox[{"p4", ",", "D"}], "]"}], 
           ",", RowBox[{"Momentum", "[", RowBox[{"p4", ",", "D"}], "]"}]}], 
         "]"}]}]]], "Output"], Cell["4. Contract the off-shell s-channel", 
   "Section"], Cell["CalcFormCalculate contracts indices while retaining \
arbitrary momentum and polarisation scalar products, including longitudinal \
and trace terms. There are no SetMandelstam calls, scalar-product \
assignments, helicity tables or reference-amplitude comparisons. FORM runs \
with one worker and a 60-second per-stage limit; its files are retained in \
sChannelWorkDirectory. No extra graph factor is inserted. The result remains \
a gauge-dependent s-channel contribution.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"sChannelWorkDirectory", "=", 
        RowBox[{"CreateDirectory", "[", RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", RowBox[{"$TemporaryDirectory", ",", RowBox[
                 {"\"fgfa-s-channel-offshell-\"", "<>", RowBox[{"CreateUUID", 
                    "[", "]"}]}]}], "}"}], "]"}], "]"}]}], ";", 
      RowBox[{"AmplitudeSChannel", "=", RowBox[{"CalcFormCalculate", "[", 
          RowBox[{RowBox[{"FeynAmpDenominatorExplicit", "[", 
              "sChannelWithPolarisations", "]"}], ",", 
            RowBox[{"Dimension", "\[Rule]", "D"}], ",", 
            RowBox[{"FORMThreads", "\[Rule]", "1"}], ",", 
            RowBox[{"TimeConstraint", "\[Rule]", "60"}], ",", 
            RowBox[{"WorkingDirectory", "\[Rule]", "sChannelWorkDirectory"}], 
            ",", RowBox[{"KeepFiles", "\[Rule]", "True"}], ",", 
            RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"FailureQ", "[", 
              "AmplitudeSChannel", "]"}], "||", RowBox[{"MemberQ", "[", 
              RowBox[{RowBox[{"{", RowBox[{"$Failed", ",", "$Aborted"}], 
                  "}"}], ",", "AmplitudeSChannel"}], "]"}], "||", 
            RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[{"AmplitudeSChannel", 
                  ",", RowBox[{"_LorentzIndex", "|", 
                    "_CalcFormCalculate"}]}], "]"}]}]}], ",", 
          RowBox[{RowBox[{"Print", "[", "\"The contraction did not complete. \
Inspect AmplitudeSChannel and sChannelWorkDirectory.\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], "Input", 
   InitializationCell -> False], Cell["The full scalar-product expression is \
stored in AmplitudeSChannel. Short displays only a preview; it does not \
change the stored expression. Momentum squares and polarisation contractions \
remain unevaluated.", "Text"], 
  Cell[BoxData[RowBox[{"Short", "[", RowBox[{"AmplitudeSChannel", ",", "4"}], 
      "]"}]], "Input", InitializationCell -> False]}, 
 WindowTitle -> "Tree-level graviton scattering with FeynArts", 
 InitializationCellEvaluation -> False, StyleDefinitions -> "Default.nb"]
