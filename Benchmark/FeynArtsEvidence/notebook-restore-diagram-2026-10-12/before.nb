Cell["PolarizationTensorD represents the formal factorised tensor \
epsilon^mu epsilon^nu. Neither p.epsilon nor epsilon.epsilon is set to zero; \
no normalisation or helicity is chosen. I and -I specify incoming \
polarisations and conjugated outgoing polarisations, not helicities.", 
         "Text", ExpressionUUID -> "12c3725a-e338-47f6-af42-3770b19c9779"],

Cell[BoxData[
 RowBox[{
  RowBox[{"externalTensors", "=", 
   RowBox[{
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
     "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
     "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000815787333487*^9, 4.00081581360179*^9}, {
  4.000818110670472*^9, 4.0008181318058863`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"292e61ba-7c0b-4706-879e-3651b86b9c85"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Contract each diagram and form the total \[ScriptCapitalM]", 
         "Section", ExpressionUUID -> 
          "6f6a6ff3-9c0d-44ad-aa3e-184e1d958b39"],

Cell["\<\
Contract the diagrams separately with FORM to limit intermediate expression \
sizes. The list diagramAmplitudes retains the individual scalar-product \
expressions. No scalar-product assignments, helicity tables, mass-shell \
conditions or extra graph factors are introduced. Each contraction uses \
CalcFormCalculate with its default options: the Lorentz dimension is inferred \
from the expression, which carries symbolic D, and successful FORM jobs are \
cleaned up automatically. The results are checked for a surviving Lorentz \
index or an unconverted head before the total is formed.\
\>", "Text",ExpressionUUID->"f555f0c6-1f7b-41fa-96e0-e41d00c29ecc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"theAmplitude", "[", 
    RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"FeynAmpDenominatorExplicit", "[", "#1", "]"}], " ", 
         "externalTensors"}], "]"}], "&"}], ")"}], "/@", "diagramTensors"}], "//",
     "Total"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000817255306489*^9, 4.000817259238511*^9}, {
  4.000817545853169*^9, 4.00081755040644*^9}, {4.000817694794487*^9, 
  4.0008177195108356`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"571a1c11-feb5-4f90-af0c-802cd772764d"],

Cell["\<\
The complete polarisation-contracted, amputated off-shell tree expression is \
stored in \[ScriptCapitalM] (Mathematica's ScriptCapitalM symbol). Its \
preview below is shortened only for display. This is not yet an on-shell \
physical scattering amplitude: the external virtualities, longitudinal \
contractions and trace terms remain unconstrained. No loop measure or spin \
sum is included.\
\>", "Text",
 CellChangeTimes->{{4.000817266878055*^9, 4.000817267051003*^9}, {
  4.000817323113295*^9, 
  4.000817323283*^9}},ExpressionUUID->"460c06eb-23a9-45da-93f4-23d0e7b522bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Short", "[", 
  RowBox[{
   RowBox[{"theAmplitude", "[", 
    RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "]"}], ",", "4"}], 
  "]"}]], "Input",
