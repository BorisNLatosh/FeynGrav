Cell["\<\
PolarizationTensorD represents the formal factorised tensor epsilon^mu \
epsilon^nu. Neither p.epsilon nor epsilon.epsilon is set to zero; no \
normalisation or helicity is chosen. I and -I specify incoming polarisations \
and conjugated outgoing polarisations, not helicities.\
\>", "Text",ExpressionUUID->"12c3725a-e338-47f6-af42-3770b19c9779"],

Cell[BoxData[
 RowBox[{
  RowBox[{"externalTensors", "=", 
   RowBox[{
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p1", ",", "mu1", ",", "nu1", ",", "\[ImaginaryI]", ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p2", ",", "mu2", ",", "nu2", ",", "\[ImaginaryI]", ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p3", ",", "mu3", ",", "nu3", ",", 
      RowBox[{"-", "\[ImaginaryI]"}], ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p4", ",", "mu4", ",", "nu4", ",", 
      RowBox[{"-", "\[ImaginaryI]"}], ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}]}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[6]:=",ExpressionUUID->"292e61ba-7c0b-4706-879e-3651b86b9c85"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Contract each diagram and form the total \[ScriptCapitalM]", 
         "Section", ExpressionUUID -> 
          "6f6a6ff3-9c0d-44ad-aa3e-184e1d958b39"],

Cell["Contract the \
diagrams separately with FORM to limit intermediate expression sizes. The \
list diagramAmplitudes retains the individual scalar-product expressions. No \
scalar-product assignments, helicity tables, mass-shell conditions or extra \
graph factors are introduced. FORM uses one worker and a 60-second per-stage \
limit; job files are retained under treeWorkDirectory.", "Text", 
         ExpressionUUID -> "f555f0c6-1f7b-41fa-96e0-e41d00c29ecc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"diagramAmplitudes", ",", "\[ScriptCapitalM]"}], "]"}], ";", 
  RowBox[{"treeWorkDirectory", "=", 
   RowBox[{"CreateDirectory", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$TemporaryDirectory", ",", 
       RowBox[{"\"\<fgfa-four-tree-offshell-\>\"", "<>", 
        RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], "]"}]}], ";", 
  RowBox[{"diagramAmplitudes", "=", 
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"tensor", ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "result", "}"}], ",", 
        RowBox[{
         RowBox[{"result", "=", 
          RowBox[{"CalcFormCalculate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"FeynAmpDenominatorExplicit", "[", "tensor", "]"}], " ", 
             "externalTensors"}], ",", 
            RowBox[{"Dimension", "\[Rule]", "D"}], ",", 
            RowBox[{"FORMThreads", "\[Rule]", "1"}], ",", 
            RowBox[{"TimeConstraint", "\[Rule]", "60"}], ",", 
            RowBox[{"WorkingDirectory", "\[Rule]", "treeWorkDirectory"}], ",", 
            RowBox[{"KeepFiles", "\[Rule]", "True"}], ",", 
            RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FailureQ", "[", "result", "]"}], "||", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"$Failed", ",", "$Aborted"}], "}"}], ",", "result"}], 
             "]"}], "||", 
            RowBox[{"!", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"result", ",", 
               RowBox[{"_LorentzIndex", "|", "_CalcFormCalculate"}]}], 
              "]"}]}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", 
             "[", "\"\<A diagram contraction did not complete. Inspect \
treeWorkDirectory.\>\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "result"}]}], 
       "]"}]}], "]"}], "/@", "diagramTensors"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[7]:=",ExpressionUUID->"571a1c11-feb5-4f90-af0c-802cd772764d"],

