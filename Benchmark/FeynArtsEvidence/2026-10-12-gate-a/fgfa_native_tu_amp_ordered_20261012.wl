$HistoryLength=0;$LoadFeynArts=True;Get["FeynCalc`"];
FeynArts`$FAVerbose=0;FeynArts`$ModelPath=Prepend[FeynArts`$ModelPath,"/tmp"];
Print["INIT=",FeynArts`InitializeModel["fgfa_native_tu_ordered_20261012",FeynArts`GenericModel->"fgfa_native_tu_ordered_20261012"]];
short[x_]:=StringTake[ToString[InputForm[x]],UpTo[2700]];
lim[e_]:=TimeConstrained[e,12,$TimedOut];
opts={FeynArts`Model->"fgfa_native_tu_ordered_20261012",FeynArts`GenericModel->"fgfa_native_tu_ordered_20261012",FeynArts`InsertionLevel->{FeynArts`Classes}};
tree=lim[FeynArts`InsertFields[FeynArts`CreateTopologies[0,1->2],FeynArts`T[1]->{FeynArts`S[1],FeynArts`S[1]},Sequence@@opts]];
Print["TREE_INSERT=",short[tree]];
treeAmp=lim[FeynArts`CreateFeynAmp[tree,FeynArts`PreFactor->1,FeynArts`Truncated->True]];
Print["TREE_TRUNC_AMP=",short[treeAmp]];
If[treeAmp =!= $TimedOut,Print["TREE_TRUNC_FC=",short[lim[FCFAConvert[treeAmp,IncomingMomenta->{p},OutgoingMomenta->{k1,k2},Contract->False,ChangeDimension->False,List->True]]]]];
loop=lim[FeynArts`InsertFields[FeynArts`CreateTopologies[1,1->1,FeynArts`ExcludeTopologies->{FeynArts`Tadpoles}],FeynArts`T[1]->FeynArts`T[1],Sequence@@opts,FeynArts`ExcludeParticles->{FeynArts`T[1],FeynArts`S[1]}]];
Print["LOOP_INSERT=",short[loop]];
loopGhost=lim[FeynArts`CreateFeynAmp[loop,FeynArts`PreFactor->1,FeynArts`Truncated->True]];
Print["LOOP_GHOST_AMP=",short[loopGhost]];
If[loopGhost =!= $TimedOut,Print["LOOP_GHOST_FC=",short[lim[FCFAConvert[loopGhost,IncomingMomenta->{p},OutgoingMomenta->{q},LoopMomenta->{ell},Contract->False,ChangeDimension->False,List->True]]]]];
loopCommuting=lim[Block[{FeynArts`$FermionLines=False},FeynArts`CreateFeynAmp[loop,FeynArts`PreFactor->1,FeynArts`Truncated->True]]];
Print["LOOP_COMMUTING_AMP=",short[loopCommuting]];
Print["GHOST_MINUS_COMMUTING=",If[Head[loopGhost]===FeynArts`FAFeynAmpList && Head[loopCommuting]===FeynArts`FAFeynAmpList,TrueQ[loopGhost[[1,3]]===-loopCommuting[[1,3]]],"not comparable"]];
Print["DONE"];
Quit[];
