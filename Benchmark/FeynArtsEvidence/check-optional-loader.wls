$HistoryLength=0;
path="/home/latosh/.Wolfram/Applications/FeynGrav/FeynArtsIntegration/FeynArtsIntegration.wl";
before=FileNames["*.gen",DirectoryName[path]];
Get[path];
after=FileNames["*.gen",DirectoryName[path]];
Print["OPTIONAL_LOAD_NO_FEYNARTS=",!MemberQ[$Packages,"FeynArts`"]];
Print["OPTIONAL_LOAD_NO_FEYNGRAV=",!MemberQ[$Packages,"FeynGrav`"]];
Print["OPTIONAL_LOAD_NO_MODEL_OUTPUT=",before===after];
s=<|"Model"->"PureGR","Incoming"->{FeynArts`T[1]},"Outgoing"->{FeynArts`T[1],FeynArts`T[1]},"LoopOrder"->0|>;
Print["PREFLIGHT_3=",InputForm[FeynGrav`FeynArtsIntegration`FeynGravValidateProcess[s]]];
Print["PREFLIGHT_LOOP=",InputForm[FeynGrav`FeynArtsIntegration`FeynGravValidateProcess[Join[s,<|"Outgoing"->{FeynArts`T[1]},"LoopOrder"->1,"OneParticleIrreducible"->True|>]]]];
Quit[0];
