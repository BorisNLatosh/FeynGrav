$HistoryLength=0;
$LoadFeynArts=True;
Print["FEYNGRAV_ON_PATH=",MemberQ[$Path,_?(StringContainsQ[#,"FeynGrav"]&)]];
Print["PATH_ENTRIES_WITH_FEYNGRAV=",InputForm[Select[$Path,StringContainsQ[#,"FeynGrav"]&]]];
Print["LOAD_BY_NAME_START"];
loadResult=CheckAbort[<<FeynGrav`;$LoadedFeynGrav, $Aborted];
Print["LOAD_BY_NAME_RESULT=",InputForm[loadResult]];
If[loadResult===$Aborted,Print["NAME_LOAD_FAILED"];Quit[3]];
(* Is a quartic graviton vertex already imported by package initialisation? *)
vertex=FeynGrav`GravitonVertex[Lor1,Lor2,p,Lor3,Lor4,-p,Lor5,Lor6,-ell,Lor7,Lor8,ell];
Print["GRAVITON_VERTEX_READY_ON_LOAD=",Head[vertex]=!=FeynGrav`GravitonVertex," HEAD=",Head[vertex]," BYTES=",ByteCount[vertex]];
Print["LIBRARY_INFO=",InputForm[FeynGrav`FeynGravLibraryInformation[]]];
modelDirectory="/home/latosh/.Wolfram/Applications/FeynGrav/Benchmark/FeynArtsEvidence/model-first-2026-10-12/model";
model="FGPureGR5a149c98161e2b2e";
absoluteModel=FileNameJoin[{modelDirectory,model}];
Print["ABSOLUTE_MODEL_NAME=",absoluteModel];
absoluteResult=CheckAbort[FeynArts`InitializeModel[absoluteModel,FeynArts`GenericModel->absoluteModel],$Aborted];
Print["ABSOLUTE_PATH_MODEL_LOAD=",InputForm[absoluteResult]," GENERIC=",FeynArts`$GenericModel," CLASSES=",FeynArts`$Model];
Print["MODELPATH_UNCHANGED=",InputForm[FeynArts`$ModelPath]];
Quit[0];
