        Cell["PolarizationTensorD represents the formal factorised tensor \
epsilon^mu epsilon^nu. Neither p.epsilon nor epsilon.epsilon is set to zero; \
no normalisation or helicity is chosen. I and -I specify incoming \
polarisations and conjugated outgoing polarisations, not helicities.", 
         "Text", ExpressionUUID -> "12c3725a-e338-47f6-af42-3770b19c9779"], 
        Cell[BoxData[RowBox[{RowBox[{"externalTensors", "=", 
              RowBox[{RowBox[{"PolarizationTensorD", "[", RowBox[{"p1", ",", 
                    "mu1", ",", "nu1", ",", "\[ImaginaryI]"}], "]"}], " ", 
                RowBox[{"PolarizationTensorD", "[", RowBox[{"p2", ",", "mu2", 
                    ",", "nu2", ",", "\[ImaginaryI]"}], "]"}], " ", 
                RowBox[{"PolarizationTensorD", "[", RowBox[{"p3", ",", "mu3", 
                    ",", "nu3", ",", RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], 
                " ", RowBox[{"PolarizationTensorD", "[", RowBox[{"p4", ",", 
                    "mu4", ",", "nu4", ",", RowBox[{"-", "\[ImaginaryI]"}]}], 
                  "]"}]}]}], ";"}]], "Input", InitializationCell -> False, 
         CellChangeTimes -> {{4.000815787333487*^9, 4.00081581360179*^9}}, 
         ExpressionUUID -> "292e61ba-7c0b-4706-879e-3651b86b9c85"]}, Open]], 
     Cell[CellGroupData[
       {Cell["4. Contract each diagram and form the total \[ScriptCapitalM]", 
         "Section", ExpressionUUID -> 
          "6f6a6ff3-9c0d-44ad-aa3e-184e1d958b39"], Cell["Contract the \
diagrams separately with FORM to limit intermediate expression sizes. The \
list diagramAmplitudes retains the individual scalar-product expressions. No \
scalar-product assignments, helicity tables, mass-shell conditions or extra \
graph factors are introduced. The helper contractDiagram[diagram] performs \
one contraction: it sets Dimension, one FORM worker, a 60-second per-stage \
limit, the working directory and file retention, and aborts unless the result \
is a scalar free of unconverted heads. Job files are retained under \
treeWorkDirectory.", "Text", ExpressionUUID -> 
          "f555f0c6-1f7b-41fa-96e0-e41d00c29ecc"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"Clear", "[", 
                 RowBox[{"diagramAmplitudes", ",", "\[ScriptCapitalM]"}], 
                 "]"}], ";", RowBox[{"treeWorkDirectory", "=", RowBox[
                  {"CreateDirectory", "[", RowBox[{"FileNameJoin", "[", 
                     RowBox[{"{", RowBox[{"$TemporaryDirectory", ",", 
                         RowBox[{"\"fgfa-four-tree-offshell-\"", "<>", 
                          RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], 
                   "]"}]}], ";", RowBox[{RowBox[{"contractDiagram", "[", 
                   "tensor_", "]"}], ":=", RowBox[{"Module", "[", 
                   RowBox[{RowBox[{"{", "result", "}"}], ",", RowBox[
                      {RowBox[{"result", "=", RowBox[{"CalcFormCalculate", 
                          "[", RowBox[{RowBox[{RowBox[{
                          "FeynAmpDenominatorExplicit", "[", "tensor", "]"}], 
                          " ", "externalTensors"}], ",", RowBox[{"Dimension", 
                          "\[Rule]", "D"}], ",", RowBox[{"FORMThreads", 
                          "\[Rule]", "1"}], ",", RowBox[{"TimeConstraint", 
                          "\[Rule]", "60"}], ",", RowBox[{"WorkingDirectory", 
                          "\[Rule]", "treeWorkDirectory"}], ",", RowBox[
                          {"KeepFiles", "\[Rule]", "True"}]}], "]"}]}], ";", 
                       RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"FailureQ", 
                          "[", "result", "]"}], "||", RowBox[{"MemberQ", "[", 
                          RowBox[{RowBox[{"{", RowBox[{"$Failed", ",", 
                          "$Aborted"}], "}"}], ",", "result"}], "]"}], "||", 
                          RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[
                          {"result", ",", RowBox[{"_LorentzIndex", "|", 
                          "_CalcFormCalculate"}]}], "]"}]}]}], ",", RowBox[
                          {RowBox[{"Print", "[", RowBox[{"\"A diagram \
contraction did not complete. Inspect \"", ",", "treeWorkDirectory"}], "]"}], 
                          ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
                       "result"}]}], "]"}]}], ";", RowBox[
                {"diagramAmplitudes", "=", RowBox[{"contractDiagram", "/@", 
                   "diagramTensors"}]}], ";"}]], "Input", 
            InitializationCell -> False, CellLabel -> "In[7]:=", 
            ExpressionUUID -> "571a1c11-feb5-4f90-af0c-802cd772764d"], 
