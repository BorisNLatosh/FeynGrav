       {Cell["3. Build the four off-shell amplitudes", "Section", 
         ExpressionUUID -> "abf8b48b-3f95-4714-ba67-0a4717f65159"], 
        Cell["Use incoming momenta p1,p2 and outgoing momenta p3,p4. All \
virtualities and scalar products remain symbolic. MomentumConservation -> \
True supplies internal routing at each vertex without imposing mass-shell \
conditions or eliminating an external momentum. Truncated -> True removes \
external propagators; polarisations are attached explicitly in the next \
cell.", "Text", ExpressionUUID -> "ed144ddd-09e4-41e1-a993-199ac60484cc"], 
        Cell[CellGroupData[{Cell[BoxData[RowBox[{RowBox[{"treeRawAmplitude", 
                 "=", RowBox[{"CreateFeynAmp", "[", RowBox[{"treeInsertions", 
                     ",", RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
                     RowBox[{"GaugeRules", "\[Rule]", RowBox[{"{", "}"}]}], 
                     ",", RowBox[{"MomentumConservation", "\[Rule]", 
                       "True"}], ",", RowBox[{"Truncated", "\[Rule]", 
                       "True"}]}], "]"}]}], ";", RowBox[{"diagramTensors", 
                 "=", RowBox[{"FCFAConvert", "[", RowBox[{"treeRawAmplitude", 
                     ",", RowBox[{"IncomingMomenta", "\[Rule]", RowBox[
                        {"{", RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
                     RowBox[{"OutgoingMomenta", "\[Rule]", RowBox[{"{", 
                         RowBox[{"p3", ",", "p4"}], "}"}]}], ",", RowBox[
                      {"LorentzIndexNames", "\[Rule]", RowBox[{"{", RowBox[
                          {"mu1", ",", "nu1", ",", "mu2", ",", "nu2", ",", 
                          "mu3", ",", "nu3", ",", "mu4", ",", "nu4", ",", 
                          "alpha1", ",", "beta1", ",", "alpha2", ",", 
                          "beta2"}], "}"}]}], ",", RowBox[{"ChangeDimension", 
                       "\[Rule]", "D"}]}], "]"}]}], ";", RowBox[{"If", "[", 
                 RowBox[{RowBox[{RowBox[{"Length", "[", "diagramTensors", 
                       "]"}], "=!=", "4"}], ",", RowBox[{RowBox[{"Print", 
                       "[", "\"Expected the contact and three exchange \
diagrams.\"", "]"}], ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], 
            "Input", InitializationCell -> False, CellLabel -> "In[5]:=", 
            ExpressionUUID -> "e282d4c1-2225-4341-99df-111dde6fddda"], 
