Notebook[{Cell["Tree-level graviton scattering with FeynArts", "Title", 
   ExpressionUUID -> "14a74f86-b215-4b20-94e3-aff4e139f2e7"], 
  Cell["Generate and display all four off-shell 2 -> 2 graviton tree diagrams \
with FeynArts: the three exchange channels and the quartic contact. Attach \
unconstrained external polarisation tensors, contract each contribution, and \
store their sum in \[ScriptCapitalM]. No mass-shell, transversality, \
tracelessness or helicity conditions are imposed.", "Text"], 
  Cell["1. Initialisation", "Section", ExpressionUUID -> 
    "66979d8e-122c-4326-a3d4-6b1c333b6c2c"], Cell["Start with a fresh kernel \
(especially after running the previous on-shell version) and evaluate the \
cell below with Shift+Enter. FeynGrav loads FeynCalc and CalcFormConverter; \
setting $LoadFeynArts first also loads the installed FeynCalc-patched \
FeynArts. The saved pure-GR model uses gauge parameter 2 and contains the \
cubic and quartic graviton interactions and gravitational ghosts. No diagrams \
are generated and FORM is not executed here. Opening this notebook executes \
nothing.", "Text", ExpressionUUID -> "3f444fd2-0054-4d3a-9b81-971cc7884bc8"], 
  Cell[BoxData[RowBox[{RowBox[{"$LoadFeynArts", "=", "True"}], ";", 
      RowBox[{"feynGravDirectory", "=", RowBox[{"ExpandFileName", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[
                 {"NotebookDirectory", "[", "]"}], ",", "\"..\""}], "}"}], 
            "]"}], "]"}]}], ";", RowBox[{"Get", "[", 
        RowBox[{"FileNameJoin", "[", RowBox[
           {"{", RowBox[{"feynGravDirectory", ",", "\"FeynGrav.wl\""}], 
            "}"}], "]"}], "]"}], ";", RowBox[{"FeynGrav`importGravitons", 
        "[", "2", "]"}], ";", RowBox[{"grModelDirectory", "=", 
        RowBox[{"FileNameJoin", "[", RowBox[
           {"{", RowBox[{"feynGravDirectory", ",", "\"Benchmark\"", ",", 
              "\"FeynArtsEvidence\"", ",", "\"model-first-2026-10-12\"", ",", 
              "\"model\""}], "}"}], "]"}]}], ";", 
      RowBox[{"grModel", "=", "\"FGPureGR5a149c98161e2b2e\""}], ";", 
      RowBox[{"FeynArts`$ModelPath", "=", RowBox[{"Prepend", "[", 
          RowBox[{RowBox[{"DeleteCases", "[", RowBox[{"FeynArts`$ModelPath", 
                ",", "grModelDirectory"}], "]"}], ",", "grModelDirectory"}], 
          "]"}]}], ";", RowBox[{"If", "[", 
        RowBox[{RowBox[{RowBox[{"FeynArts`InitializeModel", "[", 
              RowBox[{"grModel", ",", RowBox[{"FeynArts`GenericModel", 
                  "\[Rule]", "grModel"}], ",", RowBox[
                 {"FeynArts`Reinitialize", "\[Rule]", "False"}]}], "]"}], 
            "=!=", "True"}], ",", RowBox[{RowBox[{"Print", "[", "\"The \
pure-GR model could not be loaded. Check grModelDirectory and restart with a \
fresh kernel.\"", "]"}], ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], 
   "Input", InitializationCell -> True], 
  Cell["2. Generate and display the contributing diagrams", "Section"], 
  Cell["Including both cubic and quartic vertices generates the s-, t- and \
u-channel exchanges and the four-graviton contact. Do not select a single \
channel. The diagram sheet is displayed before CreateFeynAmp or any FORM \
calculation is called.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"treeTopologies", "=", 
        RowBox[{"FeynArts`CreateTopologies", "[", 
          RowBox[{"0", ",", RowBox[{"2", "\[Rule]", "2"}], ",", 
            RowBox[{"FeynArts`Adjacencies", "\[Rule]", RowBox[{"{", 
                RowBox[{"3", ",", "4"}], "}"}]}]}], "]"}]}], ";", 
      RowBox[{"treeInsertions", "=", RowBox[{"FeynArts`InsertFields", "[", 
          RowBox[{"treeTopologies", ",", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"FeynArts`T", "[", "1", "]"}], ",", RowBox[
                   {"FeynArts`T", "[", "1", "]"}]}], "}"}], "\[Rule]", 
              RowBox[{"{", RowBox[{RowBox[{"FeynArts`T", "[", "1", "]"}], 
                  ",", RowBox[{"FeynArts`T", "[", "1", "]"}]}], "}"}]}], ",", 
            RowBox[{"FeynArts`Model", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`GenericModel", "\[Rule]", "grModel"}], ",", 
            RowBox[{"FeynArts`InsertionLevel", "\[Rule]", RowBox[{"{", 
                "FeynArts`Classes", "}"}]}]}], "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[RowBox[{RowBox[{"diagramGraphics", "=", 
        RowBox[{"FeynArts`Paint", "[", RowBox[{"treeInsertions", ",", 
            RowBox[{"FeynArts`ColumnsXRows", "\[Rule]", RowBox[{"{", 
                RowBox[{"2", ",", "2"}], "}"}]}], ",", 
            RowBox[{"FeynArts`Numbering", "\[Rule]", "FeynArts`Simple"}], 
            ",", RowBox[{"FeynArts`SheetHeader", "\[Rule]", 
              "\"Four-graviton tree diagrams\""}], ",", 
            RowBox[{"FeynArts`AutoEdit", "\[Rule]", "False"}], ",", 
            RowBox[{"DisplayFunction", "\[Rule]", "Identity"}]}], "]"}]}], 
      ";", RowBox[{"diagramSheet", "=", RowBox[{"Show", "[", 
          RowBox[{RowBox[{"First", "[", RowBox[{"Show", "[", 
                "diagramGraphics", "]"}], "]"}], ",", 
            RowBox[{"ImageSize", "\[Rule]", "640"}]}], "]"}]}]}]], "Input", 
   InitializationCell -> False], Cell["Paint supplies the actual inserted \
FeynArts diagrams. The four numbers identify the contact and three exchange \
contributions; they are not extra multiplicative weights. FeynArts already \
supplies the graph factors.", "Text"], 
  Cell["3. Build the four off-shell amplitudes", "Section"], 
  Cell["Use incoming momenta p1,p2 and outgoing momenta p3,p4. All \
virtualities and scalar products remain symbolic. MomentumConservation -> \
True supplies internal routing at each vertex without imposing mass-shell \
conditions or eliminating an external momentum. Truncated -> True removes \
external propagators; polarisations are attached explicitly in the next \
cell.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"treeRawAmplitude", "=", 
        RowBox[{"FeynArts`CreateFeynAmp", "[", RowBox[{"treeInsertions", ",", 
            RowBox[{"FeynArts`PreFactor", "\[Rule]", "1"}], ",", 
            RowBox[{"FeynArts`GaugeRules", "\[Rule]", RowBox[{"{", "}"}]}], 
            ",", RowBox[{"FeynArts`MomentumConservation", "\[Rule]", 
              "True"}], ",", RowBox[{"FeynArts`Truncated", "\[Rule]", 
              "True"}]}], "]"}]}], ";", RowBox[{"diagramTensors", "=", 
        RowBox[{"FCFAConvert", "[", RowBox[{"treeRawAmplitude", ",", 
            RowBox[{"IncomingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
            RowBox[{"OutgoingMomenta", "\[Rule]", RowBox[{"{", 
                RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
            RowBox[{"LorentzIndexNames", "\[Rule]", RowBox[{"{", 
                RowBox[{"mu1", ",", "nu1", ",", "mu2", ",", "nu2", ",", 
                  "mu3", ",", "nu3", ",", "mu4", ",", "nu4", ",", "alpha1", 
                  ",", "beta1", ",", "alpha2", ",", "beta2"}], "}"}]}], ",", 
            RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
            RowBox[{"Contract", "\[Rule]", "False"}], ",", 
            RowBox[{"List", "\[Rule]", "True"}], ",", 
            RowBox[{"Prefactor", "\[Rule]", "1"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"!", RowBox[{"ListQ", "[", "diagramTensors", 
                "]"}]}], "||", RowBox[{RowBox[{"Length", "[", 
                "diagramTensors", "]"}], "=!=", "4"}]}], ",", 
          RowBox[{RowBox[{"Print", "[", 
              "\"Expected the contact and three exchange diagrams.\"", "]"}], 
            ";", RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], "Input", 
   InitializationCell -> False], Cell["PolarizationTensorD represents the \
formal factorised tensor epsilon^mu epsilon^nu. Neither p.epsilon nor \
epsilon.epsilon is set to zero; no normalisation or helicity is chosen. I and \
-I specify incoming polarisations and conjugated outgoing polarisations, not \
helicities.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"externalTensors", "=", 
        RowBox[{RowBox[{"PolarizationTensorD", "[", RowBox[{"p1", ",", "mu1", 
              ",", "nu1", ",", "\[ImaginaryI]", ",", RowBox[{
                "Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p2", ",", "mu2", ",", 
              "nu2", ",", "\[ImaginaryI]", ",", RowBox[{"Transversality", 
                "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p3", ",", "mu3", ",", 
              "nu3", ",", RowBox[{"-", "\[ImaginaryI]"}], ",", 
              RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
          RowBox[{"PolarizationTensorD", "[", RowBox[{"p4", ",", "mu4", ",", 
              "nu4", ",", RowBox[{"-", "\[ImaginaryI]"}], ",", 
              RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}]}]}], 
      ";"}]], "Input", InitializationCell -> False], 
  Cell["4. Contract each diagram and form the total \[ScriptCapitalM]", 
   "Section"], Cell["Contract the diagrams separately with FORM to limit \
intermediate expression sizes. The list diagramAmplitudes retains the \
individual scalar-product expressions. No scalar-product assignments, \
helicity tables, mass-shell conditions or extra graph factors are introduced. \
FORM uses one worker and a 60-second per-stage limit; job files are retained \
under treeWorkDirectory.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"diagramAmplitudes", 
          ",", "\[ScriptCapitalM]"}], "]"}], ";", 
      RowBox[{"treeWorkDirectory", "=", RowBox[{"CreateDirectory", "[", 
          RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{
                "$TemporaryDirectory", ",", RowBox[
                 {"\"fgfa-four-tree-offshell-\"", "<>", RowBox[{"CreateUUID", 
                    "[", "]"}]}]}], "}"}], "]"}], "]"}]}], ";", 
      RowBox[{"diagramAmplitudes", "=", 
        RowBox[{RowBox[{"Function", "[", RowBox[{"tensor", ",", 
              RowBox[{"Module", "[", RowBox[{RowBox[{"{", "result", "}"}], 
                  ",", RowBox[{RowBox[{"result", "=", RowBox[
                       {"CalcFormCalculate", "[", RowBox[{RowBox[{RowBox[
                          {"FeynAmpDenominatorExplicit", "[", "tensor", 
                          "]"}], " ", "externalTensors"}], ",", RowBox[
                          {"Dimension", "\[Rule]", "D"}], ",", RowBox[
                          {"FORMThreads", "\[Rule]", "1"}], ",", RowBox[
                          {"TimeConstraint", "\[Rule]", "60"}], ",", RowBox[
                          {"WorkingDirectory", "\[Rule]", 
                          "treeWorkDirectory"}], ",", RowBox[{"KeepFiles", 
                          "\[Rule]", "True"}], ",", RowBox[{"ShowProgress", 
                          "\[Rule]", "False"}]}], "]"}]}], ";", RowBox[
                     {"If", "[", RowBox[{RowBox[{RowBox[{"FailureQ", "[", 
                          "result", "]"}], "||", RowBox[{"MemberQ", "[", 
                          RowBox[{RowBox[{"{", RowBox[{"$Failed", ",", 
                          "$Aborted"}], "}"}], ",", "result"}], "]"}], "||", 
                          RowBox[{"!", RowBox[{"FreeQ", "[", RowBox[
                          {"result", ",", RowBox[{"_LorentzIndex", "|", 
                          "_CalcFormCalculate"}]}], "]"}]}]}], ",", RowBox[
                         {RowBox[{"Print", "[", "\"A diagram contraction did \
not complete. Inspect treeWorkDirectory.\"", "]"}], ";", RowBox[{"Abort", 
                          "[", "]"}]}]}], "]"}], ";", "result"}]}], "]"}]}], 
            "]"}], "/@", "diagramTensors"}]}], ";"}]], "Input", 
   InitializationCell -> False], 
  Cell[BoxData[RowBox[
     {RowBox[{"If", "[", RowBox[
         {RowBox[{RowBox[{"!", RowBox[{"ListQ", "[", "diagramAmplitudes", 
                "]"}]}], "||", RowBox[{RowBox[{"Length", "[", 
                "diagramAmplitudes", "]"}], "=!=", "4"}]}], ",", 
          RowBox[{RowBox[{"Print", "[", "\"All four diagram amplitudes must \
be calculated before summing.\"", "]"}], ";", RowBox[{"Abort", "[", 
              "]"}]}]}], "]"}], ";", RowBox[{"\[ScriptCapitalM]", "=", 
        RowBox[{"Total", "[", "diagramAmplitudes", "]"}]}], ";"}]], "Input", 
   InitializationCell -> False], Cell["The complete polarisation-contracted, \
amputated off-shell tree expression is stored in \[ScriptCapitalM] \
(Mathematica's ScriptCapitalM symbol). Its preview below is shortened only \
for display. This is not yet an on-shell physical scattering amplitude: the \
external virtualities, longitudinal contractions and trace terms remain \
unconstrained. No loop measure or spin sum is included.", "Text"], 
  Cell[BoxData[RowBox[{"Short", "[", RowBox[{"\[ScriptCapitalM]", ",", "4"}], 
      "]"}]], "Input", InitializationCell -> False]}, 
 InitializationCellEvaluation -> False, WindowSize -> {1435.5, 851.25}, 
 WindowMargins -> {{-2.25, Automatic}, {Automatic, -22.5}}, 
 WindowTitle -> "Tree-level graviton scattering with FeynArts", 
 FrontEndVersion -> "15.0 for Linux x86 (64-bit) (July 2, 2026)", 
 StyleDefinitions -> "Default.nb", ExpressionUUID -> 
  "1a03c30d-5f92-4e9f-8eaa-103a7f415e46"]
