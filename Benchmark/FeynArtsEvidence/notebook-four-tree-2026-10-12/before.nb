Cell["\<\
Optional drawing: evaluate FeynArts`Paint[sInsertions]. The calculation below \
does not require a graphical front end.\
\>", "Text",ExpressionUUID->"f47fb638-3b60-4fff-8e35-940ad3b76b10"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sRawAmplitude", "=", 
   RowBox[{"FeynArts`CreateFeynAmp", "[", 
    RowBox[{"sInsertions", ",", 
     RowBox[{"FeynArts`PreFactor", "\[Rule]", "1"}], ",", 
     RowBox[{"FeynArts`GaugeRules", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"FeynArts`MomentumConservation", "\[Rule]", "True"}], ",", 
     RowBox[{"FeynArts`Truncated", "\[Rule]", "True"}]}], "]"}]}], ";", 
  RowBox[{"sConverted", "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"sRawAmplitude", ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "mu1", ",", "nu1", ",", "mu2", ",", "nu2", ",", "mu3", ",", "nu3", ",",
         "mu4", ",", "nu4", ",", "alpha1", ",", "beta1", ",", "alpha2", ",", 
        "beta2"}], "}"}]}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
     RowBox[{"Contract", "\[Rule]", "False"}], ",", 
     RowBox[{"List", "\[Rule]", "True"}], ",", 
     RowBox[{"Prefactor", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"ListQ", "[", "sConverted", "]"}]}], "||", 
     RowBox[{
      RowBox[{"Length", "[", "sConverted", "]"}], "=!=", "1"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Expected one converted s-channel diagram.\>\"", "]"}],
      ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"sChannelTensor", "=", 
   RowBox[{"First", "[", "sConverted", "]"}]}], ";", 
  RowBox[{"sChannelRouting", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"sChannelTensor", ",", 
     RowBox[{
      RowBox[{"PropagatorDenominator", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"q_", ",", "___"}], "]"}], ",", "0"}], "]"}], "\[RuleDelayed]",
       "q"}], ",", "\[Infinity]"}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[10]:=",ExpressionUUID->"c6ee0ceb-68ae-4cbc-8e83-f013a121c3ef"],

