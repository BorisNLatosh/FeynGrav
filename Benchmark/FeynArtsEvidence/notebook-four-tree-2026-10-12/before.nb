Notebook[{

Cell[CellGroupData[{
Cell["Tree-level graviton scattering with FeynArts", "Title",ExpressionUUID->"14a74f86-b215-4b20-94e3-aff4e139f2e7"],

Cell["\<\
Construct the off-shell s-channel four-graviton tree contribution using \
FeynArts, attach external polarisation tensors and contract their indices. No \
mass-shell, transversality, tracelessness or helicity conditions are imposed. \
The other channels and quartic contact are not included yet.\
\>", "Text",ExpressionUUID->"c0302a8c-69b0-4c1b-9b8f-7154b4c07b81"],

Cell[CellGroupData[{

Cell["1. Initialisation", "Section",ExpressionUUID->"66979d8e-122c-4326-a3d4-6b1c333b6c2c"],

Cell["\<\
Start with a fresh kernel (especially after running the previous on-shell \
version) and evaluate the cell below with Shift+Enter. FeynGrav loads \
FeynCalc and CalcFormConverter; setting $LoadFeynArts first also loads the \
installed FeynCalc-patched FeynArts. The saved pure-GR model uses gauge \
parameter 2 and contains the cubic and quartic graviton interactions and \
gravitational ghosts. No diagrams are generated and FORM is not executed \
here. Opening this notebook executes nothing.\
\>", "Text",ExpressionUUID->"3f444fd2-0054-4d3a-9b81-971cc7884bc8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"$LoadFeynArts", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feynGravDirectory", "=", 
   RowBox[{"ExpandFileName", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<..\>\""}], "}"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"feynGravDirectory", ",", "\"\<FeynGrav.wl\>\""}], "}"}], "]"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FeynGrav`importGravitons", "[", "2", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"grModelDirectory", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "feynGravDirectory", ",", "\"\<Benchmark\>\"", 
      ",", "\"\<FeynArtsEvidence\>\"", ",", "\"\<model-first-2026-10-12\>\"", 
      ",", "\"\<model\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grModel", "=", "\"\<FGPureGR5a149c98161e2b2e\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FeynArts`$ModelPath", "=", 
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{"FeynArts`$ModelPath", ",", "grModelDirectory"}], "]"}], ",", 
     "grModelDirectory"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"FeynArts`InitializeModel", "[", 
      RowBox[{"grModel", ",", 
       RowBox[{"FeynArts`GenericModel", "->", "grModel"}], ",", 
       RowBox[{"FeynArts`Reinitialize", "->", "False"}]}], "]"}], "=!=", 
     "True"}], ",", "\n", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<The pure-GR model could not be loaded. Check \
grModelDirectory and restart with a fresh kernel.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[1]:=",ExpressionUUID->"5f5398da-98c2-4abb-a0a5-6efdedbe96e2"],

