Cell[CellGroupData[{

Cell["2. Generate and select the s-channel", "Section",ExpressionUUID->"48993e10-f1e5-4023-9f94-b30ce0f23fd2"],

Cell["\<\
Generate cubic 2 -> 2 tree topologies and select the one whose two incoming \
external lines meet at the same vertex. This identifies the s-channel by \
connectivity, not diagram-list position. FeynArts supplies the two cubic \
vertices, propagator and graph factor; no additional symmetry factor is \
applied. Use incoming momenta p1, p2 and outgoing momenta p3, p4. Their \
virtualities and scalar products remain symbolic; FeynArts supplies the signs \
of momenta entering individual vertices.\
\>", "Text",ExpressionUUID->"0b14eb27-317b-4097-a1ad-3093fb006b22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"treeTopologies", "=", 
   RowBox[{"FeynArts`CreateTopologies", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"FeynArts`Adjacencies", "\[Rule]", 
      RowBox[{"{", "3", "}"}]}]}], "]"}]}], ";", 
  RowBox[{"sTopologies", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"treeTopologies", ",", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"incomingVertices", "=", 
          RowBox[{"Cases", "[", 
           RowBox[{"#1", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"FeynArts`Propagator", "[", "FeynArts`Incoming", "]"}], 
              "[", 
              RowBox[{"_", ",", "vertex_"}], "]"}], "\[RuleDelayed]", 
             "vertex"}], ",", "\[Infinity]"}], "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "incomingVertices", "]"}], "===", "2"}], "&&", 
         RowBox[{"SameQ", "@@", "incomingVertices"}]}]}], "]"}], "&"}]}], 
    "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "sTopologies", "]"}], "=!=", "1"}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Expected exactly one s-channel topology.\>\"", "]"}], 
     ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"sInsertions", "=", 
   RowBox[{"FeynArts`InsertFields", "[", 
    RowBox[{"sTopologies", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"FeynArts`T", "[", "1", "]"}], ",", 
