\\!\\(\\*FormBox[\\\"\\\\\\\"/tmp/fgfa-s-channel-offshell-a5c5ea83-ddcf-4114-\
8438-06629904543a/calcform-job-a52b1278-31de-44a7-94d8-b2295bd5cabc\\\\\\\"\\\
\", TraditionalForm]\\).\"", 2, 14, 1, 19367115729486888689, "Local", 
