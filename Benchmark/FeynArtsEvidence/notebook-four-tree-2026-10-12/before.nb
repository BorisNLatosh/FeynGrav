Cell[BoxData["sChannelRouting"], "Input",
 InitializationCell->False,
 CellLabel->"In[11]:=",ExpressionUUID->"25d4dfe4-07e4-4465-ac43-1a510ce8c73f"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"p3", "+", "p4"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000801075891629*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"c8eda33f-8e2c-48ff-9494-8b29fcde995f"]
}, Open  ]],

Cell["\<\
MomentumConservation -> True determines internal routing at each vertex; it \
does not put external legs on shell. The exchanged momentum is p3+p4 = p1+p2 \
by overall momentum conservation. Its propagator is kept as 1/(p3+p4)^2, not \
replaced by a Mandelstam variable. The tensor is amputated; external \
polarisation tensors are attached below. No external momentum is eliminated \
or put on shell.\
\>", "Text",ExpressionUUID->"bb3ae6ce-6e1f-4b79-9b15-036df7df742b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Attach unconstrained external polarisations", "Section",ExpressionUUID->"74f75c55-2792-4d0d-b5ab-f81134f68276"],

Cell["\<\
PolarizationTensorD represents a factorised tensor epsilon^mu epsilon^nu. \
Keep these polarisation vectors formal: neither p.epsilon nor epsilon.epsilon \
is set to zero, and no normalisation or helicity is chosen. Transversality -> \
False is explicit on every leg. I and -I select incoming polarisations and \
conjugated outgoing polarisations; they do not choose helicities. This is an \
off-shell contracted Green-function contribution, not yet a physical on-shell \
scattering amplitude.\
\>", "Text",ExpressionUUID->"2365666b-6558-4d2c-97b9-5f14fc1217f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sExternalTensors", "=", 
   RowBox[{
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p1", ",", "mu1", ",", "nu1", ",", "\[ImaginaryI]", ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p2", ",", "mu2", ",", "nu2", ",", "\[ImaginaryI]", ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p3", ",", "mu3", ",", "nu3", ",", 
      RowBox[{"-", "\[ImaginaryI]"}], ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p4", ",", "mu4", ",", "nu4", ",", 
      RowBox[{"-", "\[ImaginaryI]"}], ",", 
      RowBox[{"Transversality", "\[Rule]", "False"}]}], "]"}]}]}], ";", 
  RowBox[{"sChannelWithPolarisations", "=", 
   RowBox[{"sChannelTensor", " ", "sExternalTensors"}]}], ";", 
  RowBox[{"sChannelPole", "=", 
   RowBox[{"FeynAmpDenominatorExplicit", "[", 
    RowBox[{"First", "[", 
     RowBox[{"Cases", "[", 
      RowBox[{
      "sChannelTensor", ",", "_FeynAmpDenominator", ",", "\[Infinity]"}], 
      "]"}], "]"}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[12]:=",ExpressionUUID->"a95cabc2-38d7-4578-b53b-2638bf5c7f44"],

Cell[CellGroupData[{

Cell[BoxData["sChannelPole"], "Input",
 InitializationCell->False,
 CellLabel->"In[13]:=",ExpressionUUID->"d49d9b99-9a38-4e32-acde-e5b10845e4d5"],

Cell[BoxData[
 FormBox[
  FractionBox["1", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       FormBox[
        FormBox["p3",
         TraditionalForm],
        TraditionalForm], 
       FormBox["\<\"\[CenterDot]\"\>",
        TraditionalForm], 
       FormBox[
        FormBox["p4",
         TraditionalForm],
        TraditionalForm]}], ")"}]}], "+", 
    SuperscriptBox[
     FormBox[
      FormBox["p3",
       TraditionalForm],
      TraditionalForm], "2"], "+", 
    SuperscriptBox[
     FormBox[
      FormBox["p4",
       TraditionalForm],
      TraditionalForm], "2"]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.000801075914405*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"11ed22b8-d609-4dff-b28a-e07e17dbb57f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Contract the off-shell s-channel", "Section",ExpressionUUID->"1cebae8a-87d3-4b29-89e3-1a60e7935385"],

Cell["\<\
CalcFormCalculate contracts indices while retaining arbitrary momentum and \
polarisation scalar products, including longitudinal and trace terms. There \
are no SetMandelstam calls, scalar-product assignments, helicity tables or \
reference-amplitude comparisons. FORM runs with one worker and a 60-second \
per-stage limit; its files are retained in sChannelWorkDirectory. No extra \
graph factor is inserted. The result remains a gauge-dependent s-channel \
contribution.\
\>", "Text",ExpressionUUID->"200df282-fdbd-45ff-b81e-508de235fa8f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"sChannelWorkDirectory", "=", 
   RowBox[{"CreateDirectory", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$TemporaryDirectory", ",", 
       RowBox[{"\"\<fgfa-s-channel-offshell-\>\"", "<>", 
        RowBox[{"CreateUUID", "[", "]"}]}]}], "}"}], "]"}], "]"}]}], ";", 
  RowBox[{"AmplitudeSChannel", "=", 
   RowBox[{"CalcFormCalculate", "[", 
    RowBox[{
     RowBox[{
     "FeynAmpDenominatorExplicit", "[", "sChannelWithPolarisations", "]"}], ",", 
     RowBox[{"Dimension", "\[Rule]", "D"}], ",", 
     RowBox[{"FORMThreads", "\[Rule]", "1"}], ",", 
     RowBox[{"TimeConstraint", "\[Rule]", "60"}], ",", 
     RowBox[{"WorkingDirectory", "\[Rule]", "sChannelWorkDirectory"}], ",", 
     RowBox[{"KeepFiles", "\[Rule]", "True"}], ",", 
     RowBox[{"ShowProgress", "\[Rule]", "False"}]}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"FailureQ", "[", "AmplitudeSChannel", "]"}], "||", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"$Failed", ",", "$Aborted"}], "}"}], ",", 
       "AmplitudeSChannel"}], "]"}], "||", 
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"AmplitudeSChannel", ",", 
        RowBox[{"_LorentzIndex", "|", "_CalcFormCalculate"}]}], "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<The contraction did not complete. Inspect \
AmplitudeSChannel and sChannelWorkDirectory.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[14]:=",ExpressionUUID->"71d04388-ee7d-40c6-943d-d303d7eeea4d"],

Cell[BoxData[
 FormBox[
