}, Open  ]],

Cell["\<\
The run directory contains report.json, summary.csv and working files. \
Reports include source hashes and raw observations. The system may remove \
temporary files later; choose a persistent OutputDirectory before a run if \
you want to keep results. Cleanup is optional, deletes only successful owned \
working directories, and retains reports and failure logs.\
\>", "Text",ExpressionUUID->"6e28a1f3-1368-4234-a647-f45d10c214ca"],

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"TrueQ", "[", "cleanupSuccessfulFiles", "]"}], "&&", 
    RowBox[{"AssociationQ", "[", "report", "]"}]}], ",", 
   RowBox[{"BenchmarkCleanup", "[", "report", "]"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[20]:=",ExpressionUUID->"97417d1c-1344-4edb-af4f-df9c428f2623"]
}, Open  ]]
}, Open  ]]
