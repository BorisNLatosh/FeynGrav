Notebook[{

Cell[CellGroupData[{
Cell["Quick check and total calculation time", "Title",ExpressionUUID->"6cf3debb-38d3-490c-a91e-c6b4c20bf0c0"],

Cell["\<\
Does the converter work here, and what overhead does a small calculation have?\
\>", "Subtitle",ExpressionUUID->"d336ca94-6e50-4c6f-a227-adcbc6c11a91"],

Cell["\<\
Three small contractions have known answers. Package setup, executable checks \
and complete calculations are reported separately.\
\>", "Text",ExpressionUUID->"ea38b028-3cae-4434-9b14-fed1e78bdf68"],

Cell[CellGroupData[{

Cell["1. Setup", "Section",ExpressionUUID->"a714a91b-d8c9-4698-bd7d-f9f03af86c75"],

Cell["\<\
Use a fresh kernel for reproducible measurements. Mathematica, FeynGrav with \
FeynCalc, and FORM/TFORM are sufficient. No Python, shell scripts or external \
fixtures are needed. Opening this notebook does not execute any cells.\
\>", "Text",ExpressionUUID->"1b5e08b5-88a2-474a-8d20-faaaa83d3482"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"setupSeconds", "=", 
   RowBox[{"First", "[", 
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Support\>\"", 
          ",", "\"\<Benchmark.wl\>\""}], "}"}], "]"}], "]"}], ";"}], "]"}], 
    "]"}]}], ";"}]], "Input",
 InitializationCell->False,
