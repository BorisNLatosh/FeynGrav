Notebook[{Cell["Quick check and total calculation time", "Title"],
  Cell["Does the converter work here, and what overhead does a small calculation have?",
   "Subtitle"], Cell["Three small contractions have known answers. Package setup, executable checks \
and complete calculations are reported separately.", "Text"], Cell["1. Setup", "Section"],
  Cell["Use a fresh kernel for reproducible measurements. Mathematica, FeynGrav with FeynCalc, and \
FORM/TFORM are sufficient. No Python, shell scripts or external fixtures are needed. Opening this \
notebook does not execute any cells.", "Text"],
  Cell[BoxData[
    RowBox[{RowBox[{RowBox[{"setupSeconds", "=", RowBox[{"First", "[",
            RowBox[{"AbsoluteTiming", "[", RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[",
                    RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",",
                        "\"Support\"", ",", "\"Benchmark.wl\""}], "}"}], "]"}], "]"}], ";"}],
              "]"}], "]"}]}], ";"}]}]], "Input", InitializationCell -> False],
  Cell["2. Choose a profile", "Section"], Cell["Replace None below with \"Quick\" or \"Full\". \
Until you do, evaluation skips the benchmarks. Quick uses three measured small trials and one \
measured substantial trial; Full uses five and three, respectively. One warmup is recorded \
separately. Full workloads can take substantial time and disk space.", "Text"],
  Cell[BoxData[
    RowBox[{RowBox[{RowBox[{"config", "=", RowBox[{"BenchmarkConfiguration", "[", "]"}]}], ";"}],
      "", RowBox[{RowBox[{RowBox[{"config", "[", "\"Profile\"", "]"}], "=", "None"}], ";"}],
      "", RowBox[{RowBox[{RowBox[{"config", "[", "\"FORMExecutable\"", "]"}], "=",
          "Automatic"}], ";"}], "",
      RowBox[{RowBox[{RowBox[{"config", "[", "\"TFORMExecutable\"", "]"}], "=", "Automatic"}],
        ";"}], "", RowBox[{RowBox[{RowBox[{"config", "[", "\"Workers\"", "]"}], "=",
          "Automatic"}], ";"}], "",
      RowBox[{RowBox[{RowBox[{"config", "[", "\"Repetitions\"", "]"}], "=", "Automatic"}], ";"}],
      "", RowBox[{RowBox[{RowBox[{"config", "[", "\"PhysicalRepetitions\"", "]"}], "=",
          "Automatic"}], ";"}], "",
      RowBox[{RowBox[{RowBox[{"config", "[", "\"ExecutionTimeout\"", "]"}], "=", "Automatic"}],
        ";"}], "", RowBox[{RowBox[{RowBox[{"config", "[", "\"OutputDirectory\"", "]"}], "=",
          "Automatic"}], ";"}], "", RowBox[{RowBox[{"cleanupSuccessfulFiles", "=", "False"}],
        ";"}]}]], "Input", InitializationCell -> False], Cell["Automatic uses PATH discovery, \
profile trial counts, and a unique directory under the system temporary directory. Supply absolute \
executable paths if your desktop kernel has a different PATH. Timeouts are 60 seconds per FORM \
execution in Quick and 600 in Full; they do not bound export, import or the entire notebook. Worker \
defaults are capped at the reported processor count; you may explicitly choose other counts.",
   "Text"], Cell["3. Prepare inputs and check the environment", "Section"],
  Cell[BoxData[
    RowBox[{RowBox[{RowBox[{"prepared", "=", RowBox[{"BenchmarkPrepare", "[",
            RowBox[{"\"Overview\"", ",", "config"}], "]"}]}], ";"}], "",
      RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "prepared", "]"}], ",",
            RowBox[{RowBox[{RowBox[{"prepared", "[", "\"SetupSeconds\"", "]"}], "=",
                "setupSeconds"}], ";"}]}], "]"}], ";"}]}]], "Input", InitializationCell -> False],
  Cell[BoxData[RowBox[{"StandardForm", "[",
      RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "prepared", "]"}], ",",
            RowBox[{"Dataset", "[", RowBox[{"KeyTake", "[", RowBox[{"prepared", ",",
                  RowBox[{"{", RowBox[{"\"Environment\"", ",", "\"Checks\"", ",",
                      "\"Configuration\"", ",", "\"SetupSeconds\""}], "}"}]}], "]"}], "]"}]}],
          "]"}]}], "]"}]], "Input", InitializationCell -> False],
  Cell["Preparation constructs inputs and loads any required libraries. Import fixtures are \
generated at the start of each case in the following cell, before import measurements. Missing \
executables are recorded and dependent cases are skipped. No installation is attempted.", "Text"],
  Cell["4. Run sequential measurements", "Section"], Cell["For a new run, evaluate the preparation \
cell again first. Each prepared run can be executed once; previous reports are preserved.",
   "Text"],
  Cell[BoxData[
    RowBox[{RowBox[{RowBox[{"report", "=", RowBox[{"BenchmarkRun", "[", "prepared", "]"}]}],
        ";"}]}]], "Input", InitializationCell -> False], Cell["5. Inspect results and validation",
   "Section"], Cell[BoxData[RowBox[{"StandardForm", "[",
      RowBox[{RowBox[{"BenchmarkSummary", "[", "report", "]"}]}], "]"}]], "Input",
   InitializationCell -> False],
  Cell[BoxData[RowBox[{RowBox[{"BenchmarkPlot", "[", "report", "]"}]}]], "Input",
   InitializationCell -> False],
  Cell[BoxData[RowBox[{"StandardForm", "[",
      RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "report", "]"}], ",",
            RowBox[{"Dataset", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"KeyTake", "[",
                      RowBox[{"#1", ",", RowBox[{"{", RowBox[{"\"Case\"", ",", "\"Stage\"", ",",
                            "\"Workers\"", ",", "\"Phase\"", ",", "\"Trial\"", ",", "\"Seconds\"",
                            ",", "\"Status\"", ",", "\"Validation\"", ",", "\"ValidationMethod\"",
                            ",", "\"FirstBenchmarkImportInKernel\""}], "}"}]}], "]"}], "&"}],
                  ")"}], "/@", RowBox[{"report", "[", "\"Rows\"", "]"}]}], "]"}]}], "]"}]}],
      "]"}]], "Input", InitializationCell -> False], Cell["Only successful, verified measured \
trials enter the timing summary. A single trial is one observation, not a variability estimate. \
Known small answers are checked algebraically; larger cases are checked for repeatability and \
agreement across execution paths, not against an independent physics calculation. Baseline means \
that a comparison result has been recorded but has not yet been matched. Inconclusive and timed-out \
comparisons are excluded.", "Text"], Cell["6. Interpret and retain the report", "Section"],
  Cell["All timings are wall-clock seconds. First-import and warmup observations remain separate \
from measured repetitions. A first benchmark import is not necessarily a cold kernel import if you \
previously used the converter. Setup, validation, fingerprinting and display are outside stage \
timers. StageSum adds export, execution and import times; Calculate measures the separate public \
call including its availability check. Initialization, filesystem caches, background load and \
temperature can affect timings. These observations do not guarantee a speedup on another machine.",
   "Text"],
  Cell[BoxData[RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"AssociationQ", "[", "report", "]"}],
          ",", RowBox[{"report", "[", "\"Directory\"", "]"}]}], "]"}]}]], "Input",
   InitializationCell -> False], Cell["The run directory contains report.json, summary.csv and \
working files. Reports include source hashes and raw observations. The system may remove temporary \
files later; choose a persistent OutputDirectory before a run if you want to keep results. Cleanup \
is optional, deletes only successful owned working directories, and retains reports and failure \
logs.", "Text"],
  Cell[BoxData[
    RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"TrueQ", "[", "cleanupSuccessfulFiles",
              "]"}], "&&", RowBox[{"AssociationQ", "[", "report", "]"}]}], ",",
          RowBox[{"BenchmarkCleanup", "[", "report", "]"}]}], "]"}]}]], "Input",
   InitializationCell -> False]}, StyleDefinitions -> "Default.nb",
 WindowTitle -> "Quick check and total calculation time", WindowSize -> {1100, 850},
 CellContext -> Notebook, AutoGeneratedPackage -> None]