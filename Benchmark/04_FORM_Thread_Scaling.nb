 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"AssociationQ", "[", "report", "]"}], ",", 
   RowBox[{"report", "[", "\"\<Directory\>\"", "]"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[19]:=",ExpressionUUID->"d41c745d-3ba2-4a8e-9b41-4214b1010684"],

