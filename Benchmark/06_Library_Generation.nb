Cell[BoxData["\<\"FeynGrav library generator \[LongDash] \
CalcFormConverter\\nLoading preserves Directory[] and starts no calculation, \
FORM check or installation.\\nUse CheckGravitonScalars (without brackets) to \
list libraries; GenerateGravitonScalarsSpecific[1] generates one order, and \
GenerateGravitonScalars[n] generates a batch.\\nDefault library destination: \
/home/latosh/.Wolfram/Applications/FeynGrav/Libs/. Use OutputDirectory -> \
anExistingDirectory to generate elsewhere. Existing files are replaced only \
after validation.\\nAll generation commands always print library and \
calculation-stage progress. FORMThreads chooses the worker count; ShowTiming \
-> True adds detailed timings.\\nCalculation defaults: automatic FORM/TFORM \
selection, up to eight TFORM workers with serial fallback if TFORM is \
missing; Dirac and colour processing enabled.\\nPure/quadratic gravity: order \
n means n + 2 graviton legs. Gauss-Bonnet batches start at two; n = 1 returns \
Null without files.\\nUse ?function and Options[function] for signatures, \
defaults and failures. Full guide: \
/home/latosh/.Wolfram/Applications/FeynGrav/Libs/Generator.md\\nTo suppress \
this introduction, set $FeynGravLibrariesGeneratorStartupMessage = False \
before loading.\"\>"], "Print",
 CellChangeTimes->{4.000475936476617*^9, 4.000518687518972*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"95fee126-3f5a-43c6-8c33-c434e98b60d8"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Choose a profile and configuration", "Section", 
         ExpressionUUID -> "b902ded4-a3a6-4323-a385-71430399c3a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"config", "=", 
   RowBox[{"BenchmarkConfiguration", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<Profile\>\"", "]"}], "=", "\"\<Full\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<GeneratorThreads\>\"", "]"}], "=", 
   "Automatic"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cleanupSuccessfulFiles", "=", "False"}], ";"}]}], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000455383055262*^9, 4.0004553982010517`*^9}, 
   4.000475930036381*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"db116092-cb4c-480f-9e83-47f498af250a"],

Cell["Choose \"Quick\" or \"Full\" explicitly. Quick measures scalar, \
fermion and vector generation at order one. Full adds order two and \
representative general-relativity, Yang\[Dash]Mills, quadratic-gravity, \
Horndeski and Gauss\[Dash]Bonnet cases. Axion cases, unresolved G5 cases and \
Gauss\[Dash]Bonnet above order three are excluded. The helper section covers \
ITensor, CTensorGeneral without external pairs, and ETensor.", "Text", 
         ExpressionUUID -> "9a9e9cf2-76e1-459a-96cf-aae44ec9d57b"],

Cell["GeneratorThreads selects one configuration, not a scaling \
sweep: Automatic prefers up to eight TFORM workers with serial fallback. Use \
1 for serial FORM. FORMExecutable and TFORMExecutable accept explicit paths; \
automatic threads with an explicit serial path select one worker, and an \
explicit TFORM path uses up to eight. Explicit multiworker requests do not \
fall back. OutputDirectory is a parent for a unique run directory. \
PhysicalRepetitions defaults to 1/3 and Repetitions to 3/5 in Quick/Full. \
ExecutionTimeout is 60/600 seconds per FORM execution only; it does not bound \
Mathematica evaluation or the entire run.", "Text", ExpressionUUID -> 
          "a0bba96d-2ae3-4793-b914-6dc7a5456e90"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Prepare and inspect the environment", 
         "Section", ExpressionUUID -> 
          "e5242235-0e31-4142-816a-113160e86b0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prepared", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FailureQ", "[", "setup", "]"}], ",", "setup", ",", 
     RowBox[{"BenchmarkPrepare", "[", 
      RowBox[{"\"\<Generation\>\"", ",", "config"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AssociationQ", "[", "prepared", "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"prepared", "[", "\"\<SetupSeconds\>\"", "]"}], "=", 
      "setupSeconds"}], ";"}]}], "]"}], ";"}]}], "Input",
 InitializationCell->False,
 CellLabel->"In[6]:=",ExpressionUUID->"5649bace-bbf9-4b6f-8b69-b23387a0542b"],

Cell[BoxData[
 FormBox["\<\"Checking the selected FORM configuration; no rule expression is \
constructed in preparation.\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.0004759371596327`*^9, 4.000518687883399*^9},
 CellLabel->
  "During evaluation of \
In[6]:=",ExpressionUUID->"5117b845-9005-458a-b1d4-d1fce2c7d42c"]
}, Open  ]],

