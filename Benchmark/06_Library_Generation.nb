Notebook[{

Cell[CellGroupData[{
Cell["Library generation", "Title", 
      ExpressionUUID -> "9ca73271-949f-4844-831b-629ccd601fc0"],

Cell["Measure the public library generator and its individual stages. \
All libraries are written under an owned benchmark run directory; shipped \
libraries are never overwritten.", "Text", ExpressionUUID -> 
       "0fdf2065-6581-4943-9642-75c8a49dd488"],

Cell[CellGroupData[{

Cell["1. Load in a fresh kernel", "Section", 
         ExpressionUUID -> "df3e854f-5879-4161-b66c-b1640a25546c"],

Cell["Restart the kernel before switching between this generator \
notebook and notebooks 01\[Dash]05. Rule definitions are memoised: first \
observations are recorded separately, but shared caches may already have been \
populated by earlier cases. No caches are cleared.", "Text", 
         ExpressionUUID -> "a49e0e09-31a9-4b75-9e89-630a65b9b8d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"setupSeconds", "=", 
   RowBox[{"First", "[", 
    RowBox[{"AbsoluteTiming", "[", 
     RowBox[{
      RowBox[{"setup", "=", 
       RowBox[{"Get", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Support\>\"", 
           ",", "\"\<GeneratorBenchmark.wl\>\""}], "}"}], "]"}], "]"}]}], 
      ";"}], "]"}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[1]:=",ExpressionUUID->"174df627-45c1-403c-bb7d-9a71b4954b4c"],

