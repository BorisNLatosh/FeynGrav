Cell[CellGroupData[{

Cell["2. Choose a profile", "Section",ExpressionUUID->"30c3fc0f-0988-4da5-b8eb-f606f80e5580"],

Cell["\<\
Replace None below with \"Quick\" or \"Full\". Until you do, evaluation skips \
the benchmarks. Quick uses three measured small trials and one measured \
substantial trial; Full uses five and three, respectively. One warmup is \
recorded separately. Full workloads can take substantial time and disk space.\
\
\>", "Text",ExpressionUUID->"a24ee622-9206-4ece-8e6d-83d9d5e2155c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"config", "=", 
   RowBox[{"BenchmarkConfiguration", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<Profile\>\"", "]"}], "=", "\"\<Full\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<FORMExecutable\>\"", "]"}], "=", "Automatic"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<TFORMExecutable\>\"", "]"}], "=", 
   "Automatic"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<Workers\>\"", "]"}], "=", "Automatic"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<Repetitions\>\"", "]"}], "=", "Automatic"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<PhysicalRepetitions\>\"", "]"}], "=", 
   "Automatic"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<ExecutionTimeout\>\"", "]"}], "=", 
   "Automatic"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"config", "[", "\"\<OutputDirectory\>\"", "]"}], "=", 
   "Automatic"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cleanupSuccessfulFiles", "=", "False"}], ";"}]}], "Input",
 InitializationCell->False,
 CellChangeTimes->{3.999996605845248*^9, 3.999996645208351*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"2477ed12-315b-4e7f-bc34-c4ba1510a1ae"],

Cell["\<\
Automatic uses PATH discovery, profile trial counts, and a unique directory \
under the system temporary directory. Supply absolute executable paths if \
your desktop kernel has a different PATH. Timeouts are 60 seconds per FORM \
execution in Quick and 600 in Full; they do not bound export, import or the \
entire notebook. Worker defaults are capped at the reported processor count; \
you may explicitly choose other counts.\
\>", "Text",ExpressionUUID->"ca47c92d-7099-40a2-822f-11676b608b60"]
}, Open  ]],

