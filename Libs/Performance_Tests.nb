           RowBox[{"{", 
            RowBox[{
            "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2", ",", 
             "\[Mu]3", ",", "\[Nu]3", ",", "\[Mu]4", ",", "\[Nu]4"}], "}"}], 
           ",", 
           RowBox[{"DummyArray", "[", "2", "]"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\t", 
