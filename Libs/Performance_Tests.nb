        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "-", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}], ",", 
        RowBox[{"Mean", "[", "theData", "]"}], ",", 
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "+", 
