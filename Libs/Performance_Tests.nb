        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "-", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}], ",", 
        RowBox[{"Mean", "[", "theData", "]"}], ",", 
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "+", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"Length", "[", "theData", "]"}]}], "}"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]", 
