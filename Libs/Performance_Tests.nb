      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"Length", "[", "theData", "]"}]}], "}"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]", 
