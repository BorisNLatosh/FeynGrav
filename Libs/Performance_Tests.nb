Cell[BoxData[{
 RowBox[{
  RowBox[{"theData", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "100"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"<<", "GravitonVectorVertex`"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"theData", ",", 
       RowBox[{
        RowBox[{"Timing", "[", 
         RowBox[{"GravitonVectorVertex", "[", 
          RowBox[{
           RowBox[{"DummyArrayK", "[", "1", "]"}], ",", "\[Lambda]1", ",", 
           "p1", ",", "\[Lambda]2", ",", "p2", ",", "\[CurlyEpsilon]"}], 
          "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"Clear", "[", "GravitonVectorVertex`GravitonVectorVertex", "]"}],
      ";"}]}], "\[IndentingNewLine]", "]"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{"theData", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{"DeleteAnomalies", ",", "theData", ",", "3"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"theData", ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "-", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}], ",", 
        RowBox[{"Mean", "[", "theData", "]"}], ",", 
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "+", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"Length", "[", "theData", "]"}]}], "}"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", "theData", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
