Cell[BoxData[{
 RowBox[{
  RowBox[{"theData", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "100"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"<<", "CTensorGeneral`"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"theData", ",", 
       RowBox[{
        RowBox[{"Timing", "[", 
         RowBox[{"CTensorGeneral", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2"}], 
            "}"}], ",", 
           RowBox[{"DummyArray", "[", "4", "]"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"Clear", "[", "CTensorGeneral", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{"theData", "=", 
