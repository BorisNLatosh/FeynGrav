Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"theData", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "100"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"<<", "GravitonScalarVertex`"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"theData", ",", 
       RowBox[{
        RowBox[{"Timing", "[", 
         RowBox[{"GravitonScalarPotentialVertex", "[", 
          RowBox[{
           RowBox[{"DummyArray", "[", "1", "]"}], ",", "\[Lambda]"}], "]"}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{
     "Clear", "[", "GravitonScalarVertex`GravitonScalarPotentialVertex", 
      "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{"theData", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{"DeleteAnomalies", ",", "theData", ",", "3"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"theData", ",", 
      RowBox[{"AxesOrigin", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "-", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}], ",", 
        RowBox[{"Mean", "[", "theData", "]"}], ",", 
        RowBox[{
         RowBox[{"Mean", "[", "theData", "]"}], "+", 
         RowBox[{"StandardDeviation", "[", "theData", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", 
        RowBox[{"Length", "[", "theData", "]"}]}], "}"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", "theData", "]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Mean", "[", "theData", "]"}], "-", 
    RowBox[{"StandardDeviation", "[", "theData", "]"}]}], ",", 
   RowBox[{"Mean", "[", "theData", "]"}], ",", 
   RowBox[{
    RowBox[{"Mean", "[", "theData", "]"}], "+", 
    RowBox[{"StandardDeviation", "[", "theData", "]"}]}]}], "}"}]}], "Input",
