Cell[BoxData[{
 RowBox[{
  RowBox[{"theData", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "100"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{"<<", "ITensor`"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"theData", ",", 
       RowBox[{
        RowBox[{"Timing", "[", 
         RowBox[{"ITensor", "[", 
          RowBox[{"DummyArray", "[", "3", "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"Clear", "[", "ITensor", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{"theData", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{"DeleteAnomalies", ",", "theData", ",", "3"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
