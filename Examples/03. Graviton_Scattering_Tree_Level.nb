Cell[CellGroupData[{

Cell["6. Check the longitudinal replacement", "Section",ExpressionUUID->"5252ba24-4e9b-495d-a204-2d707c6efae2"],

Cell["\<\
Replace one index of the first external polarisation tensor by p1 while \
retaining the other polarisation vector. The sum of all exchange and contact \
diagrams should vanish. The other external legs remain on shell.\
\>", "Text",ExpressionUUID->"3657b7cf-15bf-4fc0-968c-b87a34d6efbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"LorentzIndex", "[", 
         RowBox[{"\[Mu]1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], 
      RowBox[{"PolarizationVectorD", "[", 
       RowBox[{"p1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], "]"}], 
      RowBox[{"PolarizationTensorD", "[", 
       RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
       "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
           "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}], "+", 
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]3", ",", "\[Nu]3", ",",
           "p3", ",", "\[Mu]2", ",", "\[Nu]2", ",", "p2", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}], "+", 
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]4", ",", "\[Nu]4", ",",
           "p4", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]2", ",", 
          "\[Nu]2", ",", "p2"}], "]"}], "+", 
        RowBox[{"GravitonVertex", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
           "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}]}], ")"}], " ", 
      RowBox[{"PolarizationTensorD", "[", 
       RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
        RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
      RowBox[{"PolarizationTensorD", "[", 
       RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
        RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], "\[Equal]", 
   "0"}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000091095956812*^9, 4.000091102122324*^9}, {
  4.00018612954399*^9, 4.000186188926262*^9}, {4.0001862284040203`*^9, 
  4.000186229663495*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"ccb1e2aa-9f37-4e8c-a956-9445bc649ef3"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"26.932905`", ",", "True"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000186329658697*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"123aeed7-3318-4c26-ba94-4f901430281c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to adapt this example", "Section",ExpressionUUID->"bbcad79b-f6ea-4b4b-b3b8-c2b43bba77a2"],

Cell["\<\
Change one ingredient at a time: a mass, a momentum assignment, or a vertex \
order. Restart the kernel before rerunning with different kinematics, because \
scalar-product definitions and assumptions persist in the session. \
Re-evaluate all dependent cells after a change. Inspect the stored \
intermediate expressions if a comparison is False or remains unevaluated; do \
not treat an unresolved expression as a passed check.\
\>", "Text",ExpressionUUID->"a7433574-5cc8-463a-9412-ad77dd91df4c"]
}, Open  ]]
}, Open  ]]
},
