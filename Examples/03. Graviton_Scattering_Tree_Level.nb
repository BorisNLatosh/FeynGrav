Cell[CellGroupData[{

Cell["t-channel exchange", "Subsection",
 Editable->False,ExpressionUUID->"a053c2fe-5e82-4adb-a4e6-08b249a6594d"],

Cell["\<\
Obtain this channel by exchanging the second and third external triples in \
the reusable exchange tensor.\
\>", "Text",
 Editable->False,ExpressionUUID->"84e39412-6fa9-4ae0-b358-02fee7f739ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeTChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"FeynGravSimplify", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]3", ",", "\[Nu]3", ",",
            "p3", ",", "\[Mu]2", ",", "\[Nu]2", ",", "p2", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
