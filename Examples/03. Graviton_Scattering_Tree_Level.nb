Cell[CellGroupData[{

Cell["Four-graviton contact interaction", "Subsection",ExpressionUUID->"bacaa403-18e6-47f6-9f71-18187a10fc91"],

Cell["\<\
GravitonVertex with four triples is the contact interaction. It is required \
together with all three exchange channels.\
\>", "Text",ExpressionUUID->"a433145d-70db-4c70-91db-260d10f69dc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeContactInteraction", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"GravitonVertex", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0001851422589893`*^9, 4.00018518058937*^9}, {
  4.000186097931632*^9, 4.000186099415148*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"7cb2f8bb-99fb-4d8c-9cc5-d7bb1986f34b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.207307`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0001863025161953`*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"8e507da2-d860-46a0-bd5f-75a2ccbd58b6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["AmplitudeContactInteraction"], "Input",
 InitializationCell->False,
 CellLabel->"In[32]:=",ExpressionUUID->"48057723-6254-4ec6-b369-1b1ebf810329"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", "h1", " ", "h2", " ", "h3", " ", "h4", " ", 
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
       RowBox[{"h1", " ", "h2", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"h1", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h1", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h3", " ", "h4", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "3"], " ", "u"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "2"], " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"4", " ", "t", " ", 
        SuperscriptBox["u", "3"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["s", "3"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.000186302565259*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"b57252f6-942b-4f6e-b84c-2fa7561c0e02"]
}, Open  ]]
