     RowBox[{
      RowBox[{"h1", " ", "h2"}], "+", "1"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h3", " ", "h4"}], "+", "1"}], ")"}]}], 
   RowBox[{"16", " ", "s"}]], TraditionalForm]], "Output",
