 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
