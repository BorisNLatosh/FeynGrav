Cell[CellGroupData[{

Cell[BoxData["AmplitudeTChannel"], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[28]:=",ExpressionUUID->"857dd199-9ca7-486a-8090-6b73a33fc85e"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[Kappa]", "2"], " ", "u", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h1", " ", "h2", " ", "h3", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "-", 
      RowBox[{"2", " ", "h1", " ", "h2", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h1", " ", "h2", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h1", " ", "h3", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "-", 
      RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h1", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h2", " ", "h3", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h2", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "-", 
      RowBox[{"2", " ", "h3", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h3", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      SuperscriptBox["s", "4"], "+", 
      RowBox[{"4", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["t", "4"]}]}], ")"}]}], 
   RowBox[{"16", " ", 
    SuperscriptBox["s", "3"], " ", "t"}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.001573324992032*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"9cb10ec9-ab0c-4990-82d0-77215eb19067"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["u-channel exchange", "Subsection",
 Editable->False,ExpressionUUID->"467142a1-b63b-4210-bd67-ea1eeb218ec1"],

Cell["\<\
Exchange the second and fourth triples. The polarisation tensors remain \
attached to their original external legs.\
\>", "Text",
 Editable->False,ExpressionUUID->"d599ba60-9dc3-4fc5-bf74-72ce70bca1a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeUChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"FeynGravSimplify", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]4", ",", "\[Nu]4", ",",
            "p4", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]2", ",",
            "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0001850856387672`*^9, 4.0001851234846163`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"adcaedf4-e5a2-49b0-9972-f9b1b6415f53"],

