     RowBox[{
      RowBox[{"h1", " ", "h2", " ", "h3", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "-", 
      RowBox[{"4", " ", "h1", " ", "h2", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h1", " ", "h2", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"4", " ", "h1", " ", "h3", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h1", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "+", 
      RowBox[{"h2", " ", "h3", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "-", 
      RowBox[{"4", " ", "h2", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"4", " ", "h3", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h3", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      SuperscriptBox["s", "4"], "+", 
      RowBox[{"4", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["u", "4"]}]}], ")"}]}], 
   RowBox[{"16", " ", 
    SuperscriptBox["s", "3"], " ", "u"}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.000186301304483*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"6a060bb8-b0cd-4f6b-814f-8fdd2fb18aa0"]
}, Open  ]]
