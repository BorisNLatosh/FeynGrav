Cell[CellGroupData[{

Cell["Four-graviton contact interaction", "Subsection",
 Editable->False,ExpressionUUID->"bacaa403-18e6-47f6-9f71-18187a10fc91"],

Cell["\<\
GravitonVertex with four triples is the contact interaction. It is required \
together with all three exchange channels.\
\>", "Text",
 Editable->False,ExpressionUUID->"a433145d-70db-4c70-91db-260d10f69dc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeContactInteraction", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"FeynGravSimplify", "[", 
        RowBox[{
         RowBox[{"GravitonVertex", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0001851422589893`*^9, 4.00018518058937*^9}, {
  4.000186097931632*^9, 4.000186099415148*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"7cb2f8bb-99fb-4d8c-9cc5-d7bb1986f34b"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.54007`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.001573336875498*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"f2261b91-7107-4bc9-bc06-93ef68d74069"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["AmplitudeContactInteraction"], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[32]:=",ExpressionUUID->"48057723-6254-4ec6-b369-1b1ebf810329"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", "h1", " ", "h2", " ", "h3", " ", "h4", " ", 
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
       RowBox[{"h1", " ", "h2", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"h1", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h1", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h3", " ", "h4", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "3"], " ", "u"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "2"], " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"4", " ", "t", " ", 
        SuperscriptBox["u", "3"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["s", "3"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.001573336983461*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"375f13b2-1321-4ca2-b8c3-518097de06b4"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Sum and check helicity amplitudes", "Section",
 Editable->False,ExpressionUUID->"a6fb60d7-9cbe-40da-ae78-22d8a2ae4e17"],

Cell["\<\
The comparisons below use the four-dimensional expressions quoted in Sannan, \
Phys. Rev. D 34 (1986) 1749. A True result confirms each displayed comparison \
in the stated convention; it is not an independent derivation of the \
reference formula.\
\>", "Text",
 Editable->False,ExpressionUUID->"d2a1f4d6-9717-4075-9983-fa03e5defaf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"TheCompleteAmplitude", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
      "AmplitudeSChannel", "+", "AmplitudeTChannel", "+", "AmplitudeUChannel",
        "+", "AmplitudeContactInteraction"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[33]:=",ExpressionUUID->"615ffb9b-a546-49cc-936e-ffbc20c8e587"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0.07588`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0015733370708857`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"890772ac-1dbc-4ae7-bfcd-0d5ec6c27a8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     SuperscriptBox["s", "4"]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"s", " ", "t", " ", "u"}], ")"}]}]]}], "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{4.0000907131118402`*^9, 4.0000911058483343`*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"34f23adb-834f-4078-824e-360ebe48c4c9"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001573337096031*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"76fbad88-53fc-4ac5-b2ba-b5ae69887466"]
}, Open  ]],

Cell[CellGroupData[{

