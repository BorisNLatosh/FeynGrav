Cell["\<\
This example requires FORM on the kernel PATH. CalcFormCalculate checks \
availability and uses up to eight TFORM workers by default, with serial \
fallback when TFORM is missing. It performs algebra and contractions, not \
loop integration. AbsoluteTiming includes export, execution and import.\
\>", "Text",ExpressionUUID->"e5f36eb8-75f3-49d8-ac04-a2c39d2972e1"],

Cell["\<\
FeynGrav supplies the vertex and propagator normalisations, including i and \
\[Kappa]. The default gravitational gauge parameter is GaugeFixingEpsilon = \
2. The displayed diagram weights are retained from the original example; the \
notebook does not derive their combinatorics.\
\>", "Text",ExpressionUUID->"a85ddb0c-fd08-47b0-b304-f6ac49d67655"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Build a reusable exchange diagram", "Section",ExpressionUUID->"3102fd1c-1a77-4eee-823e-3097dd0a9b70"],

Cell["\<\
The helper \[ScriptCapitalM]s takes four triples: {Lorentz index, Lorentz \
index, momentum}, written as twelve arguments. All vertex momenta are \
incoming. The internal graviton carries p1 + p2, with opposite signs at its \
two vertices. The helper keeps the eight external tensor indices free.\
\>", "Text",ExpressionUUID->"bdd555f2-b5d9-4100-80e3-5501a7a67530"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalM]s", "[", 
     RowBox[{
     "\[Mu]1_", ",", "\[Nu]1_", ",", "p1_", ",", "\[Mu]2_", ",", "\[Nu]2_", ",",
       "p2_", ",", "\[Mu]3_", ",", "\[Nu]3_", ",", "p3_", ",", "\[Mu]4_", ",",
       "\[Nu]4_", ",", "p4_"}], "]"}], "=", 
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{
      RowBox[{"GravitonVertex", "[", 
       RowBox[{
       "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",", 
        "p2", ",", "\[Alpha]1", ",", "\[Beta]1", ",", 
        RowBox[{
         RowBox[{"-", "p1"}], "-", "p2"}]}], "]"}], " ", 
      RowBox[{"FeynAmpDenominatorExplicit", "[", 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Alpha]1", ",", "\[Beta]1", ",", "\[Alpha]2", ",", "\[Beta]2", ",", 
         
         RowBox[{"p1", "+", "p2"}]}], "]"}], "]"}], " ", 
      RowBox[{"GravitonVertex", "[", 
       RowBox[{
       "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
        "p4", ",", "\[Alpha]2", ",", "\[Beta]2", ",", 
        RowBox[{"p1", "+", "p2"}]}], "]"}]}], "]"}]}], ";"}], "]"}]], "Input",\

 InitializationCell->False,
 CellLabel->"In[2]:=",ExpressionUUID->"9d5680c1-f3a5-49ef-b6b2-d76e433d9588"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"4.662739`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0001862746330757`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"6362c574-f43e-4e22-b80f-43cf23bb6371"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Set the massless helicity kinematics", "Section",ExpressionUUID->"e9ef7b84-e22d-4ec8-9bb3-f0b67d4f2e03"],

Cell["\<\
SetMandelstam defines all-incoming massless momenta with s + t + u = 0. The \
physical outgoing momenta are -p3 and -p4. The h1,\[Ellipsis],h4 labels take \
values \[PlusMinus]1 and label the graviton helicities \[PlusMinus]2. The \
polarisation-vector products below encode the convention used in Sannan, \
Phys. Rev. D 34 (1986) 1749.\
\>", "Text",
 CellChangeTimes->{{4.0001867396898317`*^9, 
  4.000186740307115*^9}},ExpressionUUID->"f0eb273a-bd9c-420a-8ad4-\
d1dc5a4ee840"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", 
    "0", ",", "0", ",", "0", ",", "0"}], "]"}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[3]:=",ExpressionUUID->"44fc3c15-ce7c-49d4-9c80-418f2f8f4544"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
