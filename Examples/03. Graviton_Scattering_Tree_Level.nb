Cell[CellGroupData[{

Cell["4. Evaluate the four contributions", "Section",ExpressionUUID->"07648bf7-8678-44b8-bf4e-778b22be41b4"],

Cell["\<\
First contract the exchange tensor with the incoming polarisation tensors and \
the conjugated outgoing tensors. Simplify and TrickMandelstam then reduce its \
invariant dependence. Individual channels need not be gauge invariant.\
\>", "Text",ExpressionUUID->"300e9707-e481-4ea5-824b-1f0019208724"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeSChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
          "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
         RowBox[{"PolarizationTensorD", "[", 
          RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
           RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000180892895203*^9, 4.0001809242178087`*^9}, {
  4.0001849243383102`*^9, 4.0001849674933558`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"00ff6f92-e9a8-4fd7-82a9-5641dfcb696c"],

