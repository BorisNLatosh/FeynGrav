Cell[CellGroupData[{

Cell[BoxData["AmplitudeTChannel"], "Input",
 InitializationCell->False,
 CellLabel->"In[28]:=",ExpressionUUID->"857dd199-9ca7-486a-8090-6b73a33fc85e"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[Kappa]", "2"], " ", "u", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h1", " ", "h2", " ", "h3", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "-", 
      RowBox[{"2", " ", "h1", " ", "h2", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h1", " ", "h2", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h1", " ", "h3", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "-", 
      RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h1", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h2", " ", "h3", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h2", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "-", 
      RowBox[{"2", " ", "h3", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"4", " ", "h3", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      SuperscriptBox["s", "4"], "+", 
      RowBox[{"4", " ", "s", " ", 
       SuperscriptBox["t", "3"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["t", "4"]}]}], ")"}]}], 
   RowBox[{"16", " ", 
    SuperscriptBox["s", "3"], " ", "t"}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.0001862921046762`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"4ca7819e-f572-49be-924b-eb931ef029e3"]
}, Open  ]]
}, Open  ]],

