}, Open  ]],

Cell[TextData[StyleBox["Analytic expression",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.881699156158779*^9, 
  3.881699159557932*^9}},ExpressionUUID->"49f742d9-b94a-4f3a-bbf7-\
e87bc2eafe56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"PolarizationOperator", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "==", 
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox["\[Kappa]", "2"], 
      FractionBox["1", 
       RowBox[{"D", "-", "1"}]], 
      SuperscriptBox[
       RowBox[{"SPD", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "2"], 
      RowBox[{"B0", "[", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"64", "-", 
           RowBox[{"34", " ", "D"}], "-", 
           RowBox[{"97", " ", 
            SuperscriptBox["D", "2"]}], "+", 
           RowBox[{"17", " ", 
            SuperscriptBox["D", "3"]}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["D", "4"]}]}], 
          RowBox[{"32", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "D"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "D"}], ")"}]}]], " ", 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"-", "256"}], "+", 
           RowBox[{"328", " ", "D"}], "+", 
           RowBox[{"544", " ", 
            SuperscriptBox["D", "2"]}], "-", 
           RowBox[{"116", " ", 
            SuperscriptBox["D", "3"]}], "-", 
           RowBox[{"109", " ", 
            SuperscriptBox["D", "4"]}], "+", 
           RowBox[{"27", " ", 
            SuperscriptBox["D", "5"]}]}], 
          RowBox[{"64", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", "D"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "D"}], ")"}]}]], 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
