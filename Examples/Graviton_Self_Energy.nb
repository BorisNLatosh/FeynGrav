      RowBox[{"p", ",", "\[Alpha]"}], "]"}], 
     RowBox[{"PolarizationTensor", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}]}], "==", "0"}], "//", 
   "Calc"}], "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
