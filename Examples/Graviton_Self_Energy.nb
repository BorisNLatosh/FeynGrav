Cell[TextData[{
 StyleBox["The $Assumptions to make sure that ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}], "\[CenterDot]", 
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}]}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"4e2acbfc-9f83-47a0-aaec-1d993631e1c8"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "\[CenterDot]", 
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}]}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"09f45bfa-1bc6-44df-b413-315508a0fabe"],
 StyleBox[".",
