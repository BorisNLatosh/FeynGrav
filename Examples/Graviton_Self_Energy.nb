Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPropagator1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonPropagator", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]1", ",", "\[Sigma]1", ",", "p"}], 
       "]"}], 
      RowBox[{"PolarizationOperator", "[", 
       RowBox[{
       "\[Rho]1", ",", "\[Sigma]1", ",", "\[Rho]2", ",", "\[Sigma]2", ",", 
        "p"}], "]"}], 
      RowBox[{"GravitonPropagator", "[", 
       RowBox[{
       "\[Rho]2", ",", "\[Sigma]2", ",", "\[Alpha]", ",", "\[Beta]", ",", 
        "p"}], "]"}]}], "//", "Calc"}]}], ";"}], "//", "Timing"}]], "Input",
