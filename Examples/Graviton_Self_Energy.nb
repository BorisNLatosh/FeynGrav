Cell[TextData[{
 StyleBox["The $Assumptions to make sure that ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}], "\[CenterDot]", 
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}]}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"4e2acbfc-9f83-47a0-aaec-1d993631e1c8"],
 StyleBox[" and ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"p", "\[CenterDot]", 
     RowBox[{"\[CurlyEpsilon]", "(", "p", ")"}]}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"09f45bfa-1bc6-44df-b413-315508a0fabe"],
 StyleBox[".",
  FontWeight->"Bold"]
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.9811881342724943`*^9, 
  3.9811881744098682`*^9}},ExpressionUUID->"041539b0-ca0f-4d0e-b0a9-\
1be1e7eed84b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
       
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
      "]"}], "==", "0"}], "&&", 
    RowBox[{
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p", ",", "D"}], "]"}], ",", 
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
      "]"}], "==", "0"}]}]}], ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.981187430008957*^9, 3.98118743823028*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"05da1164-29ea-4e33-a3c7-22a50a1302af"],

