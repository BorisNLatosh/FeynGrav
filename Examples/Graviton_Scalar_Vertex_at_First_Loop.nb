Cell["\<\
Optional export: set exportResult to True to write the off-shell vertex \
beside this notebook. The working directory is not changed. The default \
leaves existing files untouched.\
\>", "Text",ExpressionUUID->"9798c7a5-8802-43c3-8b38-5bc2d517e545"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exportResult", " ", "=", " ", "False"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "exportResult", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"vertexOutputFile", " ", "=", " ", 
