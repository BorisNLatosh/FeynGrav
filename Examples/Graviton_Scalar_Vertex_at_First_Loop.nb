Cell[CellGroupData[{

Cell["3.5. Ultraviolet pole", "Subsection",ExpressionUUID->"40912471-4504-42b3-b678-0bd4346379a3"],

Cell["\<\
Extract the simple UV residue of each scalar integral with Package-X, then \
collect the tensor coefficients. Their regular D \[RightArrow] 4 limit gives \
the pole residue; D-dimensional tensor labels are restored afterwards. The \
table prints the full UV-divergent part as the displayed common prefactor \
times the sum of five tensor structures and their coefficients. The complete \
expression is stored in uvDivergentPart.\
\>", "Text",ExpressionUUID->"9c12ecf1-1f00-436e-90ec-fb1b9e398ee6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"offShellMasters", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"offShellVertex", ",", " ", 
      RowBox[{"_A0", " ", "|", " ", "_B0", " ", "|", " ", "_C0"}], ",", " ", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvMasterRules", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: scalar UV residues\>\"", ",", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"integral", ",", " ", 
        RowBox[{"integral", " ", "->", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"EpsilonUV", "*", 
           RowBox[{"PaXEvaluateUV", "[", "integral", "]"}]}], "]"}]}]}], 
       "]"}], " ", "/@", " ", "offShellMasters"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvCoefficientSeries", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"ChangeDimension", "[", 
       RowBox[{
        RowBox[{"offShellVertex", " ", "/.", " ", "uvMasterRules"}], ",", " ",
         "4"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"D", ",", " ", "4", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<UV coefficients regular at D = 4\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"uvCoefficientSeries", ",", " ", "D"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvResidue", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: UV coefficient algebra\>\"", ",", " ", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"ChangeDimension", "[", 
         RowBox[{"uvCoefficientSeries", ",", " ", "D"}], "]"}], "]"}], ",", 
       " ", "tensorBasis", ",", " ", "Together"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvDivergentPart", " ", "=", " ", 
   RowBox[{"uvResidue", "/", "EpsilonUV"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvCommonPrefactor", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"\[Kappa]", "^", "3"}]}], ")"}], "/", "EpsilonUV"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvTensorCoefficients", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"uvDivergentPart", "/", "uvCommonPrefactor"}], "]"}], ",", 
         " ", "#1"}], "]"}], "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
    "tensorBasis"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<UV displayed tensor decomposition\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"uvDivergentPart", " ", "-", " ", 
      RowBox[{"uvCommonPrefactor", "*", 
       RowBox[{"uvTensorCoefficients", " ", ".", " ", "tensorBasis"}]}]}], 
     "]"}], " ", "===", " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<UV\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "uvCommonPrefactor", ",", " ", "\"\< \>\"", ",", " ", 
        RowBox[{"HoldForm", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"c", ",", " ", "a"}], "]"}], "*", 
            RowBox[{"Subsuperscript", "[", 
             RowBox[{"T", ",", " ", "a", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", " ", "#2"}], "}"}], " ", "&"}], " ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"tensorBasis", ",", " ", "uvTensorCoefficients"}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Tensor T\:2090\>\"", ",", 
           " ", "\"\<Coefficient c\:2090\>\""}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[50]:=",ExpressionUUID->"08062650-d36d-484a-a8a5-9deaa782d6b8"],

