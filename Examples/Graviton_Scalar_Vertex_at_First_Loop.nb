Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"EpsilonUV", " ", 
      RowBox[{"PaXEvaluateUV", "[", 
       RowBox[{"\[ScriptCapitalV]", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
        "]"}], "]"}]}], ",", 
     RowBox[{"Calc", "/@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MTD", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
         RowBox[{"FVD", "[", 
          RowBox[{"p1", ",", "\[Nu]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"p2", ",", "\[Mu]"}], "]"}], 
         RowBox[{"FVD", "[", 
          RowBox[{"p2", ",", "\[Nu]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
         RowBox[{"FVD", "[", 
          RowBox[{"p2", ",", "\[Nu]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"p2", ",", "\[Mu]"}], "]"}], 
         RowBox[{"FVD", "[", 
          RowBox[{"p1", ",", "\[Nu]"}], "]"}]}]}], "}"}]}], ",", "Simplify"}],
     "]"}], "==", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "3"]}], "24"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"MTD", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"SPD", "[", 
           RowBox[{"k", ",", "k"}], "]"}], "2"], "+", 
         RowBox[{
          RowBox[{"SPD", "[", 
           RowBox[{"k", ",", "k"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "11"}], 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{"SPD", "[", 
             RowBox[{"p1", ",", "p1"}], "]"}], "+", 
            RowBox[{"SPD", "[", 
             RowBox[{"p2", ",", "p2"}], "]"}]}], ")"}]}], "+", 
         RowBox[{"6", " ", 
          SuperscriptBox["m", "4"]}], "-", 
         RowBox[{"3", 
          SuperscriptBox["m", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SPD", "[", 
             RowBox[{"p1", ",", "p1"}], "]"}], "+", 
            RowBox[{"SPD", "[", 
             RowBox[{"p2", ",", "p2"}], "]"}]}], ")"}]}], "+", 
         RowBox[{"5", 
          RowBox[{"SPD", "[", 
           RowBox[{"p1", ",", "p1"}], "]"}], 
          RowBox[{"SPD", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"SPD", "[", 
            RowBox[{"p1", ",", "p1"}], "]"}], "2"]}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"SPD", "[", 
            RowBox[{"p2", ",", "p2"}], "]"}], "2"]}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Nu]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Nu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Mu]"}], "]"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"10", " ", 
          SuperscriptBox["m", "2"]}], " ", "-", " ", 
         RowBox[{"8", " ", 
          RowBox[{"SPD", "[", 
           RowBox[{"k", ",", "k"}], "]"}]}], "-", 
         RowBox[{"7", " ", 
          RowBox[{"SPD", "[", 
           RowBox[{"p1", ",", "p1"}], "]"}]}], "-", 
         RowBox[{"7", 
          RowBox[{"SPD", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Nu]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Nu]"}], "]"}]}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"8", " ", 
          SuperscriptBox["m", "2"]}], "-", 
         RowBox[{"6", " ", 
          RowBox[{"SPD", "[", 
           RowBox[{"k", ",", "k"}], "]"}]}], "+", 
         RowBox[{"6", " ", 
          RowBox[{"SPD", "[", 
           RowBox[{"p1", ",", "p1"}], "]"}]}], "+", 
         RowBox[{"6", " ", 
          RowBox[{"SPD", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ")"}]}], "-", 
      RowBox[{"21", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p1", ",", "\[Nu]"}], "]"}], 
          RowBox[{"SPD", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"p2", ",", "\[Nu]"}], "]"}], 
          RowBox[{"SPD", "[", 
           RowBox[{"p1", ",", "p1"}], "]"}]}]}], ")"}]}]}], ")"}]}]}], "//", 
  "Calc"}]], "Input",
