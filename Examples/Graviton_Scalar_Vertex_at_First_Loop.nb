Cell[CellGroupData[{

Cell["3.2. Exchange of the scalar legs", "Subsection",ExpressionUUID->"0aeefb55-0e59-492b-b0c2-4aea288b5e4c"],

Cell["\<\
The triangle integrals are symmetric under exchange of their first two \
invariants for the mass patterns appearing here. Verify these identities \
before using them to compare the two vertices.\
\>", "Text",ExpressionUUID->"f935876a-b39a-4392-a7dc-b07888809aeb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle identity: 0,m,0\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"PaXEvaluate", "[", 
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], " ", "==", " ", 
       RowBox[{"C0", "[", 
        RowBox[{"y", ",", " ", "x", ",", " ", "z", ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"PaXEvaluate", "::", "C0D0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle identity: m,0,m\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"PaXEvaluate", "[", 
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}], " ", "==", " ", 
       RowBox[{"C0", "[", 
        RowBox[{"y", ",", " ", "x", ",", " ", "z", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"PaXEvaluate", "::", "C0D0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleExchangeRules", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}], " ", "->", " ", 
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
