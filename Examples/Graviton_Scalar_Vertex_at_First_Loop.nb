 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]2", "[", 
    RowBox[{
    "\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "k_", ",", " ", "p1_", ",", " ", 
     "p2_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
