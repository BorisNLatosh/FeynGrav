72307b7157e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Asymptotic", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PaXEvaluateUVIRSplit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalV]IR", "[", 
         RowBox[{
         "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"PaXC0Expand", "->", "True"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "EpsilonIR"], "->", "0"}], ",", 
       RowBox[{
        FractionBox["1", "EpsilonUV"], "->", "0"}]}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"k", ",", "D"}], "]"}], ",", 
       RowBox[{"Momentum", "[", 
        RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "->", "0"}]}], "]"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.8946782823653717`*^9, 3.894678399589573*^9}, {
  3.894678518312107*^9, 3.894678597019628*^9}, {3.894678934592214*^9, 
  3.8946789466240263`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"d3d328c0-b6d0-482c-a916-8f3547f771cd"],

Cell[TextData[{
 StyleBox["Third, forth and sixth terms are proportional to a projector ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "\[Mu]"], 
    RowBox[{
     SubscriptBox["k", "\[Nu]"], "/", 
     SuperscriptBox["k", "2"]}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"d7416061-5752-4dbc-bb9f-a3b0726f3470"],
 StyleBox[". In that sense they remain finite and does not contribute to the \
leading IR behavior.",
