Cell[CellGroupData[{

Cell["4.3. Triangle with two massless propagators", "Subsection",ExpressionUUID->"03dbdea4-76e9-43ab-9447-04887b3331f6"],

Cell["\<\
For m > 0 and k\.b2 = \[Minus]q\.b2, q \[RightArrow] 0 from positive values, \
the dilogarithm argument approaches 1. The bracket 4\[Pi]\.b2 + 3 log\.b2(z) \
+ 12 Li\:2082(z) therefore approaches 6\[Pi]\.b2. Apply the two elementary \
limits explicitly, so the calculation does not rely on a particular \
factorization of Package-X output. The result below is the leading \
coefficient expansion followed by momentum recombination; it is not a \
complete componentwise tensor expansion along a specified external-momentum \
path.\
\>", "Text",ExpressionUUID->"31103de1-356c-4d99-b947-f2c3e194a58e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dilogArgument", " ", "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "+", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", "*", 
                RowBox[{"m", "^", "2"}]}], ")"}], "/", 
              RowBox[{"q", "^", "2"}]}], ")"}]}]}], "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"q", "^", "2"}]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"m", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dilogArgumentLimit", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"dilogArgument", ",", " ", 
     RowBox[{"q", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dilogBracketLimit", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"4", "*", 
       RowBox[{"Pi", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"3", "*", 
       RowBox[{
        RowBox[{"Log", "[", "z", "]"}], "^", "2"}]}], " ", "+", " ", 
      RowBox[{"12", "*", 
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", " ", "z"}], "]"}]}]}], ",", " ", 
     RowBox[{"z", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromBelow\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm argument limit\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"dilogArgumentLimit", " ", "==", " ", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm bracket limit\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"dilogBracketLimit", " ", "==", " ", 
    RowBox[{"6", "*", 
     RowBox[{"Pi", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleLeadingInput", " ", "=", " ", 
   RowBox[{
    RowBox[{"finiteIR", "[", "triangleMasslessKey", "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "dilogArgument", "]"}], " ", "->", " ", "0"}], ",",
       " ", 
      RowBox[{
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", " ", "dilogArgument"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "/", "6"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm limit substitution\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"triangleLeadingInput", ",", " ", "_PolyLog"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleLeading", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: massless triangle limit\>\"", ",", " ", 
     RowBox[{"combineIR", "[", 
      RowBox[{"spacelikeLeading", "[", "triangleLeadingInput", "]"}], "]"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleCoefficient", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"triangleLeading", "/", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle displayed coefficient\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"triangleLeading", " ", "-", " ", 
      RowBox[{"triangleCoefficient", "*", 
       RowBox[{"FCI", "[", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], " ", "===",
     " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"C", ",", " ", "\"\<triangle\>\""}], "]"}], "[", "q", 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "triangleCoefficient"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<triangle, shown\>\"", ",", 
           " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], "]"}], ",", " ", "\"\< = \>\"",
         ",", " ", "triangleLeading"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"76b439dd-bb9e-4e10-b8ac-aea6f73429f8"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        TagBox[
         RowBox[{
           SubscriptBox["C", "\"triangle\""], "(", "q", ")"}], HoldForm], 
        "\" = \"", 
        RowBox[{"-", 
          FractionBox[
           RowBox[{"7", " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[Pi]", "4"], " ", 
             SuperscriptBox["\[Kappa]", "3"], " ", 
             SuperscriptBox["m", "3"]}], 
           RowBox[{"32", " ", "q"}]]}]},
       "RowDefault"]},
     {
      TemplateBox[{
        TagBox[
         TemplateBox[{"V", "\"triangle, shown\"", "\"\[Mu]\[Nu]\""}, 
          "Subsuperscript", SyntaxForm -> SubsuperscriptBox], HoldForm], 
        "\" = \"", 
        RowBox[{"-", 
          FractionBox[
           RowBox[{"7", " ", "\[ImaginaryI]", " ", 
             SuperscriptBox["\[Pi]", "4"], " ", 
             SuperscriptBox["\[Kappa]", "3"], " ", 
             SuperscriptBox["m", "3"], " ", 
             SuperscriptBox[
              RowBox[{
                FormBox[
                 FormBox["k", TraditionalForm], TraditionalForm]}], 
              FormBox[
               FormBox["\[Mu]", TraditionalForm], TraditionalForm]], " ", 
             SuperscriptBox[
              RowBox[{
                FormBox[
                 FormBox["k", TraditionalForm], TraditionalForm]}], 
              FormBox[
               FormBox["\[Nu]", TraditionalForm], TraditionalForm]]}], 
           RowBox[{"32", " ", "q"}]]}]},
       "RowDefault"]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
   "Column"], TraditionalForm]], "Output",
 CellChangeTimes->{3.999673544550819*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"736b3149-b6b6-42e1-ba3d-da2eeb91fb27"]
}, Open  ]],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", 
    RowBox[{"-", 
     SuperscriptBox["q", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "fd8149f0-f483-4d42-bbde-91519bae6497"],
 ", the exact identity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["k", "\[Mu]"], 
      SuperscriptBox["k", "\[Nu]"]}], "q"], "=", 
    RowBox[{"-", "q", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["\[CapitalTheta]", "_"], "\[Mu]\[Nu]"], "(", "k", 
      ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c8edf675-fc58-4d23-955e-3d1e85f2e35a"],
 ". Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[CapitalTheta]", "_"], "\[Mu]\[Nu]"], "(", "k", ")"}], 
   TraditionalForm]],ExpressionUUID->"1d6e6346-931d-4f7c-b699-3ac195836fec"],
 " denotes GaugeProjectorBar[\[Mu], \[Nu], k]. This displayed structure \
vanishes for q \[RightArrow] 0 along a fixed spatial direction, while its \
square-root dependence remains nonanalytic."
}], "Text",ExpressionUUID->"693b9c9e-f97c-45ee-b0bb-ab5ed0646db3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4. Logarithmic bubble contribution", "Subsection",ExpressionUUID->"54f73428-f038-4e93-885b-d45579cd1186"],

Cell[TextData[{
 "Package-X can distribute the momentum logarithm among several logarithms. \
Extract their combined coefficient. For each positive argument ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "(", "q", ")", "=", "c", 
    SuperscriptBox["q", "n"]}], TraditionalForm]],ExpressionUUID->
  "2e307988-ada1-44a9-85ed-ca3aa1be7464"],
 ", use ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    FractionBox[
     RowBox[{"q", 
      SuperscriptBox["a", "\[Prime]"], "(", "q", ")"}], 
     RowBox[{"a", "(", "q", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "52f098c0-d44f-4d8a-b054-8811e8b27351"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", " ", "a", "(", "q", ")", "=", "log", " ", "c", "+", 
    FractionBox["n", "2"], "log", "(", 
    SuperscriptBox["q", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "7996917a-2a12-4aac-802a-85f297d9f76d"],
 ". The temporary symbol logK collects this common logarithm. The final \
expression uses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", "(", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox["k", "2"]}], 
     SubsuperscriptBox["\[Mu]", "R", "2"]], ")"}], TraditionalForm]],
  ExpressionUUID->"7c98b2d9-6e54-46b6-9694-bd2c1ac62bee"],
 ". ScaleMu is the renormalization scale \[Mu]_R. FeynCalc displays this \
scale as \[Mu] in the output; its meaning is distinct from the free Lorentz \
index \[Mu]. Constants in the argument do not change the coefficient of the \
momentum logarithm."
}], "Text",ExpressionUUID->"5b376619-233a-4bb5-9aa7-c49adcab05b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bubbleLogArguments", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"finiteIR", "[", "bubbleMasslessKey", "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "arg_", "]"}], " ", "/;", "  ", 
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"arg", ",", " ", "q"}], "]"}]}]}], " ", ":>", " ", "arg"}], 
      ",", " ", "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logDegrees", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", "*", 
          RowBox[{"D", "[", 
           RowBox[{"#1", ",", " ", "q"}], "]"}]}], ")"}], "/", "#1"}], "]"}], 
      " ", "&"}], " ", ")"}], " ", "/@", " ", "bubbleLogArguments"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "checks", "[", "\"\<Bubble logarithms have monomial arguments\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"IntegerQ", " ", "/@", " ", "logDegrees"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Positive bubble-log constants\>\"", "]"}], " ",
    "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "/.", " ", 
             RowBox[{"q", " ", "->", " ", "1"}]}], ")"}], " ", ">", " ", 
           "0"}], ",", " ", 
          RowBox[{
           RowBox[{"ScaleMu", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}], "]"}], " ", "&"}], 
      " ", ")"}], " ", "/@", " ", "bubbleLogArguments"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
       "checks", "[", "\"\<Bubble logarithms have monomial arguments\>\"", 
        "]"}], "]"}]}], " ", "||", "  ", 
     RowBox[{"!", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"checks", "[", "\"\<Positive bubble-log constants\>\"", "]"}], 
       "]"}]}]}], ",", " ", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bubbleLogRules", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "#1", "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"#1", " ", "/.", " ", 
          RowBox[{"q", " ", "->", " ", "1"}]}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#2", "*", "logK"}], ")"}], "/", "2"}]}]}], " ", "&"}], " ",
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"bubbleLogArguments", ",", " ", "logDegrees"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logCoefficient", " ", "=", " ", 
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"finiteIR", "[", "bubbleMasslessKey", "]"}], " ", "/.", " ", 
       "bubbleLogRules"}], "]"}], ",", " ", "logK"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logLeadingCoefficient", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: logarithm coefficient\>\"", ",", " ", 
     RowBox[{"combineIR", "[", 
      RowBox[{"spacelikeLeading", "[", "logCoefficient", "]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logarithmicVertex", " ", "=", " ", 
   RowBox[{"logLeadingCoefficient", "*", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FCI", "[", 
         RowBox[{"SPD", "[", "k", "]"}], "]"}], "/", 
        RowBox[{"ScaleMu", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logTensorCoefficient", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"logLeadingCoefficient", "/", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Logarithmic displayed coefficient\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"logLeadingCoefficient", " ", "-", " ", 
      RowBox[{"logTensorCoefficient", "*", 
       RowBox[{"FCI", "[", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], " ", "===",
     " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"C", ",", " ", "\"\<log\>\""}], "]"}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", "logTensorCoefficient"}], "}"}], "]"}], 
     ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<log, shown\>\"", ",", 
           " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], "]"}], ",", " ", "\"\< = \>\"",
         ",", " ", "logarithmicVertex"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"07460f1a-dc26-4768-ab34-f33ca5072ee6"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {
      TemplateBox[{
        TagBox[
         SubscriptBox["C", "\"log\""], HoldForm], "\" = \"", 
        RowBox[{
          FractionBox["77", "96"], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "3"], " ", 
          SuperscriptBox["m", "2"]}]},
       "RowDefault"]},
     {
      TemplateBox[{
        TagBox[
         TemplateBox[{"V", "\"log, shown\"", "\"\[Mu]\[Nu]\""}, 
          "Subsuperscript", SyntaxForm -> SubsuperscriptBox], HoldForm], 
        "\" = \"", 
        RowBox[{
          FractionBox["77", "96"], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "3"], " ", 
          SuperscriptBox["m", "2"], " ", 
          SuperscriptBox[
           RowBox[{
             FormBox[
              FormBox["k", TraditionalForm], TraditionalForm]}], 
           FormBox[
            FormBox["\[Mu]", TraditionalForm], TraditionalForm]], " ", 
          SuperscriptBox[
           RowBox[{
             FormBox[
              FormBox["k", TraditionalForm], TraditionalForm]}], 
           FormBox[
            FormBox["\[Nu]", TraditionalForm], TraditionalForm]], " ", 
          RowBox[{"log", "(", 
            RowBox[{"-", 
              FractionBox[
               SuperscriptBox[
                FormBox[
                 FormBox["k", TraditionalForm], TraditionalForm], 2], 
               SuperscriptBox["\[Mu]", "2"]]}], ")"}]}]},
       "RowDefault"]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1}}}],
   "Column"], TraditionalForm]], "Output",
 CellChangeTimes->{3.999673544613183*^9},
 CellLabel->
  "Out[100]=",ExpressionUUID->"00928097-8bfb-40f0-8f1a-5a281c7ba0d0"]
}, Open  ]],

Cell["\<\
This isolates the logarithmic sector. It does not establish that this sector \
is the only non-analytic contribution or the leading term of a complete \
observable.\
\>", "Text",ExpressionUUID->"5019fa86-e723-4d13-901e-6b05e576eb19"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Fourier convention and radial coefficient", "Section",ExpressionUUID->"77cb4dae-a272-421f-8f01-88d9ed9ecf6b"],

Cell["\<\
For a rotationally invariant scalar function f(q), use the three-dimensional \
Fourier convention displayed below. Mathematica\[CloseCurlyQuote]s default \
FourierSinTransform includes \[Sqrt](2/\[Pi]), so its prefactor here is \
\[Sqrt](\[Pi]/2)/(2\[Pi]\.b2r). See Appendix B, equations (134)\[Dash](136), \
of the linked reference.\
\>", "Text",ExpressionUUID->"24464963-8520-43fc-8dd6-cab99c7e8954"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["f", "~"], "(", "r", ")", "=", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "3"], 
     StyleBox["q",
      FontWeight->"Bold"]}], 
    SuperscriptBox[
     RowBox[{"(", "2", "\[Pi]", ")"}], "3"]], 
   SuperscriptBox["e", 
    RowBox[{"-", "i", 
     StyleBox["q",
      FontWeight->"Bold"], "\[CenterDot]", 
     StyleBox["r",
      FontWeight->"Bold"]}]], "f", "(", "q", ")", "=", 
   FractionBox["1", 
    RowBox[{"2", 
     SuperscriptBox["\[Pi]", "2"], "r"}]], 
   SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], "dq", " ", "q", " ", 
   "sin", "(", "qr", ")", " ", "f", "(", "q", ")"}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"330f1288-537b-4404-\
a4e9-54fa1738b7a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{"\"\<Latosh and Park, arXiv:2311.01756, Appendix B\>\"", ",", 
