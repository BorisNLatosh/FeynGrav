Cell[CellGroupData[{

Cell["2.3. V3", "Subsection",ExpressionUUID->"67bfc767-13a0-49d0-81f2-8d244517e8bf"],

Cell["\<\
Loop routing: gravitons l and \[Minus]p1 \[Minus] p2 \[Minus] l. The \
four-point scalar vertex joins the two scalar legs.\
\>", "Text",ExpressionUUID->"0eb98f22-f0c5-4f1f-8e0b-504ba84661f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV3", " ", "=", " ", 
   RowBox[{
    RowBox[{"GravitonVertex", "[", 
     RowBox[{"\[Mu]", ",", " ", "\[Nu]", ",", " ", 
      RowBox[{
       RowBox[{"-", "p1"}], " ", "-", " ", "p2"}], ",", " ", "a1", ",", " ", 
      "b1", ",", " ", 
      RowBox[{"-", "l"}], ",", " ", "m1", ",", " ", "n1", ",", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "p1"}], " ", "-", " ", "p2", " ", "-", " ", "l"}], 
        ")"}]}]}], "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "a1", ",", " ", "b1", ",", " ", "a2", ",", " ", "b2", ",", " ", "l"}], 
     "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{"m1", ",", " ", "n1", ",", " ", "m2", ",", " ", "n2", ",", " ", 
      RowBox[{
       RowBox[{"-", "p1"}], " ", "-", " ", "p2", " ", "-", " ", "l"}]}], 
     "]"}], "*", 
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m2", ",", " ", "n2", ",", " ", "a2", ",", " ", "b2"}], "}"}], 
      ",", " ", "p1", ",", " ", "p2", ",", " ", "m"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"e68d4987-41f9-4f62-a9d8-c4eb7aca028c"],

