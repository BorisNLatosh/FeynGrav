Cell[CellGroupData[{

Cell["3.2. Exchange of the scalar legs", "Subsection",ExpressionUUID->"0aeefb55-0e59-492b-b0c2-4aea288b5e4c"],

Cell["\<\
The triangle integrals are symmetric under exchange of their first two \
invariants for the mass patterns appearing here. Verify these identities \
before using them to compare the two vertices.\
\>", "Text",ExpressionUUID->"f935876a-b39a-4392-a7dc-b07888809aeb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle identity: 0,m,0\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"PaXEvaluate", "[", 
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], " ", "==", " ", 
       RowBox[{"C0", "[", 
        RowBox[{"y", ",", " ", "x", ",", " ", "z", ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"PaXEvaluate", "::", "C0D0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle identity: m,0,m\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{
     RowBox[{"PaXEvaluate", "[", 
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}], " ", "==", " ", 
       RowBox[{"C0", "[", 
        RowBox[{"y", ",", " ", "x", ",", " ", "z", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"PaXEvaluate", "::", "C0D0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleExchangeRules", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}], " ", "->", " ", 
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}]}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], " ", "->", " ", 
       RowBox[{"C0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", "p1", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "p2", "]"}], ",", " ", 
         RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}]}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalarExchangeResidual", " ", "=", " ", 
   RowBox[{"offShellVertex", " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[ScriptCapitalV]", "[", 
       RowBox[{
       "\[Mu]", ",", " ", "\[Nu]", ",", " ", "k", ",", " ", "p2", ",", " ", 
        "p1", ",", " ", "m"}], "]"}], " ", "/.", " ", 
      "triangleExchangeRules"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", "[", "\"\<Scalar exchange symmetry\>\"", "]"}], " ", "=", 
  " ", 
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{
    "scalarExchangeResidual", ",", " ", "masterIntegrals", ",", " ", 
     "Simplify"}], "]"}], " ", "==", " ", "0"}]}]}], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"f7d82d9b-d0f8-4244-a939-bb900d491ad6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3. On-shell longitudinal contraction", "Subsection",ExpressionUUID->"96e92e0d-38ee-414a-803c-83996831bb86"],

Cell[TextData[{
 "This checks ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["k", "\[Mu]"], 
     SubscriptBox["V", "\[Mu]\[Nu]"], 
     RowBox[{
      SuperscriptBox["\[CurlyEpsilon]", "\[Nu]"], "(", "k", ")"}]}], "=", 
    "0"}], TraditionalForm]],ExpressionUUID->
  "47ccefef-3914-4604-aaba-26d98e182839"],
 " with the scalar legs on shell and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "\[CenterDot]", "\[CurlyEpsilon]"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"5c6deb5b-beea-4ecf-befd-2bcd2bd62411"],
 ". It is a specific on-shell contraction, not a derivation of an \
unrestricted off-shell Ward identity. Kinematic and polarisation relations \
are applied as local substitutions; no scalar-product assignments are left \
behind."
}], "Text",ExpressionUUID->"2b6388b7-8593-49cb-98a9-e3151e2f1a7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"longitudinalVertex", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: longitudinal FORM\>\"", ",", " ", 
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalV]", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Nu]", ",", " ", 
         RowBox[{
          RowBox[{"-", "p1"}], " ", "-", " ", "p2"}], ",", " ", "p1", ",", 
         " ", "p2", ",", " ", "m"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "p1"}], " ", "-", " ", "p2"}], ",", " ", "\[Mu]"}], 
        "]"}], "*", 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Nu]", ",", " ", "D"}], "]"}], ",", " ", 
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"k", ",", " ", "I", ",", " ", 
             RowBox[{"Transversality", " ", "->", " ", "True"}]}], "]"}], ",",
            " ", "D"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transversalityRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"p1", ",", " ", "D"}], "]"}], ",", " ", 
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"k", ",", " ", "I", ",", " ", 
           RowBox[{"Transversality", " ", "->", " ", "True"}]}], "]"}], ",", 
         " ", "D"}], "]"}]}], "]"}], " ", "->", " ", 
     RowBox[{"-", 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", " ", "D"}], "]"}], ",", " ", 
        RowBox[{"Momentum", "[", 
         RowBox[{
          RowBox[{"Polarization", "[", 
           RowBox[{"k", ",", " ", "I", ",", " ", 
            RowBox[{"Transversality", " ", "->", " ", "True"}]}], "]"}], ",", 
          " ", "D"}], "]"}]}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"longitudinalResidual", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ExpandScalarProduct", "[", "longitudinalVertex", "]"}], " ", "/.",
       " ", "invariantRules"}], " ", "/.", " ", "onShellRules"}], " ", "/.", 
    " ", "transversalityRules"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", "[", "\"\<On-shell longitudinal contraction\>\"", "]"}], 
  " ", "=", " ", 
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{
    "longitudinalResidual", ",", " ", "masterIntegrals", ",", " ", 
     "Simplify"}], "]"}], " ", "==", " ", "0"}]}]}], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"5eaa99ef-340a-4ba5-a759-30ae759829d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.4. Off-shell infrared poles", "Subsection",ExpressionUUID->"8085b1f1-374b-49b6-ac43-b666c66cd5a6"],

Cell[TextData[{
 "Test the generic off-shell massive vertex for IR poles. This statement is \
separate from the on-shell small-momentum expansion in Section 4; absence of \
a dimensional-regularisation pole does not imply analyticity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7b9d82ef-13f8-401f-a3da-ca13414a371a"],
 "."
}], "Text",ExpressionUUID->"11b00717-38e8-4d03-af27-466da9bde08a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"offShellIRPole", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: IR pole\>\"", ",", " ", 
     RowBox[{"PaXEvaluateIR", "[", "offShellVertex", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", "[", "\"\<Off-shell IR pole\>\"", "]"}], " ", "=", " ", 
  RowBox[{"offShellIRPole", " ", "==", " ", "0"}]}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"c3b9549f-e153-43d1-81b7-9986ef38dfc2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.5. Ultraviolet pole", "Subsection",ExpressionUUID->"40912471-4504-42b3-b678-0bd4346379a3"],

Cell["\<\
Extract the simple UV residue of each scalar integral with Package-X, then \
collect the tensor coefficients. Their regular D \[RightArrow] 4 limit gives \
the pole residue; D-dimensional tensor labels are restored afterwards. The \
table prints the full UV-divergent part as the displayed common prefactor \
times the sum of five tensor structures and their coefficients. The complete \
expression is stored in uvDivergentPart.\
\>", "Text",ExpressionUUID->"9c12ecf1-1f00-436e-90ec-fb1b9e398ee6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"offShellMasters", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"offShellVertex", ",", " ", 
      RowBox[{"_A0", " ", "|", " ", "_B0", " ", "|", " ", "_C0"}], ",", " ", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvMasterRules", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: scalar UV residues\>\"", ",", " ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"integral", ",", " ", 
        RowBox[{"integral", " ", "->", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"EpsilonUV", "*", 
           RowBox[{"PaXEvaluateUV", "[", "integral", "]"}]}], "]"}]}]}], 
       "]"}], " ", "/@", " ", "offShellMasters"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvCoefficientSeries", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"ChangeDimension", "[", 
       RowBox[{
        RowBox[{"offShellVertex", " ", "/.", " ", "uvMasterRules"}], ",", " ",
         "4"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"D", ",", " ", "4", ",", " ", "0"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<UV coefficients regular at D = 4\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"uvCoefficientSeries", ",", " ", "D"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvResidue", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Check: UV coefficient algebra\>\"", ",", " ", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Expand", "[", 
        RowBox[{"ChangeDimension", "[", 
         RowBox[{"uvCoefficientSeries", ",", " ", "D"}], "]"}], "]"}], ",", 
       " ", "tensorBasis", ",", " ", "Together"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvDivergentPart", " ", "=", " ", 
   RowBox[{"uvResidue", "/", "EpsilonUV"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvCommonPrefactor", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"I", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"\[Kappa]", "^", "3"}]}], ")"}], "/", "EpsilonUV"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uvTensorCoefficients", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Factor", "[", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"uvDivergentPart", "/", "uvCommonPrefactor"}], "]"}], ",", 
         " ", "#1"}], "]"}], "]"}], " ", "&"}], " ", ")"}], " ", "/@", " ", 
    "tensorBasis"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<UV displayed tensor decomposition\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"uvDivergentPart", " ", "-", " ", 
      RowBox[{"uvCommonPrefactor", "*", 
       RowBox[{"uvTensorCoefficients", " ", ".", " ", "tensorBasis"}]}]}], 
     "]"}], " ", "===", " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<UV\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "uvCommonPrefactor", ",", " ", "\"\< \>\"", ",", " ", 
        RowBox[{"HoldForm", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"c", ",", " ", "a"}], "]"}], "*", 
            RowBox[{"Subsuperscript", "[", 
             RowBox[{"T", ",", " ", "a", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#1", ",", " ", "#2"}], "}"}], " ", "&"}], " ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"tensorBasis", ",", " ", "uvTensorCoefficients"}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Tensor T\:2090\>\"", ",", 
           " ", "\"\<Coefficient c\:2090\>\""}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}]}], "]"}]}], "Input",\

 CellLabel->"In[50]:=",ExpressionUUID->"08062650-d36d-484a-a8a5-9deaa782d6b8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. On-shell spacelike infrared limit", "Section",ExpressionUUID->"59781c03-4861-4fe7-82e6-ad913e8e8bf8"],

Cell["\<\
Put both scalar legs on shell, p\:2081\.b2 = p\:2082\.b2 = m\.b2, with m > 0. \
For spacelike k define q = \[Sqrt](\[Minus]k\.b2) > 0. In the static frame k\
\:2070 = 0, this is q = |\|01d424|. Package-X separates UV and IR poles; \
removing their inverse regulators selects the finite remainder. This is not a \
complete renormalisation prescription. The following subsections expand \
scalar tensor coefficients before recombining momenta. They do not establish \
a complete tensor asymptotic expansion: cancellations may require subleading \
coefficients. The full finite expressions remain available in finiteIR.\
\>", "Text",ExpressionUUID->"d3c6160b-f37d-4d58-a2ba-8ed3e9178f02"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"onShellVertex", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: on-shell collect\>\"", ",", " ", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"offShellVertex", " ", "/.", " ", "onShellRules"}], ",", " ", 
       "masterIntegrals", ",", " ", "Simplify"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]IR", "[", 
    RowBox[{
    "\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "k_", ",", " ", "p1_", ",", " ", 
     "p2_", ",", " ", "m_"}], "]"}], " ", "=", " ", "onShellVertex"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"onShellMasters", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{"onShellVertex", ",", " ", 
      RowBox[{"_A0", " ", "|", " ", "_B0", " ", "|", " ", "_C0"}], ",", " ", 
      "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"irContributions", " ", "=", " ", 
   RowBox[{"Association", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"integral", ",", " ", 
       RowBox[{"integral", " ", "->", " ", 
        RowBox[{
         RowBox[{"Collect", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"onShellVertex", ",", " ", "integral"}], "]"}], ",", " ", 
           "tensorBasis", ",", " ", "Simplify"}], "]"}], "*", 
         "integral"}]}]}], "]"}], " ", "/@", " ", "onShellMasters"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"irRationalPart", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"onShellVertex", " ", "-", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"Values", "[", "irContributions", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<IR decomposition\>\"", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
     "onShellVertex", " ", "-", " ", "irRationalPart", " ", "-", " ", 
      RowBox[{"Total", "[", 
       RowBox[{"Values", "[", "irContributions", "]"}], "]"}]}], "]"}], " ", "==",
     " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"List", " ", "/@", " ", 
      RowBox[{"Keys", "[", "irContributions", "]"}]}], ",", " ", 
     RowBox[{"{", "\"\<Scalar master integral\>\"", "}"}]}], "]"}], ",", " ", 
   
   RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"42c4a32c-fa52-4e5d-aa3d-27d0f7b6849f"],

Cell[CellGroupData[{

Cell["4.1. Explicit finite contributions", "Subsection",ExpressionUUID->"fad6a404-3d83-4a12-a6c4-cdec7212437b"],

Cell["\<\
IR contributions is keyed by the scalar integral itself, so the analysis does \
not depend on the order of terms in a sum. The reconstruction check also \
keeps a possible rational remainder visible. All six finite contributions are \
retained in finiteIR. The inverse regulators are removed only after Package-X \
has separated UV and IR poles.\
\>", "Text",ExpressionUUID->"c31babfe-b25b-46a4-a88c-08bfebf4eb75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"poleRemovalRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "EpsilonIR"}], " ", "->", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"1", "/", "EpsilonUV"}], " ", "->", " ", "0"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finiteIR", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: explicit finite integrals\>\"", ",", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"integral", ",", " ", "term"}], "}"}], ",", " ", 
          RowBox[{"integral", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"PaXEvaluateUVIRSplit", "[", 
               RowBox[{"term", ",", " ", 
                RowBox[{"PaXC0Expand", " ", "->", " ", "True"}]}], "]"}], " ",
               "/.", " ", "poleRemovalRules"}], " ", "/.", " ", 
             RowBox[{
              RowBox[{"FCI", "[", 
               RowBox[{"SPD", "[", "k", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"-", 
               RowBox[{"q", "^", "2"}]}]}]}], ")"}]}]}], "]"}], ",", " ", 
        "irContributions"}], "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "checks", "[", "\"\<No additional rational IR contribution\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"irRationalPart", " ", "===", " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleMassiveKey", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"C0", "[", 
     RowBox[{
      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"SPD", "[", "k", "]"}], ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", "0", ",", " ", 
      RowBox[{"m", "^", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleMasslessKey", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"C0", "[", 
     RowBox[{
      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bubbleMasslessKey", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"B0", "[", 
     RowBox[{
      RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", "0"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spacelikeLeading", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"m", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"q", " ", ">", " ", "0"}], " ", "&&", " ", 
      RowBox[{"ScaleMu", " ", ">", " ", "0"}]}], ",", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Asymptotic", "[", 
       RowBox[{"expr", ",", " ", 
        RowBox[{"q", " ", "->", " ", "0"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"combineIR", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"MomentumCombine", "[", "expr", "]"}], " ", "/.", " ", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"p1", " ", "+", " ", "p2"}], ",", " ", "D"}], "]"}], " ", "->",
       " ", 
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"-", "k"}], ",", " ", "D"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"72be02e1-a871-4deb-8cb4-652a0cfa0e13"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2. Other sectors after leading coefficient expansion", "Subsection",ExpressionUUID->"a06ee94a-0634-4bf9-b289-02eff1fe12e9"],

Cell["\<\
Keep the triangle with two massive propagators, the tadpole and the two \
bubbles with massive lines separate. Expand their scalar coefficients before \
combining momenta. The resulting tensor expressions can have a finite limit \
along a fixed spatial direction without a direction-independent limit. \
Finiteness alone does not imply analyticity. GaugeProjectorBar[\[Mu], \[Nu], \
k] is the existing longitudinal projector; no separate projector definition \
is needed.\
\>", "Text",ExpressionUUID->"ea6d4d83-8019-4553-8979-89552f9ff7e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["k", "\[Mu]"], 
     SuperscriptBox["k", "\[Nu]"]}], 
    SuperscriptBox["q", "2"]], "=", 
   RowBox[{"-", 
    SuperscriptBox[
     OverscriptBox["\[CapitalTheta]", "_"], "\[Mu]\[Nu]"], "(", "k", ")"}], ",", 
   RowBox[{
    SuperscriptBox["k", "2"], "=", 
    RowBox[{"-", 
     SuperscriptBox["q", "2"]}]}]}], TraditionalForm]], "DisplayFormula",Expre\
ssionUUID->"db03e5c7-a4a6-48ae-9db4-10a844957c1c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"regularKeys", " ", "=", " ", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Keys", "[", "finiteIR", "]"}], ",", " ", 
     RowBox[{"triangleMasslessKey", " ", "|", " ", "bubbleMasslessKey"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"regularLimits", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: regular-sector limits\>\"", ",", " ", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"integral", ",", " ", 
         RowBox[{"integral", " ", "->", " ", 
          RowBox[{"combineIR", "[", 
           RowBox[{"spacelikeLeading", "[", 
            RowBox[{"finiteIR", "[", "integral", "]"}], "]"}], "]"}]}]}], 
        "]"}], " ", "/@", " ", "regularKeys"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", " ", "#2"}], "}"}], " ", "&"}], " ", ",", " ", 
       "regularLimits"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Scalar integral\>\"", ",", 
       " ", "\"\<Contribution after leading coefficient expansion\>\""}], 
      "}"}]}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"253fa2ff-ee0f-41b5-bac6-79521bed0c65"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3. Triangle with two massless propagators", "Subsection",ExpressionUUID->"03dbdea4-76e9-43ab-9447-04887b3331f6"],

Cell["\<\
For m > 0 and k\.b2 = \[Minus]q\.b2, q \[RightArrow] 0 from positive values, \
the dilogarithm argument approaches 1. The bracket 4\[Pi]\.b2 + 3 log\.b2(z) \
+ 12 Li\:2082(z) therefore approaches 6\[Pi]\.b2. Apply the two elementary \
limits explicitly, so the calculation does not rely on a particular \
factorisation of Package-X output. The result below is the leading \
coefficient expansion followed by momentum recombination; it is not a \
complete componentwise tensor expansion along a specified external-momentum \
path.\
\>", "Text",ExpressionUUID->"31103de1-356c-4d99-b947-f2c3e194a58e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dilogArgument", " ", "=", " ", 
   RowBox[{"1", " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "+", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", "*", 
                RowBox[{"m", "^", "2"}]}], ")"}], "/", 
              RowBox[{"q", "^", "2"}]}], ")"}]}]}], "]"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"q", "^", "2"}]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"m", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dilogArgumentLimit", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{"dilogArgument", ",", " ", 
     RowBox[{"q", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromAbove\>\""}], ",", " ", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dilogBracketLimit", " ", "=", " ", 
   RowBox[{"Limit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"4", "*", 
       RowBox[{"Pi", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"3", "*", 
       RowBox[{
        RowBox[{"Log", "[", "z", "]"}], "^", "2"}]}], " ", "+", " ", 
      RowBox[{"12", "*", 
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", " ", "z"}], "]"}]}]}], ",", " ", 
     RowBox[{"z", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"Direction", " ", "->", " ", "\"\<FromBelow\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm argument limit\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"dilogArgumentLimit", " ", "==", " ", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm bracket limit\>\"", "]"}], " ", "=",
    " ", 
   RowBox[{"dilogBracketLimit", " ", "==", " ", 
    RowBox[{"6", "*", 
     RowBox[{"Pi", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleLeadingInput", " ", "=", " ", 
   RowBox[{
    RowBox[{"finiteIR", "[", "triangleMasslessKey", "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "dilogArgument", "]"}], " ", "->", " ", "0"}], ",",
       " ", 
      RowBox[{
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", " ", "dilogArgument"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"Pi", "^", "2"}], "/", "6"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Dilogarithm limit substitution\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"triangleLeadingInput", ",", " ", "_PolyLog"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleLeading", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: massless triangle limit\>\"", ",", " ", 
     RowBox[{"combineIR", "[", 
      RowBox[{"spacelikeLeading", "[", "triangleLeadingInput", "]"}], "]"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"triangleCoefficient", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"triangleLeading", "/", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Triangle displayed coefficient\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"triangleLeading", " ", "-", " ", 
      RowBox[{"triangleCoefficient", "*", 
       RowBox[{"FCI", "[", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], " ", "===",
     " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"C", ",", " ", "\"\<triangle\>\""}], "]"}], "[", "q", 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "triangleCoefficient"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<triangle, shown\>\"", ",", 
           " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], "]"}], ",", " ", "\"\< = \>\"",
         ",", " ", "triangleLeading"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"76b439dd-bb9e-4e10-b8ac-aea6f73429f8"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", 
    RowBox[{"-", 
     SuperscriptBox["q", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "fd8149f0-f483-4d42-bbde-91519bae6497"],
 ", the exact identity is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["k", "\[Mu]"], 
      SuperscriptBox["k", "\[Nu]"]}], "q"], "=", 
    RowBox[{"-", "q", 
     RowBox[{
      SuperscriptBox[
       OverscriptBox["\[CapitalTheta]", "_"], "\[Mu]\[Nu]"], "(", "k", 
      ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c8edf675-fc58-4d23-955e-3d1e85f2e35a"],
 ". Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     OverscriptBox["\[CapitalTheta]", "_"], "\[Mu]\[Nu]"], "(", "k", ")"}], 
   TraditionalForm]],ExpressionUUID->"1d6e6346-931d-4f7c-b699-3ac195836fec"],
 " denotes GaugeProjectorBar[\[Mu], \[Nu], k]. This displayed structure \
vanishes for q \[RightArrow] 0 along a fixed spatial direction, while its \
square-root dependence remains nonanalytic."
}], "Text",ExpressionUUID->"693b9c9e-f97c-45ee-b0bb-ab5ed0646db3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4. Logarithmic bubble contribution", "Subsection",ExpressionUUID->"54f73428-f038-4e93-885b-d45579cd1186"],

Cell[TextData[{
 "Package-X can distribute the momentum logarithm among several logarithms. \
Extract their combined coefficient. For each positive argument ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "(", "q", ")", "=", "c", 
    SuperscriptBox["q", "n"]}], TraditionalForm]],ExpressionUUID->
  "2e307988-ada1-44a9-85ed-ca3aa1be7464"],
 ", use ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    FractionBox[
     RowBox[{"q", 
      SuperscriptBox["a", "\[Prime]"], "(", "q", ")"}], 
     RowBox[{"a", "(", "q", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "52f098c0-d44f-4d8a-b054-8811e8b27351"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", " ", "a", "(", "q", ")", "=", "log", " ", "c", "+", 
    FractionBox["n", "2"], "log", "(", 
    SuperscriptBox["q", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "7996917a-2a12-4aac-802a-85f297d9f76d"],
 ". The temporary symbol logK collects this common logarithm. The final \
expression uses ",
 Cell[BoxData[
  FormBox[
   RowBox[{"log", "(", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox["k", "2"]}], 
     SubsuperscriptBox["\[Mu]", "R", "2"]], ")"}], TraditionalForm]],
  ExpressionUUID->"7c98b2d9-6e54-46b6-9694-bd2c1ac62bee"],
 ". ScaleMu is the renormalisation scale \[Mu]_R. FeynCalc displays this \
scale as \[Mu] in the output; its meaning is distinct from the free Lorentz \
index \[Mu]. Constants in the argument do not change the coefficient of the \
momentum logarithm."
}], "Text",ExpressionUUID->"5b376619-233a-4bb5-9aa7-c49adcab05b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bubbleLogArguments", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"finiteIR", "[", "bubbleMasslessKey", "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "arg_", "]"}], " ", "/;", "  ", 
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"arg", ",", " ", "q"}], "]"}]}]}], " ", ":>", " ", "arg"}], 
      ",", " ", "Infinity"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logDegrees", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"q", "*", 
          RowBox[{"D", "[", 
           RowBox[{"#1", ",", " ", "q"}], "]"}]}], ")"}], "/", "#1"}], "]"}], 
      " ", "&"}], " ", ")"}], " ", "/@", " ", "bubbleLogArguments"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "checks", "[", "\"\<Bubble logarithms have monomial arguments\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"IntegerQ", " ", "/@", " ", "logDegrees"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Positive bubble-log constants\>\"", "]"}], " ",
    "=", " ", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#1", " ", "/.", " ", 
             RowBox[{"q", " ", "->", " ", "1"}]}], ")"}], " ", ">", " ", 
           "0"}], ",", " ", 
          RowBox[{
           RowBox[{"ScaleMu", " ", ">", " ", "0"}], " ", "&&", " ", 
           RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}], "]"}], " ", "&"}], 
      " ", ")"}], " ", "/@", " ", "bubbleLogArguments"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
       "checks", "[", "\"\<Bubble logarithms have monomial arguments\>\"", 
        "]"}], "]"}]}], " ", "||", "  ", 
     RowBox[{"!", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"checks", "[", "\"\<Positive bubble-log constants\>\"", "]"}], 
       "]"}]}]}], ",", " ", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bubbleLogRules", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Log", "[", "#1", "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"#1", " ", "/.", " ", 
          RowBox[{"q", " ", "->", " ", "1"}]}], "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#2", "*", "logK"}], ")"}], "/", "2"}]}]}], " ", "&"}], " ",
      ",", " ", 
     RowBox[{"{", 
      RowBox[{"bubbleLogArguments", ",", " ", "logDegrees"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logCoefficient", " ", "=", " ", 
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"finiteIR", "[", "bubbleMasslessKey", "]"}], " ", "/.", " ", 
       "bubbleLogRules"}], "]"}], ",", " ", "logK"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logLeadingCoefficient", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<IR: logarithm coefficient\>\"", ",", " ", 
     RowBox[{"combineIR", "[", 
      RowBox[{"spacelikeLeading", "[", "logCoefficient", "]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logarithmicVertex", " ", "=", " ", 
   RowBox[{"logLeadingCoefficient", "*", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"FCI", "[", 
         RowBox[{"SPD", "[", "k", "]"}], "]"}], "/", 
        RowBox[{"ScaleMu", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logTensorCoefficient", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"logLeadingCoefficient", "/", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checks", "[", "\"\<Logarithmic displayed coefficient\>\"", "]"}], 
   " ", "=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"logLeadingCoefficient", " ", "-", " ", 
      RowBox[{"logTensorCoefficient", "*", 
       RowBox[{"FCI", "[", 
        RowBox[{
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Mu]"}], "]"}], "*", 
         RowBox[{"FVD", "[", 
          RowBox[{"k", ",", " ", "\[Nu]"}], "]"}]}], "]"}]}]}], "]"}], " ", "===",
     " ", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"C", ",", " ", "\"\<log\>\""}], "]"}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", "logTensorCoefficient"}], "}"}], "]"}], 
     ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<log, shown\>\"", ",", 
           " ", "\"\<\[Mu]\[Nu]\>\""}], "]"}], "]"}], ",", " ", "\"\< = \>\"",
         ",", " ", "logarithmicVertex"}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"07460f1a-dc26-4768-ab34-f33ca5072ee6"],

Cell["\<\
This isolates the logarithmic sector. It does not establish that this sector \
is the only non-analytic contribution or the leading term of a complete \
observable.\
\>", "Text",ExpressionUUID->"5019fa86-e723-4d13-901e-6b05e576eb19"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Fourier convention and radial coefficient", "Section",ExpressionUUID->"77cb4dae-a272-421f-8f01-88d9ed9ecf6b"],

Cell["\<\
For a rotationally invariant scalar function f(q), use the three-dimensional \
Fourier convention displayed below. Mathematica\[CloseCurlyQuote]s default \
FourierSinTransform includes \[Sqrt](2/\[Pi]), so its prefactor here is \
\[Sqrt](\[Pi]/2)/(2\[Pi]\.b2r). See Appendix B, equations (134)\[Dash](136), \
of the linked reference.\
\>", "Text",ExpressionUUID->"24464963-8520-43fc-8dd6-cab99c7e8954"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["f", "~"], "(", "r", ")", "=", "\[Integral]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "3"], 
     StyleBox["q",
      FontWeight->"Bold"]}], 
    SuperscriptBox[
     RowBox[{"(", "2", "\[Pi]", ")"}], "3"]], 
   SuperscriptBox["e", 
    RowBox[{"-", "i", 
     StyleBox["q",
      FontWeight->"Bold"], "\[CenterDot]", 
     StyleBox["r",
      FontWeight->"Bold"]}]], "f", "(", "q", ")", "=", 
   FractionBox["1", 
    RowBox[{"2", 
     SuperscriptBox["\[Pi]", "2"], "r"}]], 
   SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], "dq", " ", "q", " ", 
   "sin", "(", "qr", ")", " ", "f", "(", "q", ")"}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"330f1288-537b-4404-\
a4e9-54fa1738b7a5"],

Cell[BoxData[
 RowBox[{"Hyperlink", "[", 
  RowBox[{"\"\<Latosh and Park, arXiv:2311.01756, Appendix B\>\"", ",", 
   " ", "\"\<https://arxiv.org/html/2311.01756v3#A2\>\""}], "]"}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"1eb4a85e-fec5-4ac7-967a-ac545fc1b160"],

Cell[TextData[{
 "Transform the scalar function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "q", ")", "=", 
    RowBox[{"-", 
     SubscriptBox["C", "log"], 
     SuperscriptBox["q", "2"], "log", "(", 
     FractionBox[
      SuperscriptBox["q", "2"], 
      SubsuperscriptBox["\[Mu]", "R", "2"]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"3bc44434-e1de-4d10-ba26-d618854f938f"],
 " associated with the longitudinal projector. The direction-dependent \
projector cannot be pulled through a tensor Fourier transform. Thus the \
scalar radial result below is not a full tensor transform. For r > 0, \
changing the renormalisation scale adds only contact terms at the origin. The \
calculation therefore omits that polynomial term and transforms ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    SubscriptBox["C", "log"], 
    SuperscriptBox["q", "2"], "log", "(", 
    SuperscriptBox["q", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "4d57642d-b258-4de2-a654-dea1a953b0b8"],
 "."
}], "Text",ExpressionUUID->"1db88904-5031-4d92-9735-b5f95f5e7006"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"calculatedRadialInput", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "logTensorCoefficient"}], ")"}], "*", 
    RowBox[{"q", "^", "2"}], "*", 
    RowBox[{"Log", "[", 
     RowBox[{"q", "^", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"calculatedRadialTransform", " ", "=", " ", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"r", " ", ">", " ", "0"}], ",", " ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"Pi", "/", "2"}], "]"}], "*", 
         RowBox[{"FourierSinTransform", "[", 
          RowBox[{
           RowBox[{"q", "*", "calculatedRadialInput"}], ",", " ", "q", ",", 
           " ", "r"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"Pi", "^", "2"}], "*", "r"}], ")"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"HoldForm", "[", 
     RowBox[{
      RowBox[{"Overscript", "[", 
       RowBox[{"f", ",", " ", "\"\<~\>\""}], "]"}], "[", "r", "]"}], "]"}], ",",
     " ", "\"\< = \>\"", ",", " ", "calculatedRadialTransform", ",", 
    " ", "\"\<    (r > 0)\>\""}], "}"}], "]"}]}], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"d24b9216-0111-4dd4-8e37-76967a234706"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Results, checks and optional export", "Section",ExpressionUUID->"8eaaca7f-2613-48f7-8a8a-8f655e2b2059"],

Cell["\<\
The mathematical summary below collects the UV decomposition and the \
displayed coefficientwise triangle and logarithmic sectors, followed by the \
scalar radial transform. offShellVertex contains the amputated vertex; \
onShellVertex and finiteIR retain the unexpanded expressions. Reconstruction \
checks test algebraic bookkeeping, while symmetry, pole and limit checks test \
the named properties. Neither category proves completeness of a tensor \
asymptotic expansion or a scattering observable.\
\>", "Text",ExpressionUUID->"44537e0d-622f-4195-a2a7-bd47f4a2ae5a"],

Cell[BoxData[
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subsuperscript", "[", 
          RowBox[{
          "V", ",", " ", "\"\<UV\>\"", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "uvCommonPrefactor", ",", " ", "\"\< \>\"", ",", " ", 
        RowBox[{"HoldForm", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"c", ",", " ", "a"}], "]"}], "*", 
            RowBox[{"Subsuperscript", "[", 
             RowBox[{"T", ",", " ", "a", ",", " ", "\"\<\[Mu]\[Nu]\>\""}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "1", ",", " ", "5"}], "}"}]}], "]"}], 
         "]"}]}], "}"}], "]"}], ",", " ", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"List", ",", " ", 
           RowBox[{"{", 
            RowBox[{"tensorBasis", ",", " ", "uvTensorCoefficients"}], 
            "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Tensor\>\"", ",", " ", "\"\<UV coefficient\>\""}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"C", ",", " ", "\"\<triangle\>\""}], "]"}], "[", "q", 
          "]"}], "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "triangleCoefficient"}], "}"}], "]"}], ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{"Subscript", "[", 
          RowBox[{"C", ",", " ", "\"\<log\>\""}], "]"}], "]"}], ",", 
        " ", "\"\< = \>\"", ",", " ", "logTensorCoefficient"}], "}"}], "]"}], 
     ",", " ", 
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"HoldForm", "[", 
         RowBox[{
          RowBox[{"Overscript", "[", 
           RowBox[{"f", ",", " ", "\"\<~\>\""}], "]"}], "[", "r", "]"}], 
         "]"}], ",", " ", "\"\< = \>\"", ",", " ", 
        "calculatedRadialTransform", ",", " ", "\"\<    (r > 0)\>\""}], "}"}],
       "]"}]}], "}"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"e979f52a-e9f0-4fef-b6f6-af31f4d5ddbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"checkSummary", " ", "=", " ", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 
                 RowBox[{"\"\<UV displayed tensor decomposition\>\"", ",", 
                  " ", "\"\<IR decomposition\>\"", ",", 
                  " ", "\"\<Triangle displayed coefficient\>\"", ",", 
                  " ", "\"\<Logarithmic displayed coefficient\>\""}], "}"}], ",",
                 " ", "#1"}], "]"}], ",", " ", "\"\<Reconstruction\>\"", ",", 
              " ", "\"\<Symmetry / pole / limit\>\""}], "]"}], ",", " ", "#1",
             ",", " ", 
            RowBox[{"checkStatus", "[", "#2", "]"}]}], "}"}], " ", "&"}], " ",
          ",", " ", "checks"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Category\>\"", ",", " ", "\"\<Check\>\"", ",", 
         " ", "\"\<Result\>\""}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
