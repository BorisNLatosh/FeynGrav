Cell[TextData[StyleBox["Calculation of all contribution.",
 FontSize->18,
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.894658311827882*^9, 
  3.89465832533211*^9}},ExpressionUUID->"310b9c39-f43b-4694-b2ef-\
481068ad38d9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalV]1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "k_", ",", "p1_", ",", "p2_", ",", "m_"}], 
     "]"}], "=", 
    RowBox[{"TID", "[", 
     RowBox[{
      RowBox[{"CalcFormCalculate", "[", 
       RowBox[{
        RowBox[{"GravitonScalarVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a2", ",", "b2"}], "}"}], ",", "p1", ",", 
          RowBox[{"-", "l"}], ",", "m"}], "]"}], 
        RowBox[{"ScalarPropagator", "[", 
         RowBox[{"l", ",", "m"}], "]"}], 
        RowBox[{"GravitonScalarVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m2", ",", "n2"}], "}"}], ",", "l", ",", "p2", ",", "m"}], 
         "]"}], 
        RowBox[{"GravitonPropagator", "[", 
         RowBox[{"m1", ",", "n1", ",", "m2", ",", "n2", ",", 
          RowBox[{"p2", "+", "l"}]}], "]"}], 
        RowBox[{"GravitonPropagator", "[", 
         RowBox[{"a1", ",", "b1", ",", "a2", ",", "b2", ",", 
          RowBox[{"p1", "-", "l"}]}], "]"}], 
        RowBox[{"GravitonVertex", "[", 
         RowBox[{"\[Mu]", ",", "\[Nu]", ",", 
          RowBox[{
           RowBox[{"-", "p1"}], "-", "p2"}], ",", "a1", ",", "b1", ",", 
          RowBox[{"p1", "-", "l"}], ",", "m1", ",", "n1", ",", 
          RowBox[{"p2", "+", "l"}]}], "]"}]}], "]"}], ",", "l", ",", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalV]1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "k_", ",", "p1_", ",", "p2_", ",", "m_"}], 
     "]"}], "=", 
    RowBox[{
     RowBox[{"\[ScriptCapitalV]1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
      "]"}], "/.", 
     RowBox[{
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p2", ",", "D"}], "]"}]}], "]"}], "->", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Pair", "[", 
          RowBox[{
           RowBox[{"Momentum", "[", 
            RowBox[{"k", ",", "D"}], "]"}], ",", 
           RowBox[{"Momentum", "[", 
            RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "-", 
         RowBox[{"Pair", "[", 
          RowBox[{
           RowBox[{"Momentum", "[", 
            RowBox[{"p1", ",", "D"}], "]"}], ",", 
           RowBox[{"Momentum", "[", 
            RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "-", 
         RowBox[{"Pair", "[", 
          RowBox[{
           RowBox[{"Momentum", "[", 
            RowBox[{"p2", ",", "D"}], "]"}], ",", 
           RowBox[{"Momentum", "[", 
            RowBox[{"p2", ",", "D"}], "]"}]}], "]"}]}], ")"}]}]}]}]}], ";"}], 
  "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalV]1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "k_", ",", "p1_", ",", "p2_", ",", "m_"}], 
     "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalV]1", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A0", "[", "__", "]"}], ",", 
        RowBox[{"B0", "[", "__", "]"}], ",", 
        RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{"#", ",", 
         RowBox[{"FeynCalcInternal", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"MTD", "[", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"FVD", "[", 
              RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
             RowBox[{"FVD", "[", 
              RowBox[{"p2", ",", "\[Nu]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"FVD", "[", 
              RowBox[{"p1", ",", "\[Nu]"}], "]"}], 
             RowBox[{"FVD", "[", 
              RowBox[{"p2", ",", "\[Mu]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"FVD", "[", 
              RowBox[{"p1", ",", "\[Mu]"}], "]"}], 
             RowBox[{"FVD", "[", 
              RowBox[{"p1", ",", "\[Nu]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"FVD", "[", 
              RowBox[{"p2", ",", "\[Mu]"}], "]"}], 
             RowBox[{"FVD", "[", 
              RowBox[{"p2", ",", "\[Nu]"}], "]"}]}]}], "}"}], "]"}], ",", 
         "Simplify"}], "]"}], "&"}]}], "]"}]}], ";"}], "//", 
  "Timing"}]}], "Input",
 CellChangeTimes->{{3.885413353686033*^9, 3.885413377543804*^9}, 
   3.885413747934203*^9, {3.894658434673337*^9, 3.894658458350717*^9}, {
