Cell[BoxData[
 FormBox[
  InterpretationBox[
   StyleBox[
    FrameBox[
     DynamicModuleBox[{System`InformationDump`open$$ = False, 
      System`InformationDump`mouseOver$$ = False}, 
      PaneSelectorBox[{True->
       TagBox[GridBox[{
          {
           ItemBox[
            PaneBox[
             StyleBox[
              TagBox[
               TooltipBox[
                StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                 StripOnInput->False],
                "\"Symbol\"",
                TooltipStyle->"TextStyling"],
               Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
              StripOnInput->False,
              BaseStyle -> None],
             FrameMargins->{{4, 0}, {-1, 1}}],
            BaseStyle->"InformationTitleBackground",
            StripOnInput->False], 
           ItemBox["\<\"\"\>",
            BaseStyle->"InformationTitleBackground",
            StripOnInput->False]},
          {
           ItemBox[
            PaneBox[
             
             StyleBox["\<\"CalcFormCalculate[expr, opts] exports, executes \
FORM and imports its result. Options include Dimension, LoopMomenta, \
FORMExecutable, TimeConstraint, WorkingDirectory, KeepFiles, ShowTiming, \
ShowProgress and FORMThreads. Failed jobs are retained.\"\>", 
              "InformationUsageText",
              StripOnInput->False,
              LineSpacing->{1.5, 1.5, 3.}],
             FrameMargins->{{10, 10}, {8, 10}}],
            BaseStyle->"InformationUsageSubtitleBackground",
            StripOnInput->False], 
           ItemBox["\<\"\"\>",
            BaseStyle->"InformationUsageSubtitleBackground",
            StripOnInput->False]},
          {
           PaneBox[
            TagBox[GridBox[{
               {
                StyleBox[
                 TagBox[
                  TooltipBox[
                   StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                    StripOnInput->False],
                   "\"Definitions\"",
                   TooltipStyle->"TextStyling"],
                  Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                 StripOnInput->False]},
               {
                TemplateBox[{"\"\[ThinSpace]\"", 
                  GridBox[{{
                    RowBox[{
                    RowBox[{"CalcFormCalculate", "[", 
                    RowBox[{"CalcFormConverter`Private`expression_", ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"CalcFormConverter`Private`limit", "=", 
                    RowBox[{"OptionValue", "[", "TimeConstraint", "]"}]}], 
                    ",", 
                    RowBox[{"CalcFormConverter`Private`keep", "=", 
                    RowBox[{"OptionValue", "[", "KeepFiles", "]"}]}], ",", 
                    "CalcFormConverter`Private`check", ",", 
                    "CalcFormConverter`Private`directory", ",", 
                    "CalcFormConverter`Private`job", ",", 
                    "CalcFormConverter`Private`run", ",", 
                    "CalcFormConverter`Private`result", ",", 
                    
                    RowBox[{"CalcFormConverter`Private`stage", "=", 
                    "\"Check\""}], ",", 
                    "CalcFormConverter`Private`retainedFailure", ",", 
                    RowBox[{"CalcFormConverter`Private`timing", "=", 
                    RowBox[{"OptionValue", "[", "ShowTiming", "]"}]}], ",", 
                    RowBox[{"CalcFormConverter`Private`progress", "=", 
                    RowBox[{"OptionValue", "[", "ShowProgress", "]"}]}], ",", 
                    
                    RowBox[{"CalcFormConverter`Private`threads", "=", 
                    RowBox[{"OptionValue", "[", "FORMThreads", "]"}]}], ",", 
                    "CalcFormConverter`Private`announce"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"CalcFormConverter`Private`validTimeLimitQ", "[", 
                    "CalcFormConverter`Private`limit", "]"}]}], "||", 
                    RowBox[{"!", 
                    
                    RowBox[{"BooleanQ", "[", "CalcFormConverter`Private`keep",
                     "]"}]}]}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"CalcFormConverter`Private`runtimeFailure", "[", 
                    
                    RowBox[{"\"InvalidOption\"", ",", 
                    "\"Use a positive TimeConstraint or Infinity, and \
KeepFiles -> True or False.\""}], "]"}], "]"}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    
                    RowBox[{"BooleanQ", "[", 
                    "CalcFormConverter`Private`timing", "]"}]}], "||", 
                    RowBox[{"!", 
                    
                    RowBox[{"BooleanQ", "[", 
                    "CalcFormConverter`Private`progress", "]"}]}], "||", 
                    RowBox[{"!", 
                    
                    RowBox[{"CalcFormConverter`Private`validThreadsQ", "[", 
                    "CalcFormConverter`Private`threads", "]"}]}]}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"CalcFormConverter`Private`runtimeFailure", "[", 
                    
                    RowBox[{"\"InvalidOption\"", ",", 
                    "\"ShowTiming and ShowProgress must be True or False; \
FORMThreads must be a positive integer.\""}], "]"}], "]"}]}], "]"}], ";", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "CalcFormConverter`Private`name_", "]"}], ":=", 
                    RowBox[{"(", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`stage", "=", 
                    "CalcFormConverter`Private`name"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{"CalcFormConverter`Private`progress", ",", 
                    
                    RowBox[{"CalcFormConverter`Private`reportCalculation", 
                    "[", 
                    RowBox[{"Association", "[", 
                    
                    RowBox[{"\"Stage\"", "\[Rule]", 
                    "CalcFormConverter`Private`name"}], "]"}], "]"}]}], 
                    "]"}]}], ")"}]}], ";", 
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "\"Check\"", "]"}], ";", 
                    RowBox[{"CalcFormConverter`Private`check", "=", 
                    RowBox[{"CalcFormCheck", "[", 
                    RowBox[{
                    RowBox[{"FORMExecutable", "\[Rule]", 
                    RowBox[{"OptionValue", "[", "FORMExecutable", "]"}]}], 
                    ",", 
                    
                    RowBox[{"FORMThreads", "\[Rule]", 
                    "CalcFormConverter`Private`threads"}]}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"FailureQ", "[", 
                    "CalcFormConverter`Private`check", "]"}], ",", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "\"Failed\"", "]"}], ";", 
                    
                    RowBox[{"Return", "[", "CalcFormConverter`Private`check", 
                    "]"}]}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"TrueQ", "[", 
                    
                    RowBox[{"CalcFormConverter`Private`check", "[", 
                    "\"Available\"", "]"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{"CalcFormConverter`Private`progress", ",", 
                    
                    RowBox[{"CalcFormConverter`Private`reportCalculation", 
                    "[", 
                    RowBox[{"Association", "[", 
                    RowBox[{"\"Stage\"", "\[Rule]", "\"Failed\""}], "]"}], 
                    "]"}]}], "]"}], ";", 
                    RowBox[{"Return", "[", 
                    RowBox[{"CalcFormConverter`Private`runtimeFailure", "[", 
                    
                    RowBox[{"\"FORMUnavailable\"", ",", 
                    "\"FORM did not pass its availability check.\"", ",", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    
                    RowBox[{"\"Stage\"", "\[Rule]", 
                    "CalcFormConverter`Private`stage"}], ",", 
                    
                    RowBox[{"\"Check\"", "\[Rule]", 
                    "CalcFormConverter`Private`check"}]}], "]"}]}], "]"}], 
                    "]"}]}]}], "]"}], ";", 
                    RowBox[{"CalcFormConverter`Private`directory", "=", 
                    
                    RowBox[{"CalcFormConverter`Private`createJobDirectory", 
                    "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "WorkingDirectory", "]"}], 
                    ",", "\"calcform-job-\""}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"FailureQ", "[", 
                    "CalcFormConverter`Private`directory", "]"}], ",", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "\"Failed\"", "]"}], ";", 
                    
                    RowBox[{"Return", "[", 
                    "CalcFormConverter`Private`directory", "]"}]}]}], "]"}], 
                    ";", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`retainedFailure", "[", 
                    
                    
                    RowBox[{"CalcFormConverter`Private`tag_", ",", 
                    "CalcFormConverter`Private`message_", ",", 
                    RowBox[{"CalcFormConverter`Private`details_", ":", 
                    RowBox[{"Association", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"CalcFormConverter`Private`runtimeFailure", "[", 
                    
                    RowBox[{"CalcFormConverter`Private`tag", ",", 
                    "CalcFormConverter`Private`message", ",", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"Association", "[", 
                    RowBox[{
                    
                    RowBox[{"\"Stage\"", "\[Rule]", 
                    "CalcFormConverter`Private`stage"}], ",", 
                    
                    RowBox[{"\"JobDirectory\"", "\[Rule]", 
                    "CalcFormConverter`Private`directory"}], ",", 
                    RowBox[{"\"Executable\"", "\[Rule]", 
                    
                    RowBox[{"CalcFormConverter`Private`check", "[", 
                    "\"Executable\"", "]"}]}]}], "]"}], ",", 
                    "CalcFormConverter`Private`details"}], "]"}]}], "]"}]}], 
                    ";", 
                    RowBox[{"CalcFormConverter`Private`result", "=", 
                    RowBox[{"CheckAbort", "[", 
                    RowBox[{
                    RowBox[{"Catch", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "\"Export\"", "]"}], ";", 
                    RowBox[{"CalcFormConverter`Private`job", "=", 
                    RowBox[{"CalcFormExport", "[", 
                    RowBox[{"CalcFormConverter`Private`expression", ",", 
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"CalcFormConverter`Private`directory", ",", 
                    "\"job.frm\""}], "}"}], "]"}], ",", 
                    RowBox[{"Dimension", "\[Rule]", 
                    RowBox[{"OptionValue", "[", "Dimension", "]"}]}], ",", 
                    RowBox[{"LoopMomenta", "\[Rule]", 
                    RowBox[{"OptionValue", "[", "LoopMomenta", "]"}]}]}], 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"FailureQ", "[", "CalcFormConverter`Private`job", 
                    "]"}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`retainedFailure", "[", 
                    
                    RowBox[{"\"ExportFailed\"", ",", 
                    "\"FORM export failed; job files were retained.\"", ",", 
                    RowBox[{"Association", "[", 
                    
                    RowBox[{"\"Cause\"", "\[Rule]", 
                    "CalcFormConverter`Private`job"}], "]"}]}], "]"}], ",", 
                    "CalcFormConverter`Private`$failureTag"}], "]"}]}], "]"}],
                     ";", 
                    
                    RowBox[{"CalcFormConverter`Private`announce", "[", 
                    "\"Execute\"", "]"}], ";", 
                    RowBox[{"CalcFormConverter`Private`run", "=", 
                    RowBox[{"CalcFormConverter`Private`runtimeProcess", "[", 
                    RowBox[{
                    RowBox[{"CalcFormConverter`Private`formCommand", "[", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`check", "[", 
                    "\"Executable\"", "]"}], ",", 
                    
                    RowBox[{"CalcFormConverter`Private`job", "[", 
                    "\"InputFile\"", "]"}], ",", 
                    "CalcFormConverter`Private`threads"}], "]"}], ",", 
                    "CalcFormConverter`Private`directory", ",", 
                    "CalcFormConverter`Private`limit", ",", "True", ",", 
                    "CalcFormConverter`Private`progress"}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"CalcFormConverter`Private`timing", "&&", 
                    RowBox[{"NumberQ", "[", 
                    
                    RowBox[{"CalcFormConverter`Private`run", "[", 
                    "\"ElapsedSeconds\"", "]"}], "]"}]}], ",", 
                    
                    RowBox[{"CalcFormConverter`Private`reportCalculation", 
                    "[", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    RowBox[{"\"Stage\"", "\[Rule]", 
                    RowBox[{"\"execution finished (\"", "<>", 
                    
                    RowBox[{"CalcFormConverter`Private`run", "[", 
                    "\"Status\"", "]"}], "<>", "\")\""}]}], ",", 
                    RowBox[{"\"ElapsedSeconds\"", "\[Rule]", 
                    
                    RowBox[{"CalcFormConverter`Private`run", "[", 
                    "\"ElapsedSeconds\"", "]"}]}]}], "]"}], "]"}]}], "]"}], 
                    ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`run", "[", 
                    "\"Status\"", "]"}], "=!=", "\"Completed\""}], "||", 
                    RowBox[{
                    
                    RowBox[{"CalcFormConverter`Private`run", "[", 
                    "\"ExitCode\"", "]"}], "=!=", "0"}]}], ",", 
