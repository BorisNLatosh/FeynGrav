    RowBox[{"Momentum", "[", 
     RowBox[{
      RowBox[{"p1", "+", "p2"}], ",", "D"}], "]"}], "->", 
    RowBox[{"Momentum", "[", 
     RowBox[{
      RowBox[{"-", "k"}], ",", "D"}], "]"}]}]}], "//", "Factor"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Asymptotic", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"PaXEvaluateUVIRSplit", "[", 
       RowBox[{
        RowBox[{"\[ScriptCapitalV]IR", "[", 
         RowBox[{
         "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
         "]"}], "[", 
        RowBox[{"[", "6", "]"}], "]"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox["1", "EpsilonIR"], "->", "0"}], ",", 
        RowBox[{
         FractionBox["1", "EpsilonUV"], "->", "0"}]}], "}"}]}], ",", 
     RowBox[{
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{"k", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "->", "0"}]}], "]"}], "//", 
   "Simplify"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MomentumCombine", "[", "%", "]"}], "/.", 
   RowBox[{
    RowBox[{"Momentum", "[", 
     RowBox[{
      RowBox[{"p1", "+", "p2"}], ",", "D"}], "]"}], "->", 
    RowBox[{"Momentum", "[", 
     RowBox[{
      RowBox[{"-", "k"}], ",", "D"}], "]"}]}]}], "//", "Factor"}]}], "Input",
 CellChangeTimes->{{3.89468262161084*^9, 3.89468268527632*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"1609eb0e-763b-4ca8-991a-66399f404a41"],

Cell[TextData[StyleBox["The second term also does not contribute to the \
leading IR behaviour. Because of its sophisticated structure it is not easy \
to show.\nThe explicit expression for this term contains a part containing \
PolyLog.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.894682754876964*^9, 
  3.894682831374738*^9}},ExpressionUUID->"0a962d78-7619-4154-ae49-\
d54e64a81a25"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PaXEvaluateUVIRSplit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"\[ScriptCapitalV]IR", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
      "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], ",", 
    RowBox[{"PaXC0Expand", "->", "True"}]}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     FractionBox["1", "EpsilonIR"], "->", "0"}], ",", 
    RowBox[{
     FractionBox["1", "EpsilonUV"], "->", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.894678602481705*^9, 3.894678622723094*^9}, {
  3.894678961072933*^9, 3.894678971736601*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"d2b4f7ba-5c79-4742-96e6-7a771196539b"],

Cell[TextData[StyleBox["In the IR limit this structure approaches a finite \
value.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  3.894679749097231*^9, {3.894682840446804*^9, 
   3.894682853615286*^9}},ExpressionUUID->"31dedf7e-3e27-43c5-a61a-\
87747223e7c8"],

Cell[BoxData[{
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"1", "+", 
    RowBox[{
     FractionBox[
      SuperscriptBox["k", "2"], 
      RowBox[{"2", 
       SuperscriptBox["m", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"4", " ", 
           SuperscriptBox["m", "2"]}], 
          SuperscriptBox["k", "2"]]}]], "-", "1"}], ")"}]}]}], ",", 
   RowBox[{"k", "->", "0"}]}], "]"}], "\n", 
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"12", " ", 
     RowBox[{"PolyLog", "[", 
      RowBox[{"2", ",", "z"}], "]"}]}], "+", 
    RowBox[{"3", " ", 
     SuperscriptBox[
      RowBox[{"Log", "[", "z", "]"}], "2"]}], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["\[Pi]", "2"]}]}], ",", 
   RowBox[{"z", "->", "1"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.894678813358083*^9, 3.894678841270105*^9}, 
   3.894679754602618*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"de6fa764-b218-423d-b61e-358a4e46d46d"],

Cell[TextData[StyleBox["We replace this structure with the corresponding \
limit and obtain the corresponding explicit expression.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.89468224264266*^9, 3.894682261187134*^9}, {
  3.89468286571939*^9, 
  3.894682903896209*^9}},ExpressionUUID->"9f9cedee-72bc-4aac-a56c-\
f204d162864a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PaXEvaluateUVIRSplit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ScriptCapitalV]IR", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
       "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{"PaXC0Expand", "->", "True"}]}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", "EpsilonIR"], "->", "0"}], ",", 
     RowBox[{
      FractionBox["1", "EpsilonUV"], "->", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["\[Pi]", "2"]}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox[
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               SqrtBox[
                RowBox[{"1", "-", 
                 FractionBox[
                  RowBox[{"4", " ", 
                   SuperscriptBox["m", "2"]}], 
                  RowBox[{"Pair", "[", 
                   RowBox[{
                    RowBox[{"Momentum", "[", 
                    RowBox[{"k", ",", "D"}], "]"}], ",", 
                    RowBox[{"Momentum", "[", 
                    RowBox[{"k", ",", "D"}], "]"}]}], "]"}]]}]]}], ")"}], " ", 
             RowBox[{"Pair", "[", 
              RowBox[{
               RowBox[{"Momentum", "[", 
                RowBox[{"k", ",", "D"}], "]"}], ",", 
               RowBox[{"Momentum", "[", 
                RowBox[{"k", ",", "D"}], "]"}]}], "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox["m", "2"]}]]}], "]"}], "2"]}], "+", 
       RowBox[{"12", " ", 
        RowBox[{"PolyLog", "[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", 
               SqrtBox[
                RowBox[{"1", "-", 
                 FractionBox[
                  RowBox[{"4", " ", 
                   SuperscriptBox["m", "2"]}], 
                  RowBox[{"Pair", "[", 
                   RowBox[{
                    RowBox[{"Momentum", "[", 
                    RowBox[{"k", ",", "D"}], "]"}], ",", 
                    RowBox[{"Momentum", "[", 
                    RowBox[{"k", ",", "D"}], "]"}]}], "]"}]]}]]}], ")"}], " ", 
             RowBox[{"Pair", "[", 
              RowBox[{
               RowBox[{"Momentum", "[", 
                RowBox[{"k", ",", "D"}], "]"}], ",", 
               RowBox[{"Momentum", "[", 
                RowBox[{"k", ",", "D"}], "]"}]}], "]"}]}], 
            RowBox[{"2", " ", 
             SuperscriptBox["m", "2"]}]]}]}], "]"}]}]}], "->", 
      RowBox[{"6", " ", 
       SuperscriptBox["\[Pi]", "2"]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"m", ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{"k", ",", "D"}], "]"}], ",", 
       RowBox[{"Momentum", "[", 
        RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "<", "0"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MomentumCombine", "[", 
        RowBox[{"Asymptotic", "[", 
         RowBox[{"%", ",", 
          RowBox[{
           RowBox[{"Pair", "[", 
            RowBox[{
             RowBox[{"Momentum", "[", 
              RowBox[{"k", ",", "D"}], "]"}], ",", 
             RowBox[{"Momentum", "[", 
              RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "->", "0"}]}], "]"}], 
        "]"}], "/.", 
       RowBox[{
        RowBox[{"Momentum", "[", 
         RowBox[{
          RowBox[{"p1", "+", "p2"}], ",", "D"}], "]"}], "->", 
        RowBox[{"Momentum", "[", 
         RowBox[{
          RowBox[{"-", "k"}], ",", "D"}], "]"}]}]}], ")"}], "==", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "4"], " ", 
         SuperscriptBox["\[Kappa]", "3"], " ", 
         SuperscriptBox["m", "2"]}], "32"]}], "  ", 
      RowBox[{"Calc", "[", 
       RowBox[{
        SqrtBox[
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["m", "2"]}], 
          RowBox[{"SPD", "[", 
           RowBox[{"k", ",", "k"}], "]"}]}]], 
        FractionBox[
         RowBox[{
          RowBox[{"FVD", "[", 
           RowBox[{"k", ",", "\[Mu]"}], "]"}], 
          RowBox[{"FVD", "[", 
           RowBox[{"k", ",", "\[Nu]"}], "]"}]}], 
         RowBox[{"SPD", "[", 
          RowBox[{"k", ",", "k"}], "]"}]]}], "]"}]}]}], "//", "Simplify"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.894678868950844*^9, 3.894678923903698*^9}, {
  3.894678995353053*^9, 3.894679038417963*^9}, {3.894681999936013*^9, 
  3.894682229307199*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"4db0af34-a1c6-43ed-9234-96c342dcc2b4"],

Cell[TextData[{
 StyleBox["It full analogy with the other terms, this operator proportional \
to a projector operator. In a contrast it is multiplied on ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"-", 
     SuperscriptBox["k", "2"]}]], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"d932e64e-2c7f-4296-8c79-114e13537cbf"],
 StyleBox[" factor which vanishes in the IR limit.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.894921580182894*^9, 3.894921630271649*^9}, {
  3.894922121601198*^9, 
  3.894922122657365*^9}},ExpressionUUID->"33ca0003-9a5f-4cb0-9a5e-\
5b7eb4f1fa2d"],

Cell[TextData[StyleBox["The fifth term contains a log contribution which can \
contributes to the IR limit.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.894682915656297*^9, 3.894682978033565*^9}, {
  3.894683304072413*^9, 3.89468331848132*^9}, {3.894685035956727*^9, 
  3.894685047069191*^9}, {3.894685201368149*^9, 
  3.894685201760188*^9}},ExpressionUUID->"574e2b22-f7d0-4596-bf42-\
771e2573155f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Coefficient", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"PaXEvaluateUVIRSplit", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalV]IR", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "k", ",", "p1", ",", "p2", ",", "m"}], 
        "]"}], "[", 
       RowBox[{"[", "5", "]"}], "]"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", "EpsilonIR"], "->", "0"}], ",", 
       RowBox[{
        FractionBox["1", "EpsilonUV"], "->", "0"}]}], "}"}]}], ",", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["ScaleMu", "2"], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"Momentum", "[", 
          RowBox[{"k", ",", "D"}], "]"}], ",", 
         RowBox[{"Momentum", "[", 
          RowBox[{"k", ",", "D"}], "]"}]}], "]"}]]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"MomentumCombine", "[", 
       RowBox[{"Asymptotic", "[", 
        RowBox[{"%", ",", 
         RowBox[{
          RowBox[{"Pair", "[", 
           RowBox[{
            RowBox[{"Momentum", "[", 
             RowBox[{"k", ",", "D"}], "]"}], ",", 
            RowBox[{"Momentum", "[", 
             RowBox[{"k", ",", "D"}], "]"}]}], "]"}], "->", "0"}]}], "]"}], 
       "]"}], 
      RowBox[{"Log", "[", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["ScaleMu", "2"], 
         RowBox[{"Pair", "[", 
          RowBox[{
           RowBox[{"Momentum", "[", 
            RowBox[{"k", ",", "D"}], "]"}], ",", 
           RowBox[{"Momentum", "[", 
            RowBox[{"k", ",", "D"}], "]"}]}], "]"}]]}], "]"}]}], "/.", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"p1", "+", "p2"}], ",", "D"}], "]"}], "->", 
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"-", "k"}], ",", "D"}], "]"}]}]}], ")"}], "==", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["7", "32"]}], "\[ImaginaryI]", " ", 
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["\[Kappa]", "3"], " ", 
    SuperscriptBox["m", "2"], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"k", ",", "\[Mu]"}], "]"}], 
    RowBox[{"FVD", "[", 
     RowBox[{"k", ",", "\[Nu]"}], "]"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["ScaleMu", "2"], 
       RowBox[{"SPD", "[", 
        RowBox[{"k", ",", "k"}], "]"}]]}], "]"}]}]}], "//", 
  "Calc"}]}], "Input",
 CellChangeTimes->{{3.8946791318119926`*^9, 3.894679131931966*^9}, {
  3.894682336516755*^9, 3.8946824287594233`*^9}, {3.894682984322361*^9, 
  3.894682984546263*^9}, {3.894683285744487*^9, 3.894683412706698*^9}, {
  3.894684986805026*^9, 3.894685029085321*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"bc1969b2-2c33-4471-94c5-11653c6627bf"],

Cell[TextData[StyleBox["This is the only term that can potentially contribute \
to the IR limit because the log is non-analytic function.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.894921643930694*^9, 
  3.894921682968613*^9}},ExpressionUUID->"a9655bee-4a79-48cc-a0a1-\
28a0a622b475"],

Cell[TextData[{
 StyleBox["Therefore, the leading order contribution is",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["7", "32"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["\[Kappa]", "3"], " ", 
    SuperscriptBox["m", "2"], " ", 
    SuperscriptBox["k", 
     RowBox[{"2", " "}]], 
    RowBox[{"Log", "[", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["k", "2"], 
       SuperscriptBox["\[Mu]", "2"]]}], "]"}], "  ", 
    FractionBox[
     RowBox[{
      SubscriptBox["k", "\[Mu]"], 
      SubscriptBox["k", "\[Nu]"]}], 
     SuperscriptBox["k", "2"]]}], TraditionalForm]],
  FontSize->36,ExpressionUUID->"4db53af3-4498-4e49-a7b2-d4fcebca7464"],
 "\n",
 StyleBox["As it is explained in [arXiv:2311.01756] the corresponding \
expression in the coordinate representation is calculated with the \
Sin-Fourier transformation:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.894921729569639*^9, 3.89492183004354*^9}, {
  3.89492199128067*^9, 3.894922046951676*^9}, {3.9244681250617943`*^9, 
  3.924468125651843*^9}},ExpressionUUID->"3458ac31-5e17-4bc2-9b1f-\
d1136b32e2c7"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"2", " ", 
    SuperscriptBox["\[Pi]", "2"]}]], 
  FractionBox["1", "r"], 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], 
  RowBox[{"FourierSinTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["7", "32"]}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", 
     SuperscriptBox["\[Kappa]", "3"], " ", 
     SuperscriptBox["m", "2"], " ", 
     SuperscriptBox["k", "2"], 
     RowBox[{"Log", "[", 
      SuperscriptBox["k", "2"], "]"}], " ", "k"}], ",", "k", ",", "r"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.894921876656391*^9, 3.89492193335777*^9}, {
  3.894921971830989*^9, 3.894921981382826*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"aaed3998-b394-4ac5-9a1f-ce3272f20812"],

Cell[TextData[{
 StyleBox["Therefore, the corresponding leading IR contribution reads:",
  FontWeight->"Bold"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", " ", 
     FractionBox["21", "16"]}], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[Kappa]", "3"], " ", 
    SuperscriptBox["m", "2"], " ", 
    FractionBox["1", 
     SuperscriptBox["r", "5"]], " ", 
    SubscriptBox["\[Omega]", "\[Mu]\[Nu]"]}], TraditionalForm]],
  FontSize->24,
  FontWeight->"Bold",ExpressionUUID->"15faadf7-e78b-4466-b57f-182da3ecf658"]
}], "Text",
 CellChangeTimes->{{3.894922050303688*^9, 
  3.894922093027532*^9}},ExpressionUUID->"1a9552c2-e8c3-455e-a439-\
4864045268f3"]
},
