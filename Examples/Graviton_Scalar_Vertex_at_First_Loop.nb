Cell["3.1. Symmetry of the graviton indices", "Subsection",ExpressionUUID->"5d9e8820-a081-4710-af83-062c8161107e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"checks", "[", "\"\<Graviton index symmetry\>\"", "]"}], " ", "=", 
