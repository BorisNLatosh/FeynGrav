Cell[CellGroupData[{

Cell["3.4. Off-shell infrared poles", "Subsection",ExpressionUUID->"8085b1f1-374b-49b6-ac43-b666c66cd5a6"],

Cell[TextData[{
 "Test the generic off-shell massive vertex for IR poles. This statement is \
separate from the on-shell small-momentum expansion in Section 4; absence of \
a dimensional-regularization pole does not imply analyticity at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["k", "2"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7b9d82ef-13f8-401f-a3da-ca13414a371a"],
 "."
}], "Text",ExpressionUUID->"11b00717-38e8-4d03-af27-466da9bde08a"],

