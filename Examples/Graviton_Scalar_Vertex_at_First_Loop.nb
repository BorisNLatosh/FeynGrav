       DirectedInfinity[1], CalcFormConverter`WorkingDirectory -> Automatic, 
       CalcFormConverter`KeepFiles -> False, CalcFormConverter`ShowTiming -> 
       False, CalcFormConverter`ShowProgress -> False, 
       CalcFormConverter`FORMThreads -> 1}, "Attributes" -> {}, "FullName" -> 
