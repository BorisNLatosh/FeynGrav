   InformationData[<|
    "ObjectType" -> "Symbol", "Usage" -> 
     "CalcFormCalculate[expr, opts] exports, executes FORM and imports its \
result. Options include Dimension, LoopMomenta, FORMExecutable, \
TimeConstraint, WorkingDirectory, KeepFiles, ShowTiming, ShowProgress and \
FORMThreads. Failed jobs are retained.", "Documentation" -> None, "OwnValues" -> 
     None, "UpValues" -> None, "DownValues" -> 
     Information`InformationValueForm[
      DownValues, CalcFormConverter`CalcFormCalculate, {
       CalcFormConverter`CalcFormCalculate[
          Pattern[CalcFormConverter`Private`expression, 
           Blank[]], 
          OptionsPattern[]] :> 
        Module[{CalcFormConverter`Private`limit = OptionValue[TimeConstraint],
            CalcFormConverter`Private`keep = 
           OptionValue[CalcFormConverter`KeepFiles], 
           CalcFormConverter`Private`check, 
           CalcFormConverter`Private`directory, CalcFormConverter`Private`job,
            CalcFormConverter`Private`run, CalcFormConverter`Private`result, 
           CalcFormConverter`Private`stage = "Check", 
           CalcFormConverter`Private`retainedFailure, 
           CalcFormConverter`Private`timing = 
           OptionValue[CalcFormConverter`ShowTiming], 
           CalcFormConverter`Private`progress = 
           OptionValue[CalcFormConverter`ShowProgress], 
           CalcFormConverter`Private`threads = 
           OptionValue[CalcFormConverter`FORMThreads], 
           CalcFormConverter`Private`announce}, If[
            Or[
             Not[
              CalcFormConverter`Private`validTimeLimitQ[
              CalcFormConverter`Private`limit]], 
             Not[
              BooleanQ[CalcFormConverter`Private`keep]]], 
            Return[
             CalcFormConverter`Private`runtimeFailure[
             "InvalidOption", 
              "Use a positive TimeConstraint or Infinity, and KeepFiles -> \
True or False."]]]; If[
            Or[
             Not[
              BooleanQ[CalcFormConverter`Private`timing]], 
             Not[
              BooleanQ[CalcFormConverter`Private`progress]], 
             Not[
              CalcFormConverter`Private`validThreadsQ[
              CalcFormConverter`Private`threads]]], 
            Return[
             CalcFormConverter`Private`runtimeFailure[
             "InvalidOption", 
              "ShowTiming and ShowProgress must be True or False; FORMThreads \
must be a positive integer."]]]; CalcFormConverter`Private`announce[
             Pattern[CalcFormConverter`Private`name, 
              Blank[]]] := (
            CalcFormConverter`Private`stage = CalcFormConverter`Private`name; 
            If[CalcFormConverter`Private`progress, 
              
              CalcFormConverter`Private`reportCalculation[<|
               "Stage" -> CalcFormConverter`Private`name|>]]); 
          CalcFormConverter`Private`announce["Check"]; 
          CalcFormConverter`Private`check = 
           CalcFormConverter`CalcFormCheck[
            CalcFormConverter`FORMExecutable -> 
             OptionValue[CalcFormConverter`FORMExecutable], 
             CalcFormConverter`FORMThreads -> 
             CalcFormConverter`Private`threads]; If[
            FailureQ[CalcFormConverter`Private`check], 
            CalcFormConverter`Private`announce["Failed"]; 
            Return[CalcFormConverter`Private`check]]; If[
            Not[
             TrueQ[
              CalcFormConverter`Private`check["Available"]]], 
            If[CalcFormConverter`Private`progress, 
              
              CalcFormConverter`Private`reportCalculation[<|
               "Stage" -> "Failed"|>]]; Return[
              CalcFormConverter`Private`runtimeFailure[
              "FORMUnavailable", 
               "FORM did not pass its availability check.", <|
               "Stage" -> CalcFormConverter`Private`stage, "Check" -> 
                CalcFormConverter`Private`check|>]]]; 
          CalcFormConverter`Private`directory = 
           CalcFormConverter`Private`createJobDirectory[
             OptionValue[CalcFormConverter`WorkingDirectory], 
             "calcform-job-"]; If[
            FailureQ[CalcFormConverter`Private`directory], 
            CalcFormConverter`Private`announce["Failed"]; 
            Return[CalcFormConverter`Private`directory]]; 
          CalcFormConverter`Private`retainedFailure[
             Pattern[CalcFormConverter`Private`tag, 
              Blank[]], 
             Pattern[CalcFormConverter`Private`message, 
              Blank[]], 
             Optional[
              Pattern[CalcFormConverter`Private`details, 
               Blank[]], <||>]] := 
           CalcFormConverter`Private`runtimeFailure[
            CalcFormConverter`Private`tag, CalcFormConverter`Private`message, 
             
             
             Join[<|"Stage" -> CalcFormConverter`Private`stage, 
               "JobDirectory" -> CalcFormConverter`Private`directory, 
               "Executable" -> 
               CalcFormConverter`Private`check["Executable"]|>, 
              CalcFormConverter`Private`details]]; 
          CalcFormConverter`Private`result = CheckAbort[
             Catch[
             CalcFormConverter`Private`announce["Export"]; 
              CalcFormConverter`Private`job = 
               CalcFormConverter`CalcFormExport[
                CalcFormConverter`Private`expression, 
                 
                 FileNameJoin[{
                  CalcFormConverter`Private`directory, "job.frm"}], 
                 FeynCalc`Dimension -> OptionValue[FeynCalc`Dimension], 
                 FeynCalc`LoopMomenta -> OptionValue[FeynCalc`LoopMomenta]]; 
              If[
                FailureQ[CalcFormConverter`Private`job], 
                Throw[
                 CalcFormConverter`Private`retainedFailure[
                 "ExportFailed", 
                  "FORM export failed; job files were retained.", <|
                  "Cause" -> CalcFormConverter`Private`job|>], 
                 CalcFormConverter`Private`$failureTag]]; 
              CalcFormConverter`Private`announce["Execute"]; 
              CalcFormConverter`Private`run = 
               CalcFormConverter`Private`runtimeProcess[
                 CalcFormConverter`Private`formCommand[
                  CalcFormConverter`Private`check["Executable"], 
                  CalcFormConverter`Private`job["InputFile"], 
                  CalcFormConverter`Private`threads], 
                 CalcFormConverter`Private`directory, 
                 CalcFormConverter`Private`limit, True, 
                 CalcFormConverter`Private`progress]; If[
                And[CalcFormConverter`Private`timing, 
                 NumberQ[
                  CalcFormConverter`Private`run["ElapsedSeconds"]]], 
                
                CalcFormConverter`Private`reportCalculation[<|
                 "Stage" -> 
                  "execution finished (" <> 
                   CalcFormConverter`Private`run["Status"] <> ")", 
                  "ElapsedSeconds" -> 
                  CalcFormConverter`Private`run["ElapsedSeconds"]|>]]; If[
                Or[
                CalcFormConverter`Private`run["Status"] =!= "Completed", 
                 CalcFormConverter`Private`run["ExitCode"] =!= 0], 
                Throw[
                 CalcFormConverter`Private`retainedFailure[
                  If[
                  CalcFormConverter`Private`run["Status"] === "Completed", 
                   "FORMFailed", 
                   CalcFormConverter`Private`run["Status"]], 
                  "FORM execution did not complete successfully; job files \
were retained.", <|"Process" -> CalcFormConverter`Private`run|>], 
                 CalcFormConverter`Private`$failureTag]]; 
              CalcFormConverter`Private`announce["Import"]; If[
                Not[
                 FileExistsQ[
                  CalcFormConverter`Private`job["ResultFile"]]], 
                Throw[
                 CalcFormConverter`Private`retainedFailure[
                 "MissingResult", "FORM did not produce its result file.", <|
                  "Process" -> CalcFormConverter`Private`run|>], 
                 CalcFormConverter`Private`$failureTag]]; 
              CalcFormConverter`Private`result = 
               CalcFormConverter`CalcFormImport[
                 CalcFormConverter`Private`job["ResultFile"], 
                 CalcFormConverter`Private`job["MappingFile"]]; If[
                FailureQ[CalcFormConverter`Private`result], 
                CalcFormConverter`Private`retainedFailure[
                "ImportFailed", 
                 "The FORM result could not be imported; job files were \
retained.", <|"Cause" -> CalcFormConverter`Private`result, "Process" -> 
                  CalcFormConverter`Private`run|>], 
                CalcFormConverter`Private`result], 
              CalcFormConverter`Private`$failureTag], 
             CalcFormConverter`Private`retainedFailure[
             "Aborted", "Calculation aborted; job files were retained."]]; 
          If[CalcFormConverter`Private`progress, 
            CalcFormConverter`Private`reportCalculation[<|"Stage" -> If[
                FailureQ[CalcFormConverter`Private`result], "Failed", 
                "Complete"]|>]]; If[
            Not[
             FailureQ[CalcFormConverter`Private`result]], 
            AbortProtect[
             If[
              Or[CalcFormConverter`Private`keep, 
               Not[
                CalcFormConverter`Private`removeJobDirectory[
                CalcFormConverter`Private`directory]]], 
              Message[
               MessageName[CalcFormConverter`CalcFormCalculate, "files"], 
               CalcFormConverter`Private`directory]]]]; 
          CalcFormConverter`Private`result], 
        CalcFormConverter`CalcFormCalculate[
          BlankNullSequence[]] :> 
        CalcFormConverter`Private`runtimeFailure[
         "InvalidArguments", "Use CalcFormCalculate[expression, options]."]}],
      "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
     "FormatValues" -> None, 
     "Options" -> {
      FeynCalc`Dimension -> Automatic, FeynCalc`LoopMomenta -> {}, 
