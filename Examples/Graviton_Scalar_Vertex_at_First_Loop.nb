Cell[CellGroupData[{

Cell["2.4. V4 and its scalar-leg exchange", "Subsection",ExpressionUUID->"c0d5f212-4af8-40cc-8d5c-683eeffba121"],

Cell["\<\
Seed routing: graviton l and scalar p2 \[Minus] l. Add the exchanged seed \
exactly once after reduction.\
\>", "Text",ExpressionUUID->"73cc63f5-5a9d-487f-8ce7-8901f6f1a28a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV4", " ", "=", " ", 
   RowBox[{
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "p2", ",", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p2", " ", "-", " ", "l"}], ")"}]}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "i", ",", " ", "j", ",", " ", "a", ",", " ", "b", ",", " ", "l"}], "]"}],
     "*", 
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", " ", "\[Nu]", ",", " ", "i", ",", " ", "j"}], 
       "}"}], ",", " ", "p1", ",", " ", 
      RowBox[{"p2", " ", "-", " ", "l"}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"ScalarPropagator", "[", 
     RowBox[{
      RowBox[{"p2", " ", "-", " ", "l"}], ",", " ", "m"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"b9979f9f-814e-4dbb-a332-bfa283df7398"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"contractedV4", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V4: FORM\>\"", ",", " ", 
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{"integrandV4", ",", " ", 
       RowBox[{"LoopMomenta", " ", "->", " ", 
        RowBox[{"{", "l", "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reducedV4", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V4: TID\>\"", ",", " ", 
     RowBox[{"TID", "[", 
      RowBox[{"contractedV4", ",", " ", "l", ",", " ", 
       RowBox[{"ToPaVe", " ", "->", " ", "True"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"6b1fdc52-6fe7-4faf-a02d-02577fe38778"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exchangedV4", " ", "=", " ", 
   RowBox[{"reducedV4", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p1", " ", "->", " ", "p2"}], ",", " ", 
      RowBox[{"p2", " ", "->", " ", "p1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"symmetricV4", " ", "=", " ", 
   RowBox[{"reducedV4", " ", "+", " ", "exchangedV4"}]}], ";"}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"829581cf-00d8-4622-8eac-8990c56d5933"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"invariantV4", " ", "=", " ", 
   RowBox[{"symmetricV4", " ", "/.", " ", "invariantRules"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
