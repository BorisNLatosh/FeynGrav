    RowBox[{"TrueQ", "[", "exportResult", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"vertexOutputFile", " ", "=", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", 
         " ", "\"\<VertexGamma.wl\>\""}], "}"}], "]"}]}], ";", " ", 
     RowBox[{"Put", "[", 
      RowBox[{"offShellVertex", ",", " ", "vertexOutputFile"}], "]"}], ";", 
     " ", "vertexOutputFile"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"9a00aa0d-1680-449e-9733-767e9fe34637"],

Cell["\<\
The corresponding publications contain misprints in the UV-divergent term and \
infrared coefficients. Use the expressions displayed here with the \
normalization in Section 1 and the coefficientwise expansion specified in \
Section 4. The checks above verify the stated identities; they do not \
establish completeness of the infrared tensor expansion.\
\>", "Text",ExpressionUUID->"bf74081b-4603-47ea-90f1-5fe7dadb3629"]
}, Open  ]]
}, Open  ]]
},
