Cell[TextData[StyleBox["The first term does not contribute to the leading IR \
behavior because it become independent from the graviton momentum.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.894679223813419*^9, 3.8946792586700897`*^9}, {
  3.894682544401271*^9, 
