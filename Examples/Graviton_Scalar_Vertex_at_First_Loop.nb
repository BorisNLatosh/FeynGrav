Notebook[{

Cell[CellGroupData[{
Cell["One-loop scalar\[Dash]graviton vertex", "Title",ExpressionUUID->"11db28ee-7bcc-4270-89f3-7ad47c16d2d2"],

Cell["\<\
FORM contraction, tensor reduction, consistency checks and infrared analysis\
\>", "Subtitle",ExpressionUUID->"06b8fe42-f6f0-4b86-90a7-45f4e18bee47"],

Cell["\<\
This example computes the four contributions below to the \
scalar\[Dash]graviton vertex in Einstein gravity. It first constructs the \
off-shell vertex in scalar Passarino\[Dash]Veltman integrals, then checks its \
symmetries and ultraviolet pole. Finally it places the scalar legs on shell \
and examines the spacelike small-momentum limit. The diagram weights are \
those of the original example; this notebook does not derive their \
combinatorics.\
\>", "Text",ExpressionUUID->"aa98b351-8dfa-4c7c-9074-1c0beac4689f"],

Cell[CellGroupData[{

Cell["1. Setup and conventions", "Section",ExpressionUUID->"036d3283-ec42-40f9-be91-ee9c4ec01cb4"],

Cell["\<\
Start with a fresh kernel and evaluate the notebook from top to bottom. \
FeynGrav supplies vertices and propagators; FeynCalc performs tensor-integral \
reduction; FeynHelpers connects to Package-X for explicit scalar integrals \
and pole extraction. CalcFormConverter sends algebra and Lorentz contractions \
to FORM. FORM does not perform the loop integration. All packages and FORM \
must already be installed. CalcFormCalculate checks FORM availability \
automatically.\
\>", "Text",ExpressionUUID->"7c33c97a-a889-43d9-b766-b6d66431a139"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$LoadAddOns", " ", "=", " ", 
   RowBox[{"{", "\"\<FeynHelpers\>\"", "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"<<", "\"\<FeynGrav`\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{4.000096480993659*^9, 4.000096482638112*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"34d9fae9-7813-4562-85aa-9ecadc92525e"],

Cell["\<\
The scalar momenta p1 and p2 are incoming. The incoming graviton momentum is \
k = \[Minus]p1 \[Minus]p2; l is the loop momentum. The free graviton indices \
are \[Mu] and \[Nu]. Tensor algebra remains D-dimensional. The scalar mass is \
m and the gravitational coupling is \[Kappa]. The calculation uses FeynGrav\
\[CloseCurlyQuote]s default GaugeFixingEpsilon = 2. Factors of i and \[Kappa] \
are supplied by the library rules; no extra loop measure, symmetry factor or \
normalisation is introduced by FORM.\
\>", "Text",ExpressionUUID->"3498190c-a401-4efc-bf4a-45c330f2a939"],

Cell["\<\
The metric signature is (+, \[Minus], \[Minus], \[Minus]). The reported \
vertex is the amputated sum of the displayed Feynman-rule products, with \
their factors of i retained; it is not a separately normalized scattering \
matrix element.\
\>", "Text",ExpressionUUID->"13e86504-902a-461c-b7d0-84ae6c954b73"],

Cell["\<\
TID uses the FeynCalc convention in which a scalar loop integral becomes i \
\[Pi]\.b2 times its PaVe function. PaXImplicitPrefactor has its default value \
1: no factor (2\[Pi])^(\[Minus]D) is included here. The Package-X interface \
expands at D = 4 \[Minus] 2\[CurlyEpsilon]; EpsilonUV and EpsilonIR label the \
separated poles in that convention. These normalisations must be accounted \
for before comparing with a loop measure d^D l/(2\[Pi])^D.\
\>", "Text",ExpressionUUID->"18d1ae49-28df-4fb5-ac52-4f96d5e7379d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"masterIntegrals", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A0", "[", "__", "]"}], ",", " ", 
     RowBox[{"B0", "[", "__", "]"}], ",", " ", 
     RowBox[{"C0", "[", "__", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorBasis", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MTD", "[", 
       RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Nu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Nu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Mu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Nu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Nu]"}], "]"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invariantRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FCI", "[", 
      RowBox[{"SPD", "[", 
       RowBox[{"p1", ",", " ", "p2"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SPD", "[", 
          RowBox[{"k", ",", " ", "k"}], "]"}], " ", "-", " ", 
         RowBox[{"SPD", "[", 
          RowBox[{"p1", ",", " ", "p1"}], "]"}], " ", "-", " ", 
         RowBox[{"SPD", "[", 
          RowBox[{"p2", ",", " ", "p2"}], "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"onShellRules", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"p1", ",", " ", "p1"}], "]"}], " ", "->", " ", 
       RowBox[{"m", "^", "2"}]}], ",", " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"p2", ",", " ", "p2"}], "]"}], " ", "->", " ", 
       RowBox[{"m", "^", "2"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"collectVertex", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{"expr", ",", " ", "masterIntegrals", ",", " ", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", " ", "tensorBasis", ",", " ", "Simplify"}], "]"}], 
      " ", "&"}]}], " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stageTimings", " ", "=", " ", 
   RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"timed", ",", " ", "HoldRest"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"timed", "[", 
    RowBox[{"label_", ",", " ", "expr_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"measurement", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "expr", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"stageTimings", ",", " ", 
        RowBox[{"label", " ", "->", " ", 
         RowBox[{"First", "[", "measurement", "]"}]}]}], "]"}], ";", " ", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"Last", "[", "measurement", "]"}], ",", " ", 
           RowBox[{
           "_Failure", " ", "|", " ", "$Failed", " ", "|", " ", 
            "$Aborted"}]}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"label", ",", " ", "\"\<: \>\"", ",", " ", 
           RowBox[{"Last", "[", "measurement", "]"}]}], "]"}], ";", " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", " ", 
      RowBox[{"Last", "[", "measurement", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkStatus", "[", "value_", "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", " ", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"value", ",", " ", 
        RowBox[{
        "_Failure", " ", "|", " ", "$Failed", " ", "|", " ", "$Aborted"}]}], 
       "]"}]}], ",", " ", "\"\<Failure\>\"", ",", " ", 
     RowBox[{"TrueQ", "[", "value", "]"}], ",", " ", "\"\<Passed\>\"", ",", 
     " ", 
     RowBox[{"value", " ", "===", " ", "False"}], ",", " ", "\"\<Failed\>\"", 
     ",", " ", "True", ",", " ", "\"\<Unresolved\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Association", "[", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"dc2f20e0-762e-49aa-ae3a-f6c0a99e332d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Diagram contributions", "Section",ExpressionUUID->"0092eea1-25ae-47b7-af90-526beb368680"],

Cell["\<\
Each subsection retains the integrand, contracts it with FORM, reduces it \
with TID, substitutes the momentum-conservation invariant, and collects \
coefficients. The intermediate expressions are saved under descriptive names \
and suppressed in the output. LoopMomenta \[RightArrow] {l} records the \
integration momentum for conversion; TID performs the actual reduction.\
\>", "Text",ExpressionUUID->"fd0dd8c6-2d38-4705-956c-39501e5f81f7"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Contribution\>\"", ",", " ", "\"\<Internal lines\>\"", ",",
        " ", "\"\<Weight in this example\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<V1\>\"", ",", " ", "\"\<one scalar, two gravitons\>\"", ",",
        " ", "\"\<1\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<V2\>\"", ",", " ", "\"\<two scalars, one graviton\>\"", ",",
        " ", "\"\<1\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<V3\>\"", ",", 
       " ", "\"\<two gravitons; scalar contact vertex\>\"", ",", 
       " ", "\"\<1\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<V4\>\"", ",", 
       " ", "\"\<one scalar, one graviton; mixed contact vertex\>\"", ",", 
       " ", "\"\<seed + (p1 \[LeftRightArrow] p2)\>\""}], "}"}]}], "}"}], ",",
    " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"ItemSize", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic"}], "}"}]}]}], "]"}]], "Input",\

 CellLabel->"In[13]:=",ExpressionUUID->"44bf1c26-d84d-4530-9663-fe420b549d47"],

Cell[CellGroupData[{

Cell["2.1. V1", "Subsection",ExpressionUUID->"7ea8e5ba-dbb5-40f5-9b2f-1c3dc894be59"],

Cell["Loop routing: scalar l; gravitons p1 \[Minus] l and p2 + l.", "Text",ExpressionUUID->"61485bde-b7a0-4030-a845-272d0a5cad30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV1", " ", "=", " ", 
   RowBox[{
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a2", ",", " ", "b2"}], "}"}], ",", " ", "p1", ",", " ", 
      RowBox[{"-", "l"}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"ScalarPropagator", "[", 
     RowBox[{"l", ",", " ", "m"}], "]"}], "*", 
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m2", ",", " ", "n2"}], "}"}], ",", " ", "l", ",", " ", "p2", ",",
       " ", "m"}], "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{"m1", ",", " ", "n1", ",", " ", "m2", ",", " ", "n2", ",", " ", 
      RowBox[{"p2", " ", "+", " ", "l"}]}], "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{"a1", ",", " ", "b1", ",", " ", "a2", ",", " ", "b2", ",", " ", 
      RowBox[{"p1", " ", "-", " ", "l"}]}], "]"}], "*", 
    RowBox[{"GravitonVertex", "[", 
     RowBox[{"\[Mu]", ",", " ", "\[Nu]", ",", " ", 
      RowBox[{
       RowBox[{"-", "p1"}], " ", "-", " ", "p2"}], ",", " ", "a1", ",", " ", 
      "b1", ",", " ", 
      RowBox[{"p1", " ", "-", " ", "l"}], ",", " ", "m1", ",", " ", "n1", ",",
       " ", 
      RowBox[{"p2", " ", "+", " ", "l"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ed047060-635c-40a2-80cf-9eaa9396e629"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"contractedV1", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: FORM\>\"", ",", " ", 
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{"integrandV1", ",", " ", 
       RowBox[{"LoopMomenta", " ", "->", " ", 
        RowBox[{"{", "l", "}"}]}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reducedV1", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: TID\>\"", ",", " ", 
     RowBox[{"TID", "[", 
      RowBox[{"contractedV1", ",", " ", "l", ",", " ", 
       RowBox[{"ToPaVe", " ", "->", " ", "True"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"512c2fe0-d2d2-49f6-8f50-2dc2aebd8ade"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"invariantV1", " ", "=", " ", 
   RowBox[{"reducedV1", " ", "/.", " ", "invariantRules"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]1", "[", 
    RowBox[{
    "\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "k_", ",", " ", "p1_", ",", " ", 
     "p2_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: collect\>\"", ",", " ", 
     RowBox[{"collectVertex", "[", "invariantV1", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"02179c11-3aa5-490d-9468-d94a4b8d4566"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. V2", "Subsection",ExpressionUUID->"4070f178-431c-4661-b9eb-36eb184c43c0"],

Cell["Loop routing: graviton l; scalars p1 \[Minus] l and p2 + l.", "Text",ExpressionUUID->"23acdc8b-f9f5-402f-a3db-059d529531ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV2", " ", "=", " ", 
   RowBox[{
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "p1", ",", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p1", " ", "-", " ", "l"}], ")"}]}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "a", ",", " ", "b", ",", " ", "i", ",", " ", "j", ",", " ", "l"}], "]"}],
     "*", 
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", "p2", ",", " ", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p2", " ", "+", " ", "l"}], ")"}]}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"ScalarPropagator", "[", 
     RowBox[{
      RowBox[{"p2", " ", "+", " ", "l"}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"ScalarPropagator", "[", 
     RowBox[{
      RowBox[{"p1", " ", "-", " ", "l"}], ",", " ", "m"}], "]"}], "*", 
    RowBox[{"GravitonScalarVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "}"}], ",", " ", 
      RowBox[{"p1", " ", "-", " ", "l"}], ",", " ", 
      RowBox[{"p2", " ", "+", " ", "l"}], ",", " ", "m"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"eb47f715-0c96-4979-9d05-35f85fd430c5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"contractedV2", " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V2: FORM\>\"", ",", " ", 
