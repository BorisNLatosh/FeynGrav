        "\[Mu]", ",", " ", "\[Nu]", ",", " ", "k", ",", " ", "p1", ",", " ", 
         "p2", ",", " ", "m"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"offShellVertex", " ", "=", " ", 
   RowBox[{"\[ScriptCapitalV]", "[", 
    RowBox[{
    "\[Mu]", ",", " ", "\[Nu]", ",", " ", "k", ",", " ", "p1", ",", " ", "p2",
      ",", " ", "m"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"af65058a-eeea-47c3-9142-5f6e3e96ee5b"]
