Cell[CellGroupData[{

Cell["2.5. Complete off-shell vertex", "Subsection",ExpressionUUID->"44e58124-a8f3-404f-b8c8-dbebbb99321f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]", "[", 
    RowBox[{
    "\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "k_", ",", " ", "p1_", ",", " ", 
     "p2_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<Total: collect\>\"", ",", " ", 
