Cell[CellGroupData[{

Cell["3. Consistency checks and poles", "Section",ExpressionUUID->"bcabc154-a585-4adb-aff7-f8fc74c6ec16"],

Cell[CellGroupData[{

Cell["3.1. Symmetry of the graviton indices", "Subsection",ExpressionUUID->"5d9e8820-a081-4710-af83-062c8161107e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"checks", "[", "\"\<Graviton index symmetry\>\"", "]"}], " ", "=", 
  " ", 
  RowBox[{"timed", "[", 
   RowBox[{"\"\<Check: graviton indices\>\"", ",", " ", 
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{"offShellVertex", " ", "==", " ", 
      RowBox[{"\[ScriptCapitalV]", "[", 
       RowBox[{
       "\[Nu]", ",", " ", "\[Mu]", ",", " ", "k", ",", " ", "p1", ",", " ", 
