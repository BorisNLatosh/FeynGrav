 CellLabel->
  "In[101]:=",ExpressionUUID->"1eb4a85e-fec5-4ac7-967a-ac545fc1b160"],

Cell[BoxData[
 FormBox[
  TemplateBox[{
   "\"Latosh and Park, arXiv:2311.01756, Appendix B\"", 
