       "\[Mu]", ",", " ", "\[Nu]", ",", " ", "k", ",", " ", "p2", ",", " ", 
        "p1", ",", " ", "m"}], "]"}], " ", "/.", " ", 
      "triangleExchangeRules"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
