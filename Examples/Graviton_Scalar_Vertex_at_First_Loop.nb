         RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", 
         RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], " ", "->", " ", 
       RowBox[{"C0", "[", 
