Cell[CellGroupData[{

Cell["5. Massless vector", "Section",
 Editable->False,ExpressionUUID->"10a64f7e-3819-4d68-97c0-1da14ce2e40f"],

Cell["\<\
The external matter legs are amputated. The internal graviton and matter \
propagators are shown explicitly in each bubble integrand.\
\>", "Text",
 Editable->False,ExpressionUUID->"ca0234f8-ee33-4f9b-9e69-53163dff0fbe"],

Cell[CellGroupData[{

Cell["Tadpole", "Subsection",
 Editable->False,ExpressionUUID->"a3d0e403-690c-482b-81a3-3fef821cad2c"],

Cell["\<\
Close the two graviton legs of the contact vertex with a massless graviton \
propagator. The resulting integral is scaleless in dimensional \
regularisation. Declare LoopMomenta -> {k} explicitly so polynomial terms \
left by propagator cancellation are still treated as integrands. The \
following check should return True.\
\>", "Text",
 Editable->False,ExpressionUUID->"91787ca9-f724-4ca2-9020-1c3d1ec94030"],

Cell[BoxData[
 RowBox[{"vectorTadpoleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonVectorVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Sigma]", ",", 
       RowBox[{"-", "k"}], ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], "}"}],
      ",", "\[Mu]", ",", "p", ",", "\[Nu]", ",", 
     RowBox[{"-", "p"}]}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
    "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[25]:=",ExpressionUUID->"c72e144a-8b89-41d8-9fbe-e3f8112f7f92"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorPolarizationOperator1", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_"}], "]"}], "=", 
   RowBox[{"FeynGravSimplify", "[", 
    RowBox[{"vectorTadpoleIntegrand", ",", 
     RowBox[{"LoopMomenta", "->", 
      RowBox[{"{", "k", "}"}]}], ",", 
     RowBox[{"DropScaleless", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100465081532*^9, 4.0001005050623302`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"e71e5702-e25a-4f59-8360-4ec9140ad2f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VectorPolarizationOperator1", "[", "\[Mu]", ",", "\[Nu]", ",", "p", 
  "]", " ", "==", " ", "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[27]:=",ExpressionUUID->"ce6b862e-f1dc-472b-b50f-8596a6511a04"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653205497015*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"3e939fe8-50a8-48de-9ef0-009156734daa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"9970f609-6278-4ea9-b25b-35f09fc92fbf"],

Cell["\<\
Join two massless-vector\[Dash]graviton vertices with a graviton of momentum \
k and a vector of momentum p - k. Explicit expands the internal vector \
propagator.\
\>", "Text",
 Editable->False,ExpressionUUID->"95d93d12-eeec-4bad-9537-7df1c08b9b43"],

Cell[BoxData[
 RowBox[{"vectorBubbleIntegrand", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"GravitonVectorVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
        RowBox[{"-", "k"}]}], "}"}], ",", "\[Mu]", ",", "p", ",", "\[Sigma]1",
       ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
    RowBox[{"GravitonVectorVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "k"}], "}"}], ",", "\[Sigma]2",
       ",", 
      RowBox[{"p", "-", "k"}], ",", "\[Nu]", ",", 
      RowBox[{"-", "p"}]}], "]"}], " ", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]", ",", "k"}], 
     "]"}], " ", 
    RowBox[{"GluonPropagator", "[", 
     RowBox[{
      RowBox[{"p", "-", "k"}], ",", 
      RowBox[{"{", "\[Sigma]1", "}"}], ",", 
      RowBox[{"{", "\[Sigma]2", "}"}]}], "]"}]}], "//", "Explicit"}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[28]:=",ExpressionUUID->"382f1558-3922-4d2f-b3e4-a0caa60820fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorPolarizationOperator2", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{"vectorBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100471991089*^9, 4.000100476151182*^9}, {
  4.000100509468227*^9, 4.000100532998728*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"76e47c62-8945-4491-b93b-aa60178daa3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"1c873bd2-3cf6-4e55-84ae-6b187c8594cf"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"0480a826-f7f7-43d7-a044-20ee2d8603de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorPolarizationOperator", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"VectorPolarizationOperator1", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], "+", 
      RowBox[{"VectorPolarizationOperator2", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"LorentzIndex", "[", 
           RowBox[{"\[Mu]", ",", "D"}], "]"}], ",", 
          RowBox[{"LorentzIndex", "[", 
           RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}], ",", "Factor"}], 
       "]"}], "&"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[30]:=",ExpressionUUID->"d714a39b-7392-4725-856a-9ebb1ce9952e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal contraction with a transverse state", "Subsection",
 Editable->False,ExpressionUUID->"1410d07d-473c-4852-a03c-988a68dd9d7d"],

Cell["\<\
Contract one external index with p and the other with a transverse \
polarisation vector. This is weaker than testing p\[Mu] \
\[CapitalPi]\[Mu]\[Nu] = 0: a longitudinal term proportional to p\[Mu] p\[Nu] \
also passes. The cells impose p\[CenterDot]\[CurlyEpsilon](p) = 0 explicitly \
and then clear scalar-product definitions.\
\>", "Text",
 Editable->False,ExpressionUUID->"8140834a-c95c-46b7-bac5-0ce2fc1535d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[31]:=",ExpressionUUID->"717a7967-6cdc-42f2-aa2c-cf13f3198472"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FeynGravSimplify", "[", 
   RowBox[{"Explicit", "[", 
    RowBox[{
     RowBox[{"VectorPolarizationOperator", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
       
       RowBox[{"LorentzIndex", "[", 
        RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}]}], "]"}], "]"}], "==", 
  "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0001005474437113`*^9, 4.000100547813984*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"1235171b-2a4e-473c-8255-440cc091f7e2"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653207892819*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"b49ce061-8384-4f1c-abfc-1f5d3e59db42"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}]], "Input",
