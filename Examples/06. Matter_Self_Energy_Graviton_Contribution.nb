Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"8641f1ba-afc2-4022-9421-08477bda92eb"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"64ec73b8-6439-485f-ab27-380c34a78b05"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GluonPolarizationOperator", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "a_", ",", "b_", ",", "p_"}], "]"}],
    "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GluonPolarizationOperator1", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], "]"}], 
       "+", 
       RowBox[{"GluonPolarizationOperator2", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], 
        "]"}]}], "//", "SUNSimplify"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", 
        RowBox[{"Pair", "[", 
         RowBox[{
          RowBox[{"LorentzIndex", "[", 
           RowBox[{"\[Mu]", ",", "D"}], "]"}], ",", 
          RowBox[{"LorentzIndex", "[", 
           RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}], ",", "Factor"}], 
       "]"}], "&"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100769141408*^9, 4.000100772799293*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"76ad14fc-9d17-401d-bfab-864c4da1a649"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal contraction with a transverse state", "Subsection",
 Editable->False,ExpressionUUID->"c9452bda-a2f4-45cc-b4e5-c4fde9cad5b9"],

Cell["\<\
Contract one external index with p and the other with a transverse \
polarisation vector. This is weaker than testing p\[Mu] \
\[CapitalPi]\[Mu]\[Nu] = 0: a longitudinal term proportional to p\[Mu] p\[Nu] \
also passes. The cells impose p\[CenterDot]\[CurlyEpsilon](p) = 0 explicitly \
and then clear scalar-product definitions.\
\>", "Text",
 Editable->False,ExpressionUUID->"36bca8ed-ce75-45fe-a643-4d84f5aa033a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[41]:=",ExpressionUUID->"4614b99b-2cf3-458e-be9f-37095b990b2e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GluonPolarizationOperator", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
    RowBox[{"Pair", "[", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"Polarization", "[", 
         RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
      RowBox[{"LorentzIndex", "[", 
       RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}]}], "]"}], "==", 
  "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100787889319*^9, 4.000100851804347*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"7d4e3052-9e3b-4217-a7f7-bb7451e2336d"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653210811146*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"1edd4eff-da70-4eb5-9b73-01956905ec56"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[43]:=",ExpressionUUID->"9b33a60d-40eb-4c9a-98d9-f074e4b6caaf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-dimensional coefficient comparison", "Subsection",
 Editable->False,ExpressionUUID->"f1164294-0a51-49c3-a45c-2a800fc2b553"],

Cell["\<\
This optional comparison substitutes D -> 4 only in the displayed coefficient \
expression, retaining unevaluated scalar loop integrals. It checks the \
written reference in the selected gauge, not ultraviolet renormalisation.\
\>", "Text",
 Editable->False,ExpressionUUID->"4a556eff-7f98-42f6-a1f9-387790a0d8fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gluonComputed", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"GluonPolarizationOperator", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], "]"}], "/.",
      "\[VeryThinSpace]", 
     RowBox[{"D", "\[Rule]", "4"}]}], "//", "FeynAmpDenominatorExplicit"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100895192646*^9, 4.0001009067272587`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"7b62460d-c15d-457f-a913-7a127db18d7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gluonComputed", "==", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FeynAmpDenominatorExplicit", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "6"]}], " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], " ", 
       SuperscriptBox[
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}], "2"], " ", 
       RowBox[{"SUNDelta", "[", 
        RowBox[{"a", ",", "b"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GaugeProjector", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], "+", 
         FractionBox[
          RowBox[{"15", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"FV", "[", 
              RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
             RowBox[{"FV", "[", 
              RowBox[{"p", ",", "\[Nu]"}], "]"}]}], ")"}]}], 
          RowBox[{"SP", "[", 
           RowBox[{"p", ",", "p"}], "]"}]]}], ")"}]}], "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"D", "\[Rule]", "4"}]}], ")"}]}], "//", "Simplify"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100868313142*^9, 4.000100912909103*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"e859e6a3-ff14-430a-b705-ee6de35704b4"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653210841857*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"56913218-5deb-4733-b3d5-4bbc2f77fe68"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Quark", "Section",
 Editable->False,ExpressionUUID->"74e49210-86bb-46ba-aa0b-5a9bc7ce76af"],

Cell["\<\
This is the massless quark result. Gravity is diagonal in colour; the \
external fundamental colour identity is suppressed. The momentum and Dirac \
dependence follows the fermion sector with m = 0.\
\>", "Text",
 Editable->False,ExpressionUUID->"54666aa6-4798-440a-9204-e4b0e1991085"],

Cell[CellGroupData[{

Cell["Tadpole", "Subsection",
 Editable->False,ExpressionUUID->"d7e1cd7d-ac14-4717-9d46-6617cf8d8a76"],

Cell["\<\
Close the two graviton legs of the contact vertex with a massless graviton \
propagator. The resulting integral is scaleless in dimensional \
regularisation. Declare LoopMomenta -> {k} explicitly so polynomial terms \
left by propagator cancellation are still treated as integrands. The \
following check should return True.\
\>", "Text",
 Editable->False,ExpressionUUID->"17ad1ad6-a276-4dfd-b490-9df5722df4dd"],

Cell[BoxData[
 RowBox[{"quarkTadpoleIntegrand", "=", 
  RowBox[{"Explicit", "[", 
   RowBox[{
    RowBox[{"GravitonFermionVertex", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "k", ",", "\[Alpha]", ",", "\[Beta]", ",", 
        
        RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
      RowBox[{"-", "p"}], ",", "0"}], "]"}], " ", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
     "]"}]}], "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[46]:=",ExpressionUUID->"82ecd14b-e10b-4281-9691-3897bd3f89dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator1", "[", "p_", "]"}], "=", 
   RowBox[{"FeynGravSimplify", "[", 
    RowBox[{"quarkTadpoleIntegrand", ",", 
     RowBox[{"LoopMomenta", "->", 
      RowBox[{"{", "k", "}"}]}], ",", 
     RowBox[{"DropScaleless", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100933935049*^9, 4.000100942542705*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"733b4448-366d-49dc-8911-a1ff2a9cb2c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QuarkPolarizationOperator1", "[", "p", "]", " ", "==", " ", 
  "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[48]:=",ExpressionUUID->"10340cdb-7fe4-4000-a2fd-4ea1a56b7d7d"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653211014042*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"f26cdae5-623e-498d-8feb-1ac0a8ff3c41"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"997759e6-7d1c-4613-beab-762ea24544b1"],

Cell["\<\
Use the massless fermion\[Dash]graviton vertices and propagator. Dot \
preserves the open Dirac-chain order; the external colour identity is \
suppressed in this expression.\
\>", "Text",
 Editable->False,ExpressionUUID->"99ed15ab-3d83-498a-b8f2-f43809b06f06"],

Cell[BoxData[
 RowBox[{"quarkBubbleIntegrand", "=", 
  RowBox[{"Explicit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"GravitonFermionVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", 
         RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"p", "-", "k"}], ")"}]}], ",", "0"}], "]"}], ".", 
     RowBox[{"QuarkPropagator", "[", 
      RowBox[{"p", "-", "k"}], "]"}], ".", 
     RowBox[{"GravitonFermionVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "k"}], "}"}], ",", 
       RowBox[{"p", "-", "k"}], ",", 
       RowBox[{"-", "p"}], ",", "0"}], "]"}]}], " ", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
     "]"}]}], "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[49]:=",ExpressionUUID->"b151aee9-6b1b-48f1-8325-ab225d1f3bca"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator2", "[", "p_", "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{"quarkBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0001009527367363`*^9, 4.000100966308982*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"b1d67470-8abf-4f99-b0c6-645cac5cb94e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"8f81bb88-aea7-45ce-9444-eec1866b8c1d"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"f8072cd6-aedd-4faf-aa04-3596ba491940"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator", "[", "p_", "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuarkPolarizationOperator1", "[", "p", "]"}], "+", 
      RowBox[{"QuarkPolarizationOperator2", "[", "p", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[51]:=",ExpressionUUID->"14d7642a-bacb-4b1c-b800-cb8dbc0cc2cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-dimensional coefficient display", "Subsection",
 Editable->False,ExpressionUUID->"3d5bd24a-764c-47f7-aa3e-6f7528fd9234"],

Cell["\<\
Display the massless quark expression after substituting D -> 4. This is a \
coefficient presentation, not a comparison with an independent reference or a \
renormalised finite result.\
\>", "Text",
 Editable->False,ExpressionUUID->"de22132e-2f3b-4181-9a7f-6f83ac69dab8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator", "[", "p", "]"}], "/.", 
   "\[VeryThinSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"D", "\[Rule]", "4"}], ",", 
     RowBox[{"GaugeFixingEpsilon", "\[Rule]", "2"}]}], "}"}]}], "//", 
  "DiracSimplify"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.00157571504327*^9, 4.00157571977017*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"54a562aa-1d43-4870-af2f-ef2e674c9ddf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "8"]}], " ", "\[ImaginaryI]", " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox["\[Kappa]", "2"], " ", 
   SuperscriptBox[
    FormBox[
     OverscriptBox[
      FormBox["p",
       TraditionalForm], "_"],
     TraditionalForm], "2"], " ", 
   RowBox[{
    OverscriptBox["\[Gamma]", "_"], "\[CenterDot]", 
    FormBox[
     OverscriptBox[
      FormBox["p",
       TraditionalForm], "_"],
     TraditionalForm]}], " ", 
   FormBox[
    TagBox[
     FormBox[
      RowBox[{
       SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
       RowBox[{
        SuperscriptBox[
         FormBox[
          OverscriptBox[
           FormBox["p",
            TraditionalForm], "_"],
          TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
      TraditionalForm],
     HoldForm],
    TraditionalForm]}], TraditionalForm]], "Output",
 CellChangeTimes->{4.001653212808168*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"e49e0c98-022e-478f-9730-574d994a222c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to adapt this example", "Section",
 Editable->False,ExpressionUUID->"75d49a56-6acc-46d2-a783-3e92d9a00b99"],

Cell["\<\
Change one ingredient at a time: a mass, a momentum assignment, or a vertex \
order. Restart the kernel before rerunning with different kinematics, because \
scalar-product definitions and assumptions persist in the session. \
Re-evaluate all dependent cells after a change. Inspect the stored \
intermediate expressions if a comparison is False or remains unevaluated; do \
not treat an unresolved expression as a passed check.\
\>", "Text",
 Editable->False,ExpressionUUID->"12c98604-4b63-4324-b090-d6c04ca4ca6e"]
}, Open  ]]
}, Open  ]]
},
