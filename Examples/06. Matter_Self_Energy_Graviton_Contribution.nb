Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"616b9f45-571f-4cec-98d1-9a7bc4344e3b"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"52cbc03b-8873-45fa-8bd2-0f26f4382b8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ProcaPolarizationOperator", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ProcaPolarizationOperator1", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}], "+", 
      RowBox[{"ProcaPolarizationOperator2", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100417639195*^9, 4.000100423020043*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"5500f282-9c6d-4f02-8193-5edd18958cfb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-dimensional coefficient comparison", "Subsection",
 Editable->False,ExpressionUUID->"5c7f53e6-3b45-4043-8cbb-187c8c4534ae"],

Cell["\<\
This optional comparison substitutes D -> 4 only in the displayed coefficient \
expression, retaining unevaluated scalar loop integrals. It checks the \
written reference in the selected gauge, not ultraviolet renormalisation.\
\>", "Text",
 Editable->False,ExpressionUUID->"dffb1432-67c4-4505-8a98-12f4f5fa9210"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"FeynAmpDenominatorExplicit", "[", 
       RowBox[{"ProcaPolarizationOperator", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}], "]"}], "/.",
       "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ")"}], "\[Equal]", 
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "6"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], "2"], "+", 
            RowBox[{
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            SuperscriptBox["m", "4"]}], ")"}], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"B0", "[", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", 
            SuperscriptBox["m", "2"]}], "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "6"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "-", 
            RowBox[{"8", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"A0", "[", 
           SuperscriptBox["m", "2"], "]"}]}]}], ")"}], " ", 
       RowBox[{"GaugeProjector", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}]}], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", " ", 
          SuperscriptBox["m", "4"], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"B0", "[", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", 
            SuperscriptBox["m", "2"]}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Nu]"}], "]"}]}], ")"}]}], 
       RowBox[{"2", " ", 
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}]}]]}], "]"}]}], "/.", 
   "\[VeryThinSpace]", 
   RowBox[{"D", "\[Rule]", "4"}]}], "//", "FeynGravSimplify"}]], "Input",
 Editable->False,
 InitializationCell->False,
