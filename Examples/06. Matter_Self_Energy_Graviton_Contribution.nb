Cell["\<\
Use a fresh kernel. FeynGrav supplies the vertices and propagators. The \
tadpole checks use FeynGravSimplify with an explicitly declared loop momentum \
and DropScaleless -> True. Bubble integrands are reduced by FeynCalc with \
TID; subsequent coefficient algebra and comparisons use FeynGravSimplify \
where shown. FORM must be available for those calls.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{
  4.00009997597785*^9},ExpressionUUID->"9ce37baa-d571-4f6d-9856-074d3da8aa14"],

Cell["\<\
Explicit expands propagator shorthand. Fermion chains use Dot to preserve \
matrix order. DiracSimplify and SUNSimplify process the indicated Dirac and \
colour structures; Collect groups the resulting coefficients. SUNNToCACF -> \
False retains colour factors in terms of SUNN.\
\>", "Text",
 Editable->False,ExpressionUUID->"7b453c41-dc11-4817-91ff-503866d6a4f9"],

Cell["\<\
The external momentum is p and the loop momentum is k. Keep D symbolic during \
reduction and in the combined operators. TID[..., k, ToPaVe -> True] uses \
FeynCalc\[CloseCurlyQuote]s integral normalisation, including i \[Pi]\.b2; no \
(2\[Pi])^(-D) measure factor is inserted. The optional D -> 4 coefficient \
comparisons below are not Laurent expansions or renormalised finite answers: \
terms proportional to D - 4 can multiply divergent integrals.\
\>", "Text",
 Editable->False,ExpressionUUID->"0507f9a5-9183-4ead-baed-4ec8c2e29dfa"],

Cell["\<\
FeynGrav supplies the vertex and propagator normalisations, including i and \
\[Kappa]. The default gravitational gauge parameter is GaugeFixingEpsilon = \
2. The displayed diagram weights are retained from the original example; the \
notebook does not derive their combinatorics.\
\>", "Text",
 Editable->False,ExpressionUUID->"fe8fc526-322d-44ff-9051-b91f1746cf40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FeynGravImportSUNYM", "[", "2", "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[2]:=",ExpressionUUID->"1d09ce57-263f-4350-acc3-ff437df9d50d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Scalar", "Section",
 Editable->False,ExpressionUUID->"8e77db67-e2e7-4c7b-961c-bb57ad3b0946"],

Cell["\<\
The external matter legs are amputated. The internal graviton and matter \
propagators are shown explicitly in each bubble integrand.\
\>", "Text",
 Editable->False,ExpressionUUID->"d89b8a2f-3809-4789-b62d-ab15220c483c"],

Cell[CellGroupData[{

Cell["Tadpole", "Subsection",
 Editable->False,ExpressionUUID->"201aaf28-ffa8-4f8c-bd19-79fd346a3c50"],

Cell["\<\
Close the two graviton legs of the contact vertex with a massless graviton \
propagator. The resulting integral is scaleless in dimensional \
regularisation. Declare LoopMomenta -> {k} explicitly so polynomial terms \
left by propagator cancellation are still treated as integrands. The \
following check should return True.\
\>", "Text",
 Editable->False,ExpressionUUID->"bb3bfda8-2055-4226-a429-0237949bf1e9"],

Cell[BoxData[
 RowBox[{"scalarTadpoleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonScalarVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], "}"}],
      ",", "p", ",", 
     RowBox[{"-", "p"}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
    "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[3]:=",ExpressionUUID->"45cc4789-e2df-40bc-a5d1-822e450ae9cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScalarPolarizationOperator1", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"FeynGravSimplify", "[", 
    RowBox[{"scalarTadpoleIntegrand", ",", 
     RowBox[{"LoopMomenta", "->", 
      RowBox[{"{", "k", "}"}]}], ",", 
     RowBox[{"DropScaleless", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[4]:=",ExpressionUUID->"d862d513-aebc-4cdb-894b-9701d7ea6ddb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ScalarPolarizationOperator1", "[", 
   RowBox[{"p", ",", "m"}], "]"}], " ", "==", " ", "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.001575583119804*^9, 4.0015755834263372`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"9e6402a2-415c-4a30-98f9-7392e0a9fbef"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653199055949*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"6910900a-8570-4954-bd8e-8b82dd0d9659"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"675477cf-f6c3-45b9-b65e-0d3d2d4177d5"],

Cell["\<\
Join the two scalar\[Dash]graviton vertices with a graviton of momentum k and \
a scalar of momentum p - k. The scalar mass m is retained.\
\>", "Text",
 Editable->False,ExpressionUUID->"5039a59a-f6e0-41b7-bf44-876a6ab287e3"],

Cell[BoxData[
 RowBox[{"scalarBubbleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonScalarVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "p", ",", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonScalarVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", 
     RowBox[{"p", "-", "k"}], ",", 
     RowBox[{"-", "p"}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], "]"}],
    " ", 
   RowBox[{"ScalarPropagator", "[", 
    RowBox[{
     RowBox[{"p", "-", "k"}], ",", "m"}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[6]:=",ExpressionUUID->"99063939-2b5d-4913-bbce-34f20c146783"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScalarPolarizationOperator2", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{"scalarBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[7]:=",ExpressionUUID->"d65f7751-1f90-4c53-a16d-50ab0bcf538a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"cdcecd5c-d342-4c6c-942a-93389dffc137"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"4397736f-9e51-46be-999b-14703c19782b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ScalarPolarizationOperator", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ScalarPolarizationOperator1", "[", 
       RowBox[{"p", ",", "m"}], "]"}], "+", 
      RowBox[{"ScalarPolarizationOperator2", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[8]:=",ExpressionUUID->"b098053b-6424-446e-8eb5-670eaf771c36"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-dimensional coefficient comparison", "Subsection",
 Editable->False,ExpressionUUID->"98e1c7b1-c55b-4e71-94bc-3e7dc67ad5a7"],

Cell["\<\
This optional comparison substitutes D -> 4 only in the displayed coefficient \
expression, retaining unevaluated scalar loop integrals. It checks the \
written reference in the selected gauge, not ultraviolet renormalisation.\
\>", "Text",
 Editable->False,ExpressionUUID->"72d01624-d273-46b2-9671-bcdcc6e03021"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FeynGravSimplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ScalarPolarizationOperator", "[", 
      RowBox[{"p", ",", "m"}], "]"}], "/.", "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "\[Rule]", "4"}], ",", 
       RowBox[{"GaugeFixingEpsilon", "\[Rule]", "2"}]}], "}"}]}], ")"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     SuperscriptBox["m", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SP", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "-", 
       FractionBox[
        SuperscriptBox["m", "2"], "2"]}], ")"}], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"B0", "[", 
      RowBox[{
       RowBox[{"SP", "[", 
        RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", 
       SuperscriptBox["m", "2"]}], "]"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox["m", "2"], " ", "\[ImaginaryI]", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"A0", "[", 
      SuperscriptBox["m", "2"], "]"}]}]}]}], "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000099995085911*^9, 4.0001000041775007`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"b265f251-917d-4cf8-949e-4aa2c82eb597"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653199539257*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"3f35e268-4f4e-4dff-87ca-3476e9915041"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Dirac fermion", "Section",
 Editable->False,ExpressionUUID->"3876be3c-37e7-41c5-94e7-05091a0a2674"],

Cell["\<\
The external matter legs are amputated. The internal graviton and matter \
propagators are shown explicitly in each bubble integrand.\
\>", "Text",
 Editable->False,ExpressionUUID->"12980e0b-66d1-430b-8e25-b7fe85c8742f"],

Cell[CellGroupData[{

Cell["Tadpole", "Subsection",
 Editable->False,ExpressionUUID->"eba0e395-0f0b-484c-8101-6316609f0b0b"],

Cell["\<\
Close the two graviton legs of the contact vertex with a massless graviton \
propagator. The resulting integral is scaleless in dimensional \
regularisation. Declare LoopMomenta -> {k} explicitly so polynomial terms \
left by propagator cancellation are still treated as integrands. The \
following check should return True.\
\>", "Text",
 Editable->False,ExpressionUUID->"7d8bc0a6-57d5-4de9-92a4-7f333a390c0d"],

Cell[BoxData[
 RowBox[{"fermionTadpoleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonFermionVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "k", ",", "\[Alpha]", ",", "\[Beta]", ",", 
       RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
     RowBox[{"-", "p"}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
    "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[10]:=",ExpressionUUID->"89227890-490a-4333-b89d-886c1c23a7ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FermionPolarizationOperator1", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"FeynGravSimplify", "[", 
    RowBox[{"fermionTadpoleIntegrand", ",", 
     RowBox[{"LoopMomenta", "->", 
      RowBox[{"{", "k", "}"}]}], ",", 
     RowBox[{"DropScaleless", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100219991323*^9, 4.000100226292326*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"72dc86ab-5bc1-45dc-9bb2-5fcb848d135f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FermionPolarizationOperator1", "[", "p", ",", "m", "]", " ", "==", 
  " ", "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[12]:=",ExpressionUUID->"498ec560-5c8e-4a0b-bfbf-e73bab6f9039"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001653199731575*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"50554e69-c364-41d8-b94e-d17660e0ca2f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"4100daf2-e76e-4b48-9948-87f84ad93719"],

Cell["\<\
Join the two fermion\[Dash]graviton vertices with an internal graviton and \
fermion. Dot preserves the open Dirac-chain order. Each graviton slot \
contains its two Lorentz indices and incoming momentum.\
\>", "Text",
 Editable->False,ExpressionUUID->"0c30d6f1-09a4-4648-9006-97853b969d7b"],

Cell[BoxData[
 RowBox[{"fermionBubbleIntegrand", "=", 
  RowBox[{"Explicit", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"GravitonFermionVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", 
         RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], ".", 
     RowBox[{"QuarkPropagator", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "-", "k"}], ",", "m"}], "}"}], "]"}], ".", 
     RowBox[{"GravitonFermionVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "k"}], "}"}], ",", 
       RowBox[{"p", "-", "k"}], ",", 
       RowBox[{"-", "p"}], ",", "m"}], "]"}]}], " ", 
    RowBox[{"GravitonPropagator", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
     "]"}]}], "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[13]:=",ExpressionUUID->"8729acc4-8b09-4172-a487-c0948956e074"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FermionPolarizationOperator2", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{"fermionBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100017951889*^9, 4.000100045710164*^9}, {
  4.0001002233223257`*^9, 4.000100274973031*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"1df3d17e-21ea-4d67-8223-4ef140f2d76b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined operator in symbolic D", "Subsection",
 Editable->False,ExpressionUUID->"48e9a845-0c47-445d-afb0-a3fa703b557d"],

Cell["\<\
Add the tadpole and bubble contributions and collect the scalar loop \
integrals. This named combined operator retains symbolic D; the optional \
four-dimensional comparison below does not overwrite it.\
\>", "Text",
 Editable->False,ExpressionUUID->"95394321-ab58-4e63-b2d5-8fbb6ea2a694"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FermionPolarizationOperator", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"FermionPolarizationOperator1", "[", 
       RowBox[{"p", ",", "m"}], "]"}], "+", 
      RowBox[{"FermionPolarizationOperator2", "[", 
       RowBox[{"p", ",", "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100063016651*^9, 4.0001000799837837`*^9}, 
   4.000100132825869*^9, 4.000100210467094*^9, {4.000100286552602*^9, 
   4.000100290717547*^9}, 4.000100327372871*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"1e4a7441-f817-48bd-86a8-8ebefbef1834"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-dimensional coefficient comparison", "Subsection",
 Editable->False,
 CellChangeTimes->{{4.000100355124539*^9, 
  4.000100355390025*^9}},ExpressionUUID->"8033b331-8a9a-4381-ae3c-\
a887d251b9dc"],

Cell["\<\
Apply Explicit before Dirac simplification. The displayed four-dimensional \
coefficients still contain unevaluated scalar loop integrals; setting D to \
four does not perform ultraviolet subtraction.\
\>", "Text",
 Editable->False,ExpressionUUID->"8ae17b34-fecd-45d3-b5c1-b170bcf5bb74"],

Cell["\<\
Display the coefficients of the identity and slash p, then check that they \
reconstruct the computed expression. This tests the decomposition, not an \
independent reference formula.\
\>", "Text",
 Editable->False,ExpressionUUID->"57d75d85-8b5b-4005-8595-b3f6d59f5bad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fermionFourDimensional", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"DiracSimplify", "[", 
       RowBox[{
        RowBox[{"Explicit", "[", 
         RowBox[{"FermionPolarizationOperator", "[", 
          RowBox[{"p", ",", "m"}], "]"}], "]"}], ",", 
        RowBox[{"DiracOrder", "\[Rule]", "True"}]}], "]"}], "/.", 
      "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ",", "_DiracGamma", ",", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"FeynGravSimplify", "[", "#1", "]"}], "]"}], "&"}]}], "]"}]}], 
  ";", 
  RowBox[{"fermionSlash", "=", 
   RowBox[{"FCI", "[", 
    RowBox[{"GS", "[", "p", "]"}], "]"}]}], ";", 
  RowBox[{"fermionIdentityCoefficient", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"fermionFourDimensional", ",", "fermionSlash", ",", "0"}], "]"}],
     "]"}]}], ";", 
  RowBox[{"fermionSlashCoefficient", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"fermionFourDimensional", ",", "fermionSlash", ",", "1"}], "]"}],
     "]"}]}], ";", 
  TagBox[GridBox[{
     {"\"\<Identity\>\"", "fermionIdentityCoefficient"},
     {"\"\<Slash p\>\"", "fermionSlashCoefficient"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"]}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000100142994049*^9, 4.000100175815559*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"f01d58b9-9b9e-4f66-ba51-aaddff3643f5"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Identity\"\>", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "8"]}], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", "m", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"17", " ", 
          SuperscriptBox["m", "2"], " ", 
          FormBox[
           TagBox[
            FormBox[
             RowBox[{
              SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
              RowBox[{
               SuperscriptBox[
                FormBox[
                 OverscriptBox[
                  FormBox["p",
                   TraditionalForm], "_"],
                 TraditionalForm], "2"], ",", "0", ",", 
               SuperscriptBox["m", "2"]}], ")"}],
             TraditionalForm],
            HoldForm],
           TraditionalForm]}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox[
           FormBox[
            OverscriptBox[
             FormBox["p",
              TraditionalForm], "_"],
            TraditionalForm], "2"], " ", 
          FormBox[
           TagBox[
            FormBox[
             RowBox[{
              SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
              RowBox[{
               SuperscriptBox[
                FormBox[
                 OverscriptBox[
                  FormBox["p",
                   TraditionalForm], "_"],
                 TraditionalForm], "2"], ",", "0", ",", 
               SuperscriptBox["m", "2"]}], ")"}],
             TraditionalForm],
            HoldForm],
           TraditionalForm]}], "-", 
         RowBox[{"3", " ", 
          FormBox[
           TagBox[
            FormBox[
             RowBox[{
              SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
              SuperscriptBox["m", "2"], ")"}],
             TraditionalForm],
            HoldForm],
           TraditionalForm]}]}], ")"}]}]},
     {"\<\"Slash p\"\>", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"17", " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox[
             FormBox[
              OverscriptBox[
               FormBox["p",
                TraditionalForm], "_"],
              TraditionalForm], "2"], " ", 
