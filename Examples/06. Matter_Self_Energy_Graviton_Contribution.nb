Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"f5448d39-5234-416c-8046-d76e7c2a8f67"],

Cell["\<\
Join two massive-vector\[Dash]graviton vertices with a graviton of momentum k \
and a massive vector of momentum p - k. Retain both external vector indices \
and the mass m.\
\>", "Text",
 Editable->False,ExpressionUUID->"ab7c2b7f-31cd-4f39-8b9d-35bbccc576be"],

Cell[BoxData[
 RowBox[{"massiveVectorBubbleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonMassiveVectorVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "\[Mu]", ",", "p", ",",
      "\[Lambda]", ",", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonMassiveVectorVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Sigma]"}], "}"}], ",", "\[Tau]", ",", 
     RowBox[{"p", "-", "k"}], ",", "\[Nu]", ",", 
     RowBox[{"-", "p"}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]", ",", "k"}], 
    "]"}], " ", 
   RowBox[{"ProcaPropagator", "[", 
    RowBox[{"\[Lambda]", ",", "\[Tau]", ",", 
     RowBox[{"p", "-", "k"}], ",", "m"}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[21]:=",ExpressionUUID->"88cf0685-4027-4498-81b8-a15a62465dd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ProcaPolarizationOperator2", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{"massiveVectorBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
