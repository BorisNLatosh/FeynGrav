Cell[CellGroupData[{

Cell["Bubble", "Subsection",
 Editable->False,ExpressionUUID->"cd02c6d8-cdc5-4641-8474-0840b424b1e2"],

Cell["\<\
Join two gluon\[Dash]graviton vertices with an internal graviton and gluon. \
Contract the internal colour index while retaining the external colour \
indices.\
\>", "Text",
 Editable->False,ExpressionUUID->"08def40a-834d-40c3-b85c-16714b8749d0"],

Cell[BoxData[
 RowBox[{"gluonBubbleIntegrand", "=", 
  RowBox[{"Contract", "[", 
   RowBox[{"Explicit", "[", 
    RowBox[{
     RowBox[{"GravitonGluonVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
         RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", "\[Mu]", ",", "a", ",", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"p", "-", "k"}], ")"}]}], ",", "\[Sigma]1", ",", "i"}], 
      "]"}], " ", 
     RowBox[{"GluonPropagator", "[", 
      RowBox[{
       RowBox[{"p", "-", "k"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]1", ",", "i"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]2", ",", "j"}], "}"}]}], "]"}], " ", 
     RowBox[{"GravitonGluonVertex", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "k"}], "}"}], ",", 
       RowBox[{"p", "-", "k"}], ",", "\[Sigma]2", ",", "j", ",", 
       RowBox[{"-", "p"}], ",", "\[Nu]", ",", "b"}], "]"}], " ", 
     RowBox[{"GravitonPropagator", "[", 
      RowBox[{
      "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]", ",", "k"}], 
      "]"}]}], "]"}], "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[38]:=",ExpressionUUID->"7c9623f4-1bfb-4cbf-9173-762d08d1530b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GluonPolarizationOperator2", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "a_", ",", "b_", ",", "p_"}], "]"}],
    "=", 
   RowBox[{"TID", "[", 
    RowBox[{"gluonBubbleIntegrand", ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
