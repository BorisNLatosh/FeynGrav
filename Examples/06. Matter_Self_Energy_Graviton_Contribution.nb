                SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
                RowBox[{
                 SuperscriptBox[
                  FormBox[
                   OverscriptBox[
                    FormBox["p",
                    TraditionalForm], "_"],
                   TraditionalForm], "2"], ",", "0", ",", 
                 SuperscriptBox["m", "2"]}], ")"}],
               TraditionalForm],
              HoldForm],
             TraditionalForm]}], "+", 
           RowBox[{
            SuperscriptBox[
             FormBox[
              OverscriptBox[
               FormBox["p",
                TraditionalForm], "_"],
              TraditionalForm], "4"], " ", 
            FormBox[
             TagBox[
              FormBox[
               RowBox[{
                SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
                RowBox[{
                 SuperscriptBox[
                  FormBox[
                   OverscriptBox[
                    FormBox["p",
                    TraditionalForm], "_"],
                   TraditionalForm], "2"], ",", "0", ",", 
                 SuperscriptBox["m", "2"]}], ")"}],
               TraditionalForm],
              HoldForm],
             TraditionalForm]}], "+", 
           RowBox[{"8", " ", 
            SuperscriptBox["m", "4"], " ", 
            FormBox[
             TagBox[
              FormBox[
               RowBox[{
                SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
                RowBox[{
                 SuperscriptBox[
                  FormBox[
                   OverscriptBox[
                    FormBox["p",
                    TraditionalForm], "_"],
                   TraditionalForm], "2"], ",", "0", ",", 
