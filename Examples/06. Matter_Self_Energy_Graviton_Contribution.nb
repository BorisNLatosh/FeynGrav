Cell[CellGroupData[{

Cell["Tadpole", "Subsection",
 Editable->False,ExpressionUUID->"3c73fa5a-ba2d-4644-a9e6-0314903368e3"],

Cell["\<\
Close the two graviton legs of the contact vertex with a massless graviton \
propagator. The resulting integral is scaleless in dimensional \
regularisation. Declare LoopMomenta -> {k} explicitly so polynomial terms \
left by propagator cancellation are still treated as integrands. The \
following check should return True.\
\>", "Text",
 Editable->False,ExpressionUUID->"b3ba30ca-ad86-4252-b75e-c5e682842d74"],

Cell[BoxData[
 RowBox[{"massiveVectorTadpoleIntegrand", "=", 
  RowBox[{
   RowBox[{"GravitonMassiveVectorVertex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]"}], 
      "}"}], ",", "\[Mu]", ",", "p", ",", "\[Nu]", ",", 
     RowBox[{"-", "p"}], ",", "m"}], "]"}], " ", 
   RowBox[{"GravitonPropagator", "[", 
    RowBox[{
    "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]", ",", "k"}], 
    "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[18]:=",ExpressionUUID->"ded36c63-ab5f-4325-953b-381212353823"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ProcaPolarizationOperator1", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"FeynGravSimplify", "[", 
    RowBox[{"massiveVectorTadpoleIntegrand", ",", 
     RowBox[{"LoopMomenta", "->", 
      RowBox[{"{", "k", "}"}]}], ",", 
     RowBox[{"DropScaleless", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
