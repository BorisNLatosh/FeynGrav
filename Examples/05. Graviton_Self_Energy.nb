Cell["\<\
This example requires FORM on the kernel PATH. FeynGravSimplify performs \
bosonic algebra and Lorentz contractions, using TFORM automatically when \
available. TID then performs the loop reduction. The named integrand and \
contracted expression make it possible to inspect either stage separately.\
\>", "Text",
 Editable->False,ExpressionUUID->"9780ed65-e14f-441f-98a8-4ab291583ca5"],

Cell["\<\
The external momentum is p, the loop momentum is k, and m denotes the matter \
mass where present. Repeated Lorentz or colour indices are summed. TID[..., \
k, ToPaVe -> True] reduces tensor integrals to scalar A0 and B0 functions. In \
FeynCalc\[CloseCurlyQuote]s convention these expressions retain the i \[Pi]\
\.b2 normalisation; no (2\[Pi])^(-D) loop-measure prefactor is inserted here. \
Keep D symbolic during reduction. Setting D -> 4 in a displayed coefficient \
is not a Laurent expansion, UV subtraction, or a renormalised answer.\
\>", "Text",
 Editable->False,ExpressionUUID->"6b28079f-0abb-4ccb-9f93-73b4e3383df2"],

Cell["\<\
FeynGrav supplies the vertex and propagator normalisations, including i and \
\[Kappa]. The default gravitational gauge parameter is GaugeFixingEpsilon = \
2. The displayed diagram weights are retained from the original example; the \
notebook does not derive their combinatorics.\
\>", "Text",
 Editable->False,ExpressionUUID->"dfa2dcc2-d0dd-4903-98e8-157860b2469c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Massless tadpole", "Section",
 Editable->False,ExpressionUUID->"f10855b8-2bf8-4d4d-a419-3aebc934453d"],

Cell["\<\
The four-graviton vertex closes into one massless propagator. In dimensional \
regularisation the resulting scaleless tadpole vanishes. This is why its \
combinatorial weight does not affect the subsequent non-zero sum.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{4.000099291450745*^9, 
  4.000099297480855*^9}},ExpressionUUID->"aba65d18-7af1-46b8-a4ee-\
993500861f22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"FeynGravSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GravitonVertex", "[", 
         RowBox[{
         "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", ",", 
          RowBox[{"-", "p"}], ",", "\[Rho]", ",", "\[Sigma]", ",", 
          RowBox[{"-", "k"}], ",", "\[Lambda]", ",", "\[Tau]", ",", "k"}], 
         "]"}], " ", 
        RowBox[{"GravitonPropagator", "[", 
         RowBox[{
         "\[Rho]", ",", "\[Sigma]", ",", "\[Lambda]", ",", "\[Tau]", ",", 
          "k"}], "]"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", "k", "}"}]}], ",", 
       RowBox[{"DropScaleless", "->", "True"}]}], "]"}], ",", "k"}], "]"}], "==",
    "0"}], "//", "Simplify"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000099262806889*^9, 4.000099294633368*^9}, {
  4.0015735789533453`*^9, 4.001573639872571*^9}, {4.00157373911835*^9, 
  4.001573762511057*^9}, {4.001573820215657*^9, 4.001573823795833*^9}, {
  4.001574155166548*^9, 4.001574163104072*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"0c0bfdd4-617d-43a2-85d6-4218cea0b538"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.00157426578648*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"46934cfc-bce3-4081-907e-90c4820b202a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Graviton bubble", "Section",
 Editable->False,ExpressionUUID->"b0d5f114-3795-40ec-913d-b25814bb73b0"],

Cell["\<\
Connect two cubic vertices with propagators of momenta k and p-k. \[Mu],\[Nu] \
and \[Alpha],\[Beta] are free external index pairs. TID performs the one-loop \
tensor reduction; ToPaVe -> True retains scalar Passarino\[Dash]Veltman \
functions. The factor 1/2 is applied in the final sum, not in this definition.\
\>", "Text",
 Editable->False,ExpressionUUID->"84098caa-c57f-40b4-9645-02c8dee8dd74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PolarizationOperator1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"TID", "[", 
       RowBox[{
        RowBox[{"FeynGravSimplify", "[", 
         RowBox[{
          RowBox[{"GravitonVertex", "[", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m1", ",", "n1", ",", 
            RowBox[{"-", "k"}], ",", "a1", ",", "b1", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
          RowBox[{"GravitonPropagator", "[", 
           RowBox[{"m1", ",", "n1", ",", "m2", ",", "n2", ",", "k"}], "]"}], " ", 
          RowBox[{"GravitonPropagator", "[", 
           RowBox[{"a1", ",", "b1", ",", "a2", ",", "b2", ",", 
            RowBox[{"p", "-", "k"}]}], "]"}], " ", 
          RowBox[{"GravitonVertex", "[", 
           RowBox[{"m2", ",", "n2", ",", "k", ",", "a2", ",", "b2", ",", 
            RowBox[{"p", "-", "k"}], ",", "\[Alpha]", ",", "\[Beta]", ",", 
            RowBox[{"-", "p"}]}], "]"}]}], "]"}], ",", "k", ",", 
        RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A0", "[", "__", "]"}], ",", 
        RowBox[{"B0", "[", "__", "]"}], ",", 
        RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}]}], 
   ";"}], "//", "AbsoluteTiming"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0000993289385567`*^9, 4.000099354979412*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"81fafd12-10bc-4e3e-b838-94e107a56085"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"3.928646`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0015742698613987`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"fedc0c04-d64d-4ebf-8098-5c7d3ead4439"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Gravitational ghost bubble", "Section",
 Editable->False,ExpressionUUID->"f4b287c6-673c-490d-b822-d057386e5c56"],

Cell["\<\
The leading minus sign is the closed ghost-loop sign. The two factors of i \
and the massless FAD denominators are explicit in this integrand.\
\>", "Text",
 Editable->False,ExpressionUUID->"eb792614-1a14-4e4c-b53b-ffa29232f087"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PolarizationOperator2", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{"Factor", "[", 
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{"FeynGravSimplify", "[", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"GravitonGhostVertex", "[", 
            RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "a", ",", 
             RowBox[{"-", "k"}], ",", "m", ",", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
           RowBox[{"GravitonGhostVertex", "[", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
             RowBox[{"-", "p"}], ",", "n", ",", 
             RowBox[{"p", "-", "k"}], ",", "b", ",", "k"}], "]"}], " ", 
           SuperscriptBox["\[ImaginaryI]", "2"], " ", 
           RowBox[{"MTD", "[", 
            RowBox[{"a", ",", "b"}], "]"}], " ", 
           RowBox[{"MTD", "[", 
            RowBox[{"m", ",", "n"}], "]"}], " ", 
           RowBox[{"FAD", "[", 
            RowBox[{"k", ",", 
             RowBox[{"p", "-", "k"}]}], "]"}]}], ")"}]}], "]"}], ",", "k", ",", 
       RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000099384012746*^9, 4.000099394906754*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"f1643c19-062d-4eec-8fe8-c448cceefdfe"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"2.43327`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.001574272357229*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"f532f7f1-43f7-4350-bbad-577ee83a5acd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Assemble the operator", "Section",
 Editable->False,ExpressionUUID->"ee8825ea-1126-4f3d-8225-ffc3f1b4fed6"],

Cell["\<\
Combine one half of the graviton bubble with the ghost bubble, using the \
original example\[CloseCurlyQuote]s weights. No external propagators are \
attached.\
\>", "Text",
 Editable->False,ExpressionUUID->"6d1b48eb-10a9-42a7-996f-8f0aa30f871c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PolarizationOperator", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{"Factor", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"PolarizationOperator1", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
        "]"}]}], "+", 
      RowBox[{"PolarizationOperator2", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
       "]"}]}], "]"}]}], ";"}], "//", "AbsoluteTiming"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000099403387553*^9, 4.000099405697338*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"3001fd45-846c-44cb-974e-b38fdfb23923"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"0.021017`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.001574272431843*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"ccc1998e-17e3-4dd8-a7d6-00df3b264627"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Extract and reconstruct the projector form", "Section",
 Editable->False,ExpressionUUID->"1ebedf0a-041d-4faf-9876-ebb297142bbc"],

Cell["\<\
The coefficients below are extracted from the tensor calculated above using \
the installed package. The reconstruction check tests this decomposition; it \
is not an independent check of the loop calculation. The older hard-coded \
expression is omitted because it does not match the current vertex rules.\
\>", "Text",
 Editable->False,ExpressionUUID->"6e34d4d7-21cb-4b12-9770-ddd749f1e968"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gravitonProjectorCoefficients", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
       RowBox[{
        RowBox[{"PolarizationOperator", "[", 
         RowBox[{
         "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
         "]"}], ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",",
         "p"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ")"}]}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[6]:=",ExpressionUUID->"9756eb19-cad5-4c67-92a5-9c185e6eaebf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<P1\>\"", ",", " ", "\"\<P2\>\"", ",", " ", "\"\<P0\>\"", ",",
         " ", "\"\<P0Bar\>\"", ",", " ", "\"\<P0BarBar\>\""}], "}"}], ",", 
      " ", "gravitonProjectorCoefficients"}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[7]:=",ExpressionUUID->"694e6e15-5a3b-43aa-9048-cd086e13ff04"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"P1\"\>", 
      RowBox[{
       RowBox[{"-", "2"}], " ", 
       SuperscriptBox["\[Kappa]", "2"]}]},
     {"\<\"P2\"\>", 
      RowBox[{
       FractionBox["1", "120"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"61", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox[
           FormBox[
            OverscriptBox[
             FormBox["p",
              TraditionalForm], "_"],
            TraditionalForm], "4"], " ", 
          FormBox[
           TagBox[
            FormBox[
             RowBox[{
              SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
              RowBox[{
               SuperscriptBox[
                FormBox[
                 OverscriptBox[
                  FormBox["p",
                   TraditionalForm], "_"],
                 TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
             TraditionalForm],
            HoldForm],
           TraditionalForm]}], "+", 
         RowBox[{"240", " ", "\[ImaginaryI]"}]}], ")"}]}]},
     {"\<\"P0\"\>", 
      RowBox[{
       FractionBox["1", "12"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"13", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox[
           FormBox[
            OverscriptBox[
             FormBox["p",
              TraditionalForm], "_"],
            TraditionalForm], "4"], " ", 
          FormBox[
           TagBox[
            FormBox[
             RowBox[{
              SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
              RowBox[{
               SuperscriptBox[
                FormBox[
                 OverscriptBox[
                  FormBox["p",
                   TraditionalForm], "_"],
                 TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
             TraditionalForm],
            HoldForm],
           TraditionalForm]}], "+", 
         RowBox[{"33", " ", "\[ImaginaryI]"}]}], ")"}]}]},
     {"\<\"P0Bar\"\>", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"9", " ", 
         SuperscriptBox["\[Kappa]", "2"]}], "4"]}]},
     {"\<\"P0BarBar\"\>", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["\[Kappa]", "2"], "4"]}]}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.001574273181213*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"3f60b020-30af-460f-92c9-f044938faa96"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"gravitonProjectorForm", "=", 
   RowBox[{"NieuwenhuizenOperator", "[", 
    RowBox[{
     RowBox[{"Sequence", "@@", "gravitonProjectorCoefficients"}], ",", 
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
    "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[8]:=",ExpressionUUID->"27aac17d-3afd-4fcb-8cf9-ec039c258b24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FeynGravSimplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FeynAmpDenominatorExplicit", "[", 
      RowBox[{
       RowBox[{"PolarizationOperator", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
        "]"}], "-", "gravitonProjectorForm"}], "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"D", "\[Rule]", "4"}]}], ")"}], "\[Equal]", "0"}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000099419025693*^9, 4.000099423773789*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"c43c817e-e9a0-43c5-9f75-707134a51c69"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.00157427332918*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"f02f2035-6b63-4e32-a0ec-0d2fff07db71"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to adapt this example", "Section",
 Editable->False,ExpressionUUID->"539a15c4-b172-4b90-842a-2af02c1fcd25"],

Cell["\<\
Change one ingredient at a time: a mass, a momentum assignment, or a vertex \
order. Restart the kernel before rerunning with different kinematics, because \
scalar-product definitions and assumptions persist in the session. \
Re-evaluate all dependent cells after a change. Inspect the stored \
intermediate expressions if a comparison is False or remains unevaluated; do \
not treat an unresolved expression as a passed check.\
\>", "Text",
 Editable->False,ExpressionUUID->"7efe82c3-c90d-4471-92c9-cf0b8d461105"]
}, Open  ]]
}, Open  ]]
},
