Cell[CellGroupData[{

Cell["5. On-shell amplitude", "Section",
 CellChangeTimes->{{4.000866249068453*^9, 
  4.0008662571274*^9}},ExpressionUUID->"f7ca5a96-d649-4036-92ba-4a2f061206d5"],

Cell[TextData[{
 "Everything above is off shell: the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["p", "i"], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67e8e87d-3118-48bf-bf4e-8dcb34f0c210"],
 " and the polarisation contractions are still free. This section fixes them \
in three steps, clearing the old scalar products, fixing the momenta and \
fixing the polarisations, and then reduces the result to helicity amplitudes.\
\n\nThe Pair assignments below are global and persist for the session. To \
return to the off-shell expression, restart the kernel rather than trying to \
undo them cell by cell."
}], "Text",
 CellChangeTimes->{{4.000872514446718*^9, 
  4.0008725178610764`*^9}},ExpressionUUID->"8659880b-29be-4f7c-b449-\
151fe517d0ef"],

Cell["\<\
FCClearScalarProducts[] removes any scalar-product assignments made earlier \
in the session, so the on-shell relations that follow are applied to a clean \
state rather than on top of stale values.\
\>", "Text",ExpressionUUID->"a6c7bdcf-a158-4976-9f20-f3ed86f5a360"],

Cell[BoxData[
 RowBox[{"FCClearScalarProducts", "[", "]"}]], "Input",
 CellChangeTimes->{{4.0008678726207323`*^9, 4.000867877742065*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"66c13f25-1d09-4ba4-8d7e-2eee114f1ee5"],

Cell[TextData[{
 "SetMandelstam fixes the momentum products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], "\[CenterDot]", 
    SubscriptBox["p", "j"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cd2d02a-ffd0-47f5-8157-73509e462a22"],
 " for massless momenta. The physical outgoing momenta p3 and p4 are passed \
as -p3 and -p4 because SetMandelstam works with all-incoming momenta, and the \
four mass arguments are zero. This sets ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "2"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "3"], "\[CenterDot]", 
      SubscriptBox["p", "4"]}], "=", 
     RowBox[{"s", "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98d16f1e-e8f5-4d78-baa3-c2786fece602"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "3"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "2"], "\[CenterDot]", 
      SubscriptBox["p", "4"]}], "=", 
     RowBox[{
      RowBox[{"-", "t"}], "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83106704-5f9d-453f-bc66-2c9881e06160"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "4"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "2"], "\[CenterDot]", 
      SubscriptBox["p", "3"]}], "=", 
     RowBox[{
      RowBox[{"-", "u"}], "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "763852df-c52b-4864-993a-c68c82b6cba5"],
 ", which implies s + t + u = 0 together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{
      SuperscriptBox["E", "2"], "(", 
      RowBox[{"1", "-", "cos\[Theta]"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2ba0499-fa43-4f92-9bb7-92eee0342eee"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{
      SuperscriptBox["E", "2"], "(", 
      RowBox[{"1", "+", "cos\[Theta]"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eb509829-f2c4-436f-bd2c-699629c549b1"],
 " in the centre-of-mass frame. Nothing is said yet about the polarisations."
}], "Text",
 CellChangeTimes->{{4.000872525668442*^9, 
  4.0008726528106403`*^9}},ExpressionUUID->"5984d92f-30ea-4379-8423-\
aeec0fdfc188"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", " ", "t", ",", " ", "u", ",", " ", "p1", " ", ",", " ", "p2", 
    " ", ",", " ", 
    RowBox[{"-", "p3"}], " ", ",", " ", 
    RowBox[{"-", "p4"}], " ", ",", " ", "0", " ", ",", " ", "0", " ", ",", 
    " ", "0", " ", ",", " ", "0"}], " ", "]"}], ";"}]], "Input",
 CellChangeTimes->{{4.000866279129109*^9, 4.000866294509514*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8c283354-b9a6-42ad-8639-7e0f0e3d1a6f"],

Cell[TextData[{
 "Transversality: each wavefunction is orthogonal to its own momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "i"], "\[InvisibleComma]", 
    RowBox[{
     SubscriptBox["p", "i"], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6c8fe0e-4a20-4557-9caa-b08661979c7f"],
 ". The momentum is the physical one, so this holds for the incoming legs 1 \
and 2 and for the conjugated outgoing legs 3 and 4."
}], "Text",
 CellChangeTimes->{{4.000867696182254*^9, 4.0008677053117237`*^9}, {
  4.000872657247829*^9, 
  4.0008726685627604`*^9}},ExpressionUUID->"db922470-74bc-4bf4-9412-\
646aedc1d381"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}]}], "Input",
 CellChangeTimes->{{4.00086768486629*^9, 4.0008677216706467`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"ce203227-39c7-4f03-a05d-17e2ddb92d67"],

Cell[TextData[{
 "Null wavefunctions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "i"], "\[CenterDot]", 
     SubscriptBox["\[CurlyEpsilon]", "i"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b70ddcc6-a52a-4edf-a85a-9d4bdb255e1d"],
 " in the bilinear product. This is a statement about each leg on its own; \
the products between different legs are fixed by the two blocks that follow."
}], "Text",
 CellChangeTimes->{{4.000867738116025*^9, 4.000867746666482*^9}, {
  4.0008726740162897`*^9, 
  4.000872691067483*^9}},ExpressionUUID->"ba911115-4217-4148-9749-\
963c8e56c155"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}]}], "Input",
 CellChangeTimes->{{4.00086768486629*^9, 4.000867768225563*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"51304fbe-d41a-4398-b597-a69b90b502fe"],

Cell[TextData[{
 "The mixed products that vanish: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "1"], "\[CenterDot]", 
    SubscriptBox["p", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a4fcd6c-2568-44ed-bd06-071c18ec527a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "2"], "\[CenterDot]", 
    SubscriptBox["p", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d97c4286-6af7-4460-8332-3c6d15367917"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "3"], "\[CenterDot]", 
    SubscriptBox["p", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0f544c4-d7dd-41c0-b2d1-eefb7f34358a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "4"], "\[CenterDot]", 
    SubscriptBox["p", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0fa2c3c0-c5af-4f41-8823-14c88072cf31"],
 " are zero. Each wavefunction has zero time component, so these reduce to \
spatial scalar products, which vanish for the leg pairings shown."
}], "Text",
 CellChangeTimes->{{4.000872694339313*^9, 
  4.0008727508402243`*^9}},ExpressionUUID->"7cfbc5f5-e31c-470f-812a-\
581ef5e412ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", "D"}], "]"}]}], "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}]}], "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", "0"}], ";"}]}], "Input",
 CellChangeTimes->{{4.000867784848065*^9, 4.000867784848105*^9}, {
  4.0008678393504543`*^9, 4.000867840762991*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"95c222f4-a1eb-4ca0-970a-3e40c4583fd2"],

Cell[TextData[{
 "The polarisation-momentum products. With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "i"], "=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "619353ac-9de6-422e-bc8f-6279e87f3c78"],
 " the whole block equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", 
    SqrtBox[
     FractionBox[
      RowBox[{"t", " ", "u"}], 
      RowBox[{"2", " ", "s"}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53ab3d28-bee3-4268-8e79-b0e3b6989000"],
 " times a matrix built from the helicity labels; it is written out leg by \
leg here. The products are bilinear, with no complex conjugation, and the \
momenta are the physical ones."
}], "Text",
 CellChangeTimes->{{4.000872755972139*^9, 
  4.000872803639306*^9}},ExpressionUUID->"8bf1c72b-71a3-440b-b557-\
e8310e42f3bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h1"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h1", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h2", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h2"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h3"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h3", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h4", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h4"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.00086780152381*^9, 4.0008678015238333`*^9}, {
  4.000867841392047*^9, 4.000867862359373*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"75b3b2a8-1252-46e4-8ba3-f5bc7123c716"],

Cell[TextData[{
 "The polarisation-polarisation products, again bilinear with no conjugation. \
The diagonal is zero because each wavefunction is null. Off the diagonal the \
entries carry the helicity labels of the two legs together with the ratio \
t/s; using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      RowBox[{"t", "/", "s"}]}]}], "=", "cos\[Theta]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70f7f4d4-94dd-4f81-a045-59cdd47ba0f2"],
 " they encode the helicity correlations that the final amplitudes are built \
from."
}], "Text",
 CellChangeTimes->{{4.000872843281166*^9, 
  4.0008728583698263`*^9}},ExpressionUUID->"0d9ae376-1ec6-4833-995a-\
425383fe5df2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"h1", " ", "h2"}]}], ")"}]}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"h1", " ", "h3", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           RowBox[{"t", "/", "s"}]}]}], ")"}]}], "+", "1"}], ")"}]}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h1", " ", "h4", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"t", "/", "s"}]}]}], ")"}]}], "-", "1"}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
