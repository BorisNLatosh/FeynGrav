           TraditionalForm], "(", 
          FormBox["p1",
           TraditionalForm], ")"}],
         TraditionalForm]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FormBox[
         FormBox["p3",
          TraditionalForm],
         TraditionalForm], 
        FormBox["\<\"\[CenterDot]\"\>",
         TraditionalForm], 
        FormBox[
         RowBox[{
          FormBox["\<\"\[CurlyEpsilon]\"\>",
           TraditionalForm], "(", 
          FormBox["p1",
           TraditionalForm], ")"}],
         TraditionalForm]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        FormBox[
         FormBox["p3",
          TraditionalForm],
         TraditionalForm], 
        FormBox["\<\"\[CenterDot]\"\>",
         TraditionalForm], 
        FormBox[
         RowBox[{
          FormBox["\<\"\[CurlyEpsilon]\"\>",
           TraditionalForm], "(", 
          FormBox["p2",
           TraditionalForm], ")"}],
         TraditionalForm]}], ")"}], " ", 
      SuperscriptBox[
       FormBox[
        RowBox[{
         SuperscriptBox[
          FormBox["\<\"\[CurlyEpsilon]\"\>",
           TraditionalForm], "*"], "(", 
         FormBox["p3",
          TraditionalForm], ")"}],
        TraditionalForm], "2"], " ", 
      SuperscriptBox[
       FormBox[
        RowBox[{
         SuperscriptBox[
          FormBox["\<\"\[CurlyEpsilon]\"\>",
           TraditionalForm], "*"], "(", 
         FormBox["p4",
          TraditionalForm], ")"}],
        TraditionalForm], "2"], " ", 
      SuperscriptBox["\[Kappa]", "2"]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"D", "-", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         FormBox[
          FormBox["p3",
           TraditionalForm],
          TraditionalForm], "2"], "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           FormBox[
            FormBox["p3",
             TraditionalForm],
            TraditionalForm], 
           FormBox["\<\"\[CenterDot]\"\>",
            TraditionalForm], 
           FormBox[
            FormBox["p4",
             TraditionalForm],
            TraditionalForm]}], ")"}]}], "+", 
        SuperscriptBox[
         FormBox[
          FormBox["p4",
           TraditionalForm],
          TraditionalForm], "2"]}], ")"}]}]]}],
   Short[#, 4]& ], TraditionalForm]], "Output",
 CellChangeTimes->{4.000866152011819*^9, 4.000872481250589*^9, 
  4.000877324153014*^9},
 CellLabel->
  "Out[10]//Short=",ExpressionUUID->"41a04ad8-3745-43a1-a683-c08c04e8a895"]
}, Open  ]],

