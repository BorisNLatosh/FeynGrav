Cell["Paint supplies the actual inserted FeynArts diagrams. The four \
numbers identify the contact and three exchange contributions; they are not \
extra multiplicative weights. FeynArts already supplies the graph factors.", 
   "Text", ExpressionUUID -> "d300d3e2-1441-4454-b220-221ff9c5c3ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Build the four off-shell amplitudes", 
      "Section", ExpressionUUID -> "abf8b48b-3f95-4714-ba67-0a4717f65159"],

Cell["Use incoming momenta p1,p2 and outgoing momenta p3,p4. All \
virtualities and scalar products remain symbolic. MomentumConservation -> \
True supplies internal routing at each vertex without imposing mass-shell \
conditions or eliminating an external momentum. Truncated -> True removes \
external propagators; polarisations are attached explicitly in the next \
cell.", "Text", ExpressionUUID -> "ed144ddd-09e4-41e1-a993-199ac60484cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"treeRawAmplitude", "=", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"treeInsertions", ",", 
     RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
     RowBox[{"GaugeRules", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"MomentumConservation", "\[Rule]", "True"}], ",", 
     RowBox[{"Truncated", "\[Rule]", "True"}]}], "]"}]}], ";", 
  RowBox[{"diagramTensors", "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"treeRawAmplitude", ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[Mu]3", ",",
         "\[Nu]3", ",", "\[Mu]4", ",", "\[Nu]4", ",", "\[Alpha]1", ",", 
        "\[Beta]1", ",", "\[Alpha]2", ",", "\[Beta]2"}], "}"}]}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000817917840981*^9, 4.000817971857566*^9}},
