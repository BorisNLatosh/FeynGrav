       RowBox[{"h3", " ", "h4"}]}], ")"}]}], "/", "2"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000867812119295*^9, 4.000867812119308*^9}, {
  4.000867844027871*^9, 4.000867849918304*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"5c48e924-f691-4ab3-8fed-8e40cea6f95c"],

Cell[TextData[{
 "Simplify needs to know that the helicity labels are \[PlusMinus]1 before it \
can collapse the polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65ca7b0a-dd80-4344-bc73-a3407ee81b62"],
 " introduced by the tables above."
}], "Text",
 CellChangeTimes->{{4.000872865738117*^9, 
  4.000872873232658*^9}},ExpressionUUID->"8871cdab-08c7-4624-a744-\
002b3bc44cae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    SuperscriptBox["h1", "2"], "==", 
    SuperscriptBox["h2", "2"], "==", 
    SuperscriptBox["h3", "2"], "==", 
    SuperscriptBox["h4", "2"], "==", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000867906912027*^9, 4.000867927781704*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"75335823-b6ac-4fb7-93f3-69afeb50b599"],

Cell[TextData[{
 "This is where the off-shell expression becomes a helicity amplitude. \
theAmplitude already depends on s, t and u through the assignments above; \
Simplify applies the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["h", "i"], "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e2f511c-6f07-4b63-a0f7-68aa38854a08"],
 " assumptions and TrickMandelstam rewrites the result in the standard \
variables, storing it in theAmplitudeonShell, again as a function of the four \
helicity labels."
}], "Text",
 CellChangeTimes->{{4.000872878269696*^9, 
  4.000872888999866*^9}},ExpressionUUID->"0d51e679-52f5-4ff8-9c17-\
150ab244f200"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{"h1_", ",", "h2_", ",", "h3_", ",", "h4_"}], "]"}], "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"theAmplitude", "[", 
        RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "]"}], "//", 
       "Simplify"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}]], "Input",
 CellChangeTimes->{{4.0008663068576393`*^9, 4.000866332731345*^9}, {
  4.000866374038752*^9, 4.000866374379426*^9}, {4.000866457287539*^9, 
  4.0008664936454983`*^9}, {4.000867885862252*^9, 4.00086790150202*^9}, {
  4.0008679318213*^9, 4.000867974317635*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"9c340c7a-a1d2-4f67-8cab-4e9af00a6d7d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.433965`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{{4.000866276625516*^9, 4.000866333716508*^9}, {
   4.000866371303594*^9, 4.000866376357285*^9}, {4.000866460946123*^9, 
   4.000866495661399*^9}, {4.000867882624701*^9, 4.000867975035532*^9}, 
   4.000872483725177*^9, 4.000877326430341*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"fc1afbd2-f0d4-459e-951d-1d2634d14e1d"]
}, Open  ]],

Cell["\<\
Check against closed forms. Each of the four helicity combinations is \
compared with the expected tree-level expression. Both sides are put in s, t \
and u by TrickMandelstam before the comparison. The recorded outputs are True \
for each combination.\
\>", "Text",
 CellChangeTimes->{
  4.0008729007228937`*^9},ExpressionUUID->"5eff178a-4cde-481a-b5a3-\
bbee192652c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["s", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["t", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["u", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}]}], "Input",
 CellChangeTimes->{{4.000868039790948*^9, 4.000868111903015*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"74aef3b8-d420-4afa-8320-001d4112b76c"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008724837951393`*^9, 4.000877326491906*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"a9acee96-2e7e-4670-ab02-5b935ae93168"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008724837951393`*^9, 4.0008773264978237`*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"d737e911-274e-4295-ab43-ae22fdc169af"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0008724837951393`*^9, 4.000877326498806*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"1730f716-9ecc-4e62-9328-e5523b427084"]
}, Open  ]],

Cell[TextData[{
 "Scope of the result. This is the massless tree-level four-graviton \
amplitude, evaluated with the gauge parameter fixed at 2 by the model, using \
the polarisation conventions fixed above; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "i"], "=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8479bae-860f-4b72-9d2b-aebb0b81385b"],
 " are the helicity labels. No loop integration, ultraviolet subtraction, \
spin sum, phase-space integration or cross section is computed, and the \
off-shell expression from the earlier sections remains available in \
theAmplitude until the kernel is restarted."
}], "Text",
 CellChangeTimes->{{4.000872908678329*^9, 
  4.0008729173140783`*^9}},ExpressionUUID->"d550a3ce-a300-4822-9e14-\
c5e4b63c723a"],

Cell[BoxData[
 RowBox[{"FCClearScalarProducts", "[", "]"}]], "Input",
