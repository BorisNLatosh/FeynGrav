Cell[CellGroupData[{

Cell["Polarisation-projected check", "Subsection",
 Editable->False,
 CellChangeTimes->{
  4.00172424406326*^9},ExpressionUUID->"5bde6420-2bdc-4775-a040-eb9feee913b0"],

Cell["\<\
The following cell contracts one graviton index with p and the other three \
with polarisation vectors. It imposes transverse polarisations and a zero \
self-contraction for the conjugated vector, then clears the scalar-product \
definitions. True establishes this restricted projection only: these \
constraints can remove longitudinal terms, including the one-point tadpole \
contribution. It is not the unprojected tadpole-dependent Ward identity. The \
external momentum remains generic; this is not an on-shell graviton \
scattering amplitude.\
\>", "Text",
 Editable->False,ExpressionUUID->"37afc164-545b-436d-b3c1-cc59e84d4293"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorFermion", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
      "m"}], "]"}], 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Nu]", ",", "\[ImaginaryI]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Alpha]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Beta]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "==", "0"}], "//", 
  "Contract"}], "\[IndentingNewLine]", 
 RowBox[{"FCClearScalarProducts", "[", "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{4.001724057839098*^9, 4.001724211914925*^9}, 
   4.001724262410913*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"1fad0dca-6d0c-4e66-9853-0e89881e9101"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001726039301895*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"ff5b3ffd-df53-4600-9adc-8176e0ff98da"]
}, Open  ]]
