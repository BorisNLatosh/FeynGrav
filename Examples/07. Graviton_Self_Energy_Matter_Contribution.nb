Cell[CellGroupData[{

Cell["Polarisation-projected check", "Subsection",
 Editable->False,ExpressionUUID->"2dca938a-91f6-43a9-8f3f-8fd482d1542b"],

Cell["\<\
The following cell contracts one graviton index with p and the other three \
with polarisation vectors. It imposes transverse polarisations and a zero \
self-contraction for the conjugated vector, then clears the scalar-product \
definitions. True establishes this restricted projection only: these \
constraints can remove longitudinal terms, including the one-point tadpole \
contribution. It is not the unprojected tadpole-dependent Ward identity. The \
external momentum remains generic; this is not an on-shell graviton \
scattering amplitude.\
\>", "Text",
 Editable->False,ExpressionUUID->"b194b94b-0a1a-45d2-b5ec-86c34dbece28"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorVector", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Nu]", ",", "\[ImaginaryI]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Alpha]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Beta]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "==", "0"}], "//", 
  "Contract"}], "\[IndentingNewLine]", 
 RowBox[{"FCClearScalarProducts", "[", "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{4.001724057839098*^9, 4.001724211914925*^9}, 
   4.001724330676897*^9, {4.001724365130188*^9, 4.001724380614859*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"7bfa7731-7ed5-4f24-9587-c2fc878d2c4f"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001726043268362*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"d5c59bdf-ecea-44db-a9be-6bcfc2719388"]
}, Open  ]]
