             RowBox[{
              RowBox[{"4", " ", 
               SuperscriptBox["D", "2"]}], "-", 
              RowBox[{"10", " ", "D"}], "+", "1"}], ")"}], " ", 
            SuperscriptBox["m", "2"]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "4"}], ")"}], " ", "D", " ", 
