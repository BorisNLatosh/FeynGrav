            SuperscriptBox["m", "2"]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], " ", "D", " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}]}], ")"}]}], 
        RowBox[{"4", " ", "D", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]], "-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"]}], "-", 
           SuperscriptBox[
            FormBox[
             FormBox["p",
              TraditionalForm],
             TraditionalForm], "2"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}], "+", 
           RowBox[{"8", " ", 
            SuperscriptBox["m", "2"]}]}], ")"}], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
             RowBox[{
              SuperscriptBox[
               FormBox[
                FormBox["p",
                 TraditionalForm],
                TraditionalForm], "2"], ",", 
              SuperscriptBox["m", "2"], ",", 
              SuperscriptBox["m", "2"]}], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm]}], 
        RowBox[{"8", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]}]},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(0\\)]\\)\"\>", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
             SuperscriptBox["m", "2"], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm], " ", 
