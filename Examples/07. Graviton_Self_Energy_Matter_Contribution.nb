Cell[CellGroupData[{

Cell["6. SU(N) Yang\[Dash]Mills sector", "Section",
 Editable->False,ExpressionUUID->"d394f14b-26d8-46cf-8877-a0d7a6e08ac2"],

Cell["\<\
This section adds massless gluon, gauge-ghost and one massless Dirac-quark \
contribution in the fundamental representation. It therefore includes a quark \
as well as the pure Yang-Mills sector. SUNSimplify retains colour \
multiplicities in terms of SUNN; no sum over additional quark flavours is \
included.\
\>", "Text",
 Editable->False,ExpressionUUID->"591e21ff-2260-45cf-b35c-6dbfc64c8c8e"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",
 Editable->False,ExpressionUUID->"af45f86b-89ba-4680-ba3e-eaa9a3b385a5"],

Cell["\<\
Close the two matter legs of a vertex with two external gravitons. This \
two-point contact diagram is often called a tadpole diagram; it is distinct \
from the one-external-graviton amplitude that appears in the full Ward \
identity. Here the internal fields are massless, and scaleless contact \
integrals are removed by the chosen dimensional-regularisation prescription.\
\>", "Text",
 Editable->False,ExpressionUUID->"b9aa0d10-4271-48a1-949e-38303eb34e2c"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorGluon1", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "SUNSimplify", "[", "Explicit", "[", "(", 
  "Explicit", "[", "GravitonGluonVertex", "[", "{", "\[Mu]", ",", "\[Nu]", ",",
   "p", ",", "\[Alpha]", ",", "\[Beta]", ",", "-", "p", "}", ",", "-", "k", ",",
   "\[Lambda]1", ",", "a1", ",", "k", ",", "\[Lambda]2", ",", "a2", "]", " ", 
  "GluonPropagator", "[", "k", ",", "{", "\[Lambda]1", ",", "a1", "}", ",", "{",
   "\[Lambda]2", ",", "a2", "}", "]", "]", ")", "/", "2", "]", ",", 
  "SUNNToCACF", "->", "False", "]", ",", "LoopMomenta", "->", "{", "k", "}", ",",
   "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098724569545*^9, 4.000098754833439*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"1533c99a-1238-4aac-b4e5-ca322434302c"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorQuark1", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "-", "SUNN", " ", "DiracSimplify", "[", "Explicit",
   "[", "DiracTrace", "[", "GravitonFermionVertex", "[", "{", "\[Mu]", ",", 
  "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", ",", "-", "p", "}", ",",
   "-", "k", ",", "k", ",", "0", "]", ".", "QuarkPropagator", "[", "k", "]", "]",
   "]", ",", "DiracTraceEvaluate", "->", "True", "]", ",", "LoopMomenta", "->",
   "{", "k", "}", ",", "DropScaleless", "->", "True", "]", "]", 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098760592371*^9, 4.00009879337845*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"15067961-9018-4e1d-88f5-0a8f333dff36"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorGhost1", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "SUNSimplify", "[", "Explicit", "[", "-", "(", 
  "Explicit", "[", "GravitonYMGhostVertex", "[", "{", "\[Mu]", ",", "\[Nu]", ",",
   "\[Alpha]", ",", "\[Beta]", "}", ",", "-", "k", ",", "a", ",", "k", ",", 
  "b", "]", " ", "GhostPropagator", "[", "k", ",", "a", ",", "b", "]", "]", ")",
   "]", ",", "SUNNToCACF", "->", "False", "]", ",", "LoopMomenta", "->", "{", 
  "k", "}", ",", "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098799819141*^9, 4.000098814968729*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"7474a6e4-f4b2-4fb8-b12a-d67ef08dc1a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble contributions", "Subsection",
 Editable->False,ExpressionUUID->"d4a69626-ea4e-4d7f-a606-a2e2b32ecefd"],

Cell["\<\
Join the two matter\[Dash]graviton vertices with the indicated propagators. \
The integrand specifies the momentum routing; k is the integration variable.\
\>", "Text",
 Editable->False,ExpressionUUID->"70a6884a-ee02-4125-9a43-d566d1474d03"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorGluon2", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "SUNSimplify", "[", "Explicit", "[", "(", 
  "Explicit", "[", "GravitonGluonVertex", "[", "{", "\[Mu]", ",", "\[Nu]", ",",
   "p", "}", ",", "-", "k", ",", "\[Sigma]1", ",", "a1", ",", "-", "(", "p", "-",
   "k", ")", ",", "\[Rho]1", ",", "b1", "]", " ", "GluonPropagator", "[", "k",
   ",", "{", "\[Sigma]1", ",", "a1", "}", ",", "{", "\[Sigma]2", ",", "a2", "}",
   "]", " ", "GluonPropagator", "[", "p", "-", "k", ",", "{", "\[Rho]1", ",", 
  "b1", "}", ",", "{", "\[Rho]2", ",", "b2", "}", "]", " ", 
  "GravitonGluonVertex", "[", "{", "\[Alpha]", ",", "\[Beta]", ",", "-", "p", 
  "}", ",", "k", ",", "\[Sigma]2", ",", "a2", ",", "p", "-", "k", ",", 
  "\[Rho]2", ",", "b2", "]", "]", ")", "/", "2", "]", ",", "SUNNToCACF", "->",
   "False", "]", ",", "LoopMomenta", "->", "{", "k", "}", ",", 
  "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.00009882625436*^9, 4.0000988461123743`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"108f4b0d-f2f9-48f5-9b8a-a2ba6772147f"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorQuark2", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "-", "DiracSimplify", "[", "Explicit", "[", "SUNN",
   " ", "DiracTrace", "[", "GravitonFermionVertex", "[", "{", "\[Mu]", ",", 
  "\[Nu]", ",", "p", "}", ",", "k", ",", "-", "(", "p", "+", "k", ")", ",", 
  "0", "]", ".", "QuarkPropagator", "[", "{", "-", "k", ",", "0", "}", "]", ".",
   "GravitonFermionVertex", "[", "{", "\[Alpha]", ",", "\[Beta]", ",", "-", 
  "p", "}", ",", "p", "+", "k", ",", "-", "k", ",", "0", "]", ".", 
  "QuarkPropagator", "[", "-", "p", "-", "k", "]", "]", "]", ",", 
  "DiracTraceEvaluate", "->", "True", "]", ",", "LoopMomenta", "->", "{", "k",
   "}", ",", "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098852650778*^9, 4.000098892898199*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"29d3bbb9-1ea0-452b-9e8e-c273bc5872e4"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorGhost2", "[", "\[Mu]_", ",", "\[Nu]_", ",",
   "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", "PaVeToABCD", "[", 
  "FeynGravSimplify", "[", "SUNSimplify", "[", "Explicit", "[", "-", "(", 
  "Explicit", "[", "GravitonYMGhostVertex", "[", "{", "\[Mu]", ",", "\[Nu]", "}",
   ",", "-", "k", ",", "a", ",", "-", "(", "p", "-", "k", ")", ",", "i", "]", 
  " ", "GravitonYMGhostVertex", "[", "{", "\[Alpha]", ",", "\[Beta]", "}", ",",
   "k", ",", "b", ",", "p", "-", "k", ",", "j", "]", " ", "GhostPropagator", "[",
   "k", ",", "a", ",", "b", ",", "Explicit", "\[Rule]", "True", "]", " ", 
  "GhostPropagator", "[", "p", "-", "k", ",", "i", ",", "j", ",", "Explicit", 
  "\[Rule]", "True", "]", "]", ")", "]", ",", "SUNNToCACF", "->", "False", "]",
   ",", "LoopMomenta", "->", "{", "k", "}", ",", "DropScaleless", "->", 
  "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098899413966*^9, 4.0000989157164917`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"38fcad94-365b-41e8-9e30-36e6e6213948"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined tensor", "Subsection",
 Editable->False,ExpressionUUID->"55feddb0-31c1-4ef7-bfa3-1c69800cbf93"],

Cell["\<\
Add the contact and bubble amplitudes. Their definitions include the \
real-boson symmetry factor 1/2 or the closed-Dirac/ghost-loop sign -1, as \
appropriate. Colour multiplicities are retained.\
\>", "Text",
 Editable->False,ExpressionUUID->"3e0b8649-3d18-4424-9f26-93164deb3943"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorGluon1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGluon2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorQuark1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorQuark2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGhost1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGhost2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[56]:=",ExpressionUUID->"21d8b451-6049-4a7c-9652-c2fc3fc9f2db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Full tadpole-dependent Ward identities", "Subsection",
 Editable->False,ExpressionUUID->"87110aa8-e77e-43d3-823f-617a705cec86"],

Cell[TextData[{
 "The one-external-graviton loop has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{"\[Alpha]", "\[Beta]"}]], "=", "t", " ", 
    SuperscriptBox["\[Eta]", 
     RowBox[{"\[Alpha]", "\[Beta]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6debf0d7-c75f-4634-b1e1-43b71adbd25b"],
 ". The first cell computes t by contracting its two indices and dividing by \
D. This one-point function is different from the two-graviton contact loop \
calculated above. Both use the same loop normalisation and diagram weights. \
With these massless fields and DropScaleless -> True, the one-point integrals \
are scaleless and t vanishes."
}], "Text",
 Editable->False,ExpressionUUID->"c8e0510f-b6b3-4f19-914e-0b1b81c686e4"],

Cell[BoxData[
 RowBox[{"gravitonTadpoleSUNYM", "=", "PaVeToABCD", "[", "FeynGravSimplify", "[",
   "Contract", "[", "MTD", "[", "\[Alpha]", ",", "\[Beta]", "]", " ", "(", 
  "SUNSimplify", "[", "Explicit", "[", "GravitonGluonVertex", "[", "{", 
  "\[Alpha]", ",", "\[Beta]", ",", "0", "}", ",", "k", ",", "\[Rho]1", ",", 
  "a", ",", "-", "k", ",", "\[Rho]2", ",", "b", "]", " ", "GluonPropagator", "[",
   "k", ",", "{", "\[Rho]1", ",", "a", "}", ",", "{", "\[Rho]2", ",", "b", "}",
   "]", "/", "2", "-", "GravitonYMGhostVertex", "[", "{", "\[Alpha]", ",", 
  "\[Beta]", "}", ",", "k", ",", "a", ",", "-", "k", ",", "b", "]", " ", 
  "GhostPropagator", "[", "k", ",", "a", ",", "b", "]", "]", ",", 
  "SUNNToCACF", "->", "False", "]", "-", "SUNN", " ", "DiracSimplify", "[", 
  "Explicit", "[", "DiracTrace", "[", "GravitonFermionVertex", "[", "{", 
  "\[Alpha]", ",", "\[Beta]", ",", "0", "}", ",", "-", "k", ",", "k", ",", 
  "0", "]", ".", "QuarkPropagator", "[", "k", "]", "]", "]", ",", 
  "DiracTraceEvaluate", "->", "True", "]", ")", "]", "/", "D", ",", 
  "LoopMomenta", "->", "{", "k", "}", ",", "DropScaleless", "->", "True", "]",
   "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[57]:=",ExpressionUUID->"0ef7927c-a3cb-4121-8ea2-d0bdc22b2f06"],

Cell[TextData[{
 "The four checks contract the self-energy with p on ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "294c39ac-7eae-46b4-b61a-de901041422f"],
 ", ",
 Cell[BoxData[
  FormBox["\[Nu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "80ea2bcf-b690-41eb-8c04-ab35eb98f4f6"],
 ", ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "87bd11e2-80db-4923-9e0a-51f0d9acb80f"],
 " and ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "065c2578-29b4-4ddb-86f4-9252550d223b"],
 ", respectively, and add the corresponding one-point contribution. For the \
first contraction the residual is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "\[Mu]"], " ", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Mu]", "\[Nu]", ",", "\[Alpha]", "\[Beta]"}]], "+", 
    FractionBox[
     RowBox[{"\[Kappa]", " ", "t"}], "2"], 
    RowBox[{"(", 
     SuperscriptBox["p", "\[Alpha]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Beta]"}]], "+", 
     SuperscriptBox["p", "\[Beta]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Alpha]"}]], "-", 
     SuperscriptBox["p", "\[Nu]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Alpha]", "\[Beta]"}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"208a6f51-ef34-4f84-9884-2a6d78d9761b"],
 ". Each check leaves three indices free, keeps D symbolic and uses no \
polarisation constraints or on-shell substitution. Each result should be \
True. These checks test the full two-point Ward identity; they do not by \
themselves fix every transverse coefficient or perform renormalisation."
}], "Text",
 Editable->False,ExpressionUUID->"53ee96c4-4ed4-440a-a90e-3c5fbf47f234"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", "FeynGravSimplify", "[", "FVD", "[", "p", ",", 
  "\[Mu]", "]", " ", "GravitonPolarizationOperatorSUNYM", "[", "\[Mu]", ",", 
  "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", "]", "+", "\[Kappa]", " ",
   "gravitonTadpoleSUNYM", "/", "2", " ", "(", "FVD", "[", "p", ",", 
  "\[Alpha]", "]", " ", "MTD", "[", "\[Nu]", ",", "\[Beta]", "]", "+", "FVD", 
  "[", "p", ",", "\[Beta]", "]", " ", "MTD", "[", "\[Nu]", ",", "\[Alpha]", "]",
   "-", "FVD", "[", "p", ",", "\[Nu]", "]", " ", "MTD", "[", "\[Alpha]", ",", 
  "\[Beta]", "]", ")", "]", "]", "==", "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[58]:=",ExpressionUUID->"fe5debc9-20ed-4572-bda5-bf1d0b26eb02"],

