Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", "FeynGravSimplify", "[", "FVD", "[", "p", ",", 
  "\[Alpha]", "]", " ", "GravitonPolarizationOperatorSUNYM", "[", "\[Mu]", ",",
   "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", "]", "+", "\[Kappa]", " ",
