Cell[CellGroupData[{

Cell["Polarisation-projected check", "Subsection",
 Editable->False,
 CellChangeTimes->{
  4.001724404364656*^9},ExpressionUUID->"dc943e53-5c03-4493-8e55-\
1bb25d853be5"],

Cell["\<\
The following cell contracts one graviton index with p and the other three \
with polarisation vectors. It imposes transverse polarisations and a zero \
self-contraction for the conjugated vector, then clears the scalar-product \
definitions. True establishes this restricted projection only: these \
constraints can remove longitudinal terms, including the one-point tadpole \
contribution. It is not the unprojected tadpole-dependent Ward identity. The \
external momentum remains generic; this is not an on-shell graviton \
scattering amplitude.\
\>", "Text",
 Editable->False,ExpressionUUID->"67887e34-47e2-4795-b512-06ac75aaa963"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Nu]", ",", "\[ImaginaryI]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Alpha]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Beta]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "==", "0"}], "//", 
  "Contract"}], "\[IndentingNewLine]", 
 RowBox[{"FCClearScalarProducts", "[", "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{4.001724057839098*^9, 4.001724211914925*^9}, 
   4.001724330676897*^9, {4.001724365130188*^9, 4.001724380614859*^9}, 
   4.001724422521996*^9},
 CellLabel->"In[62]:=",ExpressionUUID->"3ca6528e-c583-47ac-80fd-cc5199c32659"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001726047225272*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"a1f5a37e-f831-465d-b4a8-2830bb2b9ab2"]
}, Open  ]]
