  "\[Mu]", ",", "\[Nu]", "]", ")", "]", "]", "==", "0"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[9]:=",ExpressionUUID->"9ebf23ab-42b5-4aec-8168-8d3cc42613f2"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001726039107987*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"0a1c649a-bbca-4913-9c9f-8a09f690173d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", "FeynGravSimplify", "[", "FVD", "[", "p", ",", 
  "\[Beta]", "]", " ", "GravitonPolarizationOperatorFermion", "[", "\[Mu]", ",",
   "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", "m", "]", "+", 
  "\[Kappa]", " ", "gravitonTadpoleFermion", "/", "2", " ", "(", "FVD", "[", 
