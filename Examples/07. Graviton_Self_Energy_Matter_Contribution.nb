Cell[CellGroupData[{

Cell["Tensor decomposition", "Subsection",
 Editable->False,ExpressionUUID->"ce044ad9-2371-4442-99e9-9c06b3762619"],

Cell[TextData[{
 "The table lists coefficients in the package basis, ordered as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4f47599a-ca64-46c1-91f9-e1fde65dd728"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "62b1433f-7a02-440c-b049-bea7aeb4760a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "006bcaa1-4eac-40c6-ba4a-a883e4d4becf"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["P", "0"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"5c6b6562-b49c-40cb-a9e8-e482db2c6052"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox[
     SubscriptBox["P", "0"], "_"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9c9f670e-577c-43c4-acac-919eb07afec0"],
 ". NieuwenhuizenOperatorExpansion checks reconstruction of the input tensor; \
this is a decomposition, not a comparison with an independent reference. The \
package keeps the fixed ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a0c6f3a0-9ed6-440d-83ad-a03c3a0077cc"],
 " normalisation in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b04d9983-997b-4529-b181-ef5867394556"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b93a9034-1171-4cc7-bd44-f793422f87c4"],
 ". For symbolic D these operators provide a tensor basis, but are not the \
conventional D-dimensional spin projectors normalised with ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"D", "-", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4001a2d5-6bc4-48de-bc63-4646ccd439e1"],
 ". Also, the unchanged collection pattern B0[_] matches one argument, \
whereas B0 has three: it does not explicitly collect B0 terms. This affects \
the requested organisation, not the definition of the tensor."
}], "Text",
 Editable->False,ExpressionUUID->"ec207bf0-0c6b-4db8-86a0-9be7e6820ce0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(0\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[SubscriptBox[\(P\), \(0\)], \
\(_\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[OverscriptBox[SubscriptBox[\(P\), \
\(0\)], \(_\)], \(_\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A0", "[", "_", "]"}], ",", 
            RowBox[{"B0", "[", "_", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
        RowBox[{
         RowBox[{"GravitonPolarizationOperatorFermion", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",",
            "m"}], "]"}], ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", 
         "\[Beta]", ",", "p"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{4.001723803866247*^9, 4.001723919636293*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"853c42b8-fe6b-402b-9f6b-0a7b45cf4555"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(1\\)]\\)\"\>", 
