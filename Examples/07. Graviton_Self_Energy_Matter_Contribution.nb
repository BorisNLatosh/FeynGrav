Cell[CellGroupData[{

Cell["Tensor decomposition", "Subsection",
 Editable->False,ExpressionUUID->"81e67708-2af6-41f2-a9b3-8c558f53a441"],

Cell[TextData[{
 "The table lists coefficients in the package basis, ordered as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bdfab1a2-97c4-4824-9869-8ed8959699ec"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0be59e45-85b2-4c2c-a431-299756d599c4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1df35483-67fe-4515-8d17-08c803b5acb4"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["P", "0"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"80d000be-4f32-4f6d-b385-fb46604ff75c"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox[
     SubscriptBox["P", "0"], "_"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6160e87a-4454-459a-93f3-03eecb8f4cc1"],
 ". NieuwenhuizenOperatorExpansion checks reconstruction of the input tensor; \
this is a decomposition, not a comparison with an independent reference."
}], "Text",
 Editable->False,ExpressionUUID->"d3fc901f-e59e-47e8-b6ec-2b0d67ac49f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(0\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[SubscriptBox[\(P\), \(0\)], \
\(_\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[OverscriptBox[SubscriptBox[\(P\), \
\(0\)], \(_\)], \(_\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A0", "[", "_", "]"}], ",", 
            RowBox[{"B0", "[", "_", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
        RowBox[{
         RowBox[{"GravitonPolarizationOperatorProca", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",",
            "m"}], "]"}], ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", 
         "\[Beta]", ",", "p"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{4.001723803866247*^9, 4.001723919636293*^9}, {
  4.001724034301485*^9, 4.001724049808526*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"428bfd4b-a099-4108-bab6-b45619310e28"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(1\\)]\\)\"\>", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         SuperscriptBox["m", "2"], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
             SuperscriptBox["m", "2"], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm]}], 
        RowBox[{"2", " ", "D"}]]}]},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(2\\)]\\)\"\>", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", 
               SuperscriptBox["D", "2"]}], "-", 
              RowBox[{"3", " ", "D"}], "-", "7"}], ")"}], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "4"]}], "+", 
           RowBox[{"16", " ", 
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], " ", 
            SuperscriptBox["m", "4"]}], "+", 
           RowBox[{"8", " ", 
            RowBox[{"(", 
             RowBox[{"D", "+", "3"}], ")"}], " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}]}], ")"}], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
             RowBox[{
              SuperscriptBox[
               FormBox[
                FormBox["p",
                 TraditionalForm],
                TraditionalForm], "2"], ",", 
              SuperscriptBox["m", "2"], ",", 
              SuperscriptBox["m", "2"]}], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm]}], 
        RowBox[{"16", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]], "-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
             SuperscriptBox["m", "2"], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", 
               SuperscriptBox["D", "2"]}], "-", 
              RowBox[{"3", " ", "D"}], "-", "7"}], ")"}], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}], "+", 
           RowBox[{"4", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", 
               SuperscriptBox["D", "3"]}], "-", 
              RowBox[{"4", " ", 
               SuperscriptBox["D", "2"]}], "+", "D", "+", "1"}], ")"}], " ", 
            SuperscriptBox["m", "2"]}]}], ")"}]}], 
        RowBox[{"8", " ", "D", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]}]},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(0\\)]\\)\"\>", 
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"8", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox["D", "2"]}], "-", 
              RowBox[{"13", " ", "D"}], "-", "6"}], ")"}], " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox["D", "3"]}], "-", 
              RowBox[{"17", " ", 
               SuperscriptBox["D", "2"]}], "+", 
              RowBox[{"18", " ", "D"}], "+", "28"}], ")"}], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "4"]}], "+", 
           RowBox[{"80", " ", 
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], " ", 
            SuperscriptBox["m", "4"]}]}], ")"}], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
             RowBox[{
              SuperscriptBox[
               FormBox[
                FormBox["p",
                 TraditionalForm],
                TraditionalForm], "2"], ",", 
              SuperscriptBox["m", "2"], ",", 
              SuperscriptBox["m", "2"]}], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm]}], 
        RowBox[{"32", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]], "-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
             SuperscriptBox["m", "2"], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               SuperscriptBox["D", "3"]}], "-", 
              RowBox[{"14", " ", 
               SuperscriptBox["D", "2"]}], "+", 
              RowBox[{"11", " ", "D"}], "-", "1"}], ")"}], " ", 
            SuperscriptBox["m", "2"]}], "+", 
           RowBox[{"D", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", 
               SuperscriptBox["D", "3"]}], "-", 
              RowBox[{"17", " ", 
               SuperscriptBox["D", "2"]}], "+", 
              RowBox[{"18", " ", "D"}], "+", "28"}], ")"}], " ", 
            SuperscriptBox[
             FormBox[
              FormBox["p",
               TraditionalForm],
              TraditionalForm], "2"]}]}], ")"}]}], 
        RowBox[{"16", " ", "D", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]}]},
     {"\<\"\\!\\(\\*OverscriptBox[SubscriptBox[\\(P\\), \\(0\\)], \\(_\\)]\\)\
\"\>", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox["\[Pi]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], " ", 
         SuperscriptBox["\[Kappa]", "2"], " ", 
         SuperscriptBox["m", "2"], " ", 
         FormBox[
          TagBox[
           FormBox[
            RowBox[{
             SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
             SuperscriptBox["m", "2"], ")"}],
            TraditionalForm],
           HoldForm],
          TraditionalForm]}], 
        RowBox[{"4", " ", "D"}]]}]},
     {"\<\"\\!\\(\\*OverscriptBox[OverscriptBox[SubscriptBox[\\(P\\), \
\\(0\\)], \\(_\\)], \\(_\\)]\\)\"\>", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"D", "-", "1"}], ")"}], " ", 
        SuperscriptBox["\[Kappa]", "2"], " ", 
        SuperscriptBox["m", "2"], " ", 
        FormBox[
         TagBox[
          FormBox[
           RowBox[{
            SubscriptBox["\<\"A\"\>", "\<\"0\"\>"], "(", 
            SuperscriptBox["m", "2"], ")"}],
           TraditionalForm],
          HoldForm],
         TraditionalForm]}], 
       RowBox[{"4", " ", "D"}]]}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
