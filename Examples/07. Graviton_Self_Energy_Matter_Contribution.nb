Cell[BoxData[
 RowBox[{"Factor", "[", "FeynGravSimplify", "[", "FVD", "[", "p", ",", 
  "\[Beta]", "]", " ", "GravitonPolarizationOperatorSUNYM", "[", "\[Mu]", ",",
   "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", "]", "+", "\[Kappa]", " ",
   "gravitonTadpoleSUNYM", "/", "2", " ", "(", "FVD", "[", "p", ",", "\[Mu]", 
  "]", " ", "MTD", "[", "\[Alpha]", ",", "\[Nu]", "]", "+", "FVD", "[", "p", ",",
   "\[Nu]", "]", " ", "MTD", "[", "\[Alpha]", ",", "\[Mu]", "]", "-", "FVD", "[",
