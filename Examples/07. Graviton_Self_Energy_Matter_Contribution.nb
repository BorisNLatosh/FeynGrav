Cell["\<\
The following cell contracts one graviton index with p and the other three \
with polarisation vectors. It imposes transverse polarisations and a zero \
self-contraction for the conjugated vector, then clears the scalar-product \
definitions. True establishes this restricted projection only: these \
constraints can remove longitudinal terms, including the one-point tadpole \
contribution. It is not the unprojected tadpole-dependent Ward identity. The \
external momentum remains generic; this is not an on-shell graviton \
scattering amplitude.\
\>", "Text",
 Editable->False,ExpressionUUID->"a68ca4c9-e0f0-4e49-a5ab-ecbfc6b30a3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorProca", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
      "m"}], "]"}], 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Nu]", ",", "\[ImaginaryI]"}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Alpha]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], 
    RowBox[{"PolarizationVectorD", "[", 
     RowBox[{"p", ",", "\[Beta]", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}], "==", "0"}], "//", 
  "Contract"}], "\[IndentingNewLine]", 
 RowBox[{"FCClearScalarProducts", "[", "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{4.001724057839098*^9, 4.001724211914925*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"6473b7f7-cabc-49a2-b388-d51f9ed629b1"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001726042033764*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"597afba3-ecc8-455e-94f1-71cb8299447d"]
}, Open  ]]
