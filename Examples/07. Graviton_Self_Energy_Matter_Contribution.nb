Cell[CellGroupData[{

Cell["4. Massive-vector loop", "Section",
 Editable->False,ExpressionUUID->"44d71d5e-8594-4c64-a47a-53ba3d1f8658"],

Cell[TextData[{
 "A massive Proca field contributes the contact and bubble diagrams below, \
each with the real-boson symmetry factor ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c4efb6a-5b98-4b5e-a19e-25e84b9eeb5e"],
 ". Keep the longitudinal part of the Proca propagator. The calculation is \
for nonzero symbolic mass; a massless gauge field is treated separately below."
}], "Text",
 Editable->False,ExpressionUUID->"6ad0d672-6659-437c-a598-e0ecaaa3ad37"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",
 Editable->False,ExpressionUUID->"d0c8f8e4-8127-4444-aec1-0acae79e55f9"],

Cell[TextData[{
 "Close the two matter legs of a vertex with two external gravitons. This \
two-point contact diagram is often called a tadpole diagram; it is distinct \
from the one-external-graviton amplitude that appears in the full Ward \
identity. Its massive ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "64e49daf-6757-440f-9883-19612ee91b53"],
 " contribution must be retained."
}], "Text",
 Editable->False,ExpressionUUID->"6e106bf7-31bc-4131-9dc9-068e0a9ca25e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"PaVeToABCD", "[", 
    RowBox[{"FeynGravSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GravitonMassiveVectorVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
            "}"}], ",", "\[Lambda]1", ",", 
           RowBox[{"-", "k"}], ",", "\[Lambda]2", ",", "k", ",", "m"}], "]"}],
          " ", 
         RowBox[{"ProcaPropagator", "[", 
          RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "k", ",", "m"}], 
          "]"}]}], ")"}], "/", "2"}], ",", 
      RowBox[{"LoopMomenta", "->", 
       RowBox[{"{", "k", "}"}]}], ",", 
      RowBox[{"DropScaleless", "->", "True"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0000983717955647`*^9, 4.0000983874326363`*^9}, {
  4.001723947914126*^9, 4.001723980531727*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"9861ccf2-4557-4d05-9c55-2f98287fd965"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble contributions", "Subsection",
 Editable->False,ExpressionUUID->"96e48691-f243-4800-97ac-fc5733c319f9"],

Cell["\<\
Join the two matter\[Dash]graviton vertices with the indicated propagators. \
The integrand specifies the momentum routing; k is the integration variable.\
\>", "Text",
 Editable->False,ExpressionUUID->"fe61dee9-b03b-480b-acca-00b1b38a9a59"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"PaVeToABCD", "[", 
    RowBox[{"FeynGravSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GravitonMassiveVectorVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "\[Rho]1", ",", 
           RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], " ", 
         RowBox[{"ProcaPropagator", "[", 
          RowBox[{"\[Rho]1", ",", "\[Rho]2", ",", "k", ",", "m"}], "]"}], " ", 
         RowBox[{"ProcaPropagator", "[", 
          RowBox[{"\[Sigma]1", ",", "\[Sigma]2", ",", 
           RowBox[{"p", "-", "k"}], ",", "m"}], "]"}], " ", 
         RowBox[{"GravitonMassiveVectorVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "\[Rho]2", ",", 
           "k", ",", "\[Sigma]2", ",", 
           RowBox[{"p", "-", "k"}], ",", "m"}], "]"}]}], ")"}], "/", "2"}], ",", 
      RowBox[{"LoopMomenta", "->", 
       RowBox[{"{", "k", "}"}]}], ",", 
      RowBox[{"DropScaleless", "->", "True"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098392883709*^9, 4.000098400087792*^9}, {
  4.001723986656376*^9, 4.00172398695063*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"0eecc726-4119-4373-9cc1-84eaf4230b6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined tensor", "Subsection",
 Editable->False,ExpressionUUID->"199334d1-19c9-4362-a4ff-9a46dd007fb6"],

Cell["\<\
Add the contact and bubble amplitudes. Their definitions include the \
real-boson symmetry factor 1/2 or the closed-Dirac/ghost-loop sign -1, as \
appropriate. Colour multiplicities are retained.\
\>", "Text",
 Editable->False,ExpressionUUID->"2ae10cef-88a5-403e-906b-7dce42647f13"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonPolarizationOperatorProca1", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], "+", 
      RowBox[{"GravitonPolarizationOperatorProca2", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[20]:=",ExpressionUUID->"342e84e3-e525-41aa-8499-5736972eb952"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Full tadpole-dependent Ward identities", "Subsection",
 Editable->False,ExpressionUUID->"7f45d3f5-5060-4483-9e82-80ca303827b0"],

Cell[TextData[{
 "The one-external-graviton loop has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{"\[Alpha]", "\[Beta]"}]], "=", "t", " ", 
    SuperscriptBox["\[Eta]", 
     RowBox[{"\[Alpha]", "\[Beta]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"69f4c595-09cb-4204-817d-f0328c5db06d"],
 ". The first cell computes t by contracting its two indices and dividing by \
D. This one-point function is different from the two-graviton contact loop \
calculated above. Both use the same loop normalisation and diagram weights. \
The massive one-point function is retained; no vacuum-energy subtraction is \
made."
}], "Text",
 Editable->False,ExpressionUUID->"4b6835e0-3646-4337-93fb-c409bc422629"],

Cell[BoxData[
 RowBox[{"gravitonTadpoleProca", "=", "PaVeToABCD", "[", "FeynGravSimplify", "[",
   "Contract", "[", "MTD", "[", "\[Alpha]", ",", "\[Beta]", "]", " ", "(", 
  "GravitonMassiveVectorVertex", "[", "{", "\[Alpha]", ",", "\[Beta]", "}", ",",
   "\[Rho]1", ",", "k", ",", "\[Rho]2", ",", "-", "k", ",", "m", "]", " ", 
  "ProcaPropagator", "[", "\[Rho]1", ",", "\[Rho]2", ",", "k", ",", "m", "]", 
  "/", "2", ")", "]", "/", "D", ",", "LoopMomenta", "->", "{", "k", "}", ",", 
  "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[21]:=",ExpressionUUID->"de1b92ac-7a1a-49b3-b03d-1c4e094e1f8b"],

Cell[TextData[{
 "The four checks contract the self-energy with p on ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f542e966-8553-4e7f-96b3-71adf1f9b1a5"],
 ", ",
 Cell[BoxData[
  FormBox["\[Nu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "edfcc83f-7e18-42ed-9e5d-de2fbfa4d454"],
 ", ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ec2e2713-90cd-4b78-8c6c-1e755fd393af"],
 " and ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c4413c8-b508-4e40-927d-bf44687f2005"],
 ", respectively, and add the corresponding one-point contribution. For the \
first contraction the residual is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "\[Mu]"], " ", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Mu]", "\[Nu]", ",", "\[Alpha]", "\[Beta]"}]], "+", 
    FractionBox[
     RowBox[{"\[Kappa]", " ", "t"}], "2"], 
    RowBox[{"(", 
     SuperscriptBox["p", "\[Alpha]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Beta]"}]], "+", 
     SuperscriptBox["p", "\[Beta]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Alpha]"}]], "-", 
     SuperscriptBox["p", "\[Nu]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Alpha]", "\[Beta]"}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"51c3d8d7-b8b5-4885-9acf-457c31640b5f"],
 ". Each check leaves three indices free, keeps D symbolic and uses no \
polarisation constraints or on-shell substitution. Each result should be \
True. These checks test the full two-point Ward identity; they do not by \
themselves fix every transverse coefficient or perform renormalisation."
}], "Text",
 Editable->False,ExpressionUUID->"135dfbdd-22c2-40a6-b745-92c940018979"],

