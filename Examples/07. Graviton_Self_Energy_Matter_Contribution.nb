Cell[CellGroupData[{

Cell["5. Massless-vector loop", "Section",
 Editable->False,ExpressionUUID->"a99a265e-c423-4d84-9a32-493f5a99c08a"],

Cell[TextData[{
 "The massless-vector sector includes the vector and its Faddeev-Popov ghost \
diagrams at the package defaults. Vector loops carry weight ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e459fb5a-7c3e-4ff9-862b-d9ada2307c96"],
 " and closed ghost loops carry weight -1. With DropScaleless -> True, \
massless contact integrals vanish in dimensional regularisation."
}], "Text",
 Editable->False,ExpressionUUID->"2dce0b18-815b-4524-b144-bd79b6f97d94"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",
 Editable->False,ExpressionUUID->"4c28ea24-bf0d-40d0-95f9-da00e2afa923"],

Cell["\<\
Close the two matter legs of a vertex with two external gravitons. This \
two-point contact diagram is often called a tadpole diagram; it is distinct \
from the one-external-graviton amplitude that appears in the full Ward \
identity. Here the internal fields are massless, and scaleless contact \
integrals are removed by the chosen dimensional-regularisation prescription.\
\>", "Text",
 Editable->False,ExpressionUUID->"5059e595-2380-4e3e-a7bc-a477498b8c19"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"PaVeToABCD", "[", 
    RowBox[{"FeynGravSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Explicit", "[", 
         RowBox[{
          RowBox[{"GravitonVectorVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]",
               ",", 
              RowBox[{"-", "p"}]}], "}"}], ",", "\[Lambda]1", ",", "k", ",", 
            "\[Lambda]2", ",", 
            RowBox[{"-", "k"}]}], "]"}], " ", 
          RowBox[{"GluonPropagator", "[", 
           RowBox[{"k", ",", 
            RowBox[{"{", "\[Lambda]1", "}"}], ",", 
            RowBox[{"{", "\[Lambda]2", "}"}]}], "]"}]}], "]"}], ")"}], "/", 
       "2"}], ",", 
      RowBox[{"LoopMomenta", "->", 
       RowBox[{"{", "k", "}"}]}], ",", 
      RowBox[{"DropScaleless", "->", "True"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098603507942*^9, 4.0000986074974413`*^9}, {
  4.00172427812497*^9, 4.0017242783179407`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"514d44c4-6fce-4d0b-a0a7-569fef4e4b80"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorVector1Ghost", "[", "\[Mu]_", ",", 
  "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", 
  "PaVeToABCD", "[", "FeynGravSimplify", "[", "-", "(", 
  "GravitonVectorGhostVertex", "[", "{", "\[Mu]", ",", "\[Nu]", ",", 
  "\[Alpha]", ",", "\[Beta]", "}", ",", "k", ",", "-", "k", "]", " ", 
  "ScalarPropagator", "[", "k", ",", "0", "]", ")", ",", "LoopMomenta", "->", 
  "{", "k", "}", ",", "DropScaleless", "->", "True", "]", "]", ";"}]], "Input",\

 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098593775447*^9, 4.000098596455524*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"af2932c5-475d-4441-91e3-da4580dc4b90"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble contributions", "Subsection",
 Editable->False,ExpressionUUID->"e24ecb5c-6582-4ca3-b0d1-0253927a4de2"],

Cell["\<\
Join the two matter\[Dash]graviton vertices with the indicated propagators. \
The integrand specifies the momentum routing; k is the integration variable.\
\>", "Text",
 Editable->False,ExpressionUUID->"d79f4c0b-2649-4739-80a9-98a076858c15"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"PaVeToABCD", "[", 
    RowBox[{"FeynGravSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Explicit", "[", 
         RowBox[{
          RowBox[{"GravitonVectorVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", "\[Rho]1",
             ",", 
            RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
          RowBox[{"GravitonVectorVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
              RowBox[{"-", "p"}]}], "}"}], ",", "\[Rho]2", ",", "k", ",", 
            "\[Sigma]2", ",", 
            RowBox[{"p", "-", "k"}]}], "]"}], " ", 
          RowBox[{"GluonPropagator", "[", 
           RowBox[{"k", ",", 
            RowBox[{"{", "\[Rho]1", "}"}], ",", 
            RowBox[{"{", "\[Rho]2", "}"}]}], "]"}], " ", 
          RowBox[{"GluonPropagator", "[", 
           RowBox[{
            RowBox[{"p", "-", "k"}], ",", 
            RowBox[{"{", "\[Sigma]1", "}"}], ",", 
            RowBox[{"{", "\[Sigma]2", "}"}]}], "]"}]}], "]"}], ")"}], "/", 
       "2"}], ",", 
      RowBox[{"LoopMomenta", "->", 
       RowBox[{"{", "k", "}"}]}], ",", 
      RowBox[{"DropScaleless", "->", "True"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.0000986277265368`*^9, 4.000098637269905*^9}, {
  4.0017242878244753`*^9, 4.001724288037919*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"ac9ea415-655a-46bd-a52d-e75087fb9283"],

Cell[BoxData[
 RowBox[{"GravitonPolarizationOperatorVector2Ghost", "[", "\[Mu]_", ",", 
  "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", "]", "=", 
  "PaVeToABCD", "[", "FeynGravSimplify", "[", "-", "(", 
  "GravitonVectorGhostVertex", "[", "{", "\[Mu]", ",", "\[Nu]", "}", ",", "-",
   "k", ",", "-", "(", "p", "-", "k", ")", "]", " ", 
  "GravitonVectorGhostVertex", "[", "{", "\[Alpha]", ",", "\[Beta]", "}", ",",
   "k", ",", "p", "-", "k", "]", " ", "ScalarPropagator", "[", "k", ",", "0", 
  "]", " ", "ScalarPropagator", "[", "p", "-", "k", ",", "0", "]", ")", ",", 
  "LoopMomenta", "->", "{", "k", "}", ",", "DropScaleless", "->", "True", "]",
   "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.000098645755061*^9, 4.000098652164929*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"50da5d62-0e9e-418c-a158-671af3a9ae0b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined tensor", "Subsection",
 Editable->False,ExpressionUUID->"49a29b31-3b0f-482d-a35a-486d74b974d0"],

Cell["\<\
Add the contact and bubble amplitudes. Their definitions include the \
real-boson symmetry factor 1/2 or the closed-Dirac/ghost-loop sign -1, as \
appropriate. Colour multiplicities are retained.\
\>", "Text",
 Editable->False,ExpressionUUID->"d9555789-0f90-4faa-8fb4-ff0a6ec614b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorVector1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorVector1Ghost", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorVector2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorVector2Ghost", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{{4.001724352290563*^9, 4.001724354800729*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"d2fc1e9b-4879-42fd-bf5c-d36f92a4663a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Full tadpole-dependent Ward identities", "Subsection",
 Editable->False,ExpressionUUID->"dc72fc4f-ffb5-4ed2-a680-2749365684b3"],

Cell[TextData[{
 "The one-external-graviton loop has the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["T", 
     RowBox[{"\[Alpha]", "\[Beta]"}]], "=", "t", " ", 
    SuperscriptBox["\[Eta]", 
     RowBox[{"\[Alpha]", "\[Beta]"}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e211b0c4-2ffe-4905-b137-60e3fce461ba"],
 ". The first cell computes t by contracting its two indices and dividing by \
D. This one-point function is different from the two-graviton contact loop \
calculated above. Both use the same loop normalisation and diagram weights. \
With these massless fields and DropScaleless -> True, the one-point integrals \
are scaleless and t vanishes."
}], "Text",
 Editable->False,ExpressionUUID->"1700c99a-21d6-4125-a9db-83c60887372f"],

Cell[BoxData[
 RowBox[{"gravitonTadpoleVector", "=", "PaVeToABCD", "[", "FeynGravSimplify", 
  "[", "Contract", "[", "MTD", "[", "\[Alpha]", ",", "\[Beta]", "]", " ", "(",
   "Explicit", "[", "GravitonVectorVertex", "[", "{", "\[Alpha]", ",", 
  "\[Beta]", ",", "0", "}", ",", "\[Rho]1", ",", "k", ",", "\[Rho]2", ",", "-",
   "k", "]", " ", "GluonPropagator", "[", "k", ",", "{", "\[Rho]1", "}", ",", 
  "{", "\[Rho]2", "}", "]", "]", "/", "2", "-", "GravitonVectorGhostVertex", "[",
   "{", "\[Alpha]", ",", "\[Beta]", "}", ",", "k", ",", "-", "k", "]", " ", 
  "ScalarPropagator", "[", "k", ",", "0", "]", ")", "]", "/", "D", ",", 
  "LoopMomenta", "->", "{", "k", "}", ",", "DropScaleless", "->", "True", "]",
   "]", ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[38]:=",ExpressionUUID->"880e380b-63c1-4bc2-89e5-b156cdd1fcb1"],

Cell[TextData[{
 "The four checks contract the self-energy with p on ",
 Cell[BoxData[
  FormBox["\[Mu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dbd18c1c-a6bd-4a67-9c6a-64f8bf03b490"],
 ", ",
 Cell[BoxData[
  FormBox["\[Nu]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7f009ce7-4fe1-4558-9bce-cb9011c38601"],
 ", ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a2c7bd34-893c-446e-aa88-9741188a7ad6"],
 " and ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "853c9070-0334-4464-bbee-0fcab5c51dc8"],
 ", respectively, and add the corresponding one-point contribution. For the \
first contraction the residual is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "\[Mu]"], " ", 
    SuperscriptBox["\[CapitalPi]", 
     RowBox[{"\[Mu]", "\[Nu]", ",", "\[Alpha]", "\[Beta]"}]], "+", 
    FractionBox[
     RowBox[{"\[Kappa]", " ", "t"}], "2"], 
    RowBox[{"(", 
     SuperscriptBox["p", "\[Alpha]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Beta]"}]], "+", 
     SuperscriptBox["p", "\[Beta]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Nu]", "\[Alpha]"}]], "-", 
     SuperscriptBox["p", "\[Nu]"], " ", 
     SuperscriptBox["\[Eta]", 
      RowBox[{"\[Alpha]", "\[Beta]"}]], ")"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7bec4935-f810-4adc-b00d-51d4b5ccf2a8"],
 ". Each check leaves three indices free, keeps D symbolic and uses no \
polarisation constraints or on-shell substitution. Each result should be \
True. These checks test the full two-point Ward identity; they do not by \
themselves fix every transverse coefficient or perform renormalisation."
}], "Text",
 Editable->False,ExpressionUUID->"0f821aea-3aba-4aaa-a91f-2849b9b59856"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Factor", "[", "FeynGravSimplify", "[", "FVD", "[", "p", ",", 
  "\[Mu]", "]", " ", "GravitonPolarizationOperatorVector", "[", "\[Mu]", ",", 
  "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", "]", "+", "\[Kappa]", " ",
