Cell[CellGroupData[{

Cell["Tensor decomposition", "Subsection",
 Editable->False,ExpressionUUID->"e21eec27-c9dd-47db-8013-966d4bc61a90"],

Cell[TextData[{
 "The table lists coefficients in the package basis, ordered as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "277922f9-6f2e-46be-ad08-a4555d8dbb26"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7866462-0693-49b4-86d2-3cff17ac9a98"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7452c66e-2fdb-4ea1-8463-0bed7aaa2536"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["P", "0"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ede76479-1c2d-444b-b7f7-4c3b66661d4a"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox[
     SubscriptBox["P", "0"], "_"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"26a774dc-5cb6-480e-b813-c5f91d6dda92"],
 ". NieuwenhuizenOperatorExpansion checks reconstruction of the input tensor; \
this is a decomposition, not a comparison with an independent reference."
}], "Text",
 Editable->False,ExpressionUUID->"e5fc5173-dbec-40ce-bf4e-09cd2882824a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(0\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[SubscriptBox[\(P\), \(0\)], \
\(_\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[OverscriptBox[SubscriptBox[\(P\), \
\(0\)], \(_\)], \(_\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A0", "[", "_", "]"}], ",", 
            RowBox[{"B0", "[", "_", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
        RowBox[{
         RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}], ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", 
         ",", "p"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{4.001723803866247*^9, 4.001723919636293*^9}, {
   4.001724034301485*^9, 4.001724049808526*^9}, 4.001724341250444*^9, {
   4.001724384414403*^9, 4.001724384576133*^9}, 4.00172442508818*^9},
 CellLabel->"In[68]:=",ExpressionUUID->"8f2c4cb0-75ce-400f-9464-fca26b28bd9c"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(1\\)]\\)\"\>", "0"},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(2\\)]\\)\"\>", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        SuperscriptBox["\[Kappa]", "2"], " ", 
        SuperscriptBox[
         FormBox[
          FormBox["p",
           TraditionalForm],
          TraditionalForm], "4"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["D", "2"]}], "-", 
             RowBox[{"3", " ", "D"}], "-", "8"}], ")"}], " ", 
           SubsuperscriptBox["C", "A", "2"]}], "+", 
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"D", "-", "1"}], ")"}], " ", 
           SubscriptBox["C", "A"]}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["D", "2"]}], "+", 
          RowBox[{"3", " ", "D"}], "+", "8"}], ")"}], " ", 
        FormBox[
         TagBox[
          FormBox[
           RowBox[{
            SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
            RowBox[{
             SuperscriptBox[
              FormBox[
               FormBox["p",
                TraditionalForm],
               TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
           TraditionalForm],
          HoldForm],
         TraditionalForm]}], 
       RowBox[{"16", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(0\\)]\\)\"\>", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"D", "-", "4"}], ")"}], " ", 
        SuperscriptBox["\[Kappa]", "2"], " ", 
        SuperscriptBox[
         FormBox[
          FormBox["p",
           TraditionalForm],
          TraditionalForm], "4"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"3", " ", 
              SuperscriptBox["D", "2"]}], "-", 
             RowBox[{"8", " ", "D"}], "-", "8"}], ")"}], " ", 
           SubsuperscriptBox["C", "A", "2"]}], "+", 
          RowBox[{"4", " ", 
           SubscriptBox["C", "A"]}], "-", 
          RowBox[{"3", " ", 
           SuperscriptBox["D", "2"]}], "+", 
          RowBox[{"8", " ", "D"}], "+", "8"}], ")"}], " ", 
        FormBox[
         TagBox[
          FormBox[
           RowBox[{
            SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
            RowBox[{
             SuperscriptBox[
              FormBox[
               FormBox["p",
                TraditionalForm],
               TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
           TraditionalForm],
          HoldForm],
         TraditionalForm]}], 
       RowBox[{"32", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]},
     {"\<\"\\!\\(\\*OverscriptBox[SubscriptBox[\\(P\\), \\(0\\)], \\(_\\)]\\)\
\"\>", "0"},
     {"\<\"\\!\\(\\*OverscriptBox[OverscriptBox[SubscriptBox[\\(P\\), \
\\(0\\)], \\(_\\)], \\(_\\)]\\)\"\>", "0"}
    },
