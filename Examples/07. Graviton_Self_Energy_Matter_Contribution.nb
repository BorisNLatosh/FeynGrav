Cell[CellGroupData[{

Cell["Tensor decomposition", "Subsection",
 Editable->False,ExpressionUUID->"ed5432be-8784-4a77-9ab1-0828efa0cb4e"],

Cell[TextData[{
 "The table lists coefficients in the package basis, ordered as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ed7d483a-8993-469c-af55-9eb8148c1d60"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfa1299c-f04f-494d-9eaf-4bdfc6a896ec"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "47a3d588-b0c1-4e44-9ccc-d6480a68df84"],
 ", ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    SubscriptBox["P", "0"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eac6a3de-b943-45da-9fd6-455f8895dea4"],
 " and ",
 Cell[BoxData[
  FormBox[
   OverscriptBox[
    OverscriptBox[
     SubscriptBox["P", "0"], "_"], "_"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"77d455d0-2ea8-4c74-9cc2-e33703b482b4"],
 ". NieuwenhuizenOperatorExpansion checks reconstruction of the input tensor; \
this is a decomposition, not a comparison with an independent reference."
}], "Text",
 Editable->False,ExpressionUUID->"46d49b7d-bc5c-4af7-a832-63b1255138f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(P\), \(1\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(2\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*SubscriptBox[\(P\), \(0\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[SubscriptBox[\(P\), \(0\)], \
\(_\)]\)\>\"", ",", 
        " ", "\"\<\!\(\*OverscriptBox[OverscriptBox[SubscriptBox[\(P\), \
\(0\)], \(_\)], \(_\)]\)\>\""}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"A0", "[", "_", "]"}], ",", 
            RowBox[{"B0", "[", "_", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
        RowBox[{
         RowBox[{"GravitonPolarizationOperatorVector", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}], ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", 
         ",", "p"}], "]"}]}]}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{4.001723803866247*^9, 4.001723919636293*^9}, {
   4.001724034301485*^9, 4.001724049808526*^9}, 4.001724341250444*^9, {
   4.001724384414403*^9, 4.001724384576133*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"0fb09482-d1de-4da6-96eb-c4e07b82d7e3"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(1\\)]\\)\"\>", "0"},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(2\\)]\\)\"\>", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           SuperscriptBox["D", "2"]}], "-", 
          RowBox[{"3", " ", "D"}], "-", "8"}], ")"}], " ", 
        SuperscriptBox["\[Kappa]", "2"], " ", 
        SuperscriptBox[
         FormBox[
          FormBox["p",
           TraditionalForm],
          TraditionalForm], "4"], " ", 
        FormBox[
         TagBox[
          FormBox[
           RowBox[{
            SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
            RowBox[{
             SuperscriptBox[
              FormBox[
               FormBox["p",
                TraditionalForm],
               TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
           TraditionalForm],
          HoldForm],
         TraditionalForm]}], 
       RowBox[{"16", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]},
     {"\<\"\\!\\(\\*SubscriptBox[\\(P\\), \\(0\\)]\\)\"\>", 
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["D", "3"]}], "-", 
          RowBox[{"20", " ", 
           SuperscriptBox["D", "2"]}], "+", 
          RowBox[{"24", " ", "D"}], "+", "32"}], ")"}], " ", 
        SuperscriptBox["\[Kappa]", "2"], " ", 
        SuperscriptBox[
         FormBox[
          FormBox["p",
           TraditionalForm],
          TraditionalForm], "4"], " ", 
        FormBox[
         TagBox[
          FormBox[
           RowBox[{
            SubscriptBox["\<\"B\"\>", "\<\"0\"\>"], "(", 
            RowBox[{
             SuperscriptBox[
              FormBox[
               FormBox["p",
                TraditionalForm],
               TraditionalForm], "2"], ",", "0", ",", "0"}], ")"}],
           TraditionalForm],
          HoldForm],
         TraditionalForm]}], 
       RowBox[{"32", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["D", "2"], "-", "1"}], ")"}]}]]},
     {"\<\"\\!\\(\\*OverscriptBox[SubscriptBox[\\(P\\), \\(0\\)], \\(_\\)]\\)\
\"\>", "0"},
     {"\<\"\\!\\(\\*OverscriptBox[OverscriptBox[SubscriptBox[\\(P\\), \
\\(0\\)], \\(_\\)], \\(_\\)]\\)\"\>", "0"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.001726043948752*^9},
