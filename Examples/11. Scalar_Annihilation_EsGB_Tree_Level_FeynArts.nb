Cell["5. Calculate the on-shell amplitude", "Section",ExpressionUUID->"d7367d8a-3470-48cd-a0ce-b9daed560672"],

Cell["\<\
The diagram result is i M; division by I defines M. External propagators are \
removed and the two outgoing polarisation tensors are attached explicitly. \
ScalarMass, GaussBonnetG1 and GaussBonnetG2 are replaced by m, g1 and g2. The \
option ChangeDimension -> D keeps the converted tensors in the same Lorentz \
space as the external polarisations; explicit D-dependent coefficients are \
retained. No loop integration, symmetry factor for final-state phase space or \
polarisation sum is performed.\
\>", "Text",ExpressionUUID->"61097593-813e-436d-b6ea-a234067ffa02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalM]", " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ExpandScalarProduct", "[", 
        RowBox[{"Contract", "[", 
         RowBox[{
          RowBox[{"FeynAmpDenominatorExplicit", "[", 
           RowBox[{
            RowBox[{"FCFAConvert", "[", 
             RowBox[{
              RowBox[{"CreateFeynAmp", "[", 
               RowBox[{"insertions", ",", " ", 
                RowBox[{"PreFactor", " ", "->", " ", "1"}], ",", " ", 
                RowBox[{"GaugeRules", " ", "->", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                RowBox[{"MomentumConservation", " ", "->", " ", "True"}], ",",
                 " ", 
                RowBox[{"Truncated", " ", "->", " ", "True"}]}], "]"}], ",", 
              " ", 
              RowBox[{"IncomingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
              RowBox[{"OutgoingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", " ", 
              RowBox[{"LorentzIndexNames", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{
                "\[Mu]3", ",", " ", "\[Nu]3", ",", " ", "\[Mu]4", ",", " ", 
                 "\[Nu]4", ",", " ", "\[Alpha]", ",", " ", "\[Beta]", ",", 
                 " ", "\[Gamma]", ",", " ", "\[Delta]"}], "}"}]}], ",", "  ", 
              
              RowBox[{"ChangeDimension", " ", "->", " ", "D"}], ",", " ", 
              RowBox[{"Contract", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"Prefactor", " ", "->", " ", "1"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ScalarMass", " ", "->", " ", "m"}], ",", " ", 
              RowBox[{"GaussBonnetG1", " ", "->", " ", "g1"}], ",", " ", 
              RowBox[{"GaussBonnetG2", " ", "->", " ", "g2"}]}], "}"}]}], 
           "]"}], " ", "externalTensors"}], "]"}], "]"}], "/", "I"}], " ", 
      "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"g1", ",", " ", "g2"}], "}"}], ",", " ", "Factor"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.001391917053898*^9, 4.001391922077232*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"97e96685-583e-4c05-8fb6-d4d49da81456"],

