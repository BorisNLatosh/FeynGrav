Cell["Gauge invariance must be checked on the tensor amplitude, not by replacing polarisations in the final helicity expression. Here ξ is arbitrary and the other graviton is represented by a generic transverse null vector ε3 or ε4. Crossed products ε3·p4 and ε4·p3 are not set to zero. Symmetry supplies the other term in the gauge variation pμ ξν + ξμ pν. The expected residuals are {0, 0}.", "Text", ExpressionUUID->"cd50ad53-3622-447a-a51c-de3369b4eb72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wardTensor", " ", "=", " ", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{"FCFAConvert", "[", 
       RowBox[{
        RowBox[{"CreateFeynAmp", "[", 
         RowBox[{"insertions", ",", " ", 
          RowBox[{"PreFactor", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"GaugeRules", " ", "->", " ", 
           RowBox[{"{", "}"}]}], ",", " ", 
          RowBox[{"MomentumConservation", " ", "->", " ", "True"}], ",", " ", 
          
          RowBox[{"Truncated", " ", "->", " ", "True"}]}], "]"}], ",", " ", 
        RowBox[{"IncomingMomenta", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
        RowBox[{"OutgoingMomenta", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", " ", 
        RowBox[{"LorentzIndexNames", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
          "\[Mu]3", ",", " ", "\[Nu]3", ",", " ", "\[Mu]4", ",", " ", 
           "\[Nu]4", ",", " ", "\[Alpha]", ",", " ", "\[Beta]", ",", " ", 
           "\[Gamma]", ",", " ", "\[Delta]"}], "}"}]}], ",", " ", 
        RowBox[{"ChangeDimension", " ", "->", " ", "D"}], ",", " ", 
        RowBox[{"Contract", " ", "->", " ", "False"}], ",", " ", 
        RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
        RowBox[{"Prefactor", " ", "->", " ", "1"}]}], "]"}], " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ScalarMass", " ", "->", " ", "m"}], ",", " ", 
        RowBox[{"GaussBonnetG1", " ", "->", " ", "g1"}], ",", " ", 
        RowBox[{"GaussBonnetG2", " ", "->", " ", "g2"}]}], "}"}]}], "]"}], "/",
     "I"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wardRules", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"SPD", "[", "\[CurlyEpsilon]3", "]"}], " ", "->", " ", "0"}], ",",
       " ", 
      RowBox[{
       RowBox[{"SPD", "[", "\[CurlyEpsilon]4", "]"}], " ", "->", " ", "0"}], ",",
       " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"\[CurlyEpsilon]3", ",", " ", "p3"}], "]"}], " ", "->", " ", 
       "0"}], ",", " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"\[CurlyEpsilon]4", ",", " ", "p4"}], "]"}], " ", "->", " ", 
       "0"}], ",", " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"\[CurlyEpsilon]3", ",", " ", "p2"}], "]"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"\[CurlyEpsilon]3", ",", " ", "p4"}], "]"}], " ", "-", " ", 
        RowBox[{"SPD", "[", 
         RowBox[{"\[CurlyEpsilon]3", ",", " ", "p1"}], "]"}]}]}], ",", " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
