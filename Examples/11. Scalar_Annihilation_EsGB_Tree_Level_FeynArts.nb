     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "I"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], "=", "0"}], 
  ";"}], "\n", 
