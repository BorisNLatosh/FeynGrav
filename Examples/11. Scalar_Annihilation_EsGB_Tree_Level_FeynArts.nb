Cell[CellGroupData[{

Cell["2. Load the FeynArts model", "Section",ExpressionUUID->"8b587cdc-7b37-42ba-a731-01dcd3db0981"],

Cell[BoxData[
 RowBox[{
  RowBox[{"model", " ", "=", " ", "\"\<Einstein-scalar-Gauss-Bonnet\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.001391521468733*^9, 4.001391521786271*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"91d01f96-f0be-4ba4-956e-04511203e71d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Generate and display the diagrams", "Section",ExpressionUUID->"cc78a90c-c317-41fc-b712-cb3550fc664c"],

Cell["\<\
Six diagrams contribute: the combined minimal/Gauss\[Dash]Bonnet hh phi phi \
contact; the minimal s-channel graviton exchange; minimal t- and u-channel \
scalar exchanges; and two additional t- and u-channel graviton exchanges \
proportional to g1^2. Ghosts do not contribute to this tree. The last two \
diagrams have total order kappa^4; they are retained because the model cutoff \
is kappa^2 per vertex, not per amplitude.\
\>", "Text",ExpressionUUID->"0597466f-f456-4dcc-8eaf-acbcbc1e1363"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"topologies", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Adjacencies", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"insertions", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"topologies", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", "[", "1", "]"}], ",", " ", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"9ac0cd99-630a-47c8-8bdc-965dde93843b"],

