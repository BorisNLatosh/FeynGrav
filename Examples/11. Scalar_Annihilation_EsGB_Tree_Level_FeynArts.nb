Cell["Consistency checks", "Subsection",ExpressionUUID->"4cbcc62a-5a89-407c-9fe6-857ceefdf1b0"],

Cell["The table checks the coupling decomposition, the two generic Ward contractions above and the zero-gravity limit. Equalities are understood away from propagator poles. These tree-level checks do not establish loop results.", "Text", ExpressionUUID->"8393748d-45b7-4d5b-a4e8-1d9ae43a2ac6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"kinematicZero", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{"ExpandScalarProduct", "[", "expr", "]"}], " ", "/.", " ", 
      RowBox[{"u", " ", "->", " ", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"m", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", 
        "t"}]}]}], "]"}], " ", "===", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Coupling decomposition\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{
       "\[ScriptCapitalM]", " ", "-", " ", "mMinimal", " ", "-", " ", 
        "mQuadraticCoupling", " ", "-", " ", "mLinearCouplingExchange"}], 
       "]"}]}], ",", " ", 
     RowBox[{"\"\<Graviton p3 Ward identity\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"wardResiduals", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "===", " ", "0"}], ")"}]}], ",",
      " ", 
     RowBox[{"\"\<Graviton p4 Ward identity\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"wardResiduals", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "===", " ", "0"}], ")"}]}], ",",
      " ", 
     RowBox[{"\"\<Gravity switched off\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
        RowBox[{"\[Kappa]", " ", "->", " ", "0"}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"List", " ", "@@@", " ", "checks"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Check\>\"", ",", " ", "\"\<Passed\>\""}], "}"}]}], "]"}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"81f41fa3-4e3f-4ed4-8897-6a2e34a91e78"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Check\"\>", "\<\"Passed\"\>"},
     {"\<\"Coupling decomposition\"\>", "True"},
     {"\<\"Graviton p3 Ward identity\"\>", "True"},
     {"\<\"Graviton p4 Ward identity\"\>", "True"},
     {"\<\"Gravity switched off\"\>", "True"}
    },
    AutoDelete->False,
