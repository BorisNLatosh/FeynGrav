 CellChangeTimes->{{4.00086780152381*^9, 4.0008678015238333`*^9}, {
  4.000867841392047*^9, 4.000867862359373*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"75b3b2a8-1252-46e4-8ba3-f5bc7123c716"],

Cell[TextData[{
 "The polarisation-polarisation products, again bilinear with no conjugation. \
The diagonal is zero because each wavefunction is null. Off the diagonal the \
entries carry the helicity labels of the two legs together with the ratio \
t/s; using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      RowBox[{"t", "/", "s"}]}]}], "=", "cos\[Theta]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70f7f4d4-94dd-4f81-a045-59cdd47ba0f2"],
 " they encode the helicity correlations that the final amplitudes are built \
from."
}], "Text",
 CellChangeTimes->{{4.000872843281166*^9, 
  4.0008728583698263`*^9}},ExpressionUUID->"0d9ae376-1ec6-4833-995a-\
425383fe5df2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"h1", " ", "h2"}]}], ")"}]}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"h1", " ", "h3", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           RowBox[{"t", "/", "s"}]}]}], ")"}]}], "+", "1"}], ")"}]}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h1", " ", "h4", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"t", "/", "s"}]}]}], ")"}]}], "-", "1"}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h2", " ", "h3", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          RowBox[{"t", "/", "s"}]}]}], ")"}]}], "-", "1"}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"h2", " ", "h4", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           RowBox[{"t", "/", "s"}]}]}], ")"}]}], "+", "1"}], ")"}]}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"h3", " ", "h4"}]}], ")"}]}], "/", "2"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000867812119295*^9, 4.000867812119308*^9}, {
  4.000867844027871*^9, 4.000867849918304*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"5c48e924-f691-4ab3-8fed-8e40cea6f95c"],

Cell[TextData[{
 "Simplify needs to know that the helicity labels are \[PlusMinus]1 before it \
can collapse the polynomials in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65ca7b0a-dd80-4344-bc73-a3407ee81b62"],
 " introduced by the tables above."
}], "Text",
 CellChangeTimes->{{4.000872865738117*^9, 
  4.000872873232658*^9}},ExpressionUUID->"8871cdab-08c7-4624-a744-\
002b3bc44cae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    SuperscriptBox["h1", "2"], "==", 
    SuperscriptBox["h2", "2"], "==", 
    SuperscriptBox["h3", "2"], "==", 
    SuperscriptBox["h4", "2"], "==", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000867906912027*^9, 4.000867927781704*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"75335823-b6ac-4fb7-93f3-69afeb50b599"],

Cell[TextData[{
 "This is where the off-shell expression becomes a helicity amplitude. \
theAmplitude already depends on s, t and u through the assignments above; \
Simplify applies the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["h", "i"], "2"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e2f511c-6f07-4b63-a0f7-68aa38854a08"],
 " assumptions and TrickMandelstam rewrites the result in the standard \
variables, storing it in theAmplitudeonShell, again as a function of the four \
helicity labels."
}], "Text",
 CellChangeTimes->{{4.000872878269696*^9, 
  4.000872888999866*^9}},ExpressionUUID->"0d51e679-52f5-4ff8-9c17-\
150ab244f200"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{"h1_", ",", "h2_", ",", "h3_", ",", "h4_"}], "]"}], "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"theAmplitude", "[", 
        RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "]"}], "//", 
       "Simplify"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}]], "Input",
 CellChangeTimes->{{4.0008663068576393`*^9, 4.000866332731345*^9}, {
  4.000866374038752*^9, 4.000866374379426*^9}, {4.000866457287539*^9, 
  4.0008664936454983`*^9}, {4.000867885862252*^9, 4.00086790150202*^9}, {
  4.0008679318213*^9, 4.000867974317635*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"9c340c7a-a1d2-4f67-8cab-4e9af00a6d7d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.428779`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{4.0013822605868597`*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"7bc23600-f6c0-4d1c-bbec-01c467d25705"]
}, Open  ]],

Cell["\<\
Check against closed forms. Each of the three helicity combinations is \
compared with the expected tree-level expression. Both sides are put in s, t \
and u by TrickMandelstam before the comparison. The recorded outputs are True \
for each combination.\
\>", "Text",
 CellChangeTimes->{
  4.0008729007228937`*^9},ExpressionUUID->"5eff178a-4cde-481a-b5a3-\
bbee192652c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"+", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["s", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["t", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrickMandelstam", "[", 
   RowBox[{
    RowBox[{"theAmplitudeonShell", "[", 
     RowBox[{
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"+", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "==", 
  RowBox[{"\[ImaginaryI]", " ", 
   FractionBox[
    SuperscriptBox["\[Kappa]", "2"], "4"], 
   FractionBox[
    SuperscriptBox["u", "4"], 
    RowBox[{"s", " ", "t", " ", "u"}]]}]}]}], "Input",
 CellChangeTimes->{{4.000868039790948*^9, 4.000868111903015*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"74aef3b8-d420-4afa-8320-001d4112b76c"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0013822606494713`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"e05ef686-9a1b-439c-94ac-e322cf184e82"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001382260664137*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"c7ae7684-74ec-48a6-89d4-c1db8ff70356"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001382260664815*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"f16c7156-eb23-4414-be00-b464b5779caf"]
}, Open  ]],

Cell[TextData[{
 "Scope of the result. This is the massless tree-level four-graviton \
amplitude, evaluated with the gauge parameter fixed at 2 by the model, using \
the polarisation conventions fixed above; ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "i"], "=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8479bae-860f-4b72-9d2b-aebb0b81385b"],
 " are the helicity labels. No loop integration, ultraviolet subtraction, \
spin sum, phase-space integration or cross section is computed, and the \
off-shell expression from the earlier sections remains available in \
theAmplitude until the kernel is restarted."
}], "Text",
 CellChangeTimes->{{4.000872908678329*^9, 
  4.0008729173140783`*^9}},ExpressionUUID->"d550a3ce-a300-4822-9e14-\
c5e4b63c723a"],

Cell[BoxData[
 RowBox[{"FCClearScalarProducts", "[", "]"}]], "Input",
 CellChangeTimes->{{4.0008678726207323`*^9, 4.000867877742065*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"6ce12eff-32e0-4955-b2f8-5bc5dcd8a082"]
}, Open  ]]
}, Open  ]]
},
