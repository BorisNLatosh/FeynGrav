 CellChangeTimes->{{4.000867784848065*^9, 4.000867784848105*^9}, {
  4.0008678393504543`*^9, 4.000867840762991*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"95c222f4-a1eb-4ca0-970a-3e40c4583fd2"],

Cell[TextData[{
 "The polarisation-momentum products. With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "i"], "=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "619353ac-9de6-422e-bc8f-6279e87f3c78"],
 " the whole block equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", 
    SqrtBox[
     FractionBox[
      RowBox[{"t", " ", "u"}], 
      RowBox[{"2", " ", "s"}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53ab3d28-bee3-4268-8e79-b0e3b6989000"],
 " times a matrix built from the helicity labels; it is written out leg by \
leg here. The products are bilinear, with no complex conjugation, and the \
momenta are the physical ones."
}], "Text",
 CellChangeTimes->{{4.000872755972139*^9, 
  4.000872803639306*^9}},ExpressionUUID->"8bf1c72b-71a3-440b-b557-\
e8310e42f3bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h1"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h1", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{"h2", " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h2"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h3"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"t", " ", 
      RowBox[{"u", "/", "s"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
