Cell[CellGroupData[{

Cell["2. Generate and display the contributing diagrams", "Section",ExpressionUUID->"f00c30cd-8060-465d-aa98-9050a865affb"],

Cell["\<\
Including both cubic and quartic vertices generates the s-, t- and u-channel \
exchanges and the four-graviton contact. Do not select a single channel. The \
diagram sheet is displayed before CreateFeynAmp or any FORM calculation is \
called.\
\>", "Text",ExpressionUUID->"6162d8d6-59be-41c6-a914-361541dbb910"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"treeTopologies", "=", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"Adjacencies", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"treeInsertions", "=", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"treeTopologies", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", "[", "1", "]"}], ",", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", "[", "1", "]"}], ",", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}]}], ",", 
     RowBox[{"Model", "\[Rule]", "grModel"}], ",", 
