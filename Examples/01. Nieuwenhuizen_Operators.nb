Cell["Idempotence", "Subsection",
 Editable->False,ExpressionUUID->"f563b8ba-278e-4305-8a7d-62cdc204d084"],

Cell["\<\
Each diagonal projector squares to itself. The following checks explicitly \
specialize to D = 4, matching the numerical factors used later.\
\>", "Text",
 Editable->False,ExpressionUUID->"06ce0e01-d76c-4622-87f5-55a2886bd67f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FeynGravSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{"NieuwenhuizenOperator0", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "p"}], 
       "]"}], " ", 
      RowBox[{"NieuwenhuizenOperator0", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
        "]"}]}], "]"}], "\[Equal]", 
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"NieuwenhuizenOperator0", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "]"}]}], "/.", "\[VeryThinSpace]", 
   RowBox[{"D", "\[Rule]", "4"}]}], "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellChangeTimes->{4.0000905042064657`*^9, 4.000101036619925*^9},
