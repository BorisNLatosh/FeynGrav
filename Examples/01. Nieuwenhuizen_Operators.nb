Cell[CellGroupData[{

Cell["4. Verify the algebra", "Section",
 Editable->False,ExpressionUUID->"e0cc930c-396c-43d0-b164-5c7ad7ba5a60"],

Cell["\<\
Repeated Lorentz indices are contracted by FeynGravSimplify. Each check sends \
the tensor expression to FORM and imports the contracted result into FeynCalc \
notation.\
\>", "Text",
 Editable->False,ExpressionUUID->"5783cdd2-e436-4d4a-bb5a-986bbb849373"],

Cell[CellGroupData[{

Cell["Completeness", "Subsection",
 Editable->False,ExpressionUUID->"f7a3f46f-61b6-49ff-a60a-fd8373f5e20a"],

Cell["\<\
The four diagonal projectors sum to the identity on symmetric rank-two \
tensors. The mixed scalar operator is not included in this sum.\
\>", "Text",
 Editable->False,ExpressionUUID->"f4c38e98-fd17-41f0-b5bc-92a879d7594c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FeynGravSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NieuwenhuizenOperator0", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator1", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator2", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator0Bar", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}]}], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"MTD", "[", 
        RowBox[{"\[Mu]", ",", "\[Alpha]"}], "]"}], " ", 
       RowBox[{"MTD", "[", 
        RowBox[{"\[Nu]", ",", "\[Beta]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"MTD", "[", 
        RowBox[{"\[Mu]", ",", "\[Beta]"}], "]"}], " ", 
       RowBox[{"MTD", "[", 
        RowBox[{"\[Nu]", ",", "\[Alpha]"}], "]"}]}]}], ")"}]}]}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
