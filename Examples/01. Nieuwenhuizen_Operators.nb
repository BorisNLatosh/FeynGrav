Cell[CellGroupData[{

Cell["Mixed operator and spin 1 or spin 2", "Subsection",
 Editable->False,ExpressionUUID->"8c110338-af72-483a-887e-c531a43f81e1"],

Cell["\<\
The mixed scalar operator is orthogonal to the spin-1 and spin-2 sectors. Its \
name contains 0BarBar; it is not an additional idempotent projector.\
\>", "Text",
 Editable->False,ExpressionUUID->"9fd6a7a2-2969-4c50-8ef1-0b08215a08ae"],

