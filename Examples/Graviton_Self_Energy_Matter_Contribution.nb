 RowBox[{
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Calc", "[", 
     RowBox[{
      RowBox[{"GravitonPolarizationOperatorProca", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], 
      RowBox[{"FVD", "[", 
       RowBox[{"p", ",", "\[Mu]"}], "]"}], 
      RowBox[{"PolarizationTensor", "[", 
       RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"A0", "[", "__", "]"}], ",", 
      RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", "ClearScalarProducts"}], "Input",
