Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"81e67708-2af6-41f2-a9b3-8c558f53a441"],

Cell["\<\
Store the computed and reference tensors under explicit names, display the \
reference, and compare them after the stated D -> 4 substitution. True means \
agreement; an unevaluated equality is unresolved, not a successful check.\
\>", "Text",ExpressionUUID->"ca97ffc8-ce85-4c98-8ccf-91490da8c110"],

Cell[BoxData[
 RowBox[{
  RowBox[{"procaReference", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", 
         SuperscriptBox["m", "2"], ",", 
         SuperscriptBox["m", "2"]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "12"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], "2"], "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            RowBox[{"12", " ", 
             SuperscriptBox["m", "4"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "120"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"13", " ", 
             SuperscriptBox[
              RowBox[{"SP", "[", 
               RowBox[{"p", ",", "p"}], "]"}], "2"]}], "+", 
            RowBox[{"56", " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{"48", " ", 
             SuperscriptBox["m", "4"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"A0", "[", 
        SuperscriptBox["m", "2"], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "6"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "+", 
            RowBox[{"3", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox["m", "2"], " ", 
          RowBox[{"NieuwenhuizenOperator1", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["13", "60"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "+", 
            RowBox[{"3", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox["m", "2"], " ", 
          RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[30]:=",ExpressionUUID->"70135a3a-d4a1-47db-a407-cf84c08da8ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"procaComputed", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"GravitonPolarizationOperatorProca", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[31]:=",ExpressionUUID->"59295a82-a474-4d59-ab54-6d79ee4ed738"],

Cell[BoxData[
 RowBox[{"CalcFormCalculate", "[", 
  RowBox[{"procaComputed", "\[Equal]", "procaReference"}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000098533400818*^9, 4.000098546375814*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"32ee3064-ff22-432d-b734-c871f9e2c454"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Massless-vector loop", "Section",ExpressionUUID->"a99a265e-c423-4d84-9a32-493f5a99c08a"],

Cell["\<\
Use the stored diagram functions to inspect this sector independently after \
setup. The massless-vector and Yang\[Dash]Mills sections include the \
displayed ghost terms. Fermion chains use Dot and DiracTrace, retaining their \
order. GravitonFermionVertex takes graviton triples {index, index, incoming \
momentum}; include these momenta even when older examples list only the \
indices.\
\>", "Text",ExpressionUUID->"5d882c39-4c80-4263-82d6-2c912e0c40fa"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",ExpressionUUID->"4c28ea24-bf0d-40d0-95f9-da00e2afa923"],

Cell["\<\
Close two matter legs of a contact vertex into a loop. A massive tadpole can \
contribute A0[m\.b2]; do not discard it as scaleless.\
\>", "Text",ExpressionUUID->"5059e595-2380-4e3e-a7bc-a477498b8c19"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{"Explicit", "[", 
       RowBox[{
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", ",", 
            RowBox[{"-", "p"}]}], "}"}], ",", "\[Lambda]1", ",", "k", ",", 
          "\[Lambda]2", ",", 
          RowBox[{"-", "k"}]}], "]"}], " ", 
        RowBox[{"GluonPropagator", "[", 
         RowBox[{"k", ",", 
          RowBox[{"{", "\[Lambda]1", "}"}], ",", 
          RowBox[{"{", "\[Lambda]2", "}"}]}], "]"}]}], "]"}], "]"}], ",", "k",
      ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000098603507942*^9, 4.0000986074974413`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"514d44c4-6fce-4d0b-a0a7-569fef4e4b80"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector1Ghost", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonVectorGhostVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
         "}"}], ",", "k", ",", 
        RowBox[{"-", "k"}]}], "]"}], " ", 
      RowBox[{"ScalarPropagator", "[", 
       RowBox[{"k", ",", "0"}], "]"}]}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
