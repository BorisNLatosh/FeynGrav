Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"81e67708-2af6-41f2-a9b3-8c558f53a441"],

Cell["\<\
Store the computed and reference tensors under explicit names, display the \
reference, and compare them after the stated D -> 4 substitution. True means \
agreement; an unevaluated equality is unresolved, not a successful check.\
\>", "Text",ExpressionUUID->"ca97ffc8-ce85-4c98-8ccf-91490da8c110"],

Cell[BoxData[
 RowBox[{
  RowBox[{"procaReference", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", 
         SuperscriptBox["m", "2"], ",", 
         SuperscriptBox["m", "2"]}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "12"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], "2"], "-", 
            RowBox[{"4", " ", 
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            RowBox[{"12", " ", 
             SuperscriptBox["m", "4"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "120"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"13", " ", 
             SuperscriptBox[
              RowBox[{"SP", "[", 
               RowBox[{"p", ",", "p"}], "]"}], "2"]}], "+", 
            RowBox[{"56", " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{"48", " ", 
             SuperscriptBox["m", "4"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"A0", "[", 
        SuperscriptBox["m", "2"], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "6"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "+", 
            RowBox[{"3", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox["m", "2"], " ", 
          RowBox[{"NieuwenhuizenOperator1", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["13", "60"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "+", 
            RowBox[{"3", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox["m", "2"], " ", 
          RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[30]:=",ExpressionUUID->"70135a3a-d4a1-47db-a407-cf84c08da8ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"procaComputed", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"GravitonPolarizationOperatorProca", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], "]"}], "/.", "\[VeryThinSpace]", 
