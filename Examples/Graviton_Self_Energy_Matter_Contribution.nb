Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"ed5432be-8784-4a77-9ab1-0828efa0cb4e"],

Cell["\<\
Store the computed and reference tensors under explicit names, display the \
reference, and compare them after the stated D -> 4 substitution. True means \
agreement; an unevaluated equality is unresolved, not a successful check.\
\>", "Text",ExpressionUUID->"f057d2b0-51aa-4a61-9637-040f8975909d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vectorComputed", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{"GravitonPolarizationOperatorVector", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
       "]"}], "]"}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[42]:=",ExpressionUUID->"e16a9c69-214e-483e-9e4d-48ba3be441e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vectorReference", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], " ", 
      RowBox[{"B0", "[", 
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], " ", 
      SuperscriptBox[
       RowBox[{"SP", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "8"], " ", 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}]}], ")"}]}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[43]:=",ExpressionUUID->"1eb96298-59bd-4bd5-b457-4d3b0bd3e827"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"CalcFormCalculate", "[", 
    RowBox[{"Explicit", "[", 
     RowBox[{"vectorComputed", "-", "vectorReference"}], "]"}], "]"}], "]"}], 
  "\[Equal]", "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000986983301773`*^9, 4.0000986994188004`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"c3da5b48-6830-4589-adca-88482d39c30d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. SU(N) Yang\[Dash]Mills sector", "Section",ExpressionUUID->"d394f14b-26d8-46cf-8877-a0d7a6e08ac2"],

Cell["\<\
Use the stored diagram functions to inspect this sector independently after \
setup. The massless-vector and Yang\[Dash]Mills sections include the \
displayed ghost terms. Fermion chains use Dot and DiracTrace, retaining their \
order. GravitonFermionVertex takes graviton triples {index, index, incoming \
momentum}; include these momenta even when older examples list only the \
indices.\
\>", "Text",ExpressionUUID->"5cf20e44-3582-4261-97f7-d79100638821"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",ExpressionUUID->"af45f86b-89ba-4680-ba3e-eaa9a3b385a5"],

Cell["\<\
Close two matter legs of a contact vertex into a loop. A massive tadpole can \
contribute A0[m\.b2]; do not discard it as scaleless.\
\>", "Text",ExpressionUUID->"b9aa0d10-4271-48a1-949e-38303eb34e2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorGluon1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Explicit", "[", 
      RowBox[{
       RowBox[{"GravitonGluonVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"-", "p"}]}], "}"}], ",", 
         RowBox[{"-", "k"}], ",", "\[Lambda]1", ",", "a1", ",", "k", ",", 
         "\[Lambda]2", ",", "a2"}], "]"}], " ", 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{"k", ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]1", ",", "a1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]2", ",", "a2"}], "}"}]}], "]"}]}], "]"}], ",", 
     "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
