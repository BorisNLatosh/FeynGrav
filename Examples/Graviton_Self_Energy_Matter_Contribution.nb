Cell[CellGroupData[{

Cell["Bubble contributions", "Subsection",ExpressionUUID->"e24ecb5c-6582-4ca3-b0d1-0253927a4de2"],

Cell["\<\
Join the two matter\[Dash]graviton vertices with the indicated propagators. \
The integrand specifies the momentum routing; k is the integration variable.\
\>", "Text",ExpressionUUID->"d79f4c0b-2649-4739-80a9-98a076858c15"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{"Explicit", "[", 
       RowBox[{
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", "\[Rho]1", ",", 
          RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
            RowBox[{"-", "p"}]}], "}"}], ",", "\[Rho]2", ",", "k", ",", 
          "\[Sigma]2", ",", 
          RowBox[{"p", "-", "k"}]}], "]"}], " ", 
        RowBox[{"GluonPropagator", "[", 
         RowBox[{"k", ",", 
          RowBox[{"{", "\[Sigma]1", "}"}], ",", 
          RowBox[{"{", "\[Sigma]2", "}"}]}], "]"}], " ", 
        RowBox[{"GluonPropagator", "[", 
         RowBox[{
          RowBox[{"p", "-", "k"}], ",", 
          RowBox[{"{", "\[Rho]1", "}"}], ",", 
          RowBox[{"{", "\[Rho]2", "}"}]}], "]"}]}], "]"}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000986277265368`*^9, 4.000098637269905*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"ac9ea415-655a-46bd-a52d-e75087fb9283"],

