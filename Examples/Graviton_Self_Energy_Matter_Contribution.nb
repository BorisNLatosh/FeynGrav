Cell[TextData[StyleBox["Explicit expression.",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.879400213069611*^9, 3.879400226285658*^9}, {
   3.879477219669986*^9, 3.8794772203338*^9}, 
