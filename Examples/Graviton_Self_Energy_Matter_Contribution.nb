Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorFermion", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], "==", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], 
       RowBox[{"A0", "[", 
        SuperscriptBox["m", "2"], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", 
           RowBox[{"2", " ", "D"}]], 
          SuperscriptBox["m", "2"], 
          RowBox[{"NieuwenhuizenOperator1", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"D", "+", "1"}], ")"}]}]], 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "-", 
                RowBox[{"8", " ", "D"}], "+", 
                RowBox[{"5", " ", 
                 SuperscriptBox["D", "2"]}]}], ")"}], " ", 
              SuperscriptBox["m", "2"]}], 
             RowBox[{"2", " ", "D"}]], "-", 
            RowBox[{
             FractionBox["1", "4"], " ", 
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"D", "+", "1"}], ")"}]}]], 
          RowBox[{"(", 
           RowBox[{
            FractionBox["1", "8"], 
            FractionBox["1", "D"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "-", 
                 RowBox[{"20", " ", "D"}], "+", 
                 RowBox[{"11", " ", 
                  SuperscriptBox["D", "2"]}]}], ")"}], " ", 
               SuperscriptBox["m", "2"]}], "-", 
              RowBox[{"2", " ", 
               RowBox[{"(", 
                RowBox[{"D", "-", "4"}], ")"}], " ", "D", " ", 
               RowBox[{"SPD", "[", 
                RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          FractionBox["1", "D"], 
          SuperscriptBox["m", "2"], " ", 
          RowBox[{"NieuwenhuizenOperator0Bar", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], 
       FractionBox["1", "8"], 
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"D", "+", "1"}], ")"}]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", " ", 
          SuperscriptBox["m", "2"]}], "-", 
         RowBox[{"SPD", "[", 
          RowBox[{"p", ",", "p"}], "]"}]}], ")"}], 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", 
         SuperscriptBox["m", "2"], ",", 
         SuperscriptBox["m", "2"]}], "]"}], 
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"8", " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"20", " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"D", "-", "4"}], ")"}], 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//",
    "Calc"}], "//", "Simplify"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.981088721830638*^9, 3.98108894742192*^9}, {
  3.981089001868044*^9, 3.981089119776331*^9}, {3.981089342957806*^9, 
