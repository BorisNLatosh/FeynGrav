Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"ce044ad9-2371-4442-99e9-9c06b3762619"],

Cell["Expand the computed tensor with Explicit before Dirac simplification or projector decomposition. Keep D symbolic until the tensor is simplified, then display the four-dimensional projector coefficients.", "Text",ExpressionUUID->"cbec0228-94bd-470a-b9bd-b2e222279be7"],

Cell["These coefficients are extracted from the computed tensor. The final equality checks its reconstruction in the projector basis; it is not an independent reference for the loop calculation.", "Text",ExpressionUUID->"5d0db086-f5d0-4cdc-b0b3-47d58308e37d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fermionProjectorTensor", "=", 
   RowBox[{"CalcFormCalculate", "[", 
    RowBox[{"DiracSimplify", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{"GravitonPolarizationOperatorFermion", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"fermionProjectorCoefficients", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
       RowBox[{
       "fermionProjectorTensor", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", 
        ",", "\[Beta]", ",", "p"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ")"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[19]:=",ExpressionUUID->"9592fbd6-5afa-4a34-84af-bc716c25858b"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<P1\>\"", ",", " ", "\"\<P2\>\"", ",", " ", "\"\<P0\>\"", ",",
         " ", "\"\<P0Bar\>\"", ",", " ", "\"\<P0BarBar\>\""}], "}"}], ",", 
      " ", "fermionProjectorCoefficients"}], "}"}], "]"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[20]:=",ExpressionUUID->"ba636254-3edb-4386-9f83-74076cb31242"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fermionProjectorForm", "=", 
   RowBox[{"NieuwenhuizenOperator", "[", 
    RowBox[{
     RowBox[{"Sequence", "@@", "fermionProjectorCoefficients"}], ",", "\[Mu]",
      ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[21]:=",ExpressionUUID->"c72cb364-22a3-449a-9035-342e1417d1e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fermionProjectorReconstructionCheck", "=", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{
       RowBox[{"FeynAmpDenominatorExplicit", "[", 
        RowBox[{"Explicit", "[", 
         RowBox[{"fermionProjectorTensor", "-", "fermionProjectorForm"}], 
         "]"}], "]"}], "/.", "\[VeryThinSpace]", 
       RowBox[{"D", "\[Rule]", "4"}]}], "]"}], "]"}], "\[Equal]", "0"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[22]:=",ExpressionUUID->"211aad79-29fa-44f9-8006-d594a5a7fe85"],

Cell[BoxData["fermionProjectorReconstructionCheck"], "Input",
 InitializationCell->False,
 CellLabel->"In[23]:=",ExpressionUUID->"b7f78cac-46dc-4627-9dca-aa5cf77fb14f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Massive-vector loop", "Section",ExpressionUUID->"44d71d5e-8594-4c64-a47a-53ba3d1f8658"],

Cell["\<\
Use the stored diagram functions to inspect this sector independently after \
setup. The massless-vector and Yang\[Dash]Mills sections include the \
displayed ghost terms. Fermion chains use Dot and DiracTrace, retaining their \
order. GravitonFermionVertex takes graviton triples {index, index, incoming \
momentum}; include these momenta even when older examples list only the \
indices.\
\>", "Text",ExpressionUUID->"2411d5d3-46c7-4a95-b3f9-e3c5fe7b80f4"],

Cell[CellGroupData[{

Cell["Tadpole contributions", "Subsection",ExpressionUUID->"d0c8f8e4-8127-4444-aec1-0acae79e55f9"],

Cell["\<\
Close two matter legs of a contact vertex into a loop. A massive tadpole can \
contribute A0[m\.b2]; do not discard it as scaleless.\
\>", "Text",ExpressionUUID->"6e106bf7-31bc-4131-9dc9-068e0a9ca25e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{
       RowBox[{"GravitonMassiveVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "}"}], ",", "\[Lambda]1", ",", 
         RowBox[{"-", "k"}], ",", "\[Lambda]2", ",", "k", ",", "m"}], "]"}], " ", 
       RowBox[{"ProcaPropagator", "[", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "k", ",", "m"}], 
        "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000983717955647`*^9, 4.0000983874326363`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"9861ccf2-4557-4d05-9c55-2f98287fd965"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble contributions", "Subsection",ExpressionUUID->"96e48691-f243-4800-97ac-fc5733c319f9"],

Cell["\<\
Join the two matter\[Dash]graviton vertices with the indicated propagators. \
The integrand specifies the momentum routing; k is the integration variable.\
\>", "Text",ExpressionUUID->"fe61dee9-b03b-480b-acca-00b1b38a9a59"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"CalcFormCalculate", "[", 
      RowBox[{
       RowBox[{"GravitonMassiveVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "\[Rho]1", ",", 
         RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], " ", 
       RowBox[{"ProcaPropagator", "[", 
        RowBox[{"\[Rho]1", ",", "\[Rho]2", ",", "k", ",", "m"}], "]"}], " ", 
       RowBox[{"ProcaPropagator", "[", 
        RowBox[{"\[Sigma]1", ",", "\[Sigma]2", ",", 
         RowBox[{"p", "-", "k"}], ",", "m"}], "]"}], " ", 
       RowBox[{"GravitonMassiveVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "\[Rho]2", ",", 
         "k", ",", "\[Sigma]2", ",", 
         RowBox[{"p", "-", "k"}], ",", "m"}], "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000098392883709*^9, 4.000098400087792*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"0eecc726-4119-4373-9cc1-84eaf4230b6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined tensor", "Subsection",ExpressionUUID->"199334d1-19c9-4362-a4ff-9a46dd007fb6"],

Cell["\<\
Add the stored terms with the weights written here and collect scalar \
integral coefficients. These are amputated tensors in this example\
\[CloseCurlyQuote]s convention.\
\>", "Text",ExpressionUUID->"2ae10cef-88a5-403e-906b-7dce42647f13"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorProca", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", ",",
      "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonPolarizationOperatorProca1", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], "+", 
      RowBox[{"GravitonPolarizationOperatorProca2", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[26]:=",ExpressionUUID->"342e84e3-e525-41aa-8499-5736972eb952"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal contractions", "Subsection",ExpressionUUID->"bd6ba812-e783-4ef0-9bbf-5d9bfcac3bcd"],

Cell["\<\
Inspect the contraction with the external momentum. A zero residual means \
that this particular contraction vanishes. Off-shell or massive-sector \
residuals should be read as displayed; this cell alone does not establish a \
full renormalised Ward identity.\
\>", "Text",ExpressionUUID->"e9ef33ab-ead5-4dea-b19b-cb6afc3c7303"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000098430460556*^9, 4.000098446239254*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"97444f9a-89bb-4043-b123-aa7a4463b229"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{
       RowBox[{"GravitonPolarizationOperatorProca", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",",
          "m"}], "]"}], " ", 
       RowBox[{"FVD", "[", 
        RowBox[{"p", ",", "\[Mu]"}], "]"}], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}], " ", 
       RowBox[{"PolarizationTensor", "[", 
        RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p"}], "]"}]}], "]"}], "]"}],
     ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"A0", "[", "__", "]"}], ",", 
      RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}], "==", 
  "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000984631580563`*^9, 4.0000985095283833`*^9}},
