        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"CA", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "D"}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "5"}], "+", 
              RowBox[{"2", " ", "D"}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["CA", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "5"}], "+", 
              RowBox[{"2", " ", "D"}]}], ")"}]}]}], ")"}], 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "CA", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "4"}], "+", "D"}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"20", "-", 
              RowBox[{"14", " ", "D"}], "+", 
              RowBox[{"3", " ", 
               SuperscriptBox["D", "2"]}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["CA", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"20", "-", 
              RowBox[{"14", " ", "D"}], "+", 
              RowBox[{"3", " ", 
               SuperscriptBox["D", "2"]}]}], ")"}]}]}], ")"}], 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}]}], ")"}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//", 
