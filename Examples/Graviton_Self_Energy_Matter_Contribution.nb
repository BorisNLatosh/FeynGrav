Cell[CellGroupData[{

Cell["Combined tensor", "Subsection",ExpressionUUID->"49a29b31-3b0f-482d-a35a-486d74b974d0"],

Cell["\<\
Add the stored terms with the weights written here and collect scalar \
integral coefficients. These are amputated tensors in this example\
\[CloseCurlyQuote]s convention.\
\>", "Text",ExpressionUUID->"d9555789-0f90-4faa-8fb4-ff0a6ec614b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"Factor", "[", 
