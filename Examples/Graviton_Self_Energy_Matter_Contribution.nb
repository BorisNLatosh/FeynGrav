        RowBox[{
         RowBox[{"GravitonGluonVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", 
           RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", "a1", ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"p", "-", "k"}], ")"}]}], ",", "\[Rho]1", ",", "b1"}], 
          "]"}], " ", 
