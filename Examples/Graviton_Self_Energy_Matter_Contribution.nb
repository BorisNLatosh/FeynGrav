Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"ce044ad9-2371-4442-99e9-9c06b3762619"],

Cell["Expand the computed tensor with Explicit before Dirac simplification or projector decomposition. Keep D symbolic until the tensor is simplified, then display the four-dimensional projector coefficients.", "Text",ExpressionUUID->"cbec0228-94bd-470a-b9bd-b2e222279be7"],

Cell["These coefficients are extracted from the computed tensor. The final equality checks its reconstruction in the projector basis; it is not an independent reference for the loop calculation.", "Text",ExpressionUUID->"5d0db086-f5d0-4cdc-b0b3-47d58308e37d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fermionProjectorTensor", "=", 
   RowBox[{"CalcFormCalculate", "[", 
    RowBox[{"DiracSimplify", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{"GravitonPolarizationOperatorFermion", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
  RowBox[{"fermionProjectorCoefficients", "=", 
   RowBox[{"Factor", "/@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"NieuwenhuizenOperatorExpansion", "[", 
       RowBox[{
       "fermionProjectorTensor", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", 
        ",", "\[Beta]", ",", "p"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ")"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[19]:=",ExpressionUUID->"9592fbd6-5afa-4a34-84af-bc716c25858b"],

