40b29a8265b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorVector", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "==", 
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox["\[Kappa]", "2"], 
      FractionBox["1", "8"], 
      FractionBox["1", 
       RowBox[{"D", "-", "1"}]], 
      RowBox[{"B0", "[", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "5"}], "+", 
           RowBox[{"2", " ", "D"}]}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"SPD", "[", 
           RowBox[{"p", ",", "p"}], "]"}], "2"], 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"20", "-", 
           RowBox[{"14", " ", "D"}], "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["D", "2"]}]}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"SPD", "[", 
           RowBox[{"p", ",", "p"}], "]"}], "2"], 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}]}], ")"}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//", 
   "Calc"}], "//", "Simplify"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810906775131407`*^9, 3.981090759320869*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"c472370f-c0bd-46e8-9adb-60a3844a4046"],

