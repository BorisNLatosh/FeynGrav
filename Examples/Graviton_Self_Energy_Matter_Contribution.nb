  3.8946567526731*^9}},ExpressionUUID->"bfe6f573-bba1-443c-b8e5-81bcd9401d72"],

Cell[TextData[StyleBox["Tadpole contribution.",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.879389364695619*^9, 3.879389391318482*^9}, {
  3.894656826073153*^9, 
  3.894656831809654*^9}},ExpressionUUID->"bbf1bf0a-bbeb-4d25-abec-\
3d8bc7ba1501"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorScalar1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
      ",", "m_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GravitonScalarVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
           "}"}], ",", 
          RowBox[{"-", "k"}], ",", "k", ",", "m"}], "]"}], 
        RowBox[{"ScalarPropagator", "[", 
         RowBox[{"k", ",", "m"}], "]"}]}], ",", "k", ",", 
       RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], ";"}], "//",
   "Timing"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.879474359957933*^9, 3.879474380468923*^9}, 
   3.879917092378941*^9, 3.885587005544106*^9, {3.8946568128983507`*^9, 
   3.894656821907007*^9}, {3.981426278152141*^9, 3.981426281237093*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"f342da8c-1882-4d37-bff5-d529cf8bdbd8"],

