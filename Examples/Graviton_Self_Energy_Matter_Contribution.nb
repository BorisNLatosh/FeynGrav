Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "==", 
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox["\[Kappa]", "2"], 
      FractionBox["1", "8"], 
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"D", "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"D", "+", "1"}], ")"}]}]], 
      SuperscriptBox[
       RowBox[{"SPD", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "2"], 
      RowBox[{"B0", "[", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], 
      RowBox[{"(", 
