            RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], 
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
            RowBox[{"-", "p"}]}], "}"}], ",", "\[Rho]2", ",", "k", ",", 
          "\[Sigma]2", ",", 
