Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"Factor", "[", 
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorGluon1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGluon2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorQuark1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorQuark2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGhost1", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "+", 
     RowBox[{"GravitonPolarizationOperatorGhost2", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[51]:=",ExpressionUUID->"21d8b451-6049-4a7c-9652-c2fc3fc9f2db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal contractions", "Subsection",ExpressionUUID->"dc943e53-5c03-4493-8e55-1bb25d853be5"],

Cell["\<\
Inspect the contraction with the external momentum. A zero residual means \
that this particular contraction vanishes. Off-shell or massive-sector \
residuals should be read as displayed; this cell alone does not establish a \
full renormalised Ward identity.\
\>", "Text",ExpressionUUID->"68ffbd1d-8805-4b5c-8e41-c477a20c41f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}]}], "]"}], "==", "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000098930786881*^9, 4.000098932054824*^9}, {
  4.0000989790465384`*^9, 4.000098985466899*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"b208631a-2956-494f-8b14-607b75ba4c03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Nu]"}], "]"}]}], "]"}], "==", "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000099005709752*^9, 4.0000990093281097`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"f78fd5aa-3352-4f5e-b45a-4157b276f51d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Alpha]"}], "]"}]}], "]"}], "==", "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000990121505136`*^9, 4.0000990166864147`*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"68be1194-f8eb-4f65-80a3-695c58f0b0f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Beta]"}], "]"}]}], "]"}], "==", "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000990189209213`*^9, 4.0000990217125463`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"ca9da632-7d92-450e-a303-b44dde029b24"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Projector form and comparison", "Subsection",ExpressionUUID->"e21eec27-c9dd-47db-8013-966d4bc61a90"],

Cell["Expand both tensors before comparison and reduce their colour factors to the same SUNN convention. SUNN is a scalar parameter supported by CalcFormCalculate; colour tensors must first be contracted by SUNSimplify. Compare the difference with zero after FORM contraction and scalar simplification.", "Text",ExpressionUUID->"1c01d141-9c1c-4008-94f7-01dfc8184fbb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"yangMillsReference", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[Pi]", "2"], " ", 
        RowBox[{"B0", "[", 
         RowBox[{
          RowBox[{"SPD", "[", 
           RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], " ", 
        SuperscriptBox[
         RowBox[{"SPD", "[", 
          RowBox[{"p", ",", "p"}], "]"}], "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["SUNN", "2"], "-", "1"}], ")"}], " ", 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["1", "8"], " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["SUNN", "2"], "-", "1"}], ")"}]}], "-", 
           FractionBox["SUNN", "40"]}], ")"}], " ", 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}]}], ")"}]}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[56]:=",ExpressionUUID->"10755ba9-bcac-4ad0-9c17-2e48c2dfeccc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"yangMillsComputed", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"SUNSimplify", "[", 
      RowBox[{
       RowBox[{"Explicit", "[", 
        RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
         RowBox[{
         "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
         "]"}], "]"}], ",", 
       RowBox[{"SUNNToCACF", "\[Rule]", "False"}]}], "]"}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"D", "\[Rule]", "4"}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[57]:=",ExpressionUUID->"989f2fae-6b99-4efa-8e75-71108ae3c150"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"CalcFormCalculate", "[", 
    RowBox[{"SUNSimplify", "[", 
     RowBox[{
      RowBox[{"Explicit", "[", 
       RowBox[{"yangMillsComputed", "-", "yangMillsReference"}], "]"}], ",", 
      RowBox[{"SUNNToCACF", "\[Rule]", "False"}]}], "]"}], "]"}], "]"}], "\[Equal]",
   "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0000990357467203`*^9, 4.000099086598074*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"b86fd2be-9c9f-4077-b75b-448f9c0c33f8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to adapt this example", "Section",ExpressionUUID->"33d49ce3-0c25-45aa-a859-c3a5c575a38b"],

Cell["\<\
Change one ingredient at a time: a mass, a momentum assignment, or a vertex \
order. Restart the kernel before rerunning with different kinematics, because \
scalar-product definitions and assumptions persist in the session. \
Re-evaluate all dependent cells after a change. Inspect the stored \
intermediate expressions if a comparison is False or remains unevaluated; do \
not treat an unresolved expression as a passed check.\
\>", "Text",ExpressionUUID->"efcde377-77f5-4a3d-9407-05dd8beb1b44"]
}, Open  ]]
}, Open  ]]
},
