Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorGluon1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], " ", "=", " ", 
   RowBox[{"TID", "[", " ", 
    RowBox[{
     RowBox[{"Calc", "[", 
      RowBox[{
       RowBox[{"GravitonGluonVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", 
           ",", 
           RowBox[{"-", "p"}]}], "}"}], ",", 
         RowBox[{"-", "k"}], ",", "\[Lambda]1", ",", "a1", ",", "k", ",", 
         "\[Lambda]2", ",", "a2"}], "]"}], 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]1", ",", " ", "a1"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]2", ",", " ", "a2"}], "}"}]}], "]"}]}], "]"}], 
     " ", ",", "k", ",", " ", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorQuark1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], " ", "=", 
   RowBox[{"TID", "[", " ", 
    RowBox[{
     RowBox[{"Calc", "[", 
      RowBox[{"SUNN", " ", 
       RowBox[{"GravitonFermionVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "}"}], ",", 
         RowBox[{"-", "k"}], ",", "k", ",", "0"}], "]"}], 
       RowBox[{"QuarkPropagator", "[", "k", "]"}]}], "]"}], " ", ",", "k", 
     ",", " ", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorGhost1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", " ", 
   RowBox[{"TID", "[", " ", 
    RowBox[{
     RowBox[{"Calc", "[", 
      RowBox[{
       RowBox[{"GravitonYMGhostVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
          "}"}], ",", 
         RowBox[{"-", "k"}], ",", "a", ",", "k", ",", "b"}], "]"}], 
       RowBox[{"GhostPropagator", "[", 
        RowBox[{"k", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}], ",", " ",
      "k", ",", " ", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.879905156258421*^9, 3.879905189585134*^9}, {
   3.8799052223641768`*^9, 3.879905301659518*^9}, {3.879905784769352*^9, 
   3.879905831133331*^9}, {3.87991728666999*^9, 3.879917289213415*^9}, 
   3.8813690663230553`*^9, {3.881373007437724*^9, 3.881373009358612*^9}, 
