Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Calc", "[", 
      RowBox[{
       RowBox[{"GravitonVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", 
           ",", 
           RowBox[{"-", "p"}]}], "}"}], ",", "\[Lambda]1", ",", "k", ",", 
         "\[Lambda]2", ",", 
         RowBox[{"-", "k"}]}], "]"}], 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{"k", ",", " ", 
         RowBox[{"{", "\[Lambda]1", "}"}], ",", " ", 
         RowBox[{"{", "\[Lambda]2", "}"}]}], "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector1Ghost", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonVectorGhostVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "k", ",", 
        RowBox[{"-", "k"}]}], "]"}], 
      RowBox[{"ScalarPropagator", "[", 
       RowBox[{"k", ",", "0"}], "]"}]}], ",", "k", ",", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.879576776425581*^9, 3.879576825585064*^9}, {
   3.87957693253304*^9, 3.8795769396673183`*^9}, 3.879577202696071*^9, {
   3.8799171700122538`*^9, 3.879917192454946*^9}, 3.881702770695478*^9, {
