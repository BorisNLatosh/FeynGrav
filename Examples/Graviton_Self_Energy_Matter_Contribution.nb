Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorGluon2", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], " ", "=", " ", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"TID", "[", 
       RowBox[{
        RowBox[{"Calc", "[", 
         RowBox[{
          RowBox[{"GravitonGluonVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", 
            RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", "a1", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"p", "-", "k"}], ")"}]}], ",", "\[Rho]1", ",", "b1"}], 
           "]"}], 
          RowBox[{"GluonPropagator", "[", 
           RowBox[{"k", ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Sigma]1", ",", " ", "a1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Sigma]2", ",", " ", "a2"}], "}"}]}], "]"}], 
          RowBox[{"GluonPropagator", "[", 
           RowBox[{
            RowBox[{"p", "-", "k"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Rho]1", ",", " ", "b1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Rho]2", ",", " ", "b2"}], "}"}]}], "]"}], 
          RowBox[{"GravitonGluonVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
              RowBox[{"-", "p"}]}], "}"}], ",", "k", ",", "\[Sigma]2", ",", 
            "a2", ",", 
            RowBox[{"p", "-", "k"}], ",", "\[Rho]2", ",", "b2"}], "]"}]}], 
         "]"}], ",", "k", ",", 
        RowBox[{"ToPaVe", "->", "True"}]}], "]"}], ",", 
      "GaugeFixingEpsilonSUNYM", ",", "Factor"}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorQuark2", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], " ", "=", " ", 
    RowBox[{"TID", "[", " ", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{"SUNN", " ", 
        RowBox[{"DiracTrace", "[", " ", 
         RowBox[{
          RowBox[{"GravitonFermionVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "k", ",", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"p", "+", "k"}], ")"}]}], ",", "0"}], "]"}], ".", 
          RowBox[{"QuarkPropagator", "[", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0"}], "}"}], "]"}], ".", 
          RowBox[{"GravitonFermionVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", 
            RowBox[{"p", "+", "k"}], ",", 
            RowBox[{"-", "k"}], ",", "0"}], "]"}], ".", 
          RowBox[{"QuarkPropagator", "[", 
           RowBox[{"p", "+", "k"}], "]"}]}], " ", "]"}]}], "]"}], ",", " ", 
      "k", ",", " ", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorGhost2", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], " ", "=", 
    RowBox[{
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{"Calc", "[", 
        RowBox[{
         RowBox[{"GravitonYMGhostVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", 
           RowBox[{"-", "k"}], ",", "a", ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"p", "-", "k"}], ")"}]}], ",", "i"}], "]"}], 
         RowBox[{"GravitonYMGhostVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "k", ",", "b", 
           ",", 
           RowBox[{"p", "-", "k"}], ",", "j"}], "]"}], 
         RowBox[{"GhostPropagator", "[", 
          RowBox[{"k", ",", " ", "a", ",", " ", "b", ",", 
           RowBox[{"Explicit", "->", "True"}]}], "]"}], 
         RowBox[{"GhostPropagator", "[", 
          RowBox[{
           RowBox[{"p", "-", "k"}], ",", "i", ",", "j", ",", 
           RowBox[{"Explicit", "->", "True"}]}], "]"}]}], "]"}], ",", "k", 
       ",", 
       RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], ";"}], "//",
   "Timing"}]}], "Input",
 Editable->False,
