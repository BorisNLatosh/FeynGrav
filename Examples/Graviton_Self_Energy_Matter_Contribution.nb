Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Calc", "[", 
      RowBox[{
       RowBox[{"GravitonVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", "\[Rho]1", 
         ",", 
         RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], 
       RowBox[{"GravitonVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"-", "p"}]}], "}"}], ",", "\[Rho]2", ",", "k", ",", 
         "\[Sigma]2", ",", 
         RowBox[{"p", "-", "k"}]}], "]"}], 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{"k", ",", 
         RowBox[{"{", "\[Sigma]1", "}"}], ",", 
         RowBox[{"{", "\[Sigma]2", "}"}]}], "]"}], 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{
         RowBox[{"p", "-", "k"}], ",", 
         RowBox[{"{", "\[Rho]1", "}"}], ",", 
         RowBox[{"{", "\[Rho]2", "}"}]}], "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorVector2Ghost", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonVectorGhostVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", 
        RowBox[{"-", "k"}], ",", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], 
      RowBox[{"GravitonVectorGhostVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "k", ",", 
        RowBox[{"p", "-", "k"}]}], "]"}], 
      RowBox[{"ScalarPropagator", "[", 
       RowBox[{"k", ",", "0"}], "]"}], 
      RowBox[{"ScalarPropagator", "[", 
       RowBox[{
        RowBox[{"p", "-", "k"}], ",", "0"}], "]"}]}], ",", "k", ",", 
     RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}]}], "Input",
 Editable->False,
