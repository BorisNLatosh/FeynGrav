Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorFermion1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
      ",", "m_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{"Calc", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"DiracTrace", "[", " ", 
          RowBox[{
           RowBox[{"GravitonFermionVertex", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], "}"}],
              ",", "k", ",", 
             RowBox[{"-", "k"}], ",", "m"}], "]"}], ".", 
           RowBox[{"QuarkPropagator", "[", 
            RowBox[{"{", 
             RowBox[{"k", ",", "m"}], "}"}], "]"}]}], " ", "]"}]}], " ", 
        "]"}], ",", "k", ",", 
       RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], ";"}], "//",
   "Timing"}]], "Input",
 Editable->False,
