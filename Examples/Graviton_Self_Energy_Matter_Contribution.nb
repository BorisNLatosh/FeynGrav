Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorScalar2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
     ",", "m_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"TID", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", 
         RowBox[{"-", "k"}], ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"p", "-", "k"}], ")"}]}], ",", "m"}], "]"}], 
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "k", ",", 
         RowBox[{"p", "-", "k"}], ",", "m"}], "]"}], 
       RowBox[{"ScalarPropagator", "[", 
        RowBox[{"k", ",", "m"}], "]"}], 
       RowBox[{"ScalarPropagator", "[", 
        RowBox[{
         RowBox[{"p", "-", "k"}], ",", "m"}], "]"}]}], ",", "k", ",", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], 
  ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.879309692255596*^9, 3.87930981149774*^9}, 
   3.879310745009962*^9, {3.8793113993771057`*^9, 3.879311400445964*^9}, {
