      RowBox[{"Calc", "[", 
       RowBox[{
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", "\[Rho]1", 
