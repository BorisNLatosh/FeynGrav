Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorFermion1", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
     ",", "m_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"TID", "[", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"DiracTrace", "[", " ", 
         RowBox[{
          RowBox[{"GravitonFermionVertex", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}],
              "}"}], ",", "k", ",", 
            RowBox[{"-", "k"}], ",", "m"}], "]"}], ".", 
          RowBox[{"QuarkPropagator", "[", 
           RowBox[{"{", 
            RowBox[{"k", ",", "m"}], "}"}], "]"}]}], " ", "]"}]}], " ", "]"}],
       ",", "k", ",", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], 
  ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.879390655033842*^9, 3.879390694115822*^9}, 
   3.879391012640472*^9, {3.879391504410874*^9, 3.879391530978827*^9}, {
