Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorGluon1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], " ", "=", " ", 
    RowBox[{"TID", "[", " ", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{
        RowBox[{"GravitonGluonVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", 
            ",", 
            RowBox[{"-", "p"}]}], "}"}], ",", 
          RowBox[{"-", "k"}], ",", "\[Lambda]1", ",", "a1", ",", "k", ",", 
          "\[Lambda]2", ",", "a2"}], "]"}], 
        RowBox[{"GluonPropagator", "[", 
         RowBox[{"k", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Lambda]1", ",", " ", "a1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\[Lambda]2", ",", " ", "a2"}], "}"}]}], "]"}]}], "]"}], 
      " ", ",", "k", ",", " ", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorQuark1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], " ", "=", 
    RowBox[{"TID", "[", " ", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{"SUNN", " ", 
        RowBox[{"GravitonFermionVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
           "}"}], ",", 
          RowBox[{"-", "k"}], ",", "k", ",", "0"}], "]"}], 
        RowBox[{"QuarkPropagator", "[", "k", "]"}]}], "]"}], " ", ",", "k", 
      ",", " ", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorGhost1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", " ", 
    RowBox[{"TID", "[", " ", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{
        RowBox[{"GravitonYMGhostVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]"}], 
           "}"}], ",", 
          RowBox[{"-", "k"}], ",", "a", ",", "k", ",", "b"}], "]"}], 
        RowBox[{"GhostPropagator", "[", 
         RowBox[{"k", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}], ",", 
      " ", "k", ",", " ", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}]}], "Input",
 Editable->False,
