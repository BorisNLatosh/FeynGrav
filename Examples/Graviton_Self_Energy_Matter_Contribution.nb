Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorFermion", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
     ",", "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonPolarizationOperatorFermion1", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], "+", " ", 
      RowBox[{"GravitonPolarizationOperatorFermion2", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
