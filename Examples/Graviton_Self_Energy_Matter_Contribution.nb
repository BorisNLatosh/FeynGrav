Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorProca", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], "==", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], 
       RowBox[{"A0", "[", 
        SuperscriptBox["m", "2"], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            SuperscriptBox["m", "2"], "D"]}], 
          RowBox[{"NieuwenhuizenOperator1", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["1", "4"], 
          FractionBox["1", "D"], 
          FractionBox["1", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"D", "+", "1"}], ")"}]}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", 
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["D", "2"], "-", "D", "+", "1"}], ")"}], " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", 
                SuperscriptBox["D", "2"]}], "-", 
               RowBox[{"3", "D"}], "-", "7"}], ")"}], "D", " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "-", 
         RowBox[{
          FractionBox["1", "8"], 
          FractionBox["1", "D"], 
          FractionBox["1", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"D", "-", "1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"D", "+", "1"}], ")"}]}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "4"}], "-", 
               RowBox[{"14", " ", "D"}], "+", 
               RowBox[{"5", " ", 
                SuperscriptBox["D", "2"]}]}], ")"}], " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"28", "+", 
               RowBox[{"18", " ", "D"}], "-", 
               RowBox[{"17", " ", 
                SuperscriptBox["D", "2"]}], "+", 
               RowBox[{"3", " ", 
                SuperscriptBox["D", "3"]}]}], ")"}], "D", " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox[
           SuperscriptBox["m", "2"], "D"], 
          RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", 
         SuperscriptBox["m", "2"], ",", 
         SuperscriptBox["m", "2"]}], "]"}], 
       FractionBox["1", "8"], 
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"D", "+", "1"}], ")"}]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"16", " ", 
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], " ", 
             SuperscriptBox["m", "4"]}], "+", 
            RowBox[{"8", " ", 
             RowBox[{"(", 
              RowBox[{"3", "+", "D"}], ")"}], " ", 
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "7"}], "-", 
               RowBox[{"3", " ", "D"}], "+", 
               RowBox[{"2", " ", 
                SuperscriptBox["D", "2"]}]}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"SPD", "[", 
               RowBox[{"p", ",", "p"}], "]"}], "2"]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"80", " ", 
             RowBox[{"(", 
              RowBox[{"D", "-", "1"}], ")"}], " ", 
             SuperscriptBox["m", "4"]}], "+", 
            RowBox[{"8", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "6"}], "-", 
               RowBox[{"13", " ", "D"}], "+", 
               RowBox[{"3", " ", 
                SuperscriptBox["D", "2"]}]}], ")"}], " ", 
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"28", "+", 
               RowBox[{"18", " ", "D"}], "-", 
               RowBox[{"17", " ", 
                SuperscriptBox["D", "2"]}], "+", 
               RowBox[{"3", " ", 
                SuperscriptBox["D", "3"]}]}], ")"}], " ", 
             SuperscriptBox[
              RowBox[{"SPD", "[", 
               RowBox[{"p", ",", "p"}], "]"}], "2"]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//",
