}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"CalcFormCalculate", "[", 
   RowBox[{"Explicit", "[", 
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorScalar", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p", ",", "\[Alpha]"}], "]"}]}], "]"}], "]"}], "==", 
  "0"}]], "Input",
 InitializationCell->False,
