Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorFermion2", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
      ",", "m_"}], "]"}], "=", 
    RowBox[{
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{"Calc", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"DiracTrace", "[", 
          RowBox[{
           RowBox[{"GravitonFermionVertex", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "k", ",", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"p", "+", "k"}], ")"}]}], ",", "m"}], "]"}], ".", 
           RowBox[{"QuarkPropagator", "[", 
            RowBox[{"{", 
             RowBox[{"k", ",", "m"}], "}"}], "]"}], ".", 
           RowBox[{"GravitonFermionVertex", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", 
             RowBox[{"p", "+", "k"}], ",", 
             RowBox[{"-", "k"}], ",", "m"}], "]"}], ".", 
           RowBox[{"QuarkPropagator", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"p", "+", "k"}], ",", "m"}], "}"}], "]"}]}], "]"}]}], 
        "]"}], ",", "k", ",", 
       RowBox[{"ToPaVe", "->", "True"}]}], "]"}], "//", "Factor"}]}], ";"}], "//",
