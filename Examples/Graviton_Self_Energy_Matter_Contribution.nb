Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorGluon2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"TID", "[", 
      RowBox[{
       RowBox[{"Explicit", "[", 
        RowBox[{
         RowBox[{"GravitonGluonVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "}"}], ",", 
           RowBox[{"-", "k"}], ",", "\[Sigma]1", ",", "a1", ",", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"p", "-", "k"}], ")"}]}], ",", "\[Rho]1", ",", "b1"}], 
          "]"}], " ", 
         RowBox[{"GluonPropagator", "[", 
          RowBox[{"k", ",", 
           RowBox[{"{", 
            RowBox[{"\[Sigma]1", ",", "a1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Sigma]2", ",", "a2"}], "}"}]}], "]"}], " ", 
         RowBox[{"GluonPropagator", "[", 
          RowBox[{
           RowBox[{"p", "-", "k"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Rho]1", ",", "b1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Rho]2", ",", "b2"}], "}"}]}], "]"}], " ", 
         RowBox[{"GravitonGluonVertex", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
             RowBox[{"-", "p"}]}], "}"}], ",", "k", ",", "\[Sigma]2", ",", 
           "a2", ",", 
           RowBox[{"p", "-", "k"}], ",", "\[Rho]2", ",", "b2"}], "]"}]}], 
        "]"}], ",", "k", ",", 
       RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}], ",", 
     "GaugeFixingEpsilonSUNYM", ",", "Factor"}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.00009882625436*^9, 4.0000988461123743`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"108f4b0d-f2f9-48f5-9b8a-a2ba6772147f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GravitonPolarizationOperatorQuark2", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
    "]"}], "=", 
