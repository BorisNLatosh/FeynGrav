Cell[TextData[StyleBox["Explicit expression.",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.879389572370703*^9, 3.879389577354787*^9}, 
   3.894656872162656*^9},ExpressionUUID->"6cccb758-55b7-484a-9e14-\
dfc54ad8872b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorScalar", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
       "m"}], "]"}], "==", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], " ", 
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"D", "+", "1"}], ")"}]}]], 
       RowBox[{"A0", "[", 
        SuperscriptBox["m", "2"], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              FractionBox["1", "4"], 
              RowBox[{"SPD", "[", 
               RowBox[{"p", ",", "p"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"D", "-", "2"}], ")"}], 
              SuperscriptBox["m", "2"]}]}], ")"}]}], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "8"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "20"}], " ", 
             RowBox[{"(", 
              RowBox[{"D", "-", "2"}], ")"}], " ", 
             SuperscriptBox["m", "2"]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"4", "+", 
               RowBox[{"6", " ", "D"}], "-", 
               RowBox[{"3", " ", 
                SuperscriptBox["D", "2"]}]}], ")"}], 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["\[Kappa]", "2"], " ", 
       FractionBox["1", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"D", "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"D", "+", "1"}], ")"}]}]], 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SPD", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", 
         SuperscriptBox["m", "2"], ",", 
         SuperscriptBox["m", "2"]}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "8"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}], "-", 
             RowBox[{"4", 
              SuperscriptBox["m", "2"]}]}], ")"}], "2"], 
          RowBox[{"NieuwenhuizenOperator2", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "16"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"80", " ", 
             SuperscriptBox["m", "4"]}], "+", 
            RowBox[{"8", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"3", "D"}], "-", "2"}], ")"}], " ", 
             SuperscriptBox["m", "2"], 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], " ", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "4"}], "-", 
               RowBox[{"6", " ", "D"}], "+", 
               RowBox[{"3", " ", 
                SuperscriptBox["D", "2"]}]}], ")"}], 
             SuperscriptBox[
              RowBox[{"SPD", "[", 
               RowBox[{"p", ",", "p"}], "]"}], "2"]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//",
    "Calc"}], "//", "Simplify"}]], "Input",
