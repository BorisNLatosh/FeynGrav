 RowBox[{
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Calc", "[", 
     RowBox[{
      RowBox[{"GravitonPolarizationOperatorFermion", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",", 
        "m"}], "]"}], 
