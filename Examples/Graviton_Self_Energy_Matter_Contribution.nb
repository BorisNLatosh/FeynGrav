        "m"}], "]"}], 
      RowBox[{"FVD", "[", 
       RowBox[{"p", ",", "\[Mu]"}], "]"}], 
      RowBox[{"PolarizationTensor", "[", 
       RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "p"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"A0", "[", "__", "]"}], ",", 
      RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", "ClearScalarProducts"}], "Input",
