Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GravitonPolarizationOperatorSUNYM", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "==", 
     RowBox[{"\[ImaginaryI]", " ", 
      SuperscriptBox["\[Pi]", "2"], 
      SuperscriptBox["\[Kappa]", "2"], 
      FractionBox["1", "8"], 
      FractionBox["1", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"D", "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"D", "+", "1"}], ")"}]}]], 
      SuperscriptBox[
       RowBox[{"SPD", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "2"], 
      RowBox[{"B0", "[", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"CA", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "D"}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "5"}], "+", 
              RowBox[{"2", " ", "D"}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["CA", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "5"}], "+", 
              RowBox[{"2", " ", "D"}]}], ")"}]}]}], ")"}], 
         RowBox[{"NieuwenhuizenOperator2", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "CA", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "4"}], "+", "D"}], ")"}]}], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"20", "-", 
              RowBox[{"14", " ", "D"}], "+", 
              RowBox[{"3", " ", 
               SuperscriptBox["D", "2"]}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["CA", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "+", "D"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"20", "-", 
              RowBox[{"14", " ", "D"}], "+", 
              RowBox[{"3", " ", 
               SuperscriptBox["D", "2"]}]}], ")"}]}]}], ")"}], 
         RowBox[{"NieuwenhuizenOperator0", "[", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
          "]"}]}]}], ")"}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//", 
