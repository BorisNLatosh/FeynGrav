Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorScalar", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_", 
      ",", "m_"}], "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GravitonPolarizationOperatorScalar1", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",",
          "m"}], "]"}], "+", 
       RowBox[{"GravitonPolarizationOperatorScalar2", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p", ",",
          "m"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A0", "[", "__", "]"}], ",", 
        RowBox[{"B0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}]}], 
   ";"}], "//", "Timing"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.879389522417501*^9, 3.879389556022439*^9}, {
