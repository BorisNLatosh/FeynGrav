Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorVector1", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{"TID", "[", 
     RowBox[{
      RowBox[{"Calc", "[", 
       RowBox[{
        RowBox[{"GravitonVectorVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "p", ",", "\[Alpha]", ",", "\[Beta]", 
            ",", 
            RowBox[{"-", "p"}]}], "}"}], ",", "\[Lambda]1", ",", "k", ",", 
          "\[Lambda]2", ",", 
          RowBox[{"-", "k"}]}], "]"}], 
        RowBox[{"GluonPropagator", "[", 
         RowBox[{"k", ",", " ", 
          RowBox[{"{", "\[Lambda]1", "}"}], ",", " ", 
          RowBox[{"{", "\[Lambda]2", "}"}]}], "]"}]}], "]"}], ",", "k", ",", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GravitonPolarizationOperatorVector1Ghost", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Nu]_", ",", "\[Alpha]_", ",", "\[Beta]_", ",", "p_"}], 
     "]"}], "=", 
    RowBox[{"TID", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GravitonVectorGhostVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "k", ",", 
         RowBox[{"-", "k"}]}], "]"}], 
       RowBox[{"ScalarPropagator", "[", 
        RowBox[{"k", ",", "0"}], "]"}]}], ",", "k", ",", 
      RowBox[{"ToPaVe", "->", "True"}]}], "]"}]}], ";"}], "//", 
  "Timing"}]}], "Input",
 Editable->False,
