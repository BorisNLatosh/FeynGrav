Cell[TextData[StyleBox["Bubble contribution.",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.879389394607505*^9, 3.87938939525586*^9}, {
  3.894656840265451*^9, 
