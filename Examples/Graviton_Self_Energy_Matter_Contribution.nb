     RowBox[{"GravitonPolarizationOperatorVector2Ghost", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[37]:=",ExpressionUUID->"d2fc1e9b-4879-42fd-bf5c-d36f92a4663a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Longitudinal contractions", "Subsection",ExpressionUUID->"2dca938a-91f6-43a9-8f3f-8fd482d1542b"],

Cell["\<\
Inspect the contraction with the external momentum. A zero residual means \
that this particular contraction vanishes. Off-shell or massive-sector \
residuals should be read as displayed; this cell alone does not establish a \
full renormalised Ward identity.\
\>", "Text",ExpressionUUID->"647672e5-d89f-4de8-a3c5-2b8afafb55f0"],

