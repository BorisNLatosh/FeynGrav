            RowBox[{
             RowBox[{"(", 
              RowBox[{"D", "-", "4"}], ")"}], 
             RowBox[{"SPD", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}]}], ")"}], 
          RowBox[{"NieuwenhuizenOperator0", "[", 
           RowBox[{
           "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
            "]"}]}]}], ")"}]}]}]}], "//", "FeynAmpDenominatorExplicit"}], "//",
