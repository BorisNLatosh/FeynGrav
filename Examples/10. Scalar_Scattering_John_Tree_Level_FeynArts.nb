Cell[CellGroupData[{

Cell["4. Fix the on-shell kinematics", "Section",ExpressionUUID->"564f8994-fd7b-41a5-af3d-8d0fad7d7e61"],

Cell["\<\
p1 and p2 are incoming; p3 and p4 are outgoing. SetMandelstam uses the \
all-incoming list p1, p2, -p3, -p4. All four scalars have mass m, and s + t + \
u = 4 m^2. The calculation below is a four-dimensional tree amplitude. \
Scalar-product assignments persist in the kernel.\
\>", "Text",ExpressionUUID->"afc0afa1-b8ee-4edc-afaf-455c654efc13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", " ", "t", ",", " ", "u", ",", " ", "p1", ",", " ", "p2", ",", 
    " ", 
    RowBox[{"-", "p3"}], ",", " ", 
    RowBox[{"-", "p4"}], ",", " ", "m", ",", " ", "m", ",", " ", "m", ",", 
    " ", "m"}], "]"}], ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"ea52be57-c498-460a-8189-95b75a2a6cf9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Calculate the on-shell amplitude", "Section",ExpressionUUID->"8179ae91-1dd7-4316-8ee5-f29926d0e4e6"],

Cell["\<\
The single command below constructs, converts and contracts the diagrams with \
the on-shell scalar products already assigned. The Feynman rules yield i M, \
so division by I defines M. ScalarMass and JohnBeta are replaced by m and the \
Greek symbol beta. ChangeDimension fixes tensor dimensions; the additional D \
-> 4 specialises the explicit dimension-dependent propagator coefficient. No \
phase-space symmetry factor is included.\
\>", "Text",ExpressionUUID->"7c2f8b9a-c30e-4ba1-801f-880b4aca8a2f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalM]", " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExpandScalarProduct", "[", 
         RowBox[{"Contract", "[", 
          RowBox[{"FeynAmpDenominatorExplicit", "[", 
           RowBox[{
            RowBox[{"FCFAConvert", "[", 
             RowBox[{
              RowBox[{"CreateFeynAmp", "[", 
               RowBox[{"insertions", ",", " ", 
                RowBox[{"PreFactor", " ", "->", " ", "1"}], ",", " ", 
                RowBox[{"GaugeRules", " ", "->", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                RowBox[{"MomentumConservation", " ", "->", " ", "True"}], ",",
                 " ", 
                RowBox[{"Truncated", " ", "->", " ", "True"}]}], "]"}], ",", 
              " ", 
              RowBox[{"IncomingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
              RowBox[{"OutgoingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", " ", 
              RowBox[{"LorentzIndexNames", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{
                "\[Mu]", ",", " ", "\[Nu]", ",", " ", "\[Rho]", ",", " ", 
                 "\[Sigma]", ",", " ", "\[Alpha]", ",", " ", "\[Beta]", ",", 
                 " ", "\[Gamma]", ",", " ", "\[Delta]"}], "}"}]}], ",", " ", 
              RowBox[{"ChangeDimension", " ", "->", " ", "4"}], ",", " ", 
              RowBox[{"Contract", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"Prefactor", " ", "->", " ", "1"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ScalarMass", " ", "->", " ", "m"}], ",", " ", 
              RowBox[{"JohnBeta", " ", "->", " ", "\[Beta]"}]}], "}"}]}], 
           "]"}], "]"}], "]"}], "/", "I"}], " ", "/.", " ", 
       RowBox[{"D", " ", "->", " ", "4"}]}], "]"}], ",", " ", "\[Beta]", ",", 
     " ", "Factor"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"5bea217e-244b-4559-8d5f-c51971c8fb10"],

