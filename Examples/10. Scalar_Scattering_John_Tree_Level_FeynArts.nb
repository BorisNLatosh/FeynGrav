Cell[CellGroupData[{

Cell["6. Present the amplitude", "Section",ExpressionUUID->"6c640dca-1a23-4dd1-9d76-ccfd65e1f8c5"],

Cell["\<\
The amplitude contains a minimal contribution, a term linear in beta from one \
John vertex, and a term quadratic in beta from two John vertices. Both \
vertices are of order kappa, so all three contributions are of order kappa^2. \
The table is extracted from the calculated amplitude. Pole prescriptions are \
implicit in the original propagators; rational expressions are displayed away \
from the poles.\
\>", "Text",ExpressionUUID->"0cacb26d-52a4-41f3-8e67-9c67e3fa2a80"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mMinimal", " ", "=", " ", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"\[ScriptCapitalM]", ",", " ", "\[Beta]", ",", " ", "0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mMixed", " ", "=", " ", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"\[ScriptCapitalM]", ",", " ", "\[Beta]", ",", " ", "1"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mJohn", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Beta]", "^", "2"}], " ", 
    RowBox[{"Coefficient", "[", 
     RowBox[{"\[ScriptCapitalM]", ",", " ", "\[Beta]", ",", " ", "2"}], 
     "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"cda4a1f4-9cc9-4ddf-955b-ad1999ff5475"],

