       SuperscriptBox["m", "2"], " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"s", " ", "t", " ", "u"}]}], ")"}]}], "+", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"8", " ", "s", " ", "t", " ", "u"}]], 
    RowBox[{"\[Beta]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"32", " ", 
         SuperscriptBox["m", "6"], " ", "s", " ", "t"}]}], "-", 
       RowBox[{"32", " ", 
        SuperscriptBox["m", "6"], " ", "s", " ", "u"}], "-", 
       RowBox[{"32", " ", 
        SuperscriptBox["m", "6"], " ", "t", " ", "u"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", 
        SuperscriptBox["s", "2"], " ", "t"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", 
        SuperscriptBox["s", "2"], " ", "u"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", "s", " ", 
        SuperscriptBox["t", "2"]}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", "s", " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", 
        SuperscriptBox["t", "2"], " ", "u"}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["m", "4"], " ", "t", " ", 
        SuperscriptBox["u", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "2"], " ", 
        SuperscriptBox["t", "2"]}], "+", 
       RowBox[{"6", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "2"], " ", 
        SuperscriptBox["u", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
