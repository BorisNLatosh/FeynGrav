Cell[CellGroupData[{

Cell["Consistency checks", "Subsection",ExpressionUUID->"28c4dcae-4550-4190-bcf3-0f8a814cd0db"],

Cell["\<\
The beta = 0 reference is the gravitational contribution in example 09 with \
both scalar-potential couplings set to zero. The checks also test crossing \
symmetry, the coupling decomposition and decoupling of gravity. They do not \
constitute loop validation.\
\>", "Text",ExpressionUUID->"55150929-bac2-45e0-85a6-1e525670b3f2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"minimalChannel", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"m", "^", "2"}]}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"z", " ", "-", " ", 
         RowBox[{"2", " ", 
          RowBox[{"m", "^", "2"}]}]}], ")"}]}], " ", "+", " ", 
      RowBox[{"2", " ", 
       RowBox[{"m", "^", "4"}]}]}], ")"}], "/", "x"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minimalReference", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Kappa]", "^", "2"}], "/", "4"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"minimalChannel", "[", 
       RowBox[{"s", ",", " ", "t", ",", " ", "u"}], "]"}], " ", "+", " ", 
      RowBox[{"minimalChannel", "[", 
       RowBox[{"t", ",", " ", "s", ",", " ", "u"}], "]"}], " ", "+", " ", 
      RowBox[{"minimalChannel", "[", 
       RowBox[{"u", ",", " ", "s", ",", " ", "t"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kinematicZero", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{"expr", " ", "/.", " ", 
      RowBox[{"u", " ", "->", " ", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"m", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", 
        "t"}]}]}], "]"}], " ", "===", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Minimal-coupling limit\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
          RowBox[{"\[Beta]", " ", "->", " ", "0"}]}], ")"}], " ", "-", " ", 
        "minimalReference"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<s-t crossing\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{"\[ScriptCapitalM]", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", " ", "->", " ", "t"}], ",", " ", 
            RowBox[{"t", " ", "->", " ", "s"}]}], "}"}]}], ")"}]}], "]"}]}], ",",
      " ", 
     RowBox[{"\"\<t-u crossing\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{"\[ScriptCapitalM]", " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"t", " ", "->", " ", "u"}], ",", " ", 
            RowBox[{"u", " ", "->", " ", "t"}]}], "}"}]}], ")"}]}], "]"}]}], ",",
      " ", 
     RowBox[{"\"\<Coupling decomposition\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{
       "\[ScriptCapitalM]", " ", "-", " ", "mMinimal", " ", "-", " ", 
        "mMixed", " ", "-", " ", "mJohn"}], "]"}]}], ",", " ", 
     RowBox[{"\"\<At most two John vertices\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"PolynomialQ", "[", 
         RowBox[{"\[ScriptCapitalM]", ",", " ", "\[Beta]"}], "]"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"\[ScriptCapitalM]", ",", " ", "\[Beta]"}], "]"}], " ", "<=",
          " ", "2"}]}], ")"}]}], ",", " ", 
     RowBox[{"\"\<Gravity switched off\>\"", " ", "->", " ", 
      RowBox[{"kinematicZero", "[", 
       RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
        RowBox[{"\[Kappa]", " ", "->", " ", "0"}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"List", " ", "@@@", " ", "checks"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Check\>\"", ",", " ", "\"\<Passed\>\""}], "}"}]}], "]"}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"1bece6bf-7bde-4bae-bab2-a5f10d98853f"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Check\"\>", "\<\"Passed\"\>"},
     {"\<\"Minimal-coupling limit\"\>", "True"},
     {"\<\"s-t crossing\"\>", "True"},
     {"\<\"t-u crossing\"\>", "True"},
     {"\<\"Coupling decomposition\"\>", "True"},
     {"\<\"At most two John vertices\"\>", "True"},
     {"\<\"Gravity switched off\"\>", "True"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.001389780299005*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"bbe98bed-0de0-4187-8c84-ad8de0df618a"]
}, Open  ]],

Cell["\<\
Specialise m and beta by replacement in M after the calculation. Use a fresh \
kernel for another example, or clear the scalar products and any definitions \
you introduced. No scalar-potential couplings or loop calculation are part of \
this model.\
\>", "Text",ExpressionUUID->"2ff4af11-2bda-4eeb-a8c7-4149fe554f0b"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
