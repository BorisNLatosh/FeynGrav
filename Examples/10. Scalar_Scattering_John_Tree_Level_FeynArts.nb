Cell[CellGroupData[{

Cell["2. Load the FeynArts model", "Section",ExpressionUUID->"af8eb5a2-0c4a-45fa-9180-0ccb0da0d768"],

Cell[BoxData[
 RowBox[{
  RowBox[{"model", " ", "=", " ", "\"\<John\>\""}], ";"}]], "Input",
 CellChangeTimes->{{4.001389763385391*^9, 4.00138976370008*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"bf4da74c-c704-42ae-b811-04453362073d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Generate and display the diagrams", "Section",ExpressionUUID->"5177ee9e-4c60-4316-88f6-ad1c8b349541"],

Cell["\<\
There are three graviton-exchange diagrams, in the s, t and u channels. Each \
vertex combines the minimal and John contributions. There is no four-scalar \
contact or scalar self-interaction exchange. The gravitational ghost does not \
contribute to this tree. The hh phi phi vertex cannot contribute to a \
four-scalar tree.\
\>", "Text",ExpressionUUID->"f515a68c-27f0-4741-9e01-93a18323abf1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"topologies", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Adjacencies", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"insertions", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"topologies", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"c4d9f5d0-76bf-4679-b463-302841e560ac"],

