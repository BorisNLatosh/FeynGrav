       RowBox[{"6", " ", 
        SuperscriptBox["m", "2"], " ", "s", " ", "t", " ", 
        SuperscriptBox["u", "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["t", "3"], " ", "u"}], "-", 
