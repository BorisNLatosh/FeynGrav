Cell[CellGroupData[{

Cell["Remaining scalar-sector relations", "Subsection",ExpressionUUID->"89528abf-594b-4180-a7d1-f1458e34dc9d"],

Cell["\<\
The factor 3 in the squared mixed operator belongs to the four-dimensional \
specialization. Keep dimension-dependent coefficients if adapting these \
checks to general D.\
\>", "Text",ExpressionUUID->"4196486c-3954-41a7-b1ba-49377534ddfb"],

Cell[BoxData[
 RowBox[{"CalcFormCalculate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "p"}], 
        "]"}], " ", 
       RowBox[{"NieuwenhuizenOperator0", "[", 
        RowBox[{
        "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", 
         "p"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"NieuwenhuizenOperator0", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "p"}], 
        "]"}], " ", 
       RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
        RowBox[{
        "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", 
         "p"}], "]"}]}]}], "]"}], "\[Equal]", 
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
