Notebook[{

Cell[CellGroupData[{
Cell["Spin projectors for a symmetric tensor", "Title",ExpressionUUID->"582b08ad-9aa0-47a1-88b6-599317f8fc86"],

Cell["\<\
Start here to learn how FeynGrav represents Lorentz indices, momenta and \
tensor identities. Inspect the five Nieuwenhuizen operators and verify \
completeness, idempotence and their multiplication rules.\
\>", "Text",ExpressionUUID->"9210c3a0-bec7-4229-9e19-3b07b0a4039a"],

Cell[CellGroupData[{

Cell["1. Setup and notation", "Section",ExpressionUUID->"f4046281-86df-4483-9d51-c88c6c9a8a5f"],

Cell["\<\
Start with a fresh Mathematica kernel and evaluate the input cells from top \
to bottom (Shift+Enter). Install FeynGrav and its FeynCalc dependency first; \
see the package README. Opening this notebook executes nothing. A semicolon \
stores an intermediate result without printing its full expression. Use \
?FunctionName for help and FeynGravCommands[] to discover the package \
interface.\
\>", "Text",ExpressionUUID->"0a53b9d6-5058-4ca2-9933-a1855754ced7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "\"\<FeynGrav`\>\""}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.0001010036983223`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"139888a2-6dd2-4f87-bed4-9852610a8ce4"],

Cell["\<\
This notebook requires FORM on the kernel\[CloseCurlyQuote]s PATH. \
CalcFormCalculate performs bosonic algebra and Lorentz contractions; TFORM is \
used automatically when available. FeynCalc handles loop reduction and any \
Dirac or colour algebra before the bosonic coefficients are sent to FORM.\
\>", "Text",
 CellChangeTimes->{
  4.00009044886372*^9},ExpressionUUID->"a1283fc5-f8a8-47bb-886f-568a68325c13"],

Cell["\<\
FeynGrav supplies the vertex and propagator normalisations, including i and \
\[Kappa]. The default gravitational gauge parameter is GaugeFixingEpsilon = \
2. The displayed diagram weights are retained from the original example; the \
notebook does not derive their combinatorics.\
\>", "Text",ExpressionUUID->"83a545fb-ab33-49aa-b0d6-fc2d1c6c461a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Discover the operator interface", "Section",ExpressionUUID->"1e569032-3c53-4f62-8a97-786b8d1c0935"],

Cell["\<\
The four indices label two symmetric tensor slots; p is the momentum. \
Evaluate these help queries to see the exact package conventions.\
\>", "Text",ExpressionUUID->"82e546d8-e4d7-4fb8-964c-479e706f8bb3"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<NieuwenhuizenOperator1\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.000101016110733*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"72e150eb-3cc3-4bb7-b4b7-a45704acde27"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<NieuwenhuizenOperator2\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[3]:=",ExpressionUUID->"1b27422d-e0c6-455f-b2b8-b89b1b6ef128"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<NieuwenhuizenOperator0\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[4]:=",ExpressionUUID->"caefb6a5-3856-4d75-b77b-993363db1507"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<NieuwenhuizenOperator0Bar\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[5]:=",ExpressionUUID->"61220477-91c5-4287-8969-a83a56878aad"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"\"\<NieuwenhuizenOperator0BarBar\>\"", ",", 
   RowBox[{"LongForm", "\[Rule]", "False"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[6]:=",ExpressionUUID->"511d1254-4313-40a2-a1d9-4d8aa0d5c69c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Inspect the definitions", "Section",ExpressionUUID->"217fdcef-64f4-42b4-ae5a-9a918bcd6a2f"],

Cell["\<\
The definitions use D-dimensional metrics and propagator denominators. \
FeynAmpDenominatorExplicit turns a massless denominator into 1/p\.b2. These \
projectors require non-zero p\.b2; they are not massless external \
polarisation tensors.\
\>", "Text",
 CellChangeTimes->{
  4.000090459801566*^9},ExpressionUUID->"668973e1-21b4-483a-a49f-\
6aab424ce840"],

Cell[BoxData[
 RowBox[{"NieuwenhuizenOperator1", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[7]:=",ExpressionUUID->"b09bcc2b-d839-46cc-b203-572aa245fd30"],

Cell[BoxData[
 RowBox[{"NieuwenhuizenOperator2", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[8]:=",ExpressionUUID->"c2db2ebb-7aa0-4457-91ad-45d9482f755d"],

Cell[BoxData[
 RowBox[{"NieuwenhuizenOperator0", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[9]:=",ExpressionUUID->"b85fff12-68c3-4fa5-9b13-7b49a9849fb7"],

Cell[BoxData[
 RowBox[{"NieuwenhuizenOperator0Bar", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[10]:=",ExpressionUUID->"500eda66-757c-49db-bdc8-7c92ed71b8da"],

Cell[BoxData[
 RowBox[{"NieuwenhuizenOperator0BarBar", "[", 
  RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[11]:=",ExpressionUUID->"6daf24f9-7d98-4743-ab1f-eeb616707897"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Verify the algebra", "Section",ExpressionUUID->"e0cc930c-396c-43d0-b164-5c7ad7ba5a60"],

Cell["\<\
Repeated Lorentz indices are contracted by CalcFormCalculate. Each check \
sends the tensor expression to FORM and imports the contracted result into \
FeynCalc notation.\
\>", "Text",ExpressionUUID->"5783cdd2-e436-4d4a-bb5a-986bbb849373"],

Cell[CellGroupData[{

Cell["Completeness", "Subsection",ExpressionUUID->"f7a3f46f-61b6-49ff-a60a-fd8373f5e20a"],

Cell["\<\
The four diagonal projectors sum to the identity on symmetric rank-two \
tensors. The mixed scalar operator is not included in this sum.\
\>", "Text",ExpressionUUID->"f4c38e98-fd17-41f0-b5bc-92a879d7594c"],

Cell[BoxData[
 RowBox[{"CalcFormCalculate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"NieuwenhuizenOperator0", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator1", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator2", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}], "+", 
    RowBox[{"NieuwenhuizenOperator0Bar", "[", 
     RowBox[{
     "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
     "]"}]}], "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"MTD", "[", 
        RowBox[{"\[Mu]", ",", "\[Alpha]"}], "]"}], " ", 
       RowBox[{"MTD", "[", 
        RowBox[{"\[Nu]", ",", "\[Beta]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"MTD", "[", 
        RowBox[{"\[Mu]", ",", "\[Beta]"}], "]"}], " ", 
       RowBox[{"MTD", "[", 
        RowBox[{"\[Nu]", ",", "\[Alpha]"}], "]"}]}]}], ")"}]}]}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.000090494737589*^9, 4.000101029004466*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"0d94a6c2-4217-4510-a23c-c71e3c6b3d9f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Idempotence", "Subsection",ExpressionUUID->"f563b8ba-278e-4305-8a7d-62cdc204d084"],

Cell["\<\
Each diagonal projector squares to itself. The following checks explicitly \
specialize to D = 4, matching the numerical factors used later.\
\>", "Text",ExpressionUUID->"06ce0e01-d76c-4622-87f5-55a2886bd67f"],

Cell[BoxData[
 RowBox[{"CalcFormCalculate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{"NieuwenhuizenOperator0", "[", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Sigma]", ",", "p"}], 
       "]"}], " ", 
      RowBox[{"NieuwenhuizenOperator0", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}],
        "]"}]}], "]"}], "\[Equal]", 
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"NieuwenhuizenOperator0", "[", 
      RowBox[{
      "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "p"}], 
      "]"}], "]"}]}], "/.", "\[VeryThinSpace]", 
   RowBox[{"D", "\[Rule]", "4"}]}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.0000905042064657`*^9, 4.000101036619925*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"cfc819b3-0c13-4e16-a622-d421fa0d133e"],

