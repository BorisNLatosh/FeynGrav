                     {RowBox[{RowBox[{"FVD", "[", RowBox[{"p3", ",", 
                          "\[Mu]"}], "]"}], " ", RowBox[{"FVD", "[", RowBox[
                          {"\[Xi]", ",", "\[Nu]"}], "]"}]}], "+", RowBox[
                       {RowBox[{"FVD", "[", RowBox[{"\[Xi]", ",", "\[Mu]"}], 
                          "]"}], " ", RowBox[{"FVD", "[", RowBox[{"p3", ",", 
                          "\[Nu]"}], "]"}]}]}], ")"}], " ", RowBox[
