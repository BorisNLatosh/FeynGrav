                     {"p4", ",", "\[Rho]"}], "]"}]}], "]"}], ".", 
              RowBox[{"(", RowBox[{RowBox[{"GSD", "[", "p2", "]"}], "+", 
                  "m"}], ")"}]}], "]"}], "]"}]}], ";", 
      RowBox[{RowBox[{"Expand", "[", RowBox[{"Together", "[", 
            "gluonResidual", "]"}], "]"}], "===", "0"}]}]], "Input", 
   CellTags -> "gluon-ward", ExpressionUUID -> 
    "451493d1-6199-41a7-bbab-0acec12600d9"], Cell[BoxData["True"], "Output", 
   GeneratedCell -> True, CellAutoOverwrite -> True, 
   ExpressionUUID -> "f3447b8d-d550-4cb2-9f44-86f45ed73cd5"], 
  Cell["For the gravitational Ward identity, replace the graviton tensor by \
p\:2083\:1d50\:1d58 \[Xi]\:207f\:1d58 + \[Xi]\:1d50\:1d58 \
p\:2083\:207f\:1d58. The vector \[Xi] is arbitrary: no transversality or null \
condition is imposed on it. Keep the gluon physical and impose the same \
external Dirac equations. The result should be True.", "Text", 
   ExpressionUUID -> "bc7b4356-8582-46a7-834a-9ff8e04a4a57"], 
  Cell[BoxData[RowBox[{RowBox[{"gravitonResidual", "=", 
        RowBox[{"onShell", "[", RowBox[{"FeynGravSimplify", "[", 
            RowBox[{RowBox[{"(", RowBox[{RowBox[{"GSD", "[", "p1", "]"}], 
