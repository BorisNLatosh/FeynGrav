  Cell["The diagrams are the hq\:0304qA contact, an s-channel gluon, and two \
quark exchanges. FeynArts supplies their relative signs and tree weights; no \
additional symmetry factors are inserted.", "Text", 
   ExpressionUUID -> "f0c60e46-375f-465e-8e7d-279c4eb001a1"], 
  Cell["3. Fix on-shell kinematics", "Section", 
   ExpressionUUID -> "e304602d-4c5c-4e33-ae33-9770dae7aa08"], 
  Cell[BoxData[RowBox[{RowBox[{"FCClearScalarProducts", "[", "]"}], ";", 
      RowBox[{"SetMandelstam", "[", RowBox[{"s", ",", "t", ",", "u", ",", 
          "p1", ",", "p2", ",", RowBox[{"-", "p3"}], ",", 
          RowBox[{"-", "p4"}], ",", "m", ",", "m", ",", "0", ",", "0"}], 
        "]"}], ";", RowBox[{RowBox[{"onShell", "[", "expr_", "]"}], ":=", 
        RowBox[{RowBox[{"ExpandScalarProduct", "[", 
            RowBox[{"DiracGammaExpand", "[", RowBox[{RowBox[
                 {"MomentumExpand", "[", RowBox[{"FCI", "[", "expr", "]"}], 
                  "]"}], "/.", "\[VeryThinSpace]", RowBox[
                 {RowBox[{"Momentum", "[", RowBox[{"p4", ",", "D"}], "]"}], 
                  "\[Rule]", RowBox[{"Momentum", "[", RowBox[{RowBox[
                       {"p1", "+", "p2", "-", "p3"}], ",", "D"}], "]"}]}]}], 
              "]"}], "]"}], "/.", "\[VeryThinSpace]", 
          RowBox[{"u", "\[Rule]", RowBox[{RowBox[{"2", " ", SuperscriptBox[
                 "m", "2"]}], "-", "s", "-", "t"}]}]}]}], ";"}]], "Input", 
   CellTags -> "kinematics", ExpressionUUID -> 
    "90853ac8-fb3a-457a-922b-368019607e23"], Cell["Outgoing states use \
conjugated polarisation vectors, Polarization[p, -I]. The graviton tensor is \
a product of two transverse null vectors, which is traceless. These \
conditions select physical external states without setting D = 4. The last \
scalar-product assignment combines gluon transversality with momentum \
conservation.", "Text", ExpressionUUID -> 
    "415a75a6-e408-496f-bb06-f20edbb9307f"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
              RowBox[{"p3", ",", "D"}], "]"}], ",", RowBox[{"Momentum", "[", 
              RowBox[{RowBox[{"Polarization", "[", RowBox[{"p3", ",", 
                    RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], 
              "]"}]}], "]"}], "=", "0"}], ";", 
      RowBox[{RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
              RowBox[{RowBox[{"Polarization", "[", RowBox[{"p3", ",", 
                    RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], 
              "]"}], ",", RowBox[{"Momentum", "[", RowBox[{RowBox[
                 {"Polarization", "[", RowBox[{"p3", ",", RowBox[{"-", 
                      "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
        "=", "0"}], ";", RowBox[
       {RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
              RowBox[{"p4", ",", "D"}], "]"}], ",", RowBox[{"Momentum", "[", 
              RowBox[{RowBox[{"Polarization", "[", RowBox[{"p4", ",", 
                    RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], 
              "]"}]}], "]"}], "=", "0"}], ";", 
      RowBox[{RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
              RowBox[{"p3", ",", "D"}], "]"}], ",", RowBox[{"Momentum", "[", 
              RowBox[{RowBox[{"Polarization", "[", RowBox[{"p4", ",", 
                    RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], 
              "]"}]}], "]"}], "=", RowBox[
         {RowBox[{"Pair", "[", RowBox[{RowBox[{"Momentum", "[", 
                RowBox[{"p1", ",", "D"}], "]"}], ",", RowBox[{"Momentum", 
                "[", RowBox[{RowBox[{"Polarization", "[", RowBox[{"p4", ",", 
                      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], 
                "]"}]}], "]"}], "+", RowBox[{"Pair", "[", 
            RowBox[{RowBox[{"Momentum", "[", RowBox[{"p2", ",", "D"}], "]"}], 
              ",", RowBox[{"Momentum", "[", RowBox[{RowBox[{"Polarization", 
                    "[", RowBox[{"p4", ",", RowBox[{"-", "\[ImaginaryI]"}]}], 
                    "]"}], ",", "D"}], "]"}]}], "]"}]}]}], ";"}]], "Input", 
   CellTags -> "polarisations", ExpressionUUID -> 
    "6d459caa-814d-4c1f-bcf0-b87b376e5f11"], 
  Cell["4. Calculate and present the amplitude", "Section", 
   ExpressionUUID -> "0a3964b7-ada5-4d82-9b74-4e54305c07ae"], 
  Cell["Truncated -> True leaves the ordered Dirac matrix and external \
Lorentz indices open. In these four diagrams every internal colour index \
forms a paired contraction, so DropSumOver -> True lets FORM perform the \
corresponding Einstein sums. This choice has been checked for this process \
and should not be copied blindly to other amplitudes.", "Text", 
   ExpressionUUID -> "2c9439fd-d7af-4f0c-8988-f2027239c126"], 
  Cell[BoxData[RowBox[{RowBox[{"raw", "=", RowBox[{"CreateFeynAmp", "[", 
          RowBox[{"insertions", ",", RowBox[{"Truncated", "\[Rule]", 
              "True"}], ",", RowBox[{"MomentumConservation", "\[Rule]", 
              "True"}], ",", RowBox[{"PreFactor", "\[Rule]", "1"}]}], 
          "]"}]}], ";", RowBox[{"diagrams", "=", 
        RowBox[{RowBox[{"FCFAConvert", "[", RowBox[{"raw", ",", 
              RowBox[{"IncomingMomenta", "\[Rule]", RowBox[{"{", 
                  RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
