Notebook[{Cell["Quark\[Dash]antiquark annihilation with graviton emission", 
   "Title", ExpressionUUID -> "77a8c424-c3ba-4c97-9931-7fddc7bfd689"], 
  Cell["q\:0304(p\:2081) + q(p\:2082) \[RightArrow] h(p\:2083) + A(p\:2084). \
One fundamental Dirac flavour has arbitrary mass m. This tree example keeps D \
and N symbolic and uses FeynGravSimplify with FORM for Lorentz, Dirac and \
colour algebra. Start in a fresh kernel and evaluate from top to bottom. No \
spin or colour average is taken.", "Text", ExpressionUUID -> 
    "1122509b-c27c-4ec8-a3ab-38dadbb4258b"], 
  Cell["1. Load FeynGrav and the model", "Section", 
   ExpressionUUID -> "2be3d1c0-6519-4db5-8041-4d0811b9a6a4"], 
  Cell[BoxData[RowBox[{RowBox[{"$LoadAddOns", "=", 
        RowBox[{"{", "\"FeynArts\"", "}"}]}], ";", 
      RowBox[{"<<", "\"FeynGrav`\""}], ";"}]], "Input", CellTags -> "load", 
   ExpressionUUID -> "acebcd46-e97d-4242-ad10-9af7fc0b1cb9"], 
  Cell[BoxData[RowBox[{RowBox[{"model", "=", "\"GR-SU-N-Yang-Mills\""}], ";", 
      RowBox[{"InitializeModel", "[", RowBox[{"model", ",", 
          RowBox[{"GenericModel", "\[Rule]", "model"}]}], "]"}], ";", 
      RowBox[{"SetOptions", "[", RowBox[{"FeynGravSimplify", ",", 
          RowBox[{"Method", "\[Rule]", "\"FORM\""}], ",", 
          RowBox[{"FORMThreads", "\[Rule]", "1"}], ",", 
          RowBox[{"LoopMomenta", "\[Rule]", RowBox[{"{", "}"}]}], ",", 
          RowBox[{"TensorDecomposition", "\[Rule]", "False"}]}], "]"}], 
      ";"}]], "Input", CellTags -> "model", ExpressionUUID -> 
    "9d4bb528-2550-4194-811f-66d03088fa45"], Cell["F[1] is the quark and \
-F[1] its antiquark; T[1] is the graviton and V[1] the gluon. The unchanged \
model name now includes one quark flavour. The gravitational ghost uses S[1]; \
U[1] remains the Yang\[Dash]Mills ghost.", "Text", 
   ExpressionUUID -> "2149cebe-c85f-4adc-91b1-369922f90dcf"], 
  Cell["2. Construct and display the four diagrams", "Section", 
   ExpressionUUID -> "1ce19fb6-4254-4c3d-a9d6-b0eb6cded46c"], 
  Cell[BoxData[RowBox[{RowBox[{"topologies", "=", 
        RowBox[{"CreateTopologies", "[", RowBox[{"0", ",", 
            RowBox[{"2", "\[Rule]", "2"}], ",", RowBox[{"Adjacencies", 
              "\[Rule]", RowBox[{"{", RowBox[{"3", ",", "4", ",", "5", ",", 
                  "6"}], "}"}]}]}], "]"}]}], ";", 
      RowBox[{"insertions", "=", RowBox[{"InsertFields", "[", 
          RowBox[{"topologies", ",", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"-", RowBox[{"F", "[", "1", "]"}]}], ",", 
                  RowBox[{"F", "[", "1", "]"}]}], "}"}], "\[Rule]", 
              RowBox[{"{", RowBox[{RowBox[{"T", "[", "1", "]"}], ",", 
                  RowBox[{"V", "[", "1", "]"}]}], "}"}]}], ",", 
            RowBox[{"Model", "\[Rule]", "model"}], ",", 
            RowBox[{"GenericModel", "\[Rule]", "model"}], ",", 
            RowBox[{"InsertionLevel", "\[Rule]", RowBox[{"{", "Classes", 
                "}"}]}]}], "]"}]}], ";"}]], "Input", 
   CellTags -> "insertions", ExpressionUUID -> 
    "0b153985-4a51-4046-bddd-3601c384bf0d"], 
