Cell[BoxData[
 RowBox[{
  RowBox[{"treeTopologies", "=", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"Adjacencies", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"treeInsertions", "=", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"treeTopologies", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", "[", "1", "]"}], ",", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"T", "[", "1", "]"}], ",", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}]}], ",", 
     RowBox[{"Model", "\[Rule]", "qgModel"}], ",", 
     RowBox[{"GenericModel", "\[Rule]", "qgModel"}], ",", 
     RowBox[{"InsertionLevel", "\[Rule]", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}]], "Input",
