Cell["\<\
Export and contract one diagram. The printed byte count measures the output \
passed to Mathematica.\
\>", "Text",ExpressionUUID->"2bfa479d-a47e-4c75-9e40-c53ad63de8fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qgContractOnShell", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"momenta", ":", 
      RowBox[{"{", 
       RowBox[{"_Symbol", ",", "_Symbol", ",", "_Symbol", ",", "_Symbol"}], 
       "}"}]}], ",", "config_Association"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dir", ",", "job", ",", "source", ",", "projected", ",", "cmd", ",", 
       "run", ",", "result", ",", "time"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"config", "[", "\"\<Available\>\"", "]"}], "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<FORMUnavailable\>\"", ",", "config"}], "]"}], "]"}]}], 
       "]"}], ";", 
      RowBox[{"dir", "=", 
       RowBox[{"CreateDirectory", "[", "]"}]}], ";", 
      RowBox[{"job", "=", 
       RowBox[{"CalcFormConverter`FeynGravFORMExport", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", "\"\<diagram.frm\>\""}], "}"}], "]"}]}], 
        "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AssociationQ", "[", "job", "]"}]}], ",", 
        RowBox[{"Return", "[", "job", "]"}]}], "]"}], ";", 
      RowBox[{"source", "=", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"job", "[", "\"\<InputFile\>\"", "]"}], 
         ",", "\"\<Text\>\""}], "]"}]}], ";", 
      RowBox[{"projected", "=", 
       RowBox[{"qgOnShellProgram", "[", 
        RowBox[{"source", ",", 
         RowBox[{"Import", "[", 
          RowBox[{
           RowBox[{"job", "[", "\"\<MappingFile\>\"", "]"}], 
           ",", "\"\<RawJSON\>\""}], "]"}], ",", "momenta"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "projected", "]"}], ",", 
        RowBox[{
         RowBox[{"DeleteDirectory", "[", 
          RowBox[{"dir", ",", 
           RowBox[{"DeleteContents", "\[Rule]", "True"}]}], "]"}], ";", 
         RowBox[{"Return", "[", "projected", "]"}]}]}], "]"}], ";", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"job", "[", "\"\<InputFile\>\"", "]"}], ",", "projected", 
        ",", "\"\<Text\>\""}], "]"}], ";", 
      RowBox[{"cmd", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"config", "[", "\"\<Executable\>\"", "]"}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"config", "[", "\"\<FORMThreads\>\"", "]"}], ">", "1"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<-w\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"config", "[", "\"\<FORMThreads\>\"", "]"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"job", "[", "\"\<InputFile\>\"", "]"}], "}"}]}], "]"}]}], ";", 
      RowBox[{
      "Print", "[", "\"\<FORM: contract with the on-shell scalar \
products.\>\"", "]"}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"time", ",", "run"}], "}"}], "=", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"RunProcess", "[", 
         RowBox[{"cmd", ",", 
          RowBox[{"ProcessDirectory", "\[Rule]", "dir"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "run", "]"}]}], "||", 
         RowBox[{
          RowBox[{"run", "[", "\"\<ExitCode\>\"", "]"}], "=!=", "0"}], "||", 
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"job", "[", "\"\<ResultFile\>\"", "]"}], "]"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<FORMExecution\>\"", ",", 
           RowBox[{"Association", "[", 
            RowBox[{
             RowBox[{"\"\<Directory\>\"", "\[Rule]", "dir"}], ",", 
             RowBox[{"\"\<Process\>\"", "\[Rule]", "run"}]}], "]"}]}], "]"}], 
         "]"}]}], "]"}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<FORM: \>\"", ",", 
        RowBox[{"Round", "[", 
         RowBox[{"time", ",", "0.01`"}], "]"}], ",", "\"\< s. Importing \>\"",
         ",", 
        RowBox[{"FileByteCount", "[", 
         RowBox[{"job", "[", "\"\<ResultFile\>\"", "]"}], "]"}], 
        ",", "\"\< bytes.\>\""}], "]"}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"time", ",", "result"}], "}"}], "=", 
       RowBox[{"AbsoluteTiming", "[", 
        RowBox[{"CalcFormConverter`FeynGravFORMImport", "[", 
         RowBox[{
          RowBox[{"job", "[", "\"\<ResultFile\>\"", "]"}], ",", 
          RowBox[{"job", "[", "\"\<MappingFile\>\"", "]"}]}], "]"}], "]"}]}], 
      ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Import: \>\"", ",", 
        RowBox[{"Round", "[", 
         RowBox[{"time", ",", "0.01`"}], "]"}], ",", "\"\< s.\>\""}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FailureQ", "[", "result", "]"}]}], "&&", 
         RowBox[{"result", "=!=", "$Failed"}]}], ",", 
        RowBox[{"DeleteDirectory", "[", 
         RowBox[{"dir", ",", 
          RowBox[{"DeleteContents", "\[Rule]", "True"}]}], "]"}]}], "]"}], ";",
       "result"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellTags->"qg-contract",
 CellLabel->"In[8]:=",ExpressionUUID->"0da4398e-292e-4d53-9689-7400f8bddb25"]
}, Closed]]
