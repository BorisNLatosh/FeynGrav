Cell[CellGroupData[{

Cell["FORM helper for on-shell contractions", "Subsection",ExpressionUUID->"cffe1eec-4e32-404f-961e-0863c19efc09"],

Cell["\<\
These definitions belong to this notebook. They apply the scalar products \
from section 4 inside each FORM calculation, before Mathematica reads the \
result.\
\>", "Text",ExpressionUUID->"579aa4f2-79e6-42f0-8e10-ad4a414a1193"],

Cell["\<\
Identify the four momenta and their incoming or outgoing polarisations in the \
vector table exported for this diagram. FORM can number them differently in \
each job.\
\>", "Text",ExpressionUUID->"e9e221d5-14e3-4f4b-899f-7232c0039696"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qgVectorKey", "[", "p_Symbol", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\"\<Symbol\>\"", ",", 
     RowBox[{
      RowBox[{"Context", "[", "p", "]"}], "<>", 
      RowBox[{"SymbolName", "[", "p", "]"}]}]}], "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellTags->"qg-vector-symbol",
 CellLabel->"In[5]:=",ExpressionUUID->"80ee7dee-0b4f-4fff-99b7-232e67105b92"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qgVectorKey", "[", 
    RowBox[{"FeynCalc`Polarization", "[", 
     RowBox[{"p_Symbol", ",", "sign_"}], "]"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\"\<Polarization\>\"", ",", 
     RowBox[{"qgVectorKey", "[", "p", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Complex\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Integer\>\"", ",", "\"\<0\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Integer\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"Im", "[", "sign", "]"}], "]"}]}], "}"}]}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellTags->"qg-vector-polarisation",
 CellLabel->"In[6]:=",ExpressionUUID->"bce33dc3-36b4-4663-830b-ff6e2af9831c"],

Cell["\<\
Build the substitution table. Drop vanishing products, give equal nonzero \
values the same symbol and retain the sign for opposite values. Apply the \
substitutions after each multiplication stage. Restore the original vector \
names only when writing the result for import.\
\>", "Text",ExpressionUUID->"9ff1b9dd-4e72-485a-970d-eeffb3534379"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qgOnShellProgram", "[", 
    RowBox[{"source_", ",", "mapping_", ",", "momenta_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vectors", ",", "known", ",", "labels", ",", "ids", ",", 
       RowBox[{"values", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"representatives", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"rules", "=", 
        RowBox[{"{", "}"}]}], ",", "dot", ",", "value", ",", "pos", ",", 
       "sign", ",", "name", ",", "apply", ",", "restore", ",", "declarations",
        ",", 
       RowBox[{"outputMarker", "=", "\"\<Format nospaces;\>\""}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"mapping", "[", "\"\<Version\>\"", "]"}], "=!=", "1"}], "||", 
         RowBox[{
          RowBox[{"mapping", "[", "\"\<Processing\>\"", "]"}], 
          "=!=", "\"\<TensorAlgebraOnly\>\""}], "||", 
         RowBox[{
          RowBox[{"StringCount", "[", 
           RowBox[{"source", ",", "outputMarker"}], "]"}], "=!=", "1"}], "||", 
         RowBox[{
          RowBox[{"StringCount", "[", 
           RowBox[{"source", ",", "\"\<Off Statistics;\>\""}], "]"}], "=!=", 
          "1"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<UnexpectedTreeProgram\>\"", ",", 
           RowBox[{"Association", "[", "]"}]}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"vectors", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"momenta", ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"FeynCalc`Polarization", ",", 
           RowBox[{"{", 
            RowBox[{"momenta", ",", 
             RowBox[{"{", 
              RowBox[{"\[ImaginaryI]", ",", "\[ImaginaryI]", ",", 
               RowBox[{"-", "\[ImaginaryI]"}], ",", 
               RowBox[{"-", "\[ImaginaryI]"}]}], "}"}]}], "}"}]}], "]"}]}], 
        "]"}]}], ";", 
      RowBox[{"known", "=", 
       RowBox[{"AssociationThread", "[", 
        RowBox[{
         RowBox[{"qgVectorKey", "/@", "vectors"}], ",", "vectors"}], "]"}]}], 
      ";", 
      RowBox[{"labels", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"mapping", "[", "\"\<Entries\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", "\"\<Kind\>\"", "]"}], 
           "===", "\"\<Vector\>\""}], "&"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"labels", "===", 
          RowBox[{"{", "}"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"labels", ",", 
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"known", ",", 
               RowBox[{"#1", "[", "\"\<Expression\>\"", "]"}]}], "]"}], 
             "&"}]}], "]"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<UnexpectedExternalVector\>\"", ",", 
           RowBox[{"Association", "[", "]"}]}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"ids", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#1", "[", "\"\<Name\>\"", "]"}], "&"}], ")"}], "/@", 
        "labels"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"ids", ",", 
           RowBox[{
            RowBox[{"StringMatchQ", "[", 
             RowBox[{"#1", ",", 
              RowBox[{"RegularExpression", "[", "\"\<cfv[0-9]+\>\"", "]"}]}], 
             "]"}], "&"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Failure", "[", 
          RowBox[{"\"\<InvalidVectorName\>\"", ",", 
           RowBox[{"Association", "[", "]"}]}], "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"vectors", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"known", "[", 
           RowBox[{"#1", "[", "\"\<Expression\>\"", "]"}], "]"}], "&"}], 
         ")"}], "/@", "labels"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dot", "=", 
          RowBox[{
           RowBox[{
           "ids", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           "<>", "\"\<.\>\"", "<>", 
           RowBox[{
           "ids", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}]}]}], 
         ";", 
         RowBox[{"value", "=", 
          RowBox[{"FeynCalc`Pair", "[", 
           RowBox[{
            RowBox[{"FeynCalc`Momentum", "[", 
             RowBox[{
              RowBox[{
              "vectors", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], ",", "D"}], "]"}], ",", 
            RowBox[{"FeynCalc`Momentum", "[", 
             RowBox[{
              RowBox[{
              "vectors", "\[LeftDoubleBracket]", "j", 
               "\[RightDoubleBracket]"}], ",", "D"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"value", ",", "_FeynCalc`Pair"}], "]"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{
             RowBox[{"Failure", "[", 
              RowBox[{"\"\<MissingScalarProduct\>\"", ",", 
               RowBox[{"Association", "[", 
                RowBox[{"\"\<Product\>\"", "\[Rule]", "dot"}], "]"}]}], "]"}],
              ",", "Module"}], "]"}]}], "]"}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"value", "===", "0"}], ",", 
           RowBox[{"name", "=", "\"\<0\>\""}], ",", 
           RowBox[{
            RowBox[{"pos", "=", 
             RowBox[{"FirstPosition", "[", 
              RowBox[{"values", ",", "value", ",", 
               RowBox[{"Missing", "[", "]"}], ",", 
               RowBox[{"{", "1", "}"}]}], "]"}]}], ";", 
            RowBox[{"sign", "=", "\"\<\>\""}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MissingQ", "[", "pos", "]"}], ",", 
              RowBox[{
               RowBox[{"pos", "=", 
                RowBox[{"FirstPosition", "[", 
                 RowBox[{"values", ",", 
                  RowBox[{"-", "value"}], ",", 
                  RowBox[{"Missing", "[", "]"}], ",", 
                  RowBox[{"{", "1", "}"}]}], "]"}]}], ";", 
               RowBox[{"sign", "=", "\"\<-\>\""}]}]}], "]"}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MissingQ", "[", "pos", "]"}], ",", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"values", ",", "value"}], "]"}], ";", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"representatives", ",", "dot"}], "]"}], ";", 
               RowBox[{"pos", "=", 
                RowBox[{"{", 
                 RowBox[{"Length", "[", "values", "]"}], "}"}]}], ";", 
               RowBox[{"sign", "=", "\"\<\>\""}]}]}], "]"}], ";", 
            RowBox[{"name", "=", 
             RowBox[{"sign", "<>", "\"\<qgsp\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"First", "[", "pos", "]"}], "]"}]}]}]}]}], "]"}], ";", 
         
         RowBox[{"AppendTo", "[", 
          RowBox[{"rules", ",", 
           
           RowBox[{"\"\<id \>\"", "<>", "dot", "<>", "\"\<=\>\"", "<>", 
            "name", "<>", "\"\<;\>\""}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "ids", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "i", ",", 
          RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"declarations", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"values", "===", 
          RowBox[{"{", "}"}]}], ",", "\"\<\>\"", ",", 
         RowBox[{"\"\<Symbols \>\"", "<>", 
          RowBox[{"StringRiffle", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"\"\<qgsp\>\"", "<>", 
               RowBox[{"ToString", "[", "k", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "values", "]"}]}], "}"}]}], "]"}], 
            ",", "\"\<,\>\""}], "]"}], "<>", "\"\<;\\n\>\""}]}], "]"}]}], ";", 
      RowBox[{"apply", "=", "\"\<#call qgProject\\n.sort\\n\>\""}], ";", 
      RowBox[{"declarations", "=", 
       RowBox[{
       "declarations", "<>", "\"\<#procedure qgProject\\n\>\"", "<>", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{"rules", ",", "\"\<\\n\>\""}], "]"}], 
        "<>", "\"\<\\n#endprocedure\\n\>\""}]}], ";", 
      RowBox[{"restore", "=", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\"\<id qgsp\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<=\>\"", "<>",
             "#1", "<>", "\"\<;\\n\>\""}], "&"}], ",", "representatives"}], 
         "]"}], "]"}]}], ";", 
      RowBox[{"StringReplace", "[", 
       RowBox[{"source", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Off Statistics;\>\"", "\[Rule]", 
           RowBox[{"\"\<Off Statistics;\\n\>\"", "<>", "declarations"}]}], ",", 
          RowBox[{
           RowBox[{"m", ":", 
            RowBox[{
            "RegularExpression", "[", "\"\<(?m)^Multiply cfcStage[0-9]+;$\>\"",
              "]"}]}], "\[RuleDelayed]", 
           RowBox[{"m", "<>", "\"\<\\n.sort\\n\>\"", "<>", "apply"}]}], ",", 
          RowBox[{"outputMarker", "\[Rule]", 
           RowBox[{
           "apply", "<>", "restore", "<>", "\"\<.sort\\n\>\"", "<>", 
            "outputMarker"}]}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

