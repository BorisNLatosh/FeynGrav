Cell["\<\
PolarizationTensorD represents the formal factorised tensor epsilon^mu \
epsilon^nu. Neither p.epsilon nor epsilon.epsilon is set to zero; no \
normalisation or helicity is chosen. I and -I specify incoming polarisations \
and conjugated outgoing polarisations, not helicities.\
\>", "Text",ExpressionUUID->"3e728f84-7139-4be1-b062-ca3074aea07e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"externalTensors", "=", 
   RowBox[{
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p1", ",", "\[Mu]1", ",", "\[Nu]1", ",", "\[ImaginaryI]"}], 
     "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p2", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[ImaginaryI]"}], 
     "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p3", ",", "\[Mu]3", ",", "\[Nu]3", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], " ", 
    RowBox[{"PolarizationTensorD", "[", 
     RowBox[{"p4", ",", "\[Mu]4", ",", "\[Nu]4", ",", 
      RowBox[{"-", "\[ImaginaryI]"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"2439786e-b40c-4cbb-99a6-ed4d36554c3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Set the on-shell scalar products", "Section",ExpressionUUID->"e1ae731c-5c71-4ae6-b4bd-a5d669ac6641"],

Cell["\<\
Fix the massless momentum products and external polarisations before \
contracting the diagrams. This ordering manages RAM: the generic off-shell \
s-channel alone writes over 300 MiB for Mathematica to import. Most of those \
terms contain scalar products that vanish in this helicity basis. The FORM \
job uses the table below as soon as contracted indices form dot products.\
\>", "Text",ExpressionUUID->"251a063e-f1b6-483f-b814-94553abd1d9c"],

Cell["\<\
FCClearScalarProducts[] removes any scalar-product assignments made earlier \
in the session, so the on-shell relations that follow are applied to a clean \
state rather than on top of stale values.\
\>", "Text",ExpressionUUID->"d8d8b235-ae92-4207-b531-2e53317ca49f"],

Cell[BoxData[
 RowBox[{"FCClearScalarProducts", "[", "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"89429998-586c-4197-9e10-1fb722ddccf6"],

Cell[TextData[{
 "SetMandelstam fixes the momentum products ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "i"], "\[CenterDot]", 
    SubscriptBox["p", "j"]}], TraditionalForm]],ExpressionUUID->
  "89ac283e-4a17-47c0-a50c-77219ab7c866"],
 " for massless momenta. The physical outgoing momenta p3 and p4 are passed \
as -p3 and -p4 because SetMandelstam works with all-incoming momenta, and the \
four mass arguments are zero. This sets ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "2"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "3"], "\[CenterDot]", 
      SubscriptBox["p", "4"]}], "=", 
     RowBox[{"s", "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "494f6d93-5daf-4f5d-90ca-a9b2b937546a"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "3"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "2"], "\[CenterDot]", 
      SubscriptBox["p", "4"]}], "=", 
     RowBox[{
      RowBox[{"-", "t"}], "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "59e13316-e173-499f-87dc-7ac7380c22c6"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["p", "1"], "\[CenterDot]", 
     SubscriptBox["p", "4"]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "2"], "\[CenterDot]", 
      SubscriptBox["p", "3"]}], "=", 
     RowBox[{
      RowBox[{"-", "u"}], "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "0cbe5111-e210-4115-8c54-2ba1cd654fd4"],
 ", which implies s + t + u = 0 together with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{
      SuperscriptBox["E", "2"], "(", 
      RowBox[{"1", "-", "cos\[Theta]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"46d11ccc-2403-40f1-bfb8-ee0c587662cc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{
      SuperscriptBox["E", "2"], "(", 
      RowBox[{"1", "+", "cos\[Theta]"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"46f84149-a276-433a-9c6a-c45837cf92b0"],
 " in the centre-of-mass frame. Nothing is said yet about the polarisations."
}], "Text",ExpressionUUID->"6b9f0f28-894c-4239-9c71-76cc86698233"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", " ", "t", ",", " ", "u", ",", " ", "p1", " ", ",", " ", "p2", 
    " ", ",", " ", 
    RowBox[{"-", "p3"}], " ", ",", " ", 
    RowBox[{"-", "p4"}], " ", ",", " ", "0", " ", ",", " ", "0", " ", ",", 
    " ", "0", " ", ",", " ", "0"}], " ", "]"}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"7bc583b0-a85c-432c-bf3e-78d633372f73"],

Cell[TextData[{
 "Transversality: each wavefunction is orthogonal to its own momentum, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "i"], "\[InvisibleComma]", 
    RowBox[{
     SubscriptBox["p", "i"], "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "5d9ec531-7e04-42ae-8c79-5a5609de5108"],
 ". The momentum is the physical one, so this holds for the incoming legs 1 \
and 2 and for the conjugated outgoing legs 3 and 4."
}], "Text",ExpressionUUID->"f55d6bd2-1833-4ae3-8205-b423856f106d"],

Cell[BoxData[{
 RowBox[{
