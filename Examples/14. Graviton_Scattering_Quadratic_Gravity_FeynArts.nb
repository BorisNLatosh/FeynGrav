}, Open  ]],

Cell["\<\
The comparison is for four external massless gravitons at tree level. The \
massive poles contribute internally. Evaluate the last cell to clear the \
scalar-product assignments before starting another calculation.\
\>", "Text",ExpressionUUID->"dd2fe24c-6dd8-40e2-b8d7-076a96075c3b"],

Cell[BoxData[
 RowBox[{"FCClearScalarProducts", "[", "]"}]], "Input",
