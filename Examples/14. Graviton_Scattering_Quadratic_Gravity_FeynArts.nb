      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
