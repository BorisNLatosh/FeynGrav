Cell["\<\
Paint supplies the actual inserted FeynArts diagrams. The four numbers \
identify the contact and three exchange contributions; they are not extra \
multiplicative weights. FeynArts already supplies the graph factors.\
\>", "Text",ExpressionUUID->"e4998c7c-52d2-4c0d-a9e7-68c0cca5b15a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Build the four off-shell amplitudes", "Section",ExpressionUUID->"6dac4167-9d65-4166-90a8-e71395217848"],

Cell["\<\
Use incoming momenta p1, p2 and outgoing momenta p3, p4, as in example 04. \
MomentumConservation routes the internal line and Truncated removes the \
external propagators. FeynArts applies its default gauge rule to the \
quadratic-gravity propagator. This sets the gauge parameter to 2. Keep D \
symbolic at this stage.\
\>", "Text",ExpressionUUID->"7ef5d5c6-6a21-4012-8675-85ec72012ef9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"treeRawAmplitude", "=", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"treeInsertions", ",", 
     RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
     RowBox[{"MomentumConservation", "\[Rule]", "True"}], ",", 
     RowBox[{"Truncated", "\[Rule]", "True"}]}], "]"}]}], ";", 
  RowBox[{"diagramTensors", "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"treeRawAmplitude", ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[Mu]3", ",",
         "\[Nu]3", ",", "\[Mu]4", ",", "\[Nu]4", ",", "\[Alpha]1", ",", 
        "\[Beta]1", ",", "\[Alpha]2", ",", "\[Beta]2"}], "}"}]}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"12699e44-5e3b-4492-9d40-c4d3e3f18ea1"],

Cell[CellGroupData[{

