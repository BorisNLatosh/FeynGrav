Cell["Check that all four diagrams returned an amplitude.", "Text",ExpressionUUID->"64c0f813-2934-41a2-8397-c984e8b74999"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Length", "[", "physicalDiagrams", "]"}], "\[Equal]", "4"}], "&&", 
  
  RowBox[{"AllTrue", "[", 
   RowBox[{"physicalDiagrams", ",", 
    RowBox[{
     RowBox[{"FreeQ", "[", 
      RowBox[{"#1", ",", 
       RowBox[{"_Failure", "|", "$Failed", "|", "$Aborted"}]}], "]"}], 
     "&"}]}], "]"}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"8f101932-00c9-4679-b8f2-294556971f09"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002875189933228*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"03d59e6b-90be-4170-91d8-cc140c174743"]
}, Open  ]],

Cell["\<\
Sum the four diagrams, take D = 4 and insert the chosen helicity signs. Use u \
= -s - t to compare rational expressions away from poles. A sign of +1 or -1 \
specifies a graviton helicity of +2 or -2.\
\>", "Text",ExpressionUUID->"d6602a6c-d054-4621-8b90-110071b65288"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"theAmplitudeonShell", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
   RowBox[{"Together", "[", 
    RowBox[{
     RowBox[{"Total", "[", "physicalDiagrams", "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "\[Rule]", "4"}], ",", 
       RowBox[{"h1", "\[Rule]", "a"}], ",", 
       RowBox[{"h2", "\[Rule]", "b"}], ",", 
       RowBox[{"h3", "\[Rule]", "c"}], ",", 
       RowBox[{"h4", "\[Rule]", "d"}], ",", 
       RowBox[{"u", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "s"}], "-", "t"}]}]}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[45]:=",ExpressionUUID->"13a9f8a0-5176-49e1-8899-793bbf2bbda7"],

Cell[TextData[{
 "Why should the sum agree with GR? The internal tensor propagator has a \
massive scalar pole and a massive spin-2 pole. For two external, on-shell \
massless gravitons at either end of an exchange, the residue of each massive \
pole vanishes. The exchange diagrams still depend on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "c35d98f8-5dc4-4b73-b177-a18734e7393d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "2"], TraditionalForm]],ExpressionUUID->
  "3cc2e057-c359-4b2d-a532-0cf5aaa02a98"],
 ". The remaining mass-dependent terms cancel when the contact and all three \
exchanges are added. The helicity amplitudes therefore agree with GR at \
finite masses, without taking an Einstein limit."
}], "Text",ExpressionUUID->"77620e15-8d73-4723-9048-50a078d5eb3b"],

Cell[TextData[{
 "For this action the curvature corrections ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "2f0387f1-0342-41b3-8519-a0c0a8b2b18d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", 
     RowBox[{"\[Mu]", "\[Nu]"}]], 
    SuperscriptBox["R", 
     RowBox[{"\[Mu]", "\[Nu]"}]]}], TraditionalForm]],ExpressionUUID->
  "2a4762d0-c04c-486a-9f7f-0c2fd0a1322b"],
 " can be written as terms quadratic in the vacuum Einstein equations. A \
perturbative metric field redefinition explains the equality for tree \
amplitudes with only massless external gravitons. Processes involving matter \
or external massive modes probe different couplings. See ",
 ButtonBox["Don\[AGrave] et al., Scattering amplitudes in \
super-renormalizable gravity",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://doi.org/10.1007/JHEP08(2015)038"], None}],
 ", JHEP 08 (2015) 038, sections 3.1 and 5. Equations (4.2) to (4.6) display \
the exchange and contact cancellation explicitly."
}], "Text",ExpressionUUID->"757aca86-c90c-4ca6-9c04-bfc9676a7641"],

Cell[TextData[{
 "Compare the complete on-shell sum with the GR amplitudes in the final \
helicity cell of ",
 ButtonBox["example 04",
  BaseStyle->"Hyperlink",
  ButtonData->{"04. Graviton_Scattering_Tree_Level_FeynArts.nb", None}],
 ". The three lines compare the same helicity assignments in the same order. \
Each should give True for generic kinematics away from poles, with finite M0 \
and M2. Individual diagrams can differ between the two theories."
}], "Text",ExpressionUUID->"21b5bb04-a2e9-4adb-a15a-cddc3c0df4d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Together", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"theAmplitudeonShell", "[", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "]"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       FractionBox[
        SuperscriptBox["\[Kappa]", "2"], "4"], 
       FractionBox[
        SuperscriptBox["s", "4"], 
        RowBox[{"s", " ", "t", " ", "u"}]]}]}], ")"}], "/.", 
    RowBox[{"u", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "s"}], "-", "t"}]}]}], "]"}], "===", "0"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"422f1dd2-016b-4fa6-aa53-128a80593e0c"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0028751901974287`*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"811e5260-e037-437b-86d3-d015fd389be4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Together", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"theAmplitudeonShell", "[", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", "1"}], "]"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       FractionBox[
        SuperscriptBox["\[Kappa]", "2"], "4"], 
       FractionBox[
        SuperscriptBox["t", "4"], 
        RowBox[{"s", " ", "t", " ", "u"}]]}]}], ")"}], "/.", 
    RowBox[{"u", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "s"}], "-", "t"}]}]}], "]"}], "===", "0"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"2d17e9f8-1461-48fc-b5e6-431ba37a229d"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0028751903059263`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"d2f4a61b-2a38-47da-8bf2-4a3643e6dfaa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Together", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"theAmplitudeonShell", "[", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "-", 
      RowBox[{"\[ImaginaryI]", " ", 
       FractionBox[
        SuperscriptBox["\[Kappa]", "2"], "4"], 
       FractionBox[
        SuperscriptBox["u", "4"], 
        RowBox[{"s", " ", "t", " ", "u"}]]}]}], ")"}], "/.", 
    RowBox[{"u", "\[Rule]", 
