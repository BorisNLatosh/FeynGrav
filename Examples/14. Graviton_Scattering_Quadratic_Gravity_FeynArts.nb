Cell[TextData[{
 "The mixed products that vanish: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "1"], "\[CenterDot]", 
    SubscriptBox["p", "2"]}], TraditionalForm]],ExpressionUUID->
  "e5edaa3c-e7c8-4205-a6f3-e586e8154dd6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "2"], "\[CenterDot]", 
    SubscriptBox["p", "1"]}], TraditionalForm]],ExpressionUUID->
  "2c4ada9e-4778-4234-886b-1c3ab83b99ec"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "3"], "\[CenterDot]", 
    SubscriptBox["p", "4"]}], TraditionalForm]],ExpressionUUID->
  "68734277-8c91-4033-95d1-6419b1936c11"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyEpsilon]", "4"], "\[CenterDot]", 
    SubscriptBox["p", "3"]}], TraditionalForm]],ExpressionUUID->
  "4fc8e436-ad72-43cf-9a9d-2b3844c98c29"],
 " are zero. Each wavefunction has zero time component, so these reduce to \
spatial scalar products, which vanish for the leg pairings shown."
}], "Text",ExpressionUUID->"bcfe2a2c-c17f-4aa9-9db3-106be7937d2c"],

