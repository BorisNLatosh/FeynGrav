   "=", "0"}], ";"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"79072bc8-d453-4efd-aece-ebf25f635d01"],

Cell[TextData[{
 "Null wavefunctions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "i"], "\[CenterDot]", 
     SubscriptBox["\[CurlyEpsilon]", "i"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"4ce0a670-f703-4d49-90eb-f472ee8e6829"],
 " in the bilinear product. This is a statement about each leg on its own; \
the products between different legs are fixed by the two blocks that follow."
}], "Text",ExpressionUUID->"223facb1-094c-4a5d-9476-30162e484ae6"],

