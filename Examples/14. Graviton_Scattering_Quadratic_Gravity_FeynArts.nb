     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h1"}], " ", 
    RowBox[{"\[ImaginaryI]", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
    RowBox[{"Sqrt", "[", 
