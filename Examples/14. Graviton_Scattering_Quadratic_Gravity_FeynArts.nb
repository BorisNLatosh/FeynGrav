Cell[TextData[{
 "The polarisation-momentum products. With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "i"], "=", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]],ExpressionUUID->
  "a5edfca1-15bc-4706-8d0e-4165d984c908"],
 " the whole block equals ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", 
    SqrtBox[
     FractionBox[
      RowBox[{"t", " ", "u"}], 
      RowBox[{"2", " ", "s"}]]]}], TraditionalForm]],ExpressionUUID->
  "1252b827-2da8-4716-a44a-973c407ded4c"],
 " times a matrix built from the helicity labels; it is written out leg by \
leg here. The products are bilinear, with no complex conjugation, and the \
momenta are the physical ones."
}], "Text",ExpressionUUID->"ae99ae85-f93b-4e3f-82f5-9c79eb81ad8f"],

Cell[BoxData[{
 RowBox[{
