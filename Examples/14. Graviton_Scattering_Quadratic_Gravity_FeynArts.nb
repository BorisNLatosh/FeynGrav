Cell["\<\
Contract one diagram at a time. Inside FORM the helper sets vanishing dot \
products to zero and represents each remaining scalar-product value by a \
commuting symbol. Equal values share a symbol and opposite values share it \
with opposite signs. After the final sort the importer reconstructs these \
values from the same Pair assignments. The byte count printed for each \
diagram is the size sent back to Mathematica.\
\>", "Text",ExpressionUUID->"d2ce29f3-f9f7-40ca-ba87-bc7babb31176"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"physicalDiagrams", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Diagram \>\"", ",", "j", ",", "\"\< of \>\"", ",", 
        RowBox[{"Length", "[", "diagramTensors", "]"}]}], "]"}], ";", 
      RowBox[{"qgContractOnShell", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FeynAmpDenominatorExplicit", "[", 
          RowBox[{
          "diagramTensors", "\[LeftDoubleBracket]", "j", 
           "\[RightDoubleBracket]"}], "]"}], " ", "externalTensors"}], ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
        "formConfiguration"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "diagramTensors", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"37529692-d115-4d96-bd62-3cd1c32cb648"],

