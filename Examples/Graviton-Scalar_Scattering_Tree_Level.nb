Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"-", "1"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"-", "1"}]}], "//", "Simplify"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981098023950993*^9, 3.981098062538669*^9}, {
   3.981098112513487*^9, 3.981098200776658*^9}, 3.98109823841605*^9, 
