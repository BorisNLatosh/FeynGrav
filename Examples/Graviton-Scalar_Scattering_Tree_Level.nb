Cell[TextData[{
 "In the next Section, I will perform all calculations using the Mandelstam \
variables. In this Section, it is not convenient to define the Mandelstam \
variables directly for some technical reasons. So I do the calculations as \
follows. I treat s=(p1+q1)^2, t=(q1-q2)^2 as a system of algebraic equations. \
In that system, I replace the values of k, Cos[\[Theta]], and Sin[\[Theta]] \
that I calculated manually and check whether both equations are satisfied. In \
other words, I check that the following expression for k, Sin[\[Theta]], and \
Cos[\[Theta]] holds:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox[
      SqrtBox["s"], 
      SqrtBox[
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["m", "2"], "s"]}]]]}]}], TraditionalForm]],
  ExpressionUUID->"edaa8b6c-e4e4-469a-a150-361e3dc9d82d"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"cos", "[", "\[Theta]", "]"}], "=", 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      FractionBox["t", "s"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"3296ce13-06d8-4361-a6aa-f5a45b280e54"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"sin", "[", "\[Theta]", "]"}], "=", 
    RowBox[{"2", " ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"1", "+", 
       FractionBox[
        SuperscriptBox["m", "2"], "s"]}]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], 
   TraditionalForm]],ExpressionUUID->"1b033342-762f-4228-bf20-2469e92a742a"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.981099122357903*^9, 3.9810991275899878`*^9}, {
   3.98109955879795*^9, 3.981099587652587*^9}, {3.981178953140367*^9, 
   3.981179225399899*^9}, {3.9811798304459753`*^9, 3.981179840429904*^9}, 
   3.981179947632772*^9},
 FontSize->18,ExpressionUUID->"8b6f781e-4ac2-4484-b141-f586f35c4c5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"s", ">", "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p1", "+", "q1"}], ",", 
          RowBox[{"p1", "+", "p1"}]}], "]"}], "==", "s"}], ",", 
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"q1", "-", "q2"}], ",", 
          RowBox[{"q1", "-", "q2"}]}], "]"}], "==", "t"}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "->", 
        RowBox[{
         FractionBox["1", "2"], 
         FractionBox[
          SqrtBox["s"], 
          SqrtBox[
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"], " "}]]]}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
        RowBox[{"1", "+", 
         RowBox[{"2", 
          FractionBox["t", "s"], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "->", 
        RowBox[{"2", " ", 
         FractionBox[
          SqrtBox[
           RowBox[{"-", "t"}]], "s"], 
         SqrtBox[
          RowBox[{"1", "+", 
           FractionBox[
            SuperscriptBox["m", "2"], "s"], " "}]], 
         SqrtBox[
          RowBox[{"s", "+", 
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              FractionBox[
               SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}]}], "}"}]}], "//",
     "FullSimplify"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810987934604588`*^9, 3.981098894372323*^9}, {
  3.981098932822207*^9, 3.981099109549822*^9}, {3.98109942251645*^9, 
  3.9810994442493563`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"58ccacaf-98cc-498e-afca-69ffe1a2e2a0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.981434089281762*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"7753fcaa-baa5-45a6-b613-5d5fc237c567"]
}, Open  ]],

Cell[TextData[{
 "Using the expressions above, I calculate all the scalar products I will \
encounter in the calculations. Since the graviton will scatter on a scalar, \
the graviton cannot change its helicity, so both \[CurlyEpsilon]1 and \
\[CurlyEpsilon]2 must correspond to the same helicity, which I denote as ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "02798944-faeb-45f1-9944-05d132b64c57"],
 ". However, since \[CurlyEpsilon]2 is associated with a particle in the \
out-state, it receives a complex conjugation. So I use the relation between \
complex conjugation and negative helicity. Because of this, in all formulae \
below \[CurlyEpsilon]2 carries helicity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "h"}], TraditionalForm]],ExpressionUUID->
  "0438e0a4-10fe-4740-9946-c85f1d84d42c"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.981099591957326*^9, 3.981099603461461*^9}, {
  3.981179231615353*^9, 3.981179462147354*^9}, {3.9811800060570993`*^9, 
  3.9811800386088953`*^9}},
 FontSize->18,ExpressionUUID->"7c2567f0-78f2-405f-8e35-ff18f937627b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"q1", ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"q2", ",", 
      RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p1", ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"p2", ",", 
      RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"q1", ",", 
      RowBox[{"\[CurlyEpsilon]2", "[", 
       RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"q2", ",", 
    RowBox[{"\[CurlyEpsilon]2", "[", 
     RowBox[{"-", "h"}], "]"}]}], "]"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"p1", ",", 
      RowBox[{"\[CurlyEpsilon]2", "[", 
       RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p2", ",", 
    RowBox[{"\[CurlyEpsilon]2", "[", 
     RowBox[{"-", "h"}], "]"}]}], "]"}], "==", "0"}], "\n", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"h", "==", "1"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}], ",", 
        RowBox[{"\[CurlyEpsilon]2", "[", 
         RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"1", 
          FractionBox["t", "s"], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"]}], ")"}]}]}], " ", ")"}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "->", 
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p1", "+", "q1"}], ",", 
          RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
       RowBox[{"t", "->", 
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"q1", "-", "q2"}], ",", 
          RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
    "Simplify"}]}], "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810982131556587`*^9, 3.98109823010322*^9}, {
