Notebook[{

Cell[CellGroupData[{
Cell["Kinematics", "Title",
 Editable->False,
 CellChangeTimes->{{3.981097743534445*^9, 3.9810977452632732`*^9}, {
  3.9811678935337687`*^9, 
  3.981167896996769*^9}},ExpressionUUID->"0c458c3f-7965-41f4-adce-\
3e01de9b7eae"],

Cell["\<\
One should launch these calculations separately. They do not rely on FeynCalc \
nor on FeynGrav. Moreover, these calculations define a single function with \
syntax that overlaps with FeynCalc.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9811783055678587`*^9, 3.9811783813187523`*^9}, {
   3.9811784451495028`*^9, 3.981178479652948*^9}, {3.981178715696494*^9, 
   3.981178756277232*^9}, 3.9811796311694183`*^9},
 FontSize->18,ExpressionUUID->"d06db7d8-c8b9-4764-afc3-1d69e5b6fbc8"],

Cell["\<\
Here, I go to the centre-of-mass frame and calculate all the scalar products \
between momenta and polarisation vectors \[CurlyEpsilon] to use in further \
calculations.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9811783055678587`*^9, 3.9811783813187523`*^9}, {
   3.9811784451495028`*^9, 3.981178479652948*^9}, {3.981178715696494*^9, 
   3.9811787554239273`*^9}, 3.981179636930011*^9},
 FontSize->18,ExpressionUUID->"22f45e71-acbc-4a19-ae96-1bfac513a575"],

Cell["\<\
Assumptions on the parameters. They are not necessary for calculations, just \
make Mathematica\[CloseCurlyQuote]s job a bit easier.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9810984241460533`*^9, 3.981098432234771*^9}, {
   3.981178760079739*^9, 3.9811787900752974`*^9}, 3.981179642121457*^9},
 FontSize->18,ExpressionUUID->"eda22733-0e72-4653-a317-f5bf9dca9326"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"m", ">", "0"}], "&&", 
    RowBox[{"k", ">", "0"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.981097822667588*^9, 3.981097839270281*^9}, {
  3.98109815938864*^9, 3.9810981601526213`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9ba7606a-99f6-4486-ac66-4f67ba56043d"],

Cell["\<\
Explicit expression for momenta in the centre-of-mass frame. Momenta q1 and \
q2 correspond to momenta of scalars. Momenta p1 and p2 correspond to the \
momenta of vectors.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098435586548*^9, 3.981098444618505*^9}, {
   3.98117886664599*^9, 3.98117889957336*^9}, 3.981179698384861*^9},
 FontSize->18,ExpressionUUID->"c89df547-7a06-47aa-b00e-0f699205165e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "0", ",", "k"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q1", "=", 
   RowBox[{"{", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["k", "2"], "+", 
       SuperscriptBox["m", "2"]}]], ",", "0", ",", "0", ",", 
     RowBox[{"-", "k"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"k", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
     RowBox[{"k", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q2", "=", 
   RowBox[{"{", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["k", "2"], "+", 
       SuperscriptBox["m", "2"]}]], ",", 
     RowBox[{
      RowBox[{"-", "k"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
     RowBox[{
      RowBox[{"-", "k"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], ";"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981097748541533*^9, 3.981097845706593*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"72ff87fc-5f2e-4cea-822c-d582198e1e0a"],

Cell["The conservation law.", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098447233974*^9, 3.981098460018249*^9}, {
  3.9811679482359858`*^9, 3.981167950771974*^9}},
 FontSize->18,ExpressionUUID->"be897e67-668c-49fc-9b45-e9268cfaeddd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"p1", "+", "q1"}], "==", 
   RowBox[{"p2", "+", "q2"}]}], "//", "Simplify"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810977841794147`*^9, 3.981097816215715*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"0af7ed8d-9b47-4de8-913b-2f766c930f81"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9814340888196917`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"6726c407-e6aa-48f2-ae04-38bede20f930"]
}, Open  ]],

Cell["\<\
Explicit expressions for the polarisation vectors. Vector \[CurlyEpsilon]1 \
corresponds to polarisation of the particle with momenta p1. Vector \
\[CurlyEpsilon]2 corresponds to polarisation of the particle with momenta p2.\
\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098463353971*^9, 3.981098472706061*^9}, {
  3.981167956235812*^9, 3.9811679606997004`*^9}, {3.9811789046691227`*^9, 
  3.9811789387486467`*^9}},
 FontSize->18,ExpressionUUID->"087084db-11eb-400a-b228-65ce4028fced"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CurlyEpsilon]1", "[", "h_", "]"}], "=", 
   RowBox[{"h", " ", 
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", " ", 
      RowBox[{"h", " ", "\[ImaginaryI]"}], ",", "0"}], " ", "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CurlyEpsilon]2", "[", "h_", "]"}], "=", 
   RowBox[{"h", " ", 
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
      RowBox[{"h", " ", "\[ImaginaryI]"}], " ", ",", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], ";"}]}], "Input",\

 Editable->False,
 CellChangeTimes->{{3.981097891351729*^9, 3.9810979980677977`*^9}, {
  3.981098065572178*^9, 3.9810981076900673`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c69d5a85-5ed8-4628-b3a6-710d9a376464"],

Cell["\<\
This function takes two four-momenta and computes their scalar product.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098475241804*^9, 3.981098483113758*^9}, {
   3.981178832286377*^9, 3.981178846598297*^9}, 3.981179752127611*^9},
 FontSize->18,ExpressionUUID->"ba87f90b-1362-49f0-bbf3-592f742d3de6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SP", "=", 
   RowBox[{
    RowBox[{"#1", ".", 
     RowBox[{"(", GridBox[{
        {"1", "0", "0", "0"},
        {"0", 
         RowBox[{"-", "1"}], "0", "0"},
        {"0", "0", 
         RowBox[{"-", "1"}], "0"},
        {"0", "0", "0", 
         RowBox[{"-", "1"}]}
       }], ")"}], ".", "#2"}], "&"}]}], ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810979996860237`*^9, 3.981098020827238*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"72eea226-6ef5-4767-bbe4-d78f28023e61"],

Cell["\<\
Below, I check the following properties of the polarisation vectors.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.981098598863846*^9}, 
   3.981098648316844*^9, 3.981179783527217*^9},
 FontSize->18,ExpressionUUID->"6744622d-634c-4cb2-b079-74efc697f680"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"], "\[CenterDot]", 
    SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"]}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"66d4ed3c-2f64-4cd3-8546-4949b909911f"]], \
"Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.981098598863846*^9}, {
  3.98109865303137*^9, 3.981098654867633*^9}},
 FontSize->18,ExpressionUUID->"50f21f66-e553-4f83-823e-8ebd948208d0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}]}], "]"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}]}], "]"}], "==", "0"}], "//", 
  "Simplify"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981098023950993*^9, 3.981098062538669*^9}, {
   3.981098112513487*^9, 3.981098200776658*^9}, 3.98109823841605*^9, 
   3.981098604149501*^9, {3.981098656231811*^9, 3.981098659545816*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"ed41a928-aa27-4519-969e-3ac9bfd6af9c"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.981434088855324*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"2670da03-7807-4b33-908f-9b88ed0a5af3"],

Cell[BoxData["True"], "Output",
