Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]t", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Rho]1", ",", " ", "\[Sigma]1"}], "}"}], ",", " ", "q1", 
         ",", " ", 
         RowBox[{"-", "q2"}], ",", " ", "m"}], "]"}], 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Rho]1", ",", "\[Sigma]1", ",", "\[Rho]2", ",", "\[Sigma]2", ",", 
         RowBox[{"q1", "-", "q2"}]}], "]"}], 
       RowBox[{"GravitonVertex", "[", 
        RowBox[{"\[Rho]2", ",", "\[Sigma]2", ",", 
         RowBox[{"q1", "-", "q2"}], ",", "\[Mu]1", ",", "\[Nu]1", ",", "p1", 
         ",", "\[Mu]2", ",", "\[Nu]2", ",", 
         RowBox[{"-", "p2"}]}], "]"}]}], "//", "FeynAmpDenominatorExplicit"}],
      "//", "Calc"}]}], ";"}], "//", "Timing"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]t", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{"\[ScriptCapitalM]t", ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", 
        RowBox[{"2", 
         SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}]}], ";"}], "//", 
  "Timing"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981095294166296*^9, 3.98109533927703*^9}, {
  3.981095419117236*^9, 3.981095547640378*^9}, {3.9810955961784687`*^9, 
