   RowBox[{"\[ScriptCapitalM]u", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]2", ",", " ", "\[Nu]2"}], "}"}], ",", " ", "q1", ",", 
