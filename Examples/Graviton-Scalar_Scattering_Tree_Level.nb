Notebook[{

Cell[CellGroupData[{
Cell["Kinematics", "Title",
 Editable->False,
 CellChangeTimes->{{3.981097743534445*^9, 3.9810977452632732`*^9}, {
  3.9811678935337687`*^9, 
  3.981167896996769*^9}},ExpressionUUID->"0c458c3f-7965-41f4-adce-\
3e01de9b7eae"],

Cell["\<\
One should launch these calculations separately. They do not rely on FeynCalc \
nor on FeynGrav. Moreover, these calculations define a single function with \
syntax that overlaps with FeynCalc.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9811783055678587`*^9, 3.9811783813187523`*^9}, {
   3.9811784451495028`*^9, 3.981178479652948*^9}, {3.981178715696494*^9, 
   3.981178756277232*^9}, 3.9811796311694183`*^9},
 FontSize->18,ExpressionUUID->"d06db7d8-c8b9-4764-afc3-1d69e5b6fbc8"],

Cell["\<\
Here, I go to the centre-of-mass frame and calculate all the scalar products \
between momenta and polarisation vectors \[CurlyEpsilon] to use in further \
calculations.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9811783055678587`*^9, 3.9811783813187523`*^9}, {
   3.9811784451495028`*^9, 3.981178479652948*^9}, {3.981178715696494*^9, 
   3.9811787554239273`*^9}, 3.981179636930011*^9},
 FontSize->18,ExpressionUUID->"22f45e71-acbc-4a19-ae96-1bfac513a575"],

Cell["\<\
Assumptions on the parameters. They are not necessary for calculations, just \
make Mathematica\[CloseCurlyQuote]s job a bit easier.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9810984241460533`*^9, 3.981098432234771*^9}, {
   3.981178760079739*^9, 3.9811787900752974`*^9}, 3.981179642121457*^9},
 FontSize->18,ExpressionUUID->"eda22733-0e72-4653-a317-f5bf9dca9326"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"m", ">", "0"}], "&&", 
    RowBox[{"k", ">", "0"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.981097822667588*^9, 3.981097839270281*^9}, {
  3.98109815938864*^9, 3.9810981601526213`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9ba7606a-99f6-4486-ac66-4f67ba56043d"],

Cell["\<\
Explicit expression for momenta in the centre-of-mass frame. Momenta q1 and \
q2 correspond to momenta of scalars. Momenta p1 and p2 correspond to the \
momenta of vectors.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098435586548*^9, 3.981098444618505*^9}, {
   3.98117886664599*^9, 3.98117889957336*^9}, 3.981179698384861*^9},
 FontSize->18,ExpressionUUID->"c89df547-7a06-47aa-b00e-0f699205165e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "0", ",", "k"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q1", "=", 
   RowBox[{"{", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["k", "2"], "+", 
       SuperscriptBox["m", "2"]}]], ",", "0", ",", "0", ",", 
     RowBox[{"-", "k"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"k", " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
     RowBox[{"k", " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q2", "=", 
   RowBox[{"{", 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["k", "2"], "+", 
       SuperscriptBox["m", "2"]}]], ",", 
     RowBox[{
      RowBox[{"-", "k"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", 
     RowBox[{
      RowBox[{"-", "k"}], " ", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}]}], ";"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981097748541533*^9, 3.981097845706593*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"72ff87fc-5f2e-4cea-822c-d582198e1e0a"],

Cell["The conservation law.", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098447233974*^9, 3.981098460018249*^9}, {
  3.9811679482359858`*^9, 3.981167950771974*^9}},
 FontSize->18,ExpressionUUID->"be897e67-668c-49fc-9b45-e9268cfaeddd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"p1", "+", "q1"}], "==", 
   RowBox[{"p2", "+", "q2"}]}], "//", "Simplify"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810977841794147`*^9, 3.981097816215715*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"0af7ed8d-9b47-4de8-913b-2f766c930f81"],

Cell["\<\
Explicit expressions for the polarisation vectors. Vector \[CurlyEpsilon]1 \
corresponds to polarisation of the particle with momenta p1. Vector \
\[CurlyEpsilon]2 corresponds to polarisation of the particle with momenta p2.\
\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098463353971*^9, 3.981098472706061*^9}, {
  3.981167956235812*^9, 3.9811679606997004`*^9}, {3.9811789046691227`*^9, 
  3.9811789387486467`*^9}},
 FontSize->18,ExpressionUUID->"087084db-11eb-400a-b228-65ce4028fced"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CurlyEpsilon]1", "[", "h_", "]"}], "=", 
   RowBox[{"h", " ", 
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", " ", 
      RowBox[{"h", " ", "\[ImaginaryI]"}], ",", "0"}], " ", "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CurlyEpsilon]2", "[", "h_", "]"}], "=", 
   RowBox[{"h", " ", 
    FractionBox["\[ImaginaryI]", 
     SqrtBox["2"]], 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
      RowBox[{"h", " ", "\[ImaginaryI]"}], " ", ",", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], ";"}]}], "Input",\

 Editable->False,
 CellChangeTimes->{{3.981097891351729*^9, 3.9810979980677977`*^9}, {
  3.981098065572178*^9, 3.9810981076900673`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c69d5a85-5ed8-4628-b3a6-710d9a376464"],

Cell["\<\
This function takes two four-momenta and computes their scalar product.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981098475241804*^9, 3.981098483113758*^9}, {
   3.981178832286377*^9, 3.981178846598297*^9}, 3.981179752127611*^9},
 FontSize->18,ExpressionUUID->"ba87f90b-1362-49f0-bbf3-592f742d3de6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SP", "=", 
   RowBox[{
    RowBox[{"#1", ".", 
     RowBox[{"(", GridBox[{
        {"1", "0", "0", "0"},
        {"0", 
         RowBox[{"-", "1"}], "0", "0"},
        {"0", "0", 
         RowBox[{"-", "1"}], "0"},
        {"0", "0", "0", 
         RowBox[{"-", "1"}]}
       }], ")"}], ".", "#2"}], "&"}]}], ";"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810979996860237`*^9, 3.981098020827238*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"72eea226-6ef5-4767-bbe4-d78f28023e61"],

Cell["\<\
Below, I check the following properties of the polarisation vectors.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.981098598863846*^9}, 
   3.981098648316844*^9, 3.981179783527217*^9},
 FontSize->18,ExpressionUUID->"6744622d-634c-4cb2-b079-74efc697f680"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"], "\[CenterDot]", 
    SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"]}], "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"66d4ed3c-2f64-4cd3-8546-4949b909911f"]], \
"Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.981098598863846*^9}, {
  3.98109865303137*^9, 3.981098654867633*^9}},
 FontSize->18,ExpressionUUID->"50f21f66-e553-4f83-823e-8ebd948208d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}]}], "]"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}]}], "]"}], "==", "0"}], "//", 
  "Simplify"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981098023950993*^9, 3.981098062538669*^9}, {
   3.981098112513487*^9, 3.981098200776658*^9}, 3.98109823841605*^9, 
   3.981098604149501*^9, {3.981098656231811*^9, 3.981098659545816*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"ed41a928-aa27-4519-969e-3ac9bfd6af9c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"], "\[CenterDot]", 
     SuperscriptBox["\[CurlyEpsilon]", "\[MinusPlus]"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CurlyEpsilon]", "\[MinusPlus]"], "\[CenterDot]", 
      SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"]}], "=", 
     RowBox[{"-", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "54dd6851-4827-4402-b7e1-210064fa13bb"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.981098598863846*^9}, {
  3.98109865303137*^9, 3.98109865402334*^9}},
 FontSize->18,ExpressionUUID->"e5e33aeb-4363-49f1-9475-5eecf7ca5cad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"SP", "[", 
   RowBox[{
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"-", "1"}], "]"}], ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", 
     RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
  RowBox[{"-", "1"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"SP", "[", 
    RowBox[{
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "1"}], "]"}], ",", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"+", "1"}], "]"}]}], "]"}], "==", 
   RowBox[{"-", "1"}]}], "//", "Simplify"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981098023950993*^9, 3.981098062538669*^9}, {
   3.981098112513487*^9, 3.981098200776658*^9}, 3.98109823841605*^9, 
   3.981098604149501*^9, {3.981098656231811*^9, 3.98109866735529*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"037e54cd-d513-4a18-a3b5-cd5d3dfc0984"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"], ")"}], "*"], "=", 
    SuperscriptBox["\[CurlyEpsilon]", "\[MinusPlus]"]}], TraditionalForm]],
  ExpressionUUID->"bd4974c9-4c82-430a-ac65-dd295e09f9b1"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.98109849581742*^9, 3.98109864547958*^9}},
 FontSize->18,ExpressionUUID->"442f88a8-76c8-4d38-a31d-8877270961b0"],

Cell[BoxData[{
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["h", "2"], "==", "1"}], "&&", 
    RowBox[{"h", "\[Element]", "Reals"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}], "]"}], "==", 
     RowBox[{"\[CurlyEpsilon]1", "[", 
      RowBox[{"-", "h"}], "]"}]}], "//", "Simplify"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["h", "2"], "==", "1"}], "&&", 
    RowBox[{"h", "\[Element]", "Reals"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      RowBox[{"\[CurlyEpsilon]2", "[", "h", "]"}], "]"}], "==", 
     RowBox[{"\[CurlyEpsilon]2", "[", 
      RowBox[{"-", "h"}], "]"}]}], "//", "Simplify"}]}], "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981098023950993*^9, 3.981098062538669*^9}, {
  3.981098112513487*^9, 3.981098200776658*^9}, {3.98109823841605*^9, 
  3.981098239714533*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"b55ca873-f283-4f07-8c63-17fe7746f562"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["p", "i"], "\[CenterDot]", 
    RowBox[{
     SuperscriptBox["\[CurlyEpsilon]", "\[PlusMinus]"], "(", "p", ")"}]}], 
   "=", "0"}], 
  TraditionalForm]],ExpressionUUID->"2f117b2f-54d3-4298-a080-2e2259e8b907"]], \
"Text",
 Editable->False,
 CellChangeTimes->{{3.9810986799740477`*^9, 3.9810986926958513`*^9}},
 FontSize->18,ExpressionUUID->"ff76df51-bd3e-4ac6-836c-0ae43de4c1bb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p1", ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p2", ",", 
    RowBox[{"\[CurlyEpsilon]2", "[", "h", "]"}]}], "]"}], "==", 
  "0"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810982451390877`*^9, 3.981098256910595*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"959c9c76-4638-4b35-a4b5-b95401f59c9b"],

Cell[TextData[{
 "In the next Section, I will perform all calculations using the Mandelstam \
variables. In this Section, it is not convenient to define the Mandelstam \
variables directly for some technical reasons. So I do the calculations as \
follows. I treat s=(p1+q1)^2, t=(q1-q2)^2 as a system of algebraic equations. \
In that system, I replace the values of k, Cos[\[Theta]], and Sin[\[Theta]] \
that I calculated manually and check whether both equations are satisfied. In \
other words, I check that the following expression for k, Sin[\[Theta]], and \
Cos[\[Theta]] holds:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", 
    RowBox[{
     FractionBox["1", "2"], 
     FractionBox[
      SqrtBox["s"], 
      SqrtBox[
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["m", "2"], "s"]}]]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edaa8b6c-e4e4-469a-a150-361e3dc9d82d"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"cos", "[", "\[Theta]", "]"}], "=", 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      FractionBox["t", "s"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3296ce13-06d8-4361-a6aa-f5a45b280e54"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"sin", "[", "\[Theta]", "]"}], "=", 
    RowBox[{"2", " ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"1", "+", 
       FractionBox[
        SuperscriptBox["m", "2"], "s"]}]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b033342-762f-4228-bf20-2469e92a742a"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.981099122357903*^9, 3.9810991275899878`*^9}, {
   3.98109955879795*^9, 3.981099587652587*^9}, {3.981178953140367*^9, 
   3.981179225399899*^9}, {3.9811798304459753`*^9, 3.981179840429904*^9}, 
   3.981179947632772*^9},
 FontSize->18,ExpressionUUID->"8b6f781e-4ac2-4484-b141-f586f35c4c5a"],

Cell[BoxData[
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"s", ">", "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p1", "+", "q1"}], ",", 
          RowBox[{"p1", "+", "p1"}]}], "]"}], "==", "s"}], ",", 
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"q1", "-", "q2"}], ",", 
          RowBox[{"q1", "-", "q2"}]}], "]"}], "==", "t"}]}], "}"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"k", "->", 
        RowBox[{
         FractionBox["1", "2"], 
         FractionBox[
          SqrtBox["s"], 
          SqrtBox[
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"], " "}]]]}]}], ",", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", 
        RowBox[{"1", "+", 
         RowBox[{"2", 
          FractionBox["t", "s"], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "->", 
        RowBox[{"2", " ", 
         FractionBox[
          SqrtBox[
           RowBox[{"-", "t"}]], "s"], 
         SqrtBox[
          RowBox[{"1", "+", 
           FractionBox[
            SuperscriptBox["m", "2"], "s"], " "}]], 
         SqrtBox[
          RowBox[{"s", "+", 
           RowBox[{"t", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              FractionBox[
               SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}]}], "}"}]}], "//",
     "FullSimplify"}]}], "]"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.9810987934604588`*^9, 3.981098894372323*^9}, {
  3.981098932822207*^9, 3.981099109549822*^9}, {3.98109942251645*^9, 
  3.9810994442493563`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"58ccacaf-98cc-498e-afca-69ffe1a2e2a0"],

Cell[TextData[{
 "Using the expressions above, I calculate all the scalar products I will \
encounter in the calculations. Since the graviton will scatter on a scalar, \
the graviton cannot change its helicity, so both \[CurlyEpsilon]1 and \
\[CurlyEpsilon]2 must correspond to the same helicity, which I denote as ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "02798944-faeb-45f1-9944-05d132b64c57"],
 ". However, since \[CurlyEpsilon]2 is associated with a particle in the \
out-state, it receives a complex conjugation. So I use the relation between \
complex conjugation and negative helicity. Because of this, in all formulae \
below \[CurlyEpsilon]2 carries helicity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "h"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0438e0a4-10fe-4740-9946-c85f1d84d42c"],
 "."
}], "Text",
 Editable->False,
 CellChangeTimes->{{3.981099591957326*^9, 3.981099603461461*^9}, {
  3.981179231615353*^9, 3.981179462147354*^9}, {3.9811800060570993`*^9, 
  3.9811800386088953`*^9}},
 FontSize->18,ExpressionUUID->"7c2567f0-78f2-405f-8e35-ff18f937627b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"q1", ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"q2", ",", 
      RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p1", ",", 
    RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
  "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"p2", ",", 
      RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"q1", ",", 
      RowBox[{"\[CurlyEpsilon]2", "[", 
       RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
    RowBox[{"\[ImaginaryI]", " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"q2", ",", 
    RowBox[{"\[CurlyEpsilon]2", "[", 
     RowBox[{"-", "h"}], "]"}]}], "]"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SP", "[", 
     RowBox[{"p1", ",", 
      RowBox[{"\[CurlyEpsilon]2", "[", 
       RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", 
     FractionBox["1", 
      SqrtBox["2"]], "h", "   ", 
     SqrtBox[
      FractionBox[
       RowBox[{"-", "t"}], "s"]], 
     SqrtBox[
      RowBox[{"s", "+", 
       RowBox[{"t", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"s", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"p1", "+", "q1"}], ",", 
        RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
     RowBox[{"t", "->", 
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"q1", "-", "q2"}], ",", 
        RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"p2", ",", 
    RowBox[{"\[CurlyEpsilon]2", "[", 
     RowBox[{"-", "h"}], "]"}]}], "]"}], "==", "0"}], "\n", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{"h", "==", "1"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SP", "[", 
       RowBox[{
        RowBox[{"\[CurlyEpsilon]1", "[", "h", "]"}], ",", 
        RowBox[{"\[CurlyEpsilon]2", "[", 
         RowBox[{"-", "h"}], "]"}]}], "]"}], "==", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"1", 
          FractionBox["t", "s"], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["m", "2"], "s"]}], ")"}]}]}], " ", ")"}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "->", 
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"p1", "+", "q1"}], ",", 
          RowBox[{"p1", "+", "p1"}]}], "]"}]}], ",", 
       RowBox[{"t", "->", 
        RowBox[{"SP", "[", 
         RowBox[{
          RowBox[{"q1", "-", "q2"}], ",", 
          RowBox[{"q1", "-", "q2"}]}], "]"}]}]}], "}"}]}], "//", 
    "Simplify"}]}], "]"}]}], "Input",
