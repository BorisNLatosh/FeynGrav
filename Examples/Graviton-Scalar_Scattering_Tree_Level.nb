       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Rho]1", ",", "\[Sigma]1", ",", "\[Rho]2", ",", "\[Sigma]2", ",", 
         RowBox[{"q1", "-", "q2"}]}], "]"}], 
       RowBox[{"GravitonVertex", "[", 
        RowBox[{"\[Rho]2", ",", "\[Sigma]2", ",", 
         RowBox[{"q1", "-", "q2"}], ",", "\[Mu]1", ",", "\[Nu]1", ",", "p1", 
         ",", "\[Mu]2", ",", "\[Nu]2", ",", 
         RowBox[{"-", "p2"}]}], "]"}]}], "//", "FeynAmpDenominatorExplicit"}],
      "//", "Calc"}]}], ";"}], "//", "Timing"}], "\[IndentingNewLine]", 
 RowBox[{
