Cell["\<\
The following commands define the kinematics.
The first command clears all previously defined scalar products. This is only \
a precautionary measure to ensure we use the correct set of defined scalar \
products.
The $Assumptions command I introduced to make Simplify[] work a bit faster.
Command SetMandelstam[] is a part of FeynCalc, and it defines the scalar \
product of particles\[CloseCurlyQuote] momenta in terms of Mandelstam \
variables.
The other commands define the scalar products of momenta and polarisation \
vectors. The corresponding expressions I take directly from the previous \
Section.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981096684751891*^9, 3.9810966984187202`*^9}, {
   3.9811801961579*^9, 3.981180351659464*^9}, 3.981180438356024*^9},
 FontSize->18,ExpressionUUID->"d41008e2-f0a7-4943-aab9-14d9f02c5be7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearScalarProducts", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["h", "2"], "==", "1"}], "&&", 
     RowBox[{"h", "\[Element]", "Reals"}], "&&", 
     RowBox[{"s", ">", "0"}], "&&", 
     RowBox[{"t", "<", "0"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SetMandelstam", "[", 
    RowBox[{
    "s", ",", " ", "t", ",", " ", "u", ",", " ", "q1", " ", ",", " ", "p1", 
     " ", ",", " ", 
     RowBox[{"-", "q2"}], " ", ",", " ", 
     RowBox[{"-", "p2"}], " ", ",", " ", "m", " ", ",", " ", "0", " ", ",", 
     " ", "m", " ", ",", " ", "0"}], " ", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Pair", "[", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"Polarization", "[", 
         RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
      
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"Polarization", "[", 
         RowBox[{"p2", ",", 
          RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}],
     "=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"1", 
        FractionBox["t", "s"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["m", "2"], "s"]}], ")"}]}]}], " ", ")"}]}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"q1", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"q2", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", 
   RowBox[{"\[ImaginaryI]", " ", 
    FractionBox["1", 
     SqrtBox["2"]], "h", "   ", 
    SqrtBox[
     FractionBox[
      RowBox[{"-", "t"}], "s"]], 
    SqrtBox[
     RowBox[{"s", "+", 
      RowBox[{"t", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["m", "2"], "s"]}], ")"}]}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
