   RowBox[{"\[ScriptCapitalM]t", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Rho]1", ",", " ", "\[Sigma]1"}], "}"}], ",", " ", "q1", 
         ",", " ", 
