  3.9811813504256773`*^9, {3.981184600713606*^9, 3.981184620668622*^9}},
 CellLabel->"Out[34]=",ExpressionUUID->"f51df8d8-668d-45cd-a160-8e701dcb200b"]
}, Open  ]],

Cell["\<\
The following command evaluates the complete scattering amplitude on the mass \
shell. The amplitude does not depend on the graviton helicity since the \
scalar particle has no way of knowing which helicity the graviton carries.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9811808973211203`*^9, 3.9811809637304907`*^9}},
 FontSize->18,ExpressionUUID->"d9b774ce-3135-4988-b2b9-e213453229be"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]OnShell", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Contract", "[", 
        RowBox[{"\[ScriptCapitalM]", " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
         RowBox[{"Conjugate", "[", 
          RowBox[{"PolarizationTensor", "[", 
           RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], "]"}]}], 
        "]"}], "//", "FullSimplify"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", 
        RowBox[{"2", 
         SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\[IndentingNewLine]", "\[ScriptCapitalM]OnShell"}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981100738300947*^9, 3.9811008621621733`*^9}, {
  3.981177299895554*^9, 3.981177300180049*^9}, {3.98118085630378*^9, 
  3.9811808860207853`*^9}, {3.9811809933816977`*^9, 3.9811810024088287`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"b78b4733-7ada-4eb2-907e-04a842548fde"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.055645`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9811813516885443`*^9, 3.9811846020759478`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"8f4b3567-de71-4070-8b54-ef7ab227e145"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"\[ImaginaryI]", " ", 
    SuperscriptBox["\[Kappa]", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["m", "2"], "-", "s"}], ")"}], "3"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["m", "2"], " ", "t"}], "+", 
       SuperscriptBox["s", "2"], "+", 
       RowBox[{"s", " ", "t"}]}], ")"}], "2"]}], 
   RowBox[{"4", " ", 
    SuperscriptBox["s", "4"], " ", "t", " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m", "2"], "-", "u"}], ")"}]}]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.9811813516885443`*^9, 3.9811846020847597`*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"a250789d-dd2d-459d-8a3c-e7e75fd60f8d"]
}, Open  ]],

Cell["\<\
Lastly, the gauge-invariance test. The amplitude must vanish if one replaces \
one of the polarisation operators for the corresponding momenta. It is most \
important that all the other particles must also be on the mass shell. The \
four commands below check exactly that. The first two commands replace \
polarisation operators for the particle in the out state. The last two \
commands replace the polarisation operators for the in states.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981181074285222*^9, 3.981181131509239*^9}, {
  3.9811812025385933`*^9, 3.981181322507927*^9}},
 FontSize->18,ExpressionUUID->"e2940a64-a785-4692-8948-b78d338e80a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"TrickMandelstam", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{"\[ScriptCapitalM]", " ", 
       RowBox[{"PolarizationTensor", "[", 
        RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", "\[Mu]2"}], "]"}], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Nu]2", ",", "D"}], "]"}], ",", 
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"p2", ",", 
             RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], 
        "]"}]}], "]"}], "==", "0"}], "//", "FullSimplify"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "t", ",", "u", ",", 
     RowBox[{"2", 
      SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TrickMandelstam", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{"\[ScriptCapitalM]", " ", 
       RowBox[{"PolarizationTensor", "[", 
        RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", "\[Nu]2"}], "]"}], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Mu]2", ",", "D"}], "]"}], ",", 
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"p2", ",", 
             RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], 
        "]"}]}], "]"}], "==", "0"}], "//", "FullSimplify"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "t", ",", "u", ",", 
     RowBox[{"2", 
      SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TrickMandelstam", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{"\[ScriptCapitalM]", " ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"PolarizationTensor", "[", 
         RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], "]"}], 
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", "\[Mu]1"}], "]"}], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Nu]1", ",", "D"}], "]"}], ",", 
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
        "]"}]}], "]"}], "==", "0"}], "//", "FullSimplify"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "t", ",", "u", ",", 
     RowBox[{"2", 
      SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TrickMandelstam", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Contract", "[", 
      RowBox[{"\[ScriptCapitalM]", " ", 
       RowBox[{"Conjugate", "[", 
        RowBox[{"PolarizationTensor", "[", 
         RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], "]"}], 
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", "\[Nu]1"}], "]"}], 
       RowBox[{"Pair", "[", 
        RowBox[{
         RowBox[{"LorentzIndex", "[", 
          RowBox[{"\[Mu]1", ",", "D"}], "]"}], ",", 
         RowBox[{"Momentum", "[", 
          RowBox[{
           RowBox[{"Polarization", "[", 
            RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
        "]"}]}], "]"}], "==", "0"}], "//", "FullSimplify"}], ",", 
