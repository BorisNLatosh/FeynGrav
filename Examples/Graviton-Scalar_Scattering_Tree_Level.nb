 FormBox[
  RowBox[{"{", 
   RowBox[{"0.104725`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9811813438731318`*^9, 3.981184595030117*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"52c91886-5078-4610-9384-932d78a87393"],

Cell[BoxData[
