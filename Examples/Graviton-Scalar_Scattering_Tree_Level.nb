Cell["\<\
Below, I calculate all the amplitudes contributing to graviton-scalar \
scattering at the tree level. Four amplitudes contribute to the process. \
These are the regular s-, t-, and u-channel amplitudes, plus an amplitude \
with the contact interaction. I denote them as \[ScriptCapitalM]s, \
\[ScriptCapitalM]t, \[ScriptCapitalM]u, and \[ScriptCapitalM]c \
correspondingly. Each amplitude I simplify after the calculation. For each \
operator, I also ask Mathematica to give the evaluation time for the \
illustration.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.9810969215956182`*^9, 3.981096927270494*^9}, {
  3.981180454665276*^9, 3.981180547311759*^9}, {3.9811806200142593`*^9, 
  3.9811806541760473`*^9}, {3.981180707811564*^9, 3.981180708036253*^9}},
 FontSize->18,ExpressionUUID->"ed6b9b75-cd32-4595-8ada-52c493bc0be3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]s", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]1", ",", " ", "\[Nu]1"}], "}"}], ",", " ", "q1", ",", 
         " ", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"q1", "+", "p1"}], ")"}]}], ",", " ", "m"}], "]"}], 
       RowBox[{"ScalarPropagator", "[", 
        RowBox[{
         RowBox[{"q1", "+", "p1"}], ",", "m"}], "]"}], 
       RowBox[{"GravitonScalarVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2"}], "}"}], ",", 
         RowBox[{"q1", "+", "p1"}], ",", 
         RowBox[{"-", "q2"}], ",", "m"}], "]"}]}], "//", 
      "FeynAmpDenominatorExplicit"}], "//", "Calc"}]}], ";"}], "//", 
  "Timing"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]s", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{"\[ScriptCapitalM]s", ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", 
        RowBox[{"2", 
         SuperscriptBox["m", "2"]}]}], "}"}]}], "]"}]}], ";"}], "//", 
  "Timing"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.981101042518086*^9, 3.981101048092257*^9}, {
  3.9811011202179413`*^9, 3.981101130099455*^9}, {3.981101166354437*^9, 
  3.9811011707637043`*^9}, {3.98110181984529*^9, 3.981101824501148*^9}, {
  3.981180556060223*^9, 3.981180563542885*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"068fa62a-a0c9-4f8e-9fa8-3b8ce128790d"],

