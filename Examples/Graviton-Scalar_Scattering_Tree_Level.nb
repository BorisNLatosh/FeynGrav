Cell["\<\
I sum up all the amplitudes. It is important to note that the amplitudes are \
multiplied by different combinatorial factors. The contributions from s-, t-, \
and u-channels share the same combinatorial factor, as they are topologically \
equivalent. The amplitude \[ScriptCapitalM]c has a different combinatorial \
factor of 2. \
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.981180722755261*^9, 3.981180831290037*^9}},
 FontSize->18,ExpressionUUID->"a3ba419a-ade4-4442-866b-4a50fb2a129e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalM]", "=", " ", 
    RowBox[{
     RowBox[{
     "\[ScriptCapitalM]s", "+", " ", "\[ScriptCapitalM]t", "+", " ", 
      "\[ScriptCapitalM]u", "+", 
      RowBox[{"2", " ", "\[ScriptCapitalM]c"}]}], "//", "Calc"}]}], ";"}], "//",
   "Timing"}]], "Input",
 Editable->False,
 CellChangeTimes->{{3.981100682666257*^9, 3.981100733363933*^9}, {
  3.9811011465009747`*^9, 3.981101154370709*^9}, {3.981101383264402*^9, 
  3.9811013887347403`*^9}, {3.9811014187642803`*^9, 3.981101425083118*^9}, {
  3.98110175763562*^9, 3.9811017607248907`*^9}, {3.981101868911983*^9, 
  3.981101875000431*^9}, {3.9811756936042643`*^9, 3.981175693737632*^9}, {
  3.9811775681457663`*^9, 3.981177568439863*^9}, {3.981180606645999*^9, 
  3.9811806184152718`*^9}, {3.98118458481067*^9, 3.981184606728751*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"fd35a96f-2950-4a13-8367-f232f9be68c5"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.339254`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
