Cell[CellGroupData[{

Cell["Consistency checks", "Subsection",ExpressionUUID->"8e615c93-96c0-4e5a-9f3d-6d1296f2093f"],

Cell["\<\
These checks test the scalar signs, crossing symmetry and decoupling limits. \
These are tree-level consistency checks, not loop validation.\
\>", "Text",ExpressionUUID->"5fc16c68-6613-493c-a507-5a971eb7547a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{
   RowBox[{
    RowBox[{"kinematicZero", "[", "expr_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"Together", "[", 
      RowBox[{"expr", " ", "/.", " ", 
       RowBox[{"u", " ", "->", " ", 
        RowBox[{
         RowBox[{"4", " ", 
          RowBox[{"m", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", 
         "t"}]}]}], "]"}], " ", "===", " ", "0"}]}], ";", "\n", 
   RowBox[{"checks", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Quartic sign\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{"mContact", " ", "===", " ", "\[Lambda]4"}], ")"}]}], ",", 
      " ", 
      RowBox[{"\"\<Scalar exchanges\>\"", " ", "->", " ", 
       RowBox[{"kinematicZero", "[", 
        RowBox[{"mScalar", " ", "+", " ", 
         RowBox[{
          RowBox[{"\[Lambda]3", "^", "2"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"s", " ", "-", " ", 
               RowBox[{"m", "^", "2"}]}], ")"}]}], " ", "+", " ", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"t", " ", "-", " ", 
               RowBox[{"m", "^", "2"}]}], ")"}]}], " ", "+", " ", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"u", " ", "-", " ", 
               RowBox[{"m", "^", "2"}]}], ")"}]}]}], ")"}]}]}], "]"}]}], ",", 
      " ", 
      RowBox[{"\"\<s-t crossing\>\"", " ", "->", " ", 
       RowBox[{"kinematicZero", "[", 
        RowBox[{"\[ScriptCapitalM]", " ", "-", " ", 
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"s", " ", "->", " ", "t"}], ",", " ", 
             RowBox[{"t", " ", "->", " ", "s"}]}], "}"}]}], ")"}]}], "]"}]}], 
      ",", " ", 
      RowBox[{"\"\<t-u crossing\>\"", " ", "->", " ", 
       RowBox[{"kinematicZero", "[", 
        RowBox[{"\[ScriptCapitalM]", " ", "-", " ", 
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", " ", "->", " ", "u"}], ",", " ", 
             RowBox[{"u", " ", "->", " ", "t"}]}], "}"}]}], ")"}]}], "]"}]}], 
      ",", " ", 
      RowBox[{"\"\<Gravity switched off\>\"", " ", "->", " ", 
       RowBox[{"kinematicZero", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
           RowBox[{"\[Kappa]", " ", "->", " ", "0"}]}], ")"}], " ", "-", " ", 
         "mContact", " ", "-", " ", "mScalar"}], "]"}]}], ",", " ", 
      RowBox[{"\"\<Potential switched off\>\"", " ", "->", " ", 
       RowBox[{"kinematicZero", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[ScriptCapitalM]", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Lambda]3", " ", "->", " ", "0"}], ",", " ", 
             RowBox[{"\[Lambda]4", " ", "->", " ", "0"}]}], "}"}]}], ")"}], 
         " ", "-", " ", "mGravity"}], "]"}]}]}], "}"}]}], ";", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"List", " ", "@@@", " ", "checks"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Check\>\"", ",", " ", "\"\<Passed\>\""}], "}"}]}], "]"}],
      ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], ")"}]], "Input",\

 CellLabel->"In[15]:=",ExpressionUUID->"e211d84e-0671-4a26-8f98-b268afb06a46"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Check\"\>", "\<\"Passed\"\>"},
     {"\<\"Quartic sign\"\>", "True"},
     {"\<\"Scalar exchanges\"\>", "True"},
     {"\<\"s-t crossing\"\>", "True"},
     {"\<\"t-u crossing\"\>", "True"},
     {"\<\"Gravity switched off\"\>", "True"},
     {"\<\"Potential switched off\"\>", "False"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.00138605187392*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"653ceff3-4d00-45f0-b0bc-e4dc25045fa7"]
}, Open  ]],

Cell["\<\
To change the mass or couplings, replace them in \[ScriptCapitalM] after \
completing the calculation. Restart the kernel before switching examples, or \
call FCClearScalarProducts[] and explicitly reset any other definitions you \
introduced.\
\>", "Text",ExpressionUUID->"802c9fcb-59d7-4529-a097-03149550be66"]
}, Open  ]]
