Cell[CellGroupData[{

Cell["3. Generate and display all diagrams", "Section",ExpressionUUID->"f3efb669-2fca-4f7c-b6f3-dd331cd16e8d"],

Cell["\<\
The complete tree has seven diagrams: one quartic scalar contact, scalar \
exchange in s, t and u, and graviton exchange in s, t and u. The \
gravitational ghost does not appear in this tree with only external scalars. \
Higher-valence contacts in the model cannot contribute to a four-external-leg \
tree.\
\>", "Text",ExpressionUUID->"9db53f69-7ead-4a24-8d52-756fb11e5165"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"topologies", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"Adjacencies", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "4", ",", " ", "5", ",", " ", "6"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"insertions", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"topologies", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", " ", 
     RowBox[{"Model", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"GenericModel", " ", "->", " ", "model"}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0013846167604513`*^9, 4.001384619350678*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"696b0c94-af07-4192-8561-83a00a16d44d"],

