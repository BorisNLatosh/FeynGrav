Cell[CellGroupData[{

Cell["4. Fix the on-shell kinematics", "Section",ExpressionUUID->"af9a98b2-4233-4f4a-8a54-c13784a75775"],

Cell["\<\
p1 and p2 are incoming; p3 and p4 are outgoing. SetMandelstam receives all \
momenta incoming, hence the minus signs on p3 and p4. The invariants satisfy \
s + t + u = 4 m^2. Scalar products are fixed in both four and symbolic D \
dimensions; the final tree amplitude below is evaluated in four dimensions. \
These assignments persist in the kernel.\
\>", "Text",ExpressionUUID->"75b7b58c-855e-4c44-8d17-f3bd62dd0560"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", " ", "t", ",", " ", "u", ",", " ", "p1", ",", " ", "p2", ",", 
    " ", 
    RowBox[{"-", "p3"}], ",", " ", 
    RowBox[{"-", "p4"}], ",", " ", "m", ",", " ", "m", ",", " ", "m", ",", 
    " ", "m"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.001384626151587*^9, 4.001384627150564*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"f774fb12-dfaa-4ef4-a993-af7f947629e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Calculate the on-shell amplitude", "Section",ExpressionUUID->"a4b7792d-10bf-464b-b172-253436653ec1"],

Cell["\<\
PreFactor -> 1 retains the Feynman-rule factors of i. The converted diagrams \
therefore sum to i M. There is no identical-particle phase-space factor in \
the amplitude. The potential signs are those stated above; the scalar \
exchanges carry minus \[Lambda]3^2/(channel - m^2) in M.\
\>", "Text",ExpressionUUID->"3aa9bddb-8259-443a-b1ae-59a78ef1bf37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalM]", " ", "=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ExpandScalarProduct", "[", 
         RowBox[{"Contract", "[", 
          RowBox[{"FeynAmpDenominatorExplicit", "[", 
           RowBox[{
            RowBox[{"FCFAConvert", "[", 
             RowBox[{
              RowBox[{"CreateFeynAmp", "[", 
               RowBox[{"insertions", ",", " ", 
                RowBox[{"PreFactor", " ", "->", " ", "1"}], ",", " ", 
                RowBox[{"GaugeRules", " ", "->", " ", 
                 RowBox[{"{", "}"}]}], ",", " ", 
                RowBox[{"MomentumConservation", " ", "->", " ", "True"}], ",",
                 " ", 
                RowBox[{"Truncated", " ", "->", " ", "True"}]}], "]"}], ",", 
              " ", 
              RowBox[{"IncomingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
              RowBox[{"OutgoingMomenta", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", " ", 
              RowBox[{"LorentzIndexNames", " ", "->", " ", 
               RowBox[{"{", 
                RowBox[{
                "\[Mu]", ",", " ", "\[Nu]", ",", " ", "\[Rho]", ",", " ", 
                 "\[Sigma]", ",", " ", "\[Alpha]", ",", " ", "\[Beta]", ",", 
                 " ", "\[Gamma]", ",", " ", "\[Delta]"}], "}"}]}], ",", " ", 
              RowBox[{"ChangeDimension", " ", "->", " ", "4"}], ",", " ", 
              RowBox[{"Contract", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
              RowBox[{"Prefactor", " ", "->", " ", "1"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ScalarMass", " ", "->", " ", "m"}], ",", " ", 
              RowBox[{"ScalarLambda3", " ", "->", " ", "\[Lambda]3"}], ",", 
              " ", 
              RowBox[{"ScalarLambda4", " ", "->", " ", "\[Lambda]4"}]}], 
             "}"}]}], "]"}], "]"}], "]"}], "/", "I"}], " ", "/.", " ", 
       RowBox[{"D", " ", "->", " ", "4"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Kappa]", "^", "2"}], ",", " ", 
       RowBox[{"\[Lambda]3", "^", "2"}], ",", " ", "\[Lambda]4"}], "}"}], ",",
      " ", "Factor"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"96abfd65-8a16-4567-9fb1-f7beda5c4276"],

