Cell[CellGroupData[{

Cell["6. Present the amplitude", "Section",ExpressionUUID->"90aeea2d-a486-4f52-9fe5-111062c6133e"],

Cell["\<\
The amplitude is calculated directly with the on-shell scalar products and s \
+ t + u = 4 m^2. The table separates the calculated result by coupling: the \
quartic contact, cubic scalar exchange and gravitational exchange. The \
overall i has been removed, so the displayed result is M. Pole prescriptions \
are implicit in the original propagators; the rational display is intended \
away from the poles. No cross section is calculated.\
\>", "Text",ExpressionUUID->"1fdf7ca6-94ce-48c5-9804-3f381c08432a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Contribution to M\>\"", ",", 
        " ", "\"\<On-shell expression\>\""}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Quartic contact\>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", "mContact", "]"}]}], "}"}], ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"\"\<Scalar exchange (s, t, u)\>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", "mScalar", "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Graviton exchange (s, t, u)\>\"", ",", " ", 
        RowBox[{"TraditionalForm", "[", "mGravity", "]"}]}], "}"}]}], "}"}], ",",
     " ", 
    RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
    RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ")"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"9349d8b6-2f64-41d8-a933-263f3c4c17c6"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Contribution to M\"\>", "\<\"On-shell expression\"\>"},
     {"\<\"Quartic contact\"\>", "\[Lambda]4"},
     {"\<\"Scalar exchange (s, t, u)\"\>", 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[Lambda]3", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", " ", 
           SuperscriptBox["m", "4"]}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["m", "2"], " ", "s"}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["m", "2"], " ", "t"}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["m", "2"], " ", "u"}], "+", 
          RowBox[{"s", " ", "t"}], "+", 
          RowBox[{"s", " ", "u"}], "+", 
          RowBox[{"t", " ", "u"}]}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "-", "s"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "-", "t"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m", "2"], "-", "u"}], ")"}]}]]},
     {"\<\"Graviton exchange (s, t, u)\"\>", 
      RowBox[{"\[Lambda]4", "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Kappa]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            SuperscriptBox["m", "4"], " ", "s", " ", "t"}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "4"], " ", "s", " ", "u"}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "4"], " ", "t", " ", "u"}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox["s", "2"], " ", "t"}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox["s", "2"], " ", "u"}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", "s", " ", 
            SuperscriptBox["t", "2"]}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", "s", " ", 
            SuperscriptBox["u", "2"]}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", 
            SuperscriptBox["t", "2"], " ", "u"}], "-", 
           RowBox[{"4", " ", 
            SuperscriptBox["m", "2"], " ", "t", " ", 
            SuperscriptBox["u", "2"]}], "+", 
           RowBox[{
            SuperscriptBox["s", "3"], " ", "t"}], "+", 
           RowBox[{
            SuperscriptBox["s", "3"], " ", "u"}], "-", 
           RowBox[{
            SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
           RowBox[{"s", " ", 
            SuperscriptBox["t", "3"]}], "-", 
           RowBox[{"s", " ", 
            SuperscriptBox["t", "2"], " ", "u"}], "-", 
           RowBox[{"s", " ", "t", " ", 
            SuperscriptBox["u", "2"]}], "+", 
           RowBox[{"s", " ", 
            SuperscriptBox["u", "3"]}], "+", 
           RowBox[{
            SuperscriptBox["t", "3"], " ", "u"}], "+", 
           RowBox[{"t", " ", 
            SuperscriptBox["u", "3"]}]}], ")"}]}], 
        RowBox[{"8", " ", "s", " ", "t", " ", "u"}]], "+", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Lambda]3", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            SuperscriptBox["m", "4"]}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["m", "2"], " ", "s"}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["m", "2"], " ", "t"}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["m", "2"], " ", "u"}], "+", 
           RowBox[{"s", " ", "t"}], "+", 
           RowBox[{"s", " ", "u"}], "+", 
           RowBox[{"t", " ", "u"}]}], ")"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m", "2"], "-", "s"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m", "2"], "-", "t"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m", "2"], "-", "u"}], ")"}]}]]}]}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.001386051849663*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"285df79f-24f0-47f4-b1ee-fa6a939d472c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"(", 
  RowBox[{"\[ScriptCapitalM]", " ", "//", " ", "TraditionalForm"}], 
  ")"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"7acbe1b2-fccf-453d-bcad-41587b37a536"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Lambda]4", "-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", 
        SuperscriptBox["m", "4"], " ", "s", " ", "t"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "4"], " ", "s", " ", "u"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "4"], " ", "t", " ", "u"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "2"], " ", "t"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["s", "2"], " ", "u"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", "s", " ", 
        SuperscriptBox["t", "2"]}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", "s", " ", 
        SuperscriptBox["u", "2"]}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", 
        SuperscriptBox["t", "2"], " ", "u"}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["m", "2"], " ", "t", " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{
        SuperscriptBox["s", "3"], " ", "t"}], "+", 
       RowBox[{
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
       RowBox[{"s", " ", 
        SuperscriptBox["t", "3"]}], "-", 
       RowBox[{"s", " ", 
        SuperscriptBox["t", "2"], " ", "u"}], "-", 
       RowBox[{"s", " ", "t", " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{
        SuperscriptBox["t", "3"], " ", "u"}], "+", 
       RowBox[{"t", " ", 
        SuperscriptBox["u", "3"]}]}], ")"}]}], 
    RowBox[{"8", " ", "s", " ", "t", " ", "u"}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Lambda]3", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SuperscriptBox["m", "4"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", "s"}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", "t"}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["m", "2"], " ", "u"}], "+", 
       RowBox[{"s", " ", "t"}], "+", 
       RowBox[{"s", " ", "u"}], "+", 
       RowBox[{"t", " ", "u"}]}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["m", "2"], "-", "s"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["m", "2"], "-", "t"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["m", "2"], "-", "u"}], ")"}]}]]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.001386051864451*^9},
 CellLabel->
