Cell["2. Load the FeynArts model", "Section",ExpressionUUID->"0e0b0670-2bc9-4384-ab53-d53bd6d2448e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "model", " ", "=", " ", "\"\<Single-Scalar-Tensor-Minimal-Coupling\>\""}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.001384606057777*^9, 4.001384613237446*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"9e099cbc-cde7-41d8-990a-a644efb2bfe0"]
