       RowBox[{
       "\[Nu]", ",", " ", "\[Mu]", ",", " ", "k", ",", " ", "p1", ",", " ", 
        "p2", ",", " ", "m"}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"ff384b2e-d364-40f1-88ac-7b37377959e1"],

