Notebook[{

Cell[CellGroupData[{
Cell["One-loop scalar\[Dash]graviton vertex", "Title",ExpressionUUID->"11db28ee-7bcc-4270-89f3-7ad47c16d2d2"],

Cell["\<\
FORM contraction, tensor reduction, consistency checks and infrared analysis\
\>", "Subtitle",ExpressionUUID->"06b8fe42-f6f0-4b86-90a7-45f4e18bee47"],

Cell["This example uses the native FeynArts scalar model to construct the five non-vanishing one-loop, one-particle-irreducible scalar–graviton diagrams of minimally coupled Einstein gravity. The scalar potential couplings are set to zero. FeynArts supplies the routing and diagram weights. The diagrams are grouped into four contributions for the off-shell reduction and subsequent symmetry, ultraviolet and infrared analysis below.", "Text",ExpressionUUID->"aa98b351-8dfa-4c7c-9074-1c0beac4689f"],

Cell[CellGroupData[{

Cell["1. Setup and conventions", "Section",ExpressionUUID->"036d3283-ec42-40f9-be91-ee9c4ec01cb4"],

Cell["Start with a fresh kernel and evaluate from top to bottom. FeynArts generates and draws the diagrams; FCFAConvert translates their amputated tensors to FeynCalc. FeynGravSimplify contracts the integrands with FORM, TID reduces their loop tensors, and FeynHelpers connects to Package-X for explicit scalar integrals and pole extraction. These dependencies must already be installed. The optional pure-GR bridge is not used.", "Text",ExpressionUUID->"7c33c97a-a889-43d9-b766-b6d66431a139"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"$LoadAddOns", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<FeynArts\>\"", ",", "\"\<FeynHelpers\>\""}], "}"}]}], ";", 
  RowBox[{"<<", "\"\<FeynGrav`\>\""}], ";"}]], "Input",
 CellChangeTimes->{{4.000096480993659*^9, 4.000096482638112*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"34d9fae9-7813-4562-85aa-9ecadc92525e"],

