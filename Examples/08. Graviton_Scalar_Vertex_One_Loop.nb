Cell["The two-graviton bubble has weight 1/2: exchanging its two identical internal graviton lines leaves the labelled external graph unchanged. The triangles and each mixed scalar–graviton bubble have weight 1. These native weights are already in nativeIntegrands. The earlier manual V3 weight of 1 must not be retained. Saved downstream outputs, if present, predate this change and must be recalculated.", "Text",ExpressionUUID->"080f3387-7ac8-4b70-b49e-ef15d93d6b72"],

Cell["The full action also has a three-graviton–two-scalar vertex of order κ³, beyond this model’s κ² per-vertex cutoff. Closing two of its graviton legs produces a massless tadpole with a polynomial numerator and no external momentum in its denominator. It vanishes as a scaleless integral in dimensional regularisation, even for a massive external scalar. This omission is justified only with that prescription; the model does not contain the complete κ³ vertex inventory. No separate ultraviolet or infrared value is assigned to the omitted scaleless integral.", "Text",ExpressionUUID->"30d6fbe8-2689-474b-bbca-de5df0faca3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Contribution\>\"", ",", " ", "\"\<Internal lines\>\"", ",",
        " ", "\"\<Native weight\>\""}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<V1\>\"", ",", " ", "\"\<one scalar, two gravitons\>\"", ",",
        " ", "1"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<V2\>\"", ",", " ", "\"\<two scalars, one graviton\>\"", ",",
        " ", "1"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<V3\>\"", ",", " ", "\"\<two gravitons\>\"", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<V4\>\"", ",", " ", "\"\<two mixed bubbles\>\"", ",", 
       " ", "\"\<1 for each diagram\>\""}], "}"}]}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"9c233af8-50bc-4364-a898-afafb6ad18a2"],

Cell[BoxData[
 FormBox[
  TagBox[GridBox[{
     {"\<\"Contribution\"\>", "\<\"Internal lines\"\>", "\<\"Native \
weight\"\>"},
     {"\<\"V1\"\>", "\<\"one scalar, two gravitons\"\>", "1"},
     {"\<\"V2\"\>", "\<\"two scalars, one graviton\"\>", "1"},
     {"\<\"V3\"\>", "\<\"two gravitons\"\>", 
      FractionBox["1", "2"]},
     {"\<\"V4\"\>", "\<\"two mixed bubbles\"\>", "\<\"1 for each \
diagram\"\>"}
    },
    AutoDelete->False,
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
   "Grid"], TraditionalForm]], "Output",
 CellChangeTimes->{4.001734442528531*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"4355290a-4bda-4a8e-8f1b-fa52f247326e"]
}, Open  ]],

Cell["FORM can cancel every propagator in some numerator terms. A denominator-free polynomial is also scaleless under the declared loop integration. Remove this polynomial before TID, which otherwise leaves a loop-independent constant unchanged. This helper is specific to the present diagrams: every remaining FeynAmpDenominator depends on l.", "Text",ExpressionUUID->"d51ae380-6512-488b-bc33-89f3f64902e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reduceVertex", "[", "expr_", "]"}], ":=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"expr", "-", 
      RowBox[{"(", 
       RowBox[{"expr", "/.", "\[VeryThinSpace]", 
        RowBox[{"_FeynAmpDenominator", "\[Rule]", "0"}]}], ")"}]}], ",", "l", 
     ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"384774e3-aa0f-44d2-9a59-0baa4af8dc16"],

Cell[CellGroupData[{

Cell["2.1. V1", "Subsection",ExpressionUUID->"7ea8e5ba-dbb5-40f5-9b2f-1c3dc894be59"],

Cell["Native routing: scalar l; gravitons p1 − l and p2 + l. The triangle contains two scalar–graviton vertices and one three-graviton vertex.", "Text",ExpressionUUID->"61485bde-b7a0-4030-a845-272d0a5cad30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV1", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"Select", "[", 
     RowBox[{"nativeIntegrands", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"propagatorMasses", "[", "#1", "]"}], "===", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "m"}], "}"}]}], "&"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"ed047060-635c-40a2-80cf-9eaa9396e629"],

Cell[BoxData[
 RowBox[{
  RowBox[{"contractedV1", "=", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: FORM\>\"", ",", 
     RowBox[{"FeynGravSimplify", "[", 
      RowBox[{"integrandV1", ",", 
       RowBox[{"LoopMomenta", "\[Rule]", 
        RowBox[{"{", "l", "}"}]}], ",", 
       RowBox[{"TensorDecomposition", "\[Rule]", "False"}]}], "]"}]}], 
    "]"}]}], ";", 
  RowBox[{"reducedV1", "=", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: TID\>\"", ",", 
     RowBox[{"reduceVertex", "[", "contractedV1", "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"512c2fe0-d2d2-49f6-8f50-2dc2aebd8ade"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"invariantV1", " ", "=", " ", 
   RowBox[{"reducedV1", " ", "/.", " ", "invariantRules"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalV]1", "[", 
    RowBox[{
    "\[Mu]_", ",", " ", "\[Nu]_", ",", " ", "k_", ",", " ", "p1_", ",", " ", 
     "p2_", ",", " ", "m_"}], "]"}], " ", "=", " ", 
   RowBox[{"timed", "[", 
    RowBox[{"\"\<V1: collect\>\"", ",", " ", 
     RowBox[{"collectVertex", "[", "invariantV1", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"02179c11-3aa5-490d-9468-d94a4b8d4566"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2. V2", "Subsection",ExpressionUUID->"4070f178-431c-4661-b9eb-36eb184c43c0"],

Cell["Loop routing: graviton l; scalars p1 \[Minus] l and p2 + l.", "Text",ExpressionUUID->"23acdc8b-f9f5-402f-a3db-059d529531ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"integrandV2", "=", 
