      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", 
      RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", 
      RowBox[{"m", "^", "2"}], ",", " ", "0"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bubbleMasslessKey", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"B0", "[", 
     RowBox[{
      RowBox[{"SPD", "[", "k", "]"}], ",", " ", "0", ",", " ", "0"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spacelikeLeading", "[", "expr_", "]"}], " ", ":=", " ", 
