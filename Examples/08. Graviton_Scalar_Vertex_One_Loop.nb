Cell[BoxData[{
 RowBox[{
  RowBox[{"masterIntegrals", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A0", "[", "__", "]"}], ",", " ", 
     RowBox[{"B0", "[", "__", "]"}], ",", " ", 
     RowBox[{"C0", "[", "__", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tensorBasis", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MTD", "[", 
       RowBox[{"\[Mu]", ",", " ", "\[Nu]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Nu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Nu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Mu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p1", ",", " ", "\[Nu]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Mu]"}], "]"}], "*", 
       RowBox[{"FVD", "[", 
        RowBox[{"p2", ",", " ", "\[Nu]"}], "]"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"invariantRules", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FCI", "[", 
      RowBox[{"SPD", "[", 
       RowBox[{"p1", ",", " ", "p2"}], "]"}], "]"}], " ", "->", " ", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"SPD", "[", 
          RowBox[{"k", ",", " ", "k"}], "]"}], " ", "-", " ", 
         RowBox[{"SPD", "[", 
          RowBox[{"p1", ",", " ", "p1"}], "]"}], " ", "-", " ", 
         RowBox[{"SPD", "[", 
          RowBox[{"p2", ",", " ", "p2"}], "]"}]}], ")"}]}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"onShellRules", " ", "=", " ", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"p1", ",", " ", "p1"}], "]"}], " ", "->", " ", 
       RowBox[{"m", "^", "2"}]}], ",", " ", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"p2", ",", " ", "p2"}], "]"}], " ", "->", " ", 
       RowBox[{"m", "^", "2"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"collectVertex", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"Collect", "[", 
    RowBox[{"expr", ",", " ", "masterIntegrals", ",", " ", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", " ", "tensorBasis", ",", " ", "Simplify"}], "]"}], 
      " ", "&"}]}], " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stageTimings", " ", "=", " ", 
   RowBox[{"Association", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"timed", ",", " ", "HoldRest"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"timed", "[", 
    RowBox[{"label_", ",", " ", "expr_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"measurement", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "expr", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"stageTimings", ",", " ", 
        RowBox[{"label", " ", "->", " ", 
         RowBox[{"First", "[", "measurement", "]"}]}]}], "]"}], ";", " ", 
      RowBox[{"If", "[", " ", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"Last", "[", "measurement", "]"}], ",", " ", 
           RowBox[{
           "_Failure", " ", "|", " ", "$Failed", " ", "|", " ", 
            "$Aborted"}]}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"label", ",", " ", "\"\<: \>\"", ",", " ", 
           RowBox[{"Last", "[", "measurement", "]"}]}], "]"}], ";", " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", " ", 
      RowBox[{"Last", "[", "measurement", "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkStatus", "[", "value_", "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", " ", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"value", ",", " ", 
        RowBox[{
        "_Failure", " ", "|", " ", "$Failed", " ", "|", " ", "$Aborted"}]}], 
       "]"}]}], ",", " ", "\"\<Failure\>\"", ",", " ", 
     RowBox[{"TrueQ", "[", "value", "]"}], ",", " ", "\"\<Passed\>\"", ",", 
     " ", 
     RowBox[{"value", " ", "===", " ", "False"}], ",", " ", "\"\<Failed\>\"", 
     ",", " ", "True", ",", " ", "\"\<Unresolved\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"checks", " ", "=", " ", 
   RowBox[{"Association", "[", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"dc2f20e0-762e-49aa-ae3a-f6c0a99e332d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Diagram contributions", "Section",ExpressionUUID->"0092eea1-25ae-47b7-af90-526beb368680"],

Cell["Generate one-loop 1PI topologies, excluding reducible external-leg corrections. The five retained diagrams form two triangles and three bubbles. The mass list of the complete propagator product identifies each group without relying on FeynArts’ diagram numbering. Both mixed bubbles are already included. Reduce each group separately, keeping TensorDecomposition -> False for the FORM step so that TID performs the integration.", "Text",ExpressionUUID->"fd0dd8c6-2d38-4705-956c-39501e5f81f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"topologies", "=", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"1", ",", 
     RowBox[{"2", "\[Rule]", "1"}], ",", 
     RowBox[{"Adjacencies", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4", ",", "5"}], "}"}]}], ",", 
     RowBox[{"ExcludeTopologies", "\[Rule]", "Reducible"}]}], "]"}]}], ";", 
  RowBox[{"insertions", "=", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"topologies", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "1", "]"}], ",", 
        RowBox[{"S", "[", "1", "]"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"T", "[", "1", "]"}], "}"}]}], ",", 
     RowBox[{"Model", "\[Rule]", "model"}], ",", 
     RowBox[{"GenericModel", "\[Rule]", "model"}], ",", 
     RowBox[{"InsertionLevel", "\[Rule]", 
      RowBox[{"{", "Classes", "}"}]}], ",", 
     RowBox[{"ExcludeFieldPoints", "\[Rule]", "potentialVertices"}]}], 
    "]"}]}], ";", 
  RowBox[{"rawAmplitudes", "=", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"insertions", ",", 
     RowBox[{"PreFactor", "\[Rule]", "1"}], ",", 
     RowBox[{"GaugeRules", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"Truncated", "\[Rule]", "True"}], ",", 
     RowBox[{"MomentumConservation", "\[Rule]", "True"}]}], "]"}]}], ";", 
  RowBox[{"nativeIntegrands", "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"rawAmplitudes", ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", "+", "p2"}], "}"}]}], ",", 
     RowBox[{"LoopMomenta", "\[Rule]", 
      RowBox[{"{", "l", "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}]}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
     RowBox[{"Contract", "\[Rule]", "False"}], ",", 
     RowBox[{"List", "\[Rule]", "True"}], ",", 
     RowBox[{"Prefactor", "\[Rule]", "1"}], ",", 
     RowBox[{"FinalSubstitutions", "\[Rule]", "scalarParameters"}]}], "]"}]}],
   ";", 
  RowBox[{
   RowBox[{"propagatorMasses", "[", "expr_", "]"}], ":=", 
   RowBox[{"Sort", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"FCI", "[", "expr", "]"}], ",", 
      RowBox[{
       RowBox[{"PropagatorDenominator", "[", 
        RowBox[{"_", ",", "mass_"}], "]"}], "\[RuleDelayed]", "mass"}], ",", 
      "\[Infinity]"}], "]"}], "]"}]}], ";", 
  RowBox[{"expectedMasses", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "m"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "m", ",", "m"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "m"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "m"}], "}"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"propagatorMasses", "/@", "nativeIntegrands"}], "]"}], "=!=", 
     "expectedMasses"}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", "\"\<Unexpected minimal one-loop diagram inventory. Stop \
and inspect the model and insertions.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"diagramSheet", "=", 
   RowBox[{"Paint", "[", 
    RowBox[{"insertions", ",", 
     RowBox[{"ColumnsXRows", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "2"}], "}"}]}], ",", 
     RowBox[{"Numbering", "\[Rule]", "Simple"}], ",", 
     RowBox[{
     "SheetHeader", 
      "\[Rule]", "\"\<Minimal scalar\[Dash]graviton vertex: five 1PI diagrams\
\>\""}], ",", 
     RowBox[{"AutoEdit", "\[Rule]", "False"}], ",", 
     RowBox[{"DisplayFunction", "\[Rule]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Print", "/@", 
         RowBox[{"Render", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"ImageSize", "\[Rule]", "700"}]}], "]"}]}], "&"}], 
       ")"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001728100363263*^9, 4.001728100631812*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"44bf1c26-d84d-4530-9663-fe420b549d47"],

