         RowBox[{"-", "I"}]}], "]"}], ",", " ", "D"}], "]"}]}], "]"}], " ", "=",
    " ", "0"}], ";"}]}], "Input",
 CellTags->"helicity-momentum-products",
 CellLabel->"In[23]:=",ExpressionUUID->"2dc9b930-188e-4180-93a1-a456276c21ce"],

Cell["Next assign the products between polarisation vectors. Scalar products are symmetric, so each pair needs only one assignment. Each circular polarisation has zero product with itself; its product with its own complex conjugate has the usual normalisation -1.", "Text", ExpressionUUID->"d382e4a4-f912-41b2-80e8-4f8399d2ce7d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}], ",", 
     " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}], ",", 
     " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
