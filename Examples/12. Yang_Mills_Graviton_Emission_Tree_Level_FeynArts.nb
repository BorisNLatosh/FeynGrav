 CellChangeTimes->{4.002004405035571*^9},
 CellTags->"zero-yang-mills",
 CellLabel->"Out[14]=",ExpressionUUID->"029d6fc7-c182-41d2-a7be-460e0a94cc4e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Check both gauge symmetries before fixing helicities", "Section", 
   ExpressionUUID -> "2edcc670-824c-4494-9166-c7036aa606ed"],

Cell["We now check Yang–Mills gauge invariance and gravitational gauge invariance. We use tensorAmplitude, before attaching the external polarisation vectors, so that we can replace one external state at a time. Evaluate the setup below, then the five checks in order.", "Text", ExpressionUUID->"61be136d-6b16-4b35-983b-acd74742f26f"],

Cell["For these checks, e1 and e2 represent the incoming gauge-field polarisations, e3 the outgoing gauge-field polarisation, and e4 the vector whose product with itself forms the outgoing graviton polarisation tensor. The setup imposes transversality on these physical states and the null-vector condition for e4, which makes the graviton tensor traceless. The relation involving e4 and p3 follows from momentum conservation and transversality to p4. D remains symbolic.", "Text", ExpressionUUID->"8d63d0f4-c219-4762-aaaa-c32c4c079d70"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wardStateRules", "=", 
   RowBox[{"FCI", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"e1", ",", "p1"}], "]"}], "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"e2", ",", "p2"}], "]"}], "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"e3", ",", "p3"}], "]"}], "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"e4", ",", "p3"}], "]"}], "\[Rule]", 
       RowBox[{
        RowBox[{"SPD", "[", 
         RowBox[{"e4", ",", "p1"}], "]"}], "+", 
        RowBox[{"SPD", "[", 
         RowBox[{"e4", ",", "p2"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"SPD", "[", 
        RowBox[{"e4", ",", "e4"}], "]"}], "\[Rule]", "0"}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellTags->"ward-setup",
 CellLabel->"In[15]:=",ExpressionUUID->"627e3b21-06e8-4217-82a9-b85de431bfed"],

Cell["First check the incoming gauge field with momentum p1. Replace its polarisation vector by p1 and keep the other external particles in physical states. Gauge invariance requires this contracted amplitude to vanish. The cell should return True.", "Text", ExpressionUUID->"756e92a5-7c2b-4f68-b5ca-80b141f1e149"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyOnShell", "[", 
   RowBox[{
    RowBox[{"tensorAmplitude", " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p1", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e2", ",", "\[Nu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e3", ",", "\[Rho]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Alpha]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Beta]"}], "]"}]}], ",", "wardStateRules"}], "]"}],
   "===", "0"}]], "Input",
 CellTags->"ward-gauge-1",
 CellLabel->"In[16]:=",ExpressionUUID->"fa2e5145-df34-4f29-a7a6-bf199cc60c41"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004405278945*^9},
 CellTags->"ward-gauge-1",
 CellLabel->"Out[16]=",ExpressionUUID->"b2bc5046-e331-46f4-9f1a-f651d2316de6"]
}, Open  ]],

Cell["Repeat the check for the second incoming gauge field: replace its polarisation vector by p2 and keep the other external particles in physical states. The contracted amplitude must again vanish, so the cell should return True.", "Text", ExpressionUUID->"b7d72fd0-a2fe-4bda-8c84-fc6f8959e8ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyOnShell", "[", 
   RowBox[{
    RowBox[{"tensorAmplitude", " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e1", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p2", ",", "\[Nu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e3", ",", "\[Rho]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Alpha]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Beta]"}], "]"}]}], ",", "wardStateRules"}], "]"}],
   "===", "0"}]], "Input",
 CellTags->"ward-gauge-2",
 CellLabel->"In[17]:=",ExpressionUUID->"7dcdd349-5405-4bb1-9932-e19577ab42f6"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004405583838*^9},
 CellTags->"ward-gauge-2",
 CellLabel->"Out[17]=",ExpressionUUID->"f4886b3f-fef3-41e2-9d97-f42a861828d1"]
}, Open  ]],

Cell["\<\
Now check the outgoing gauge field by replacing its polarisation vector by \
p3. Keep the other external particles in physical states. The contracted \
amplitude must vanish, so the cell should return True.\
\>", "Text",ExpressionUUID->"dec0426b-06ed-4b02-ada3-8740f4380ba0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyOnShell", "[", 
   RowBox[{
    RowBox[{"tensorAmplitude", " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e1", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e2", ",", "\[Nu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p3", ",", "\[Rho]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Alpha]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Beta]"}], "]"}]}], ",", "wardStateRules"}], "]"}],
   "===", "0"}]], "Input",
 CellTags->"ward-gauge-3",
 CellLabel->"In[18]:=",ExpressionUUID->"b9db35a6-790a-450d-9551-3d7b65002b69"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.0020044058426647`*^9},
 CellTags->"ward-gauge-3",
 CellLabel->"Out[18]=",ExpressionUUID->"b842d0fd-4af5-4591-aacb-59ca997ca0e4"]
}, Open  ]],

Cell[TextData[{"Finally, check gravitational gauge invariance. Replace the outgoing graviton polarisation tensor by ", Cell[BoxData[FormBox[RowBox[{RowBox[{SuperscriptBox[SubscriptBox["p", "4"], "\[Alpha]"], " ", SuperscriptBox["r", "\[Beta]"]}], "+", RowBox[{SuperscriptBox[SubscriptBox["p", "4"], "\[Beta]"], " ", SuperscriptBox["r", "\[Alpha]"]}]}], TraditionalForm]], "InlineFormula"], ". The vector r is arbitrary; do not impose transversality on it. Only the three gauge-field polarisations retain their physical-state conditions. The contracted amplitude must vanish for arbitrary r, so the cell should return True."}], "Text", ExpressionUUID->"b8152012-04ad-458b-be9c-c668bcd83212"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyOnShell", "[", 
   RowBox[{
    RowBox[{"tensorAmplitude", " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e1", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e2", ",", "\[Nu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e3", ",", "\[Rho]"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"FVD", "[", 
         RowBox[{"p4", ",", "\[Alpha]"}], "]"}], " ", 
        RowBox[{"FVD", "[", 
         RowBox[{"r", ",", "\[Beta]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"FVD", "[", 
         RowBox[{"r", ",", "\[Alpha]"}], "]"}], " ", 
        RowBox[{"FVD", "[", 
         RowBox[{"p4", ",", "\[Beta]"}], "]"}]}]}], ")"}]}], ",", 
    RowBox[{"Take", "[", 
     RowBox[{"wardStateRules", ",", "3"}], "]"}]}], "]"}], "===", 
  "0"}]], "Input",
 CellTags->"ward-graviton",
 CellLabel->"In[19]:=",ExpressionUUID->"5a2bb21c-2dae-4db5-afc2-3b1ee1ad263a"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004406714056*^9},
 CellTags->"ward-graviton",
 CellLabel->"Out[19]=",ExpressionUUID->"62edb111-9635-424c-9722-b588865e3612"]
}, Open  ]],

Cell["Check that the test detects a missing interaction. Remove the hAAA contact contribution and repeat the first gauge-field check. The resulting contraction should be nonzero, so the cell below tests that it is not identically zero and should return True. This shows why the contact must be included. The graviton check alone would not detect this omission in this process.", "Text", ExpressionUUID->"b39f3c45-232d-4e05-ab11-6782a3c1a500"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyOnShell", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"tensorAmplitude", "-", "contactAmplitude"}], ")"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p1", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e2", ",", "\[Nu]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e3", ",", "\[Rho]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Alpha]"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"e4", ",", "\[Beta]"}], "]"}]}], ",", "wardStateRules"}], "]"}],
   "=!=", "0"}]], "Input",
 CellTags->"negative",
 CellLabel->"In[20]:=",ExpressionUUID->"aebd838c-327d-4715-935e-8e7765e8eac2"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004407025671*^9},
 CellTags->"negative",
 CellLabel->"Out[20]=",ExpressionUUID->"7800ecf5-6f95-49e3-b51d-424473294a76"]
}, Open  ]],

Cell["This example verifies the \
selected physical tree amplitude with generic invariants, symbolic D and \
symbolic SU(N) colour. It does not calculate a colour/helicity sum, a cross \
section, loop effects or quark scattering. See the GR-SU-N-Yang-Mills model \
guide and the Example12 verification report for conventions and the bounded \
checks used to validate this notebook.", "Text", 
   ExpressionUUID -> "1709af74-a273-4529-98f1-b6b0e2d22271"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Amplitude in terms of helicities", "Section", 
    ExpressionUUID -> "c7465e59-fe7a-4b11-8d98-cf98a70b3cea"],

Cell["The amplitude is already on shell. We now specify four-dimensional \
external helicity states and keep s and t as independent invariants, with u = \
\[Minus]s \[Minus] t. The gauge-field helicities are h1, h2 and h3. We write \
the graviton helicity as 2 h4, so every hi is either +1 or \[Minus]1. The \
earlier symbolic-D amplitude and Ward checks are left unchanged.", "Text", 
    ExpressionUUID -> "4f17bfc0-d50d-43fc-9021-86f57c0d4a76"],

Cell["The following scalar products fix a consistent polarisation phase convention. The physical scattering region is s > 0 and -s < t < 0; square roots denote their positive real branches. I and -I in Polarization indicate incoming and conjugate outgoing states, not helicity. These assignments remain active in the kernel. Evaluate the general Ward checks above before this subsection; restart the kernel and evaluate from the beginning to return to unfixed polarisations.", "Text", ExpressionUUID->"7f321d2b-9936-4a6e-937a-b68cc53020f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"helicityAssumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"-", "s"}], " ", "<", " ", "t", " ", "<", " ", "0"}], " ", "&&", 
    "  ", 
    RowBox[{
     SuperscriptBox["h1", "2"], " ", "==", " ", "1"}], " ", "&&", " ", 
    RowBox[{
     SuperscriptBox["h2", "2"], "==", " ", "1"}], " ", "&&", " ", 
    RowBox[{
     SuperscriptBox["h3", "2"], " ", "==", " ", "1"}], " ", "&&", " ", 
    RowBox[{
     SuperscriptBox["h4", "2"], "==", " ", "1"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001999257429566*^9, 4.00199928021795*^9}},
 CellTags->"helicity-assumptions",
 CellLabel->"In[21]:=",ExpressionUUID->"eb394633-9bba-40e9-8ad1-725aa9abd97a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"helicityScale", " ", "=", " ", 
   SqrtBox[
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"s", "+", "t"}], ")"}], "t"}], 
      RowBox[{"2", " ", "s"}]]}]]}], ";"}]], "Input",
 CellChangeTimes->{{4.001999290675826*^9, 4.001999309878828*^9}},
 CellTags->"helicity-scale",
 CellLabel->"In[22]:=",ExpressionUUID->"c22e411a-549a-4871-b73c-df345ae24b36"],

Cell["First assign the products of each momentum with each polarisation vector. The outgoing states use Polarization[p3, -I] and Polarization[p4, -I]. These assignments include transversality and are consistent with p1 + p2 = p3 + p4.", "Text", ExpressionUUID->"c34bcafc-99fa-4dc4-9f8e-0ed4f20f388a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "h1", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", 
   RowBox[{"I", " ", "h1", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", 
   RowBox[{"I", " ", "h2", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", " ", "I"}], "]"}], ",", " ", "D"}], "]"}]}], "]"}],
    " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "h2", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", " ", 
         RowBox[{"-", "I"}]}], "]"}], ",", " ", "D"}], "]"}]}], "]"}], " ", "=",
    " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "h3", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", " ", 
         RowBox[{"-", "I"}]}], "]"}], ",", " ", "D"}], "]"}]}], "]"}], " ", "=",
    " ", 
   RowBox[{"I", " ", "h3", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", " ", 
         RowBox[{"-", "I"}]}], "]"}], ",", " ", "D"}], "]"}]}], "]"}], " ", "=",
    " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
