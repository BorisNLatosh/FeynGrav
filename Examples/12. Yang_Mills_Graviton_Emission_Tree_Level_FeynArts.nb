Cell["Check that multiplying the kinematic amplitude by the colour factor and the two couplings reconstructs the complete amplitude. The result should be True.", "Text", ExpressionUUID->"06633c9f-3467-4393-9e21-dfec0e512a15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Expand", "[", "\[ScriptCapitalM]", "]"}], "===", 
  RowBox[{"Expand", "[", 
   RowBox[{
   "gs", " ", "\[Kappa]", " ", "colourFactor", " ", "kinematicAmplitude"}], 
   "]"}]}]], "Input",
 CellTags->"colour-reconstruction",
 CellLabel->"In[12]:=",ExpressionUUID->"781b5bc0-5e8c-4bdc-9e5f-80297badf6d9"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004404995311*^9},
 CellTags->"colour-reconstruction",
 CellLabel->"Out[12]=",ExpressionUUID->"a3d0d82d-768c-4362-90be-fe8033c48799"]
}, Open  ]],

Cell["Check that the amplitude vanishes when the gravitational coupling κ is set to zero. Without this coupling, the process cannot emit a graviton. The result should be True.", "Text", ExpressionUUID->"0ff247dc-c2d3-444b-8b1b-37f6fcf87858"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"\[ScriptCapitalM]", "/.", "\[VeryThinSpace]", 
    RowBox[{"\[Kappa]", "\[Rule]", "0"}]}], ")"}], "===", "0"}]], "Input",
 CellTags->"zero-gravity",
 CellLabel->"In[13]:=",ExpressionUUID->"a7b28287-8168-4529-b23f-205e9201fc56"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004405016018*^9},
 CellTags->"zero-gravity",
 CellLabel->"Out[13]=",ExpressionUUID->"0acd5afc-a386-42ea-8b9f-8b881d4185c0"]
}, Open  ]],

Cell["Check that the amplitude vanishes when the Yang–Mills coupling gs is set to zero. This particular process requires the non-Abelian gauge interaction. The result should be True.", "Text", ExpressionUUID->"2201ab64-9ae2-4de3-8f31-83e89f0a40a3"],

