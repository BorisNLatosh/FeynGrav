Cell["With these scalar products assigned, simplify the complete amplitude using hi² = 1 and D = 4. The result is a single expression in h1, h2, h3, h4, s and t, with the original colour factor and couplings.", "Text", ExpressionUUID->"dad8d399-fcef-450c-8177-3ee4a578ff0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"helicityAmplitude", " ", "=", " ", "Factor", "[", "Simplify", "[", 
  "Expand", "[", "\[ScriptCapitalM]", " ", "/.", " ", "D", " ", "->", " ", 
  "4", "]", ",", " ", "Assumptions", " ", "->", " ", "helicityAssumptions", "]",
   "]"}]], "Input",
 CellChangeTimes->{4.001999365605221*^9},
 CellTags->"helicity-amplitude",
 CellLabel->"In[49]:=",ExpressionUUID->"474c5136-bc82-4a6c-98b7-d154bea69bb6"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"gs", " ", "\[Kappa]", " ", 
    SuperscriptBox["f", 
     RowBox[{
      FormBox[
       FormBox["a",
        TraditionalForm],
       TraditionalForm], 
      FormBox[
       FormBox["b",
        TraditionalForm],
       TraditionalForm], 
      FormBox[
       FormBox["c",
        TraditionalForm],
       TraditionalForm]}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"h1", " ", "h2", " ", "h3", " ", 
       SuperscriptBox["s", "2"]}], "+", 
      RowBox[{"h1", " ", "h2", " ", "h3", " ", "s", " ", "t"}], "+", 
      RowBox[{"h1", " ", "h2", " ", "h3", " ", 
       SuperscriptBox["t", "2"]}], "-", 
      RowBox[{"h1", " ", "h2", " ", "h4", " ", "s", " ", "t"}], "-", 
      RowBox[{"h1", " ", "h2", " ", "h4", " ", 
       SuperscriptBox["t", "2"]}], "+", 
      RowBox[{"h1", " ", "h3", " ", "h4", " ", 
       SuperscriptBox["s", "2"]}], "+", 
      RowBox[{"h1", " ", "h3", " ", "h4", " ", "s", " ", "t"}], "-", 
      RowBox[{"h1", " ", "s", " ", "t"}], "-", 
      RowBox[{"h2", " ", "h3", " ", "h4", " ", "s", " ", "t"}], "+", 
      RowBox[{"h2", " ", 
       SuperscriptBox["s", "2"]}], "+", 
      RowBox[{"h2", " ", "s", " ", "t"}], "-", 
      RowBox[{"h3", " ", "s", " ", "t"}], "-", 
      RowBox[{"h3", " ", 
       SuperscriptBox["t", "2"]}], "+", 
      RowBox[{"h4", " ", 
       SuperscriptBox["s", "2"]}], "+", 
      RowBox[{"h4", " ", "s", " ", "t"}], "+", 
      RowBox[{"h4", " ", 
       SuperscriptBox["t", "2"]}]}], ")"}]}], 
   RowBox[{"4", " ", 
    SqrtBox["2"], " ", 
    SqrtBox[
     RowBox[{
      RowBox[{"-", "s"}], " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{"s", "+", "t"}], ")"}]}]]}]], TraditionalForm]], "Output",
 CellChangeTimes->{4.002004407629966*^9},
 CellTags->"helicity-amplitude",
 CellLabel->"Out[49]=",ExpressionUUID->"b12feb24-53b9-4aba-981f-2b2f803dbd08"]
}, Open  ]],

Cell["Check that no unevaluated polarisation scalar products, momenta or \
dimension symbol remain. The cell should return True. To obtain a particular \
physical amplitude, replace the desired hi by +1 or \[Minus]1 in \
helicityAmplitude; no helicity sum or average has been taken.", "Text", 
    ExpressionUUID -> "1f66a5bb-d8c5-460e-8625-498b401e1962"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FreeQ", "[", "helicityAmplitude", ",", " ", "Pair", " ", "|", " ", 
  "Momentum", " ", "|", " ", "Polarization", " ", "|", " ", "D", 
  "]"}]], "Input",
 CellTags->"helicity-complete",
 CellLabel->"In[50]:=",ExpressionUUID->"faf39c50-5f77-4537-8967-8ac81107f8bd"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.002004407655548*^9},
 CellTags->"helicity-complete",
 CellLabel->"Out[50]=",ExpressionUUID->"c7ecd839-724c-416f-beef-93d794fe501b"]
}, Open  ]]
}, Open  ]]
