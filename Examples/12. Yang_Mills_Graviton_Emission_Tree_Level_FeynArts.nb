Cell["The model has a massless \
adjoint gauge field V[1], a graviton T[1], and distinct gravitational and \
Yang\[Dash]Mills ghost sectors. Ghosts do not occur in these physical \
external-state trees. The fixed source gauges are GaugeFixingEpsilon = 2 and \
GaugeFixingEpsilonSUNYM = \[Minus]1.", "Text", 
   ExpressionUUID -> "36e40ef9-267a-4eda-9604-b296b7afdb34"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Generate and display the four diagrams", "Section", 
   ExpressionUUID -> "a548d7d1-ebc5-48f8-80a9-d98778271ffd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"topologies", "=", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "\[Rule]", "2"}], ",", 
     RowBox[{"Adjacencies", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"3", ",", "4", ",", "5", ",", "6"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"insertions", "=", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"topologies", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"V", "[", "1", "]"}], ",", 
        RowBox[{"V", "[", "1", "]"}]}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"V", "[", "1", "]"}], ",", 
        RowBox[{"T", "[", "1", "]"}]}], "}"}]}], ",", 
     RowBox[{"Model", "\[Rule]", "model"}], ",", 
     RowBox[{"GenericModel", "\[Rule]", "model"}], ",", 
     RowBox[{"InsertionLevel", "\[Rule]", 
