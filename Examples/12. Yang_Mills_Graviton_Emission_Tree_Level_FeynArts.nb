Cell["PreFactor -> 1 retains the \
source normalisation; FeynArts supplies diagram weights. MomentumConservation \
-> True fixes internal routing. Truncated -> True leaves three free \
gauge-field indices and two graviton indices. We retain all colour sums \
during conversion, remove only external-state sum markers, and verify that \
every internal colour index occurs exactly twice in each monomial before \
using FeynCalc\[CloseCurlyQuote]s repeated-index contraction. The result is a \
fixed-colour amplitude, not a colour average.", "Text", 
   ExpressionUUID -> "fd0cc012-2518-4136-84af-f7ba855e1f7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fixedColour", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"amplitude", ",", "sums", ",", "index", ",", "terms"}], "}"}], ",", 
     RowBox[{
      RowBox[{"amplitude", "=", 
       RowBox[{"expr", "/.", "\[VeryThinSpace]", 
        RowBox[{
         RowBox[{"SumOver", "[", 
          RowBox[{"_", ",", "_", ",", "External"}], "]"}], "\[Rule]", 
         "1"}]}]}], ";", 
      RowBox[{"sums", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"amplitude", ",", "_SumOver", ",", "\[Infinity]"}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"index", "=", 
          RowBox[{"First", "[", "sum", "]"}]}], ";", 
         RowBox[{"amplitude", "=", 
          RowBox[{"amplitude", "/.", "\[VeryThinSpace]", 
           RowBox[{"sum", "\[Rule]", "1"}]}]}], ";", 
         RowBox[{"terms", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Head", "[", 
              RowBox[{"Expand", "[", "amplitude", "]"}], "]"}], "===", 
             "Plus"}], ",", 
            RowBox[{"List", "@@", 
             RowBox[{"Expand", "[", "amplitude", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"Expand", "[", "amplitude", "]"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"terms", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"#1", ",", "index", ",", "\[Infinity]"}], "]"}], "===",
                 "2"}], "&"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", 
             "[", "\"\<Unexpected internal colour sum; stop and inspect the \
diagram.\>\"", "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"sum", ",", "sums"}], "}"}]}], "]"}], ";", 
      RowBox[{"SUNSimplify", "[", 
       RowBox[{"amplitude", ",", 
        RowBox[{"SUNNToCACF", "\[Rule]", "False"}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{"tensorDiagrams", "=", 
   RowBox[{
    RowBox[{"fixedColour", "/@", "tensorDiagrams"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"YangMillsCoupling", "\[Rule]", "gs"}], ",", 
      RowBox[{
       RowBox[{"SUNIndex", "[", "Glu1", "]"}], "\[Rule]", 
       RowBox[{"SUNIndex", "[", "a", "]"}]}], ",", 
      RowBox[{
       RowBox[{"SUNIndex", "[", "Glu2", "]"}], "\[Rule]", 
       RowBox[{"SUNIndex", "[", "b", "]"}]}], ",", 
      RowBox[{
       RowBox[{"SUNIndex", "[", "Glu3", "]"}], "\[Rule]", 
       RowBox[{"SUNIndex", "[", "c", "]"}]}]}], "}"}]}]}], ";", 
  RowBox[{"tensorAmplitude", "=", 
   FractionBox[
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"Total", "[", "tensorDiagrams", "]"}], "]"}], "\[ImaginaryI]"]}],
   ";", 
  RowBox[{"contactAmplitude", "=", 
   FractionBox[
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"Select", "[", 
       RowBox[{"tensorDiagrams", ",", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"#1", ",", "FeynAmpDenominator"}], "]"}], "&"}]}], "]"}], 
      "]"}], "]"}], "\[ImaginaryI]"]}], ";", 
  RowBox[{"colourFactor", "=", 
   RowBox[{"FCI", "[", 
    RowBox[{"SUNF", "[", 
     RowBox[{"a", ",", "b", ",", "c"}], "]"}], "]"}]}], ";"}]], "Input",
 CellTags->"colour",
 CellLabel->"In[7]:=",ExpressionUUID->"b1ec4528-2274-4efc-a06f-fa19dd4a353d"],

Cell["The native diagrams give i\[ScriptCapitalM]; division by I defines \
\[ScriptCapitalM] in the same convention as the preceding examples. No \
additional symmetry factor is inserted. Keeping tensorAmplitude before \
attaching physical polarisations is essential for the Ward checks below.", 
   "Text", ExpressionUUID -> "26950513-5516-4352-8bc4-e6561d318ebd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Calculate and present the physical amplitude", "Section", 
   ExpressionUUID -> "a82fd053-d2e5-481f-8e36-da34c77b0b61"],

Cell["Incoming gauge fields use \[CurlyEpsilon](p\:2081) and \
\[CurlyEpsilon](p\:2082); the outgoing gauge field uses \
\[CurlyEpsilon]*(p\:2083). The outgoing graviton uses the factorised \
conjugate tensor \[CurlyEpsilon]*\:1d45(p\:2084) \
\[CurlyEpsilon]*\:1d5d(p\:2084). The underlying graviton vector is transverse \
and null, so the tensor is transverse and traceless. This is a convenient \
family of states, not a complete D-dimensional polarisation basis. No D = 4 \
limit is taken. The labels I and \[Minus]I specify conjugation, not \
helicity.", "Text", ExpressionUUID -> 
    "8804bdd8-2de0-40f8-8938-2ccb8a633c13"],

