Notebook[{

Cell[CellGroupData[{
Cell["Yang\[Dash]Mills scattering with graviton emission", "Title", 
   ExpressionUUID -> "785c9c37-941b-4059-afc6-eced3353a88b"],

Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["A", "a"], "(", 
          SubscriptBox["p", "1"], ")", "+", SuperscriptBox["A", "b"], "(", 
          SubscriptBox["p", "2"], ")", "\[LongRightArrow]", 
          SuperscriptBox["A", "c"], "(", SubscriptBox["p", "3"], ")", "+", 
          "h", "(", SubscriptBox["p", "4"], ")"}], TraditionalForm]], 
      "InlineFormula"]}], "Text", ExpressionUUID -> 
    "775bf4ac-cbb0-4ba2-a894-20509074a195"],

Cell["Tree-level scattering of \
two massless SU(N) gauge fields into a gauge field and a graviton. This \
example isolates a mixed non-Abelian interaction: the amplitude is \
proportional to g\:209b \[Kappa] f\:1d43\:1d47\:1d9c and vanishes when \
g\:209b = 0. Start in a fresh kernel and evaluate from top to bottom. D and N \
stay symbolic in the initial calculation. The final section specialises \
the external states to four-dimensional helicities. No colour averages or \
cross sections are calculated. FeynCalc and patched FeynArts are sufficient; FORM is not \
needed.", "Text", ExpressionUUID -> "5e0021e2-abfa-48f0-942d-a1aac046e87d"],

Cell[CellGroupData[{

Cell["1. Load FeynGrav and the model", "Section", 
   ExpressionUUID -> "f9f74084-403f-4fc1-bef3-83e88cd17443"],

