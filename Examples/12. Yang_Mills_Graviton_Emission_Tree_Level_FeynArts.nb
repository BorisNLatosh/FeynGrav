     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", " ", "D"}], "]"}], ",", " ", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", " ", 
         RowBox[{"-", "I"}]}], "]"}], ",", " ", "D"}], "]"}]}], "]"}], " ", "=",
    " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", "h4", " ", "helicityScale"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
