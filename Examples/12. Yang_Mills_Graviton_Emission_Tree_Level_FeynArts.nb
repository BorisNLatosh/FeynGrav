Cell[CellGroupData[{

Cell["3. Fix the massless on-shell kinematics", "Section", 
   ExpressionUUID -> "1aa894d1-55f6-4a33-bfa6-929806152a6d"],

Cell["The momenta p\:2081 and p\:2082 are incoming; p\:2083 and p\:2084 are \
outgoing. Thus p\:2081 + p\:2082 = p\:2083 + p\:2084 and s + t + u = 0. \
SetMandelstam fixes momentum scalar products but does not remove p\:2084 from \
products with polarisation vectors. The helper below applies that \
conservation relation explicitly and uses s and t as the independent \
invariants.", "Text", ExpressionUUID -> 
    "d882bd41-2eaa-4f0a-be45-33bb4061f35b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";", 
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", 
    RowBox[{"-", "p3"}], ",", 
    RowBox[{"-", "p4"}], ",", "0", ",", "0", ",", "0", ",", "0"}], "]"}], ";", 
  RowBox[{
   RowBox[{"simplifyOnShell", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"stateRules_", ":", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Factor", "[", 
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ExpandScalarProduct", "[", 
        RowBox[{
         RowBox[{"Contract", "[", "expr", "]"}], "/.", "\[VeryThinSpace]", 
         RowBox[{
          RowBox[{"Momentum", "[", 
           RowBox[{"p4", ",", "D"}], "]"}], "\[Rule]", 
          RowBox[{"Momentum", "[", 
           RowBox[{
            RowBox[{"p1", "+", "p2", "-", "p3"}], ",", "D"}], "]"}]}]}], 
        "]"}], "/.", "\[VeryThinSpace]", "stateRules"}], "/.", 
      "\[VeryThinSpace]", 
      RowBox[{"u", "\[Rule]", 
       RowBox[{
        RowBox[{"-", "s"}], "-", "t"}]}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellTags->"kinematics",
 CellLabel->"In[5]:=",ExpressionUUID->"4630d9fb-450a-442a-96fe-e921a4c9a8a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Construct the tensor amplitude and retain its colour factor", 
   "Section", ExpressionUUID -> "37aa916e-789c-49cf-9913-066cdd16a429"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"CreateFeynAmp", "[", 
    RowBox[{"insertions", ",", 
     RowBox[{"Truncated", "\[Rule]", "True"}], ",", 
     RowBox[{"MomentumConservation", "\[Rule]", "True"}], ",", 
     RowBox[{"PreFactor", "\[Rule]", "1"}]}], "]"}]}], ";", 
  RowBox[{"tensorDiagrams", "=", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{"raw", ",", 
     RowBox[{"IncomingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
     RowBox[{"OutgoingMomenta", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
     RowBox[{"LorentzIndexNames", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\[Mu]", ",", "\[Nu]", ",", "\[Rho]", ",", "\[Alpha]", ",", 
        "\[Beta]"}], "}"}]}], ",", 
     RowBox[{"ChangeDimension", "\[Rule]", "D"}], ",", 
     RowBox[{"List", "\[Rule]", "True"}], ",", 
     RowBox[{"SMP", "\[Rule]", "False"}], ",", 
     RowBox[{"DropSumOver", "\[Rule]", "False"}]}], "]"}]}], ";"}]], "Input",
 CellTags->"convert",
 CellLabel->"In[6]:=",ExpressionUUID->"46b42d27-e937-4232-9c61-28ca89b3b440"],

Cell[CellGroupData[{

