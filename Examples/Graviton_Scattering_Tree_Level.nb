Cell[TextData[StyleBox["Here the gauge invariance is checked.\nGraviton lines \
with momenta p2, p3 and p4 and fixed on the mass shell.\nThe graviton line \
with momentum p1 is multiplied by the corresponding momentum.",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.8484553634124193`*^9, 3.848455376637023*^9}, {
   3.894592390203501*^9, 3.894592431348141*^9}, 
   3.8945926758354588`*^9},ExpressionUUID->"380ae119-ae7d-481d-b88e-\
8bfa17640418"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TheCompleteScatteringAmplitude", " ", "=", " ", 
    RowBox[{"Total", "[", 
     RowBox[{"\[ScriptCapitalM]s", "@@@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2", ",", "\[Mu]3",
           ",", "\[Nu]3", ",", "\[Mu]4", ",", "\[Nu]4", ",", "p1", ",", "p2", 
          ",", "p3", ",", "p4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]3", ",", "\[Nu]3", ",", "\[Mu]2",
           ",", "\[Nu]2", ",", "\[Mu]4", ",", "\[Nu]4", ",", "p1", ",", "p3", 
          ",", "p2", ",", "p4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]4", ",", "\[Nu]4", ",", "\[Mu]3",
           ",", "\[Nu]3", ",", "\[Mu]2", ",", "\[Nu]2", ",", "p1", ",", "p4", 
          ",", "p3", ",", "p2"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "//", 
  "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TheCompleteScatteringAmplitude", "+=", 
    RowBox[{"GravitonVertex", "[", 
     RowBox[{
     "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",", 
      "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", 
      "\[Nu]4", ",", "p4"}], "]"}]}], ";"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TheCompleteScatteringAmplitude", " ", "=", " ", 
    RowBox[{"TheCompleteScatteringAmplitude", " ", 
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"LorentzIndex", "[", 
        RowBox[{"\[Mu]1", ",", "D"}], "]"}], ",", 
       RowBox[{"Momentum", "[", 
        RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], 
     RowBox[{"PolarizationTensor", "[", 
      RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
     RowBox[{"PolarizationTensor", "[", 
      RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], 
     RowBox[{"ComplexConjugate", "[", 
      RowBox[{
       RowBox[{"PolarizationTensor", "[", 
        RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], 
       RowBox[{"PolarizationTensor", "[", 
        RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}]}], 
   ";"}], "//", "Timing"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"TheCompleteScatteringAmplitude", " ", "=", " ", 
    RowBox[{"Contract", "[", "TheCompleteScatteringAmplitude", "]"}]}], ";"}],
   "//", "Timing"}], "\n", 
 RowBox[{"Calc", "[", 
  RowBox[{
   RowBox[{"Simplify", "[", "TheCompleteScatteringAmplitude", "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1", "\[Rule]", 
      RowBox[{
       RowBox[{"-", "p2"}], "-", "p3", "-", "p4"}]}], ",", 
     RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], "]"}]}], "Input",
 Editable->False,
 CellChangeTimes->{{3.8484574502435203`*^9, 3.848457544852818*^9}, {
   3.8484575775399218`*^9, 3.848457614575933*^9}, 3.848457710491946*^9, 
   3.84845784145864*^9, 3.848457915671874*^9, {3.8484580960022573`*^9, 
