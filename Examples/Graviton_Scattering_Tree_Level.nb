    FractionBox[
     SuperscriptBox["\[Kappa]", "2"], "4"], 
    FractionBox[
     SuperscriptBox["t", "4"], 
     RowBox[{"s", " ", "t", " ", "u"}]]}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
