Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   RowBox[{"\[ImaginaryI]", " ", 
    FractionBox[
     SuperscriptBox["\[Kappa]", "2"], "4"], 
    FractionBox[
     SuperscriptBox["s", "4"], 
     RowBox[{"s", " ", "t", " ", "u"}]]}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   RowBox[{"\[ImaginaryI]", " ", 
    FractionBox[
     SuperscriptBox["\[Kappa]", "2"], "4"], 
    FractionBox[
     SuperscriptBox["u", "4"], 
     RowBox[{"s", " ", "t", " ", "u"}]]}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
