Cell[TextData[StyleBox["Here the gauge invariance is checked.\nGraviton lines \
with momenta p2, p3 and p4 and fixed on the mass shell.\nThe graviton line \
with momentum p1 is multiplied by the corresponding momentum.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.8484553634124193`*^9, 3.848455376637023*^9}, {
   3.894592390203501*^9, 3.894592431348141*^9}, 
   3.8945926758354588`*^9},ExpressionUUID->"380ae119-ae7d-481d-b88e-\
8bfa17640418"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"LorentzIndex", "[", 
         RowBox[{"\[Mu]1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{"p1", ",", "D"}], "]"}]}], "]"}], 
      RowBox[{"Pair", "[", 
       RowBox[{
        RowBox[{"LorentzIndex", "[", 
         RowBox[{"\[Nu]1", ",", "D"}], "]"}], ",", 
        RowBox[{"Momentum", "[", 
         RowBox[{
          RowBox[{"Polarization", "[", 
           RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
       "]"}], 
      RowBox[{"PolarizationTensor", "[", 
       RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
           "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}], "+", 
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]3", ",", "\[Nu]3", ",",
           "p3", ",", "\[Mu]2", ",", "\[Nu]2", ",", "p2", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}], "+", 
        RowBox[{"\[ScriptCapitalM]s", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]4", ",", "\[Nu]4", ",",
           "p4", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]2", ",", 
          "\[Nu]2", ",", "p2"}], "]"}], "+", 
        RowBox[{"GravitonVertex", "[", 
         RowBox[{
         "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
           "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",", 
          "\[Nu]4", ",", "p4"}], "]"}]}], ")"}], 
      RowBox[{"ComplexConjugate", "[", 
       RowBox[{
        RowBox[{"PolarizationTensor", "[", 
         RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], 
        RowBox[{"PolarizationTensor", "[", 
         RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
     "]"}], "==", "0"}], "//", "Simplify"}], "//", "Timing"}]], "Input",
 CellChangeTimes->{{3.999606770384042*^9, 3.9996068486534147`*^9}, {
   3.999606881450927*^9, 3.999606923811344*^9}, {3.999606955753955*^9, 
   3.999606975416645*^9}, 3.999607099208386*^9, {3.999607150074472*^9, 
   3.999607150499959*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"ebe845dc-7010-4d6a-9f78-9e3bb8c3530e"],

