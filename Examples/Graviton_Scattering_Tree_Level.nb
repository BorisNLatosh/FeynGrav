Cell["\<\
This is the amplitude for gravitons contact interaction evaluated on-shell.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{{3.848455222005123*^9, 3.848455235339254*^9}, {
  3.848455277784911*^9, 3.848455295699737*^9}},
 FontWeight->"Bold",ExpressionUUID->"37b8723b-f4e8-4705-a233-abaab94d3108"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AmplitudeContactInteraction", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Contract", "[", 
        RowBox[{
         RowBox[{"GravitonVertex", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", 
           ",", "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", 
           ",", "\[Nu]4", ",", "p4"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}], "\[IndentingNewLine]", "AmplitudeContactInteraction"}], "Input",\

 Editable->False,
 CellChangeTimes->{{3.894586718088767*^9, 3.894586749992611*^9}, {
  3.89458687743661*^9, 3.894586902469788*^9}, {3.8945869502856617`*^9, 
  3.894586955045238*^9}, {3.894587147330565*^9, 3.894587181059105*^9}, {
  3.894587251132522*^9, 3.894587355294403*^9}, {3.8945874352410383`*^9, 
  3.894587436359736*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"34036920-4765-4504-bb5e-84c556bfcf20"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"12.724039`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.924556991540621*^9, 3.982896240453422*^9, 
  3.98332850228811*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"6e0ab495-8b45-4612-9b61-fdb02bbd851c"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", "h1", " ", "h2", " ", "h3", " ", "h4", " ", 
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
       RowBox[{"h1", " ", "h2", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"h1", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h1", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h3", " ", "h4", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "3"], " ", "u"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "2"], " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"4", " ", "t", " ", 
        SuperscriptBox["u", "3"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["s", "3"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.924556991540621*^9, 3.982896240453422*^9, 
  3.983328502308715*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"a918b82c-cde2-4090-905f-bf6186058853"]
}, Open  ]],

Cell[TextData[StyleBox["The calculated amplitudes are compared with the \
expressions obtained in [Sannan, Phys.Rev.D 34 (1986) 1749].",
 FontWeight->"Bold"]], "Text",
 Editable->False,
 CellChangeTimes->{{3.848455311051856*^9, 3.848455334964941*^9}, {
  3.894592650385778*^9, 
  3.894592650856382*^9}},ExpressionUUID->"29f59ed8-87cd-48f2-a238-\
b026654e539b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TheCompleteAmplitude", " ", "=", " ", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
      "AmplitudeSChannel", "+", "AmplitudeTChannel", "+", "AmplitudeUChannel",
        "+", "AmplitudeContactInteraction"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}]], "Input",
 Editable->False,
