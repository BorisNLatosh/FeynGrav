Cell["\<\
This is the amplitude for gravitons contact interaction evaluated on-shell.\
\>", "Text",
 CellChangeTimes->{{3.848455222005123*^9, 3.848455235339254*^9}, {
  3.848455277784911*^9, 3.848455295699737*^9}},
 FontWeight->"Bold",ExpressionUUID->"37b8723b-f4e8-4705-a233-abaab94d3108"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AmplitudeContactInteraction", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"GravitonVertex", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}], "\[IndentingNewLine]", "AmplitudeContactInteraction"}], "Input",\

 CellChangeTimes->{{3.894586718088767*^9, 3.894586749992611*^9}, {
   3.89458687743661*^9, 3.894586902469788*^9}, {3.8945869502856617`*^9, 
   3.894586955045238*^9}, {3.894587147330565*^9, 3.894587181059105*^9}, {
   3.894587251132522*^9, 3.894587355294403*^9}, {3.8945874352410383`*^9, 
   3.894587436359736*^9}, 3.9996058753051043`*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"34036920-4765-4504-bb5e-84c556bfcf20"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"1.006346`", ",", "Null"}], "}"}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999606302461956*^9, 3.9996067429555817`*^9, 
  3.9996099315147038`*^9, 3.9996532660269003`*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"5a6afe27-8737-4625-9db9-0face4126473"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", "h1", " ", "h2", " ", "h3", " ", "h4", " ", 
        SuperscriptBox["s", "2"], " ", "t", " ", "u"}], "+", 
       RowBox[{"h1", " ", "h2", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"h1", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h1", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h3", " ", 
        SuperscriptBox["s", "3"], " ", "u"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h3", " ", "s", " ", 
        SuperscriptBox["u", "3"]}], "+", 
       RowBox[{"h2", " ", "h4", " ", 
        SuperscriptBox["s", "3"], " ", "t"}], "-", 
       RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"h3", " ", "h4", " ", 
        SuperscriptBox["s", "4"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "3"], " ", "u"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "2"], " ", 
        SuperscriptBox["u", "2"]}], "+", 
       RowBox[{"4", " ", "t", " ", 
        SuperscriptBox["u", "3"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
     SuperscriptBox["s", "3"]}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.999606302461956*^9, 3.9996067429555817`*^9, 
  3.9996099315147038`*^9, 3.9996532660383453`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"1260b5df-2ca1-4df9-ab0f-045cc4967f45"]
