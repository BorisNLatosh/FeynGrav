      RowBox[{"4", " ", "h2", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h2", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "-", 
      RowBox[{"4", " ", "h3", " ", "h4", " ", "s", " ", 
       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h3", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      SuperscriptBox["s", "4"], "+", 
      RowBox[{"4", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["u", "4"]}]}], ")"}]}], 
   RowBox[{"16", " ", 
    SuperscriptBox["s", "3"], " ", "u"}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.9996545406775303`*^9},
