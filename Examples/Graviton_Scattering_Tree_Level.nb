Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AmplitudeSChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Contract", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "\[Mu]2", ",", "\[Nu]2", ",", 
           "\[Mu]3", ",", "\[Nu]3", ",", "\[Mu]4", ",", "\[Nu]4", ",", "p1", 
           ",", "p2", ",", "p3", ",", "p4"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], "//",
   "Timing"}], "\[IndentingNewLine]", "AmplitudeSChannel"}], "Input",
 Editable->False,
 CellChangeTimes->{{3.894586718088767*^9, 3.894586749992611*^9}, {
