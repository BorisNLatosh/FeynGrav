      RowBox[{"2", " ", "h1", " ", "h3", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"h1", " ", "h4", " ", 
       SuperscriptBox["s", "4"]}], "+", 
      RowBox[{"2", " ", "h1", " ", "h4", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "+", 
      RowBox[{"h2", " ", "h3", " ", 
