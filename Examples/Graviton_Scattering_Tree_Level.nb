Cell[TextData[StyleBox["This is where the kinematics are defined. It is taken \
directly from [Sannan, Phys.Rev.D 34 (1986) 1749].",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.848455167849729*^9, 3.848455186570645*^9}, {
  3.894592601231505*^9, 
  3.894592602258154*^9}},ExpressionUUID->"dbf8d730-ca1a-4391-bddd-\
978d0527425c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", 
    "0", ",", "0", ",", "0", ",", "0"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p1", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";", 
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p2", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";", 
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p3", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";", 
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p4", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "]"}], ",", "D"}], "]"}]}], "]"}], 
   "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p1", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", 
   FractionBox[
    RowBox[{"1", "+", 
     RowBox[{"h1", " ", "h2"}]}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p3", ",", 
