     SuperscriptBox["t", "4"]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"s", " ", "t", " ", "u"}], ")"}]}]]}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.0000907214424267`*^9, 4.000091109801079*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"825364ad-d7f3-45ee-a3c9-7be84880c8cb"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
