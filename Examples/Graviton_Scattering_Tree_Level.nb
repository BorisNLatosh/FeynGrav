      RowBox[{"t", " ", "u"}], 
      RowBox[{"2", " ", "s"}]]]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[22]:=",ExpressionUUID->"6cb0cb0a-9860-433d-8daf-0f2660ce20af"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p4", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p2", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{"-", "h2"}], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{"t", " ", "u"}], 
      RowBox[{"2", " ", "s"}]]]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[23]:=",ExpressionUUID->"ff5150aa-869f-4d51-a0fe-01a0f15ec0e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["h1", "2"], "\[Equal]", 
     SuperscriptBox["h2", "2"], "\[Equal]", 
     SuperscriptBox["h3", "2"], "\[Equal]", 
     SuperscriptBox["h4", "2"], "\[Equal]", "1"}], "&&", 
    RowBox[{
     RowBox[{"s", "+", "t", "+", "u"}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s", "|", "t", "|", "u"}], ")"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}]}]}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[24]:=",ExpressionUUID->"ade1fd0e-bb4b-4126-9a1c-7847bbc422a4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Evaluate the four contributions", "Section",ExpressionUUID->"07648bf7-8678-44b8-bf4e-778b22be41b4"],

Cell["\<\
First contract the exchange tensor with the incoming polarisation tensors and \
the conjugated outgoing tensors. Simplify and TrickMandelstam then reduce its \
invariant dependence. Individual channels need not be gauge invariant.\
\>", "Text",ExpressionUUID->"300e9707-e481-4ea5-824b-1f0019208724"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeSChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], " ", 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[25]:=",ExpressionUUID->"00ff6f92-e9a8-4fd7-82a9-5641dfcb696c"],

Cell[BoxData["AmplitudeSChannel"], "Input",
 InitializationCell->False,
 CellLabel->"In[26]:=",ExpressionUUID->"ed67beb0-6192-4f7f-be00-21c5191f6b65"],

Cell[CellGroupData[{

Cell["t-channel exchange", "Subsection",ExpressionUUID->"a053c2fe-5e82-4adb-a4e6-08b249a6594d"],

Cell["\<\
Obtain this channel by exchanging the second and third external triples in \
the reusable exchange tensor.\
\>", "Text",ExpressionUUID->"84e39412-6fa9-4ae0-b358-02fee7f739ed"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeTChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]3", ",", "\[Nu]3", ",",
            "p3", ",", "\[Mu]2", ",", "\[Nu]2", ",", "p2", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], " ", 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[27]:=",ExpressionUUID->"31f3a66e-a5a0-467a-9ace-41c1682ffee6"],

Cell[BoxData["AmplitudeTChannel"], "Input",
 InitializationCell->False,
 CellLabel->"In[28]:=",ExpressionUUID->"857dd199-9ca7-486a-8090-6b73a33fc85e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["u-channel exchange", "Subsection",ExpressionUUID->"467142a1-b63b-4210-bd67-ea1eeb218ec1"],

Cell["\<\
Exchange the second and fourth triples. The polarisation tensors remain \
attached to their original external legs.\
\>", "Text",ExpressionUUID->"d599ba60-9dc3-4fc5-bf74-72ce70bca1a7"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeUChannel", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalM]s", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]4", ",", "\[Nu]4", ",",
            "p4", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]2", ",",
            "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], " ", 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[29]:=",ExpressionUUID->"adcaedf4-e5a2-49b0-9972-f9b1b6415f53"],

Cell[BoxData["AmplitudeUChannel"], "Input",
 InitializationCell->False,
 CellLabel->"In[30]:=",ExpressionUUID->"6cbbfed4-12e0-4f0d-a91a-d148e3bec026"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Four-graviton contact interaction", "Subsection",ExpressionUUID->"bacaa403-18e6-47f6-9f71-18187a10fc91"],

Cell["\<\
GravitonVertex with four triples is the contact interaction. It is required \
together with all three exchange channels.\
\>", "Text",ExpressionUUID->"a433145d-70db-4c70-91db-260d10f69dc1"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"AmplitudeContactInteraction", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"CalcFormCalculate", "[", 
        RowBox[{
         RowBox[{"GravitonVertex", "[", 
          RowBox[{
          "\[Mu]1", ",", "\[Nu]1", ",", "p1", ",", "\[Mu]2", ",", "\[Nu]2", ",",
            "p2", ",", "\[Mu]3", ",", "\[Nu]3", ",", "p3", ",", "\[Mu]4", ",",
            "\[Nu]4", ",", "p4"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]1", ",", "\[Nu]1", ",", "p1"}], "]"}], " ", 
         RowBox[{"PolarizationTensor", "[", 
          RowBox[{"\[Mu]2", ",", "\[Nu]2", ",", "p2"}], "]"}], " ", 
         RowBox[{"ComplexConjugate", "[", 
          RowBox[{
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]3", ",", "\[Nu]3", ",", "p3"}], "]"}], " ", 
           RowBox[{"PolarizationTensor", "[", 
            RowBox[{"\[Mu]4", ",", "\[Nu]4", ",", "p4"}], "]"}]}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[31]:=",ExpressionUUID->"7cb2f8bb-99fb-4d8c-9cc5-d7bb1986f34b"],

Cell[BoxData["AmplitudeContactInteraction"], "Input",
 InitializationCell->False,
 CellLabel->"In[32]:=",ExpressionUUID->"48057723-6254-4ec6-b369-1b1ebf810329"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Sum and check helicity amplitudes", "Section",ExpressionUUID->"a6fb60d7-9cbe-40da-ae78-22d8a2ae4e17"],

Cell["\<\
The comparisons below use the four-dimensional expressions quoted in Sannan, \
Phys. Rev. D 34 (1986) 1749. A True result confirms each displayed comparison \
in the stated convention; it is not an independent derivation of the \
reference formula.\
\>", "Text",ExpressionUUID->"d2a1f4d6-9717-4075-9983-fa03e5defaf9"],

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"TheCompleteAmplitude", "=", 
    RowBox[{"TrickMandelstam", "[", 
     RowBox[{
      RowBox[{
      "AmplitudeSChannel", "+", "AmplitudeTChannel", "+", "AmplitudeUChannel",
        "+", "AmplitudeContactInteraction"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "]"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[33]:=",ExpressionUUID->"615ffb9b-a546-49cc-936e-ffbc20c8e587"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     SuperscriptBox["s", "4"]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"s", " ", "t", " ", "u"}], ")"}]}]]}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.0000907131118402`*^9, 4.0000911058483343`*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"34f23adb-834f-4078-824e-360ebe48c4c9"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     SuperscriptBox["u", "4"]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"s", " ", "t", " ", "u"}], ")"}]}]]}], "]"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{4.000090716608589*^9, 4.0000911081185913`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"612cf7ac-6672-4d9c-8897-0bf920af11e6"],

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"TrickMandelstam", "[", 
    RowBox[{
     RowBox[{"TheCompleteAmplitude", "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"h1", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"h2", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h3", "\[Rule]", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"h4", "\[Rule]", 
         RowBox[{"+", "1"}]}], ",", 
        RowBox[{"D", "\[Rule]", "4"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "t", ",", "u", ",", "0"}], "}"}]}], "]"}], "\[Equal]", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
