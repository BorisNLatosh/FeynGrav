       SuperscriptBox["t", "2"], " ", "u"}], "-", 
      RowBox[{"2", " ", "h3", " ", "h4", " ", "s", " ", "t", " ", 
       SuperscriptBox["u", "2"]}], "+", 
      SuperscriptBox["s", "4"], "+", 
      RowBox[{"4", " ", "s", " ", 
       SuperscriptBox["u", "3"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["u", "4"]}]}], ")"}]}], 
   RowBox[{"16", " ", 
    SuperscriptBox["s", "3"], " ", "u"}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.924556968547131*^9, 3.982896227933669*^9, 
