Cell["\<\
This tests the combined operator after replacing one external index by p and \
contracting the other with a transverse polarisation vector. The following \
cell imposes p\[CenterDot]\[CurlyEpsilon](p)=0 explicitly, then clears the \
scalar-product definitions.\
\>", "Text",ExpressionUUID->"36bca8ed-ce75-45fe-a643-4d84f5aa033a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pair", "[", 
    RowBox[{
     RowBox[{"Momentum", "[", 
      RowBox[{"p", ",", "D"}], "]"}], ",", 
     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[26]:=",ExpressionUUID->"4614b99b-2cf3-458e-be9f-37095b990b2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Contract", "[", 
   RowBox[{
    RowBox[{"GluonPolarizationOperator", "[", 
     RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], "]"}], " ", 
    RowBox[{"FVD", "[", 
     RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
    RowBox[{"Pair", "[", 
     RowBox[{
      RowBox[{"Momentum", "[", 
       RowBox[{
        RowBox[{"Polarization", "[", 
         RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
      RowBox[{"LorentzIndex", "[", 
       RowBox[{"\[Nu]", ",", "D"}], "]"}]}], "]"}]}], "]"}], "==", 
  "0"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100787889319*^9, 4.000100851804347*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"7d4e3052-9e3b-4217-a7f7-bb7451e2336d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[28]:=",ExpressionUUID->"9b33a60d-40eb-4c9a-98d9-f074e4b6caaf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Display or compare the result", "Subsection",ExpressionUUID->"f1164294-0a51-49c3-a45c-2a800fc2b553"],

Cell["\<\
The four-dimensional coefficient expression retains unevaluated scalar loop \
integrals. A True comparison confirms the written reference in this gauge; it \
does not perform UV renormalisation.\
\>", "Text",ExpressionUUID->"4a556eff-7f98-42f6-a1f9-387790a0d8fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gluonComputed", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"GluonPolarizationOperator", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "a", ",", "b", ",", "p"}], "]"}], "/.",
      "\[VeryThinSpace]", 
     RowBox[{"D", "\[Rule]", "4"}]}], "//", "FeynAmpDenominatorExplicit"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100895192646*^9, 4.0001009067272587`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"7b62460d-c15d-457f-a913-7a127db18d7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gluonComputed", "==", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FeynAmpDenominatorExplicit", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "6"]}], " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], " ", 
       SuperscriptBox[
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}], "2"], " ", 
       RowBox[{"SUNDelta", "[", 
        RowBox[{"a", ",", "b"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"GaugeProjector", "[", 
          RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], "+", 
         FractionBox[
          RowBox[{"15", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"FV", "[", 
              RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
             RowBox[{"FV", "[", 
              RowBox[{"p", ",", "\[Nu]"}], "]"}]}], ")"}]}], 
          RowBox[{"SP", "[", 
           RowBox[{"p", ",", "p"}], "]"}]]}], ")"}]}], "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"D", "\[Rule]", "4"}]}], ")"}]}], "//", "Simplify"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100868313142*^9, 4.000100912909103*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"e859e6a3-ff14-430a-b705-ee6de35704b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quark self-energy", "Subsection",ExpressionUUID->"74e49210-86bb-46ba-aa0b-5a9bc7ce76af"],

Cell["\<\
The SU(N) library was loaded in setup. SUNDelta retains the external colour \
structure; the quark example takes the massless limit.\
\>", "Text",ExpressionUUID->"54666aa6-4798-440a-9204-e4b0e1991085"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tadpole", "Subsection",ExpressionUUID->"d7e1cd7d-ac14-4717-9d46-6617cf8d8a76"],

Cell["\<\
Close the two graviton legs of the contact vertex with one graviton \
propagator. The massless gravitational tadpole is scaleless in dimensional \
regularisation.\
\>", "Text",ExpressionUUID->"17ad1ad6-a276-4dfd-b490-9df5722df4dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator1", "[", "p_", "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Explicit", "[", 
      RowBox[{
       RowBox[{"GravitonFermionVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\[Mu]", ",", "\[Nu]", ",", "k", ",", "\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
         RowBox[{"-", "p"}], ",", "0"}], "]"}], " ", 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
        "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100933935049*^9, 4.000100942542705*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"733b4448-366d-49dc-8911-a1ff2a9cb2c9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",ExpressionUUID->"997759e6-7d1c-4613-beab-762ea24544b1"],

Cell["\<\
Join two three-point vertices with a graviton and a matter propagator. Dirac \
products use Dot; do not replace them by ordinary multiplication. \
GravitonFermionVertex takes graviton triples {index, index, incoming \
momentum}; include these momenta even when older examples list only the \
indices.\
\>", "Text",ExpressionUUID->"99ed15ab-3d83-498a-b8f2-f43809b06f06"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator2", "[", "p_", "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Explicit", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"GravitonFermionVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", 
            RowBox[{"-", "k"}]}], "}"}], ",", "p", ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"p", "-", "k"}], ")"}]}], ",", "0"}], "]"}], ".", 
        RowBox[{"QuarkPropagator", "[", 
         RowBox[{"p", "-", "k"}], "]"}], ".", 
        RowBox[{"GravitonFermionVertex", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "k"}], "}"}], ",", 
          RowBox[{"p", "-", "k"}], ",", 
          RowBox[{"-", "p"}], ",", "0"}], "]"}]}], " ", 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
        "]"}]}], "]"}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0001009527367363`*^9, 4.000100966308982*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"b1d67470-8abf-4f99-b0c6-645cac5cb94e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combined operator", "Subsection",ExpressionUUID->"8f81bb88-aea7-45ce-9444-eec1866b8c1d"],

Cell["\<\
Add the stored tadpole and bubble terms and collect their scalar master \
integrals.\
\>", "Text",ExpressionUUID->"f8072cd6-aedd-4faf-aa04-3596ba491940"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"QuarkPolarizationOperator", "[", "p_", "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"QuarkPolarizationOperator1", "[", "p", "]"}], "+", 
      RowBox[{"QuarkPolarizationOperator2", "[", "p", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", "Factor"}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[33]:=",ExpressionUUID->"14d7642a-bacb-4b1c-b800-cb8dbc0cc2cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Display or compare the result", "Subsection",ExpressionUUID->"3d5bd24a-764c-47f7-aa3e-6f7528fd9234"],

Cell["\<\
The four-dimensional coefficient expression retains unevaluated scalar loop \
integrals. A True comparison confirms the written reference in this gauge; it \
does not perform UV renormalisation.\
\>", "Text",ExpressionUUID->"de22132e-2f3b-4181-9a7f-6f83ac69dab8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QuarkPolarizationOperator", "[", "p", "]"}], "/.", 
  "\[VeryThinSpace]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"D", "\[Rule]", "4"}], ",", 
    RowBox[{"GaugeFixingEpsilon", "\[Rule]", "2"}]}], "}"}]}]], "Input",
 InitializationCell->False,
 CellLabel->"In[34]:=",ExpressionUUID->"54a562aa-1d43-4870-af2f-ef2e674c9ddf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to adapt this example", "Section",ExpressionUUID->"75d49a56-6acc-46d2-a783-3e92d9a00b99"],

Cell["\<\
Change one ingredient at a time: a mass, a momentum assignment, or a vertex \
order. Restart the kernel before rerunning with different kinematics, because \
scalar-product definitions and assumptions persist in the session. \
Re-evaluate all dependent cells after a change. Inspect the stored \
intermediate expressions if a comparison is False or remains unevaluated; do \
not treat an unresolved expression as a passed check.\
\>", "Text",ExpressionUUID->"12c98604-4b63-4324-b090-d6c04ca4ca6e"]
}, Open  ]]
}, Open  ]]
},
