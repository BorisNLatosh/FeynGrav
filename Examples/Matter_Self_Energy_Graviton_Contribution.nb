     RowBox[{"VectorPolarizationOperator", "[", 
      RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], " ", 
     RowBox[{"FVD", "[", 
      RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
     RowBox[{"Pair", "[", 
      RowBox[{
       RowBox[{"Momentum", "[", 
        RowBox[{
         RowBox[{"Polarization", "[", 
          RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}], ",", 
       
       RowBox[{"LorentzIndex", "[", 
