Cell[CellGroupData[{

Cell["Display or compare the result", "Subsection",ExpressionUUID->"e4db4035-0f35-482b-ab06-f2bfc52e0a85"],

Cell["Expand the computed operator first and apply the same D -> 4 and GaugeFixingEpsilon -> 2 substitutions to both sides. FORM contracts the tensor difference; Simplify combines its scalar coefficients. True confirms this reference in the stated gauge. The master integrals remain unevaluated.", "Text",ExpressionUUID->"bc805626-2bf1-4ecd-8633-1d1abec3fd3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"vectorComputed", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{"VectorPolarizationOperator", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}], "]"}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"D", "\[Rule]", "4"}], ",", 
      RowBox[{"GaugeFixingEpsilon", "\[Rule]", "2"}]}], "}"}]}]}], ";", 
  RowBox[{"vectorReference", "=", 
   RowBox[{
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{"Explicit", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox["\[Kappa]", "2"], " ", 
       RowBox[{"B0", "[", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", "0"}], "]"}], " ", 
       SuperscriptBox[
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          FractionBox["1", "6"], " ", 
          RowBox[{"GaugeProjector", "[", 
           RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}]}], "+", 
         FractionBox[
          RowBox[{"5", " ", 
           RowBox[{"FV", "[", 
            RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
           RowBox[{"FV", "[", 
            RowBox[{"p", ",", "\[Nu]"}], "]"}]}], 
          RowBox[{"2", " ", 
           RowBox[{"SP", "[", 
            RowBox[{"p", ",", "p"}], "]"}]}]]}], ")"}]}], "]"}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"D", "\[Rule]", "4"}], ",", 
      RowBox[{"GaugeFixingEpsilon", "\[Rule]", "2"}]}], "}"}]}]}], ";", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"CalcFormCalculate", "[", 
     RowBox[{"vectorComputed", "-", "vectorReference"}], "]"}], "]"}], "\[Equal]",
    "0"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"fa10814b-2cb6-4edf-a629-535bad1e3f3b"]
}, Open  ]]
}, Open  ]],

