Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GluonPolarizationOperator2", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "a_", ",", "b_", ",", "p_"}], "]"}],
    "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{"Contract", "[", 
