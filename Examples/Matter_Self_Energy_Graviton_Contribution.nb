Cell[CellGroupData[{

Cell["Combined operator", "Subsection",ExpressionUUID->"616b9f45-571f-4cec-98d1-9a7bc4344e3b"],

Cell["\<\
Add the stored tadpole and bubble terms and collect their scalar master \
integrals.\
\>", "Text",ExpressionUUID->"52cbc03b-8873-45fa-8bd2-0f26f4382b8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ProcaPolarizationOperator", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_", ",", "m_"}], "]"}], "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ProcaPolarizationOperator1", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}], "+", 
      RowBox[{"ProcaPolarizationOperator2", "[", 
       RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A0", "[", "__", "]"}], ",", 
       RowBox[{"B0", "[", "__", "]"}], ",", 
       RowBox[{"C0", "[", "__", "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#1", ",", "m", ",", "Factor"}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100417639195*^9, 4.000100423020043*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"5500f282-9c6d-4f02-8193-5edd18958cfb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Display or compare the result", "Subsection",ExpressionUUID->"5c7f53e6-3b45-4043-8cbb-187c8c4534ae"],

Cell["\<\
The four-dimensional coefficient expression retains unevaluated scalar loop \
integrals. A True comparison confirms the written reference in this gauge; it \
does not perform UV renormalisation.\
\>", "Text",ExpressionUUID->"dffb1432-67c4-4505-8a98-12f4f5fa9210"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"FeynAmpDenominatorExplicit", "[", 
       RowBox[{"ProcaPolarizationOperator", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p", ",", "m"}], "]"}], "]"}], "/.",
       "\[VeryThinSpace]", 
      RowBox[{"D", "\[Rule]", "4"}]}], ")"}], "\[Equal]", 
    RowBox[{"FeynAmpDenominatorExplicit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "6"]}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}], "2"], "+", 
            RowBox[{
             SuperscriptBox["m", "2"], " ", 
             RowBox[{"SP", "[", 
              RowBox[{"p", ",", "p"}], "]"}]}], "+", 
            SuperscriptBox["m", "4"]}], ")"}], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"B0", "[", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", 
            SuperscriptBox["m", "2"]}], "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "6"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], "-", 
            RowBox[{"8", " ", 
             SuperscriptBox["m", "2"]}]}], ")"}], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"A0", "[", 
           SuperscriptBox["m", "2"], "]"}]}]}], ")"}], " ", 
       RowBox[{"GaugeProjector", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "p"}], "]"}]}], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", " ", 
          SuperscriptBox["m", "4"], " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Pi]", "2"], " ", 
          SuperscriptBox["\[Kappa]", "2"], " ", 
          RowBox[{"B0", "[", 
           RowBox[{
            RowBox[{"SP", "[", 
             RowBox[{"p", ",", "p"}], "]"}], ",", "0", ",", 
            SuperscriptBox["m", "2"]}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Mu]"}], "]"}], " ", 
          RowBox[{"FV", "[", 
           RowBox[{"p", ",", "\[Nu]"}], "]"}]}], ")"}]}], 
       RowBox[{"2", " ", 
        RowBox[{"SP", "[", 
         RowBox[{"p", ",", "p"}], "]"}]}]]}], "]"}]}], "/.", 
   "\[VeryThinSpace]", 
   RowBox[{"D", "\[Rule]", "4"}]}], "//", "CalcFormCalculate"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.0001004283568153`*^9, 4.00010045369446*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e6d8dd43-b48b-487b-bf6f-00d6ffac3e83"]
}, Open  ]]
}, Open  ]],

