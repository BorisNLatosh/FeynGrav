Cell[CellGroupData[{

Cell["Tadpole", "Subsection",ExpressionUUID->"a3d0e403-690c-482b-81a3-3fef821cad2c"],

Cell["\<\
Close the two graviton legs of the contact vertex with one graviton \
propagator. The massless gravitational tadpole is scaleless in dimensional \
regularisation.\
\>", "Text",ExpressionUUID->"91787ca9-f724-4ca2-9020-1c3d1ec94030"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorPolarizationOperator1", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"GravitonVectorVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", "\[Sigma]", ",", 
          RowBox[{"-", "k"}], ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}], 
         "}"}], ",", "\[Mu]", ",", "p", ",", "\[Nu]", ",", 
        RowBox[{"-", "p"}]}], "]"}], " ", 
      RowBox[{"GravitonPropagator", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Sigma]", ",", "\[Alpha]", ",", "\[Beta]", ",", "k"}],
        "]"}]}], ",", "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100465081532*^9, 4.0001005050623302`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"e71e5702-e25a-4f59-8360-4ec9140ad2f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bubble", "Subsection",ExpressionUUID->"9970f609-6278-4ea9-b25b-35f09fc92fbf"],

Cell["\<\
Join two three-point vertices with a graviton and a matter propagator. Dirac \
products use Dot; do not replace them by ordinary multiplication. \
GravitonFermionVertex takes graviton triples {index, index, incoming \
momentum}; include these momenta even when older examples list only the \
indices.\
\>", "Text",ExpressionUUID->"95d93d12-eeec-4bad-9537-7df1c08b9b43"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VectorPolarizationOperator2", "[", 
    RowBox[{"\[Mu]_", ",", "\[Nu]_", ",", "p_"}], "]"}], "=", 
   RowBox[{"TID", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GravitonVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"-", "k"}]}], "}"}], ",", "\[Mu]", ",", "p", ",", 
         "\[Sigma]1", ",", 
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{"p", "-", "k"}], ")"}]}]}], "]"}], " ", 
       RowBox[{"GravitonVectorVertex", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "\[Sigma]", ",", "k"}], "}"}], ",", 
         "\[Sigma]2", ",", 
         RowBox[{"p", "-", "k"}], ",", "\[Nu]", ",", 
         RowBox[{"-", "p"}]}], "]"}], " ", 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{
        "\[Alpha]", ",", "\[Beta]", ",", "\[Rho]", ",", "\[Sigma]", ",", 
         "k"}], "]"}], " ", 
       RowBox[{"GluonPropagator", "[", 
        RowBox[{
         RowBox[{"p", "-", "k"}], ",", 
         RowBox[{"{", "\[Sigma]1", "}"}], ",", 
         RowBox[{"{", "\[Sigma]2", "}"}]}], "]"}]}], "//", "Explicit"}], ",", 
     "k", ",", 
     RowBox[{"ToPaVe", "\[Rule]", "True"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->False,
 CellChangeTimes->{{4.000100471991089*^9, 4.000100476151182*^9}, {
  4.000100509468227*^9, 4.000100532998728*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"76e47c62-8945-4491-b93b-aa60178daa3f"]
}, Open  ]],

