     RowBox[{"Momentum", "[", 
      RowBox[{
       RowBox[{"Polarization", "[", 
        RowBox[{"p", ",", "\[ImaginaryI]"}], "]"}], ",", "D"}], "]"}]}], 
    "]"}], "=", "0"}], ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[19]:=",ExpressionUUID->"717a7967-6cdc-42f2-aa2c-cf13f3198472"],

Cell[BoxData[
 RowBox[{
