Cell["\<\
This notebook requires FORM on the kernel\[CloseCurlyQuote]s PATH. \
FeynGravSimplify performs bosonic algebra and Lorentz contractions; TFORM is \
used automatically when available. FeynCalc handles loop reduction and any \
Dirac or colour algebra before the bosonic coefficients are sent to FORM.\
\>", "Text",
 Editable->False,
 CellChangeTimes->{
  4.000101086781893*^9},ExpressionUUID->"4a8d65e3-6ce6-4c02-87ff-\
e16879c1c9ec"],

Cell["\<\
FeynGrav supplies the vertex and propagator normalisations, including i and \
\[Kappa]. The default gravitational gauge parameter is GaugeFixingEpsilon = \
2. The displayed diagram weights are retained from the original example; the \
notebook does not derive their combinatorics.\
\>", "Text",
 Editable->False,ExpressionUUID->"1633e35a-7106-4b20-bb85-7f917f324481"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Fix the external kinematics", "Section",
 Editable->False,ExpressionUUID->"9bc80cca-f19c-4ecd-b9f6-2a8b989c053a"],

Cell["\<\
SetMandelstam uses all-incoming momenta: p1 + p2 + p3 + p4 = 0. Physical \
outgoing momenta are -p3 and -p4. The masses are {m1, m2, m1, m2}; s + t + u \
= 2 m1\.b2 + 2 m2\.b2.\
\>", "Text",
 Editable->False,ExpressionUUID->"01620e23-85a0-4523-8004-63427842b0cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{
   "s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", "p3", ",", "p4", ",", 
    "m1", ",", "m2", ",", "m1", ",", "m2"}], "]"}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[2]:=",ExpressionUUID->"f7febe59-e156-4048-a991-f1fb6e574b20"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Construct the exchange amplitude", "Section",
 Editable->False,ExpressionUUID->"599f55d5-4f28-4795-8e57-81577b5f7fe4"],

Cell["\<\
Each GravitonScalarVertex has an index pair, two incoming scalar momenta and \
a mass. Join the vertices with a graviton propagator carrying p1 + p3, the \
t-channel momentum. The amplitude retains the factors of i in the Feynman \
rules.\
\>", "Text",
 Editable->False,ExpressionUUID->"7c78b6f2-b5a5-4d26-af16-207e131b8cc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[ScriptCapitalM]", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"FeynGravSimplify", "[", 
     RowBox[{
      RowBox[{"GravitonScalarVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "\[Nu]"}], "}"}], ",", "p1", ",", "p3", ",", 
        "m1"}], "]"}], " ", 
      RowBox[{"FeynAmpDenominatorExplicit", "[", 
       RowBox[{"GravitonPropagator", "[", 
        RowBox[{"\[Mu]", ",", "\[Nu]", ",", "\[Alpha]", ",", "\[Beta]", ",", 
         RowBox[{"p1", "+", "p3"}]}], "]"}], "]"}], " ", 
      RowBox[{"GravitonScalarVertex", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "p2", ",", "p4", ",",
         "m2"}], "]"}]}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"u", "\[Rule]", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["m1", "2"], "+", 
         SuperscriptBox["m2", "2"]}], ")"}]}], "-", "s", "-", "t"}]}]}], 
   "]"}]}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[3]:=",ExpressionUUID->"94425197-bc9f-4ad2-99e3-3f0e012cea09"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[Kappa]", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"D", "-", "2"}], ")"}], " ", 
        SuperscriptBox["m1", "4"]}], "+", 
       RowBox[{
        SuperscriptBox["m1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"D", "-", "4"}], ")"}], " ", 
           SuperscriptBox["m2", "2"]}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"D", "-", "2"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "s"}], "+", "t"}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"D", "-", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m2", "2"], "-", "s"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["m2", "2"], "-", "s", "-", "t"}], ")"}]}]}], ")"}]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"D", "-", "2"}], ")"}], " ", "t"}]]}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{4.00157320533152*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"fc3b0f20-0e0d-42d1-96b0-302a40510aa2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Convert to center-of-mass variables", "Section",
 Editable->False,ExpressionUUID->"a6cb08aa-8fa6-4f4f-8a70-574997efe030"],

Cell["\<\
p is now the positive magnitude of the three-momentum, rather than a \
four-vector. \[Theta] is the scattering angle; m1 and m2 are positive. These \
assumptions are local to this fresh-kernel example.\
\>", "Text",
 Editable->False,ExpressionUUID->"1e7c1bf8-9ba7-4e0f-a79f-3b2dff7548f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"m1", ">", "0"}], "&&", 
    RowBox[{"m2", ">", "0"}], "&&", 
    RowBox[{"p", ">", "0"}], "&&", 
    RowBox[{"0", "<", "\[Theta]", "<", "\[Pi]"}]}]}], ";"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[4]:=",ExpressionUUID->"7a60ef80-165f-4903-9cb3-daf9f3b360ed"],

Cell[CellGroupData[{

Cell["Phase space and incoming flux", "Subsection",
 Editable->False,ExpressionUUID->"645a3519-c24d-4091-9ea9-2cd4ccca2c9a"],

Cell["\<\
Integrate the final radial momentum k using the energy-conserving delta \
function, retaining the solid angle. The result is \
d\[Sigma]/d\[CapitalOmega], not an angle-integrated total cross section. The \
forward gravitational singularity at \[Theta] = 0 is excluded by the \
assumptions. This symbolic integration may take longer than the amplitude \
contraction.\
\>", "Text",
 Editable->False,ExpressionUUID->"6ce5b74d-09a8-48a9-b5dc-219ad4234f19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{
   RowBox[{"differentialCrossSection", "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox["m1", "2"], "+", 
           SuperscriptBox["p", "2"]}]], " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["m2", "2"], "+", 
           SuperscriptBox["p", "2"]}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"DiracDelta", "[", 
             RowBox[{
              SqrtBox[
               RowBox[{
                SuperscriptBox["m1", "2"], "+", 
                SuperscriptBox["p", "2"]}]], "+", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["m2", "2"], "+", 
                SuperscriptBox["p", "2"]}]], "-", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["m1", "2"], "+", 
                SuperscriptBox["k", "2"]}]], "-", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["m2", "2"], "+", 
                SuperscriptBox["k", "2"]}]]}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"2", " ", "\[Pi]"}], ")"}], "4"], " ", 
            SuperscriptBox["k", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["1", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"2", " ", "\[Pi]"}], ")"}], "3"]], ")"}], "2"]}], 
           RowBox[{"16", " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["m1", "2"], "+", 
              SuperscriptBox["p", "2"]}]], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["m2", "2"], "+", 
              SuperscriptBox["p", "2"]}]], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["m1", "2"], "+", 
              SuperscriptBox["k", "2"]}]], " ", 
            SqrtBox[
             RowBox[{
              SuperscriptBox["m2", "2"], "+", 
              SuperscriptBox["k", "2"]}]]}]], 
          RowBox[{"\[DifferentialD]", "k"}]}]}], ")"}], " ", 
       RowBox[{"ComplexConjugate", "[", "\[ScriptCapitalM]", "]"}], " ", 
       "\[ScriptCapitalM]"}], 
      SqrtBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["m1", "2"]}], " ", 
         SuperscriptBox["m2", "2"]}], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["p", "2"], "+", 
           SqrtBox[
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m1", "2"], "+", 
               SuperscriptBox["p", "2"]}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m2", "2"], "+", 
               SuperscriptBox["p", "2"]}], ")"}]}]]}], ")"}], "2"]}]]], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "\[Rule]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SqrtBox[
            RowBox[{
             SuperscriptBox["m1", "2"], "+", 
             SuperscriptBox["p", "2"]}]], "+", 
           SqrtBox[
            RowBox[{
             SuperscriptBox["m2", "2"], "+", 
             SuperscriptBox["p", "2"]}]]}], ")"}], "2"]}], ",", 
       RowBox[{"t", "\[Rule]", 
        RowBox[{
         RowBox[{"-", "4"}], " ", 
         SuperscriptBox["p", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Theta]", "2"], "]"}], "2"]}]}], ",", 
       RowBox[{"D", "\[Rule]", "4"}], ",", 
       RowBox[{"\[Kappa]", "\[Rule]", 
        SqrtBox[
         RowBox[{"32", " ", "\[Pi]", " ", "G"}]]}]}], "}"}]}]}], ";"}], 
  "]"}]], "Input",
 Editable->False,
 InitializationCell->False,
 CellLabel->"In[5]:=",ExpressionUUID->"6a336cdb-d961-40ec-b731-1701740422b1"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
