Cell[CellGroupData[{

Cell["5. Check the nonrelativistic limit", "Section",ExpressionUUID->"f7d327e3-4060-40bc-a9c0-bd176427e62a"],

Cell["\<\
The leading p \[RightArrow] 0 term is compared with the gravitational \
Rutherford expression. The equality should evaluate to True.\
\>", "Text",ExpressionUUID->"b41235d7-1263-4cf7-becb-adbd6c6dc7b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rutherfordLimitCheck1", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Simplify", "[", 
      RowBox[{"Asymptotic", "[", 
       RowBox[{"differentialCrossSection", ",", 
        RowBox[{"p", "\[Rule]", "0"}]}], "]"}], "]"}], "\[Equal]", 
     FractionBox[
      RowBox[{
       SuperscriptBox["G", "2"], " ", 
       SuperscriptBox["m1", "2"], " ", 
       SuperscriptBox["m2", "2"]}], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          FractionBox["1", "m1"], "+", 
          FractionBox["1", "m2"]}], ")"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"4", " ", 
         SuperscriptBox["p", "4"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", 
           FractionBox["\[Theta]", "2"], "]"}], "4"]}], ")"}]}]]}], "]"}]}], 
  ";"}]], "Input",
 InitializationCell->False,
 CellLabel->"In[7]:=",ExpressionUUID->"03e82b1a-6908-46d7-9344-84e87d6caac4"],

Cell[CellGroupData[{

Cell[BoxData["rutherfordLimitCheck1"], "Input",
 InitializationCell->False,
 CellLabel->"In[8]:=",ExpressionUUID->"5c213f87-1948-48f6-89c3-af25a19f94fe"],

Cell[BoxData[
 FormBox["True", TraditionalForm]], "Output",
 CellChangeTimes->{4.001383461333976*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"86c7886a-aa92-4a2b-a711-4206b0068856"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Expand beyond the leading term", "Subsection",ExpressionUUID->"cecbb9c1-7cc3-4a60-ada3-74df7ab95ecd"],

Cell["\<\
Series keeps the order term explicitly. Negative powers of p occur because \
the leading long-range scattering cross section grows as p\:207b\:2074.\
\>", "Text",ExpressionUUID->"f34a9239-0a58-44de-b623-bd5ce66fd552"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "/@", 
  RowBox[{"Series", "[", 
   RowBox[{"differentialCrossSection", ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", "0", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 InitializationCell->False,
 CellLabel->"In[9]:=",ExpressionUUID->"ebadf493-9dca-4d59-9d0e-339a073488be"],

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["G", "2"], " ", 
      SuperscriptBox["m1", "4"], " ", 
      SuperscriptBox["m2", "4"], " ", 
      RowBox[{
       SuperscriptBox["csc", "4"], "(", 
       FractionBox["\[Theta]", "2"], ")"}]}], 
     RowBox[{"4", " ", 
      SuperscriptBox["p", "4"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m1", "+", "m2"}], ")"}], "2"]}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["G", "2"], " ", 
      SuperscriptBox["m1", "2"], " ", 
      SuperscriptBox["m2", "2"], " ", 
      RowBox[{
       SuperscriptBox["csc", "4"], "(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         SuperscriptBox["m1", "2"]}], "+", 
        RowBox[{"4", " ", "m1", " ", "m2", " ", 
         RowBox[{"cos", "(", "\[Theta]", ")"}]}], "+", 
        RowBox[{"3", " ", "m1", " ", "m2"}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["m2", "2"]}]}], ")"}]}], 
     RowBox[{"4", " ", 
      SuperscriptBox["p", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m1", "+", "m2"}], ")"}], "2"]}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["G", "2"], " ", 
      RowBox[{
       SuperscriptBox["csc", "4"], "(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"16", " ", 
         SuperscriptBox["m1", "4"]}], "+", 
        RowBox[{"25", " ", 
         SuperscriptBox["m1", "3"], " ", "m2"}], "+", 
        RowBox[{"8", " ", 
         SuperscriptBox["m1", "2"], " ", 
         SuperscriptBox["m2", "2"], " ", 
         RowBox[{"cos", "(", 
          RowBox[{"2", " ", "\[Theta]"}], ")"}]}], "+", 
        RowBox[{"8", " ", "m1", " ", "m2", " ", 
         RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"5", " ", 
            SuperscriptBox["m1", "2"]}], "+", 
           RowBox[{"4", " ", "m1", " ", "m2"}], "+", 
           RowBox[{"5", " ", 
            SuperscriptBox["m2", "2"]}]}], ")"}]}], "+", 
        RowBox[{"58", " ", 
         SuperscriptBox["m1", "2"], " ", 
         SuperscriptBox["m2", "2"]}], "+", 
        RowBox[{"25", " ", "m1", " ", 
         SuperscriptBox["m2", "3"]}], "+", 
        RowBox[{"16", " ", 
         SuperscriptBox["m2", "4"]}]}], ")"}]}], 
     RowBox[{"16", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m1", "+", "m2"}], ")"}], "2"]}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["G", "2"], " ", 
      SuperscriptBox["p", "2"], " ", 
      RowBox[{
       SuperscriptBox["csc", "4"], "(", 
       FractionBox["\[Theta]", "2"], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"16", " ", "m1", " ", "m2", " ", 
         RowBox[{"cos", "(", 
          RowBox[{"2", " ", "\[Theta]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m1", "2"], "+", 
           RowBox[{"m1", " ", "m2"}], "+", 
           SuperscriptBox["m2", "2"]}], ")"}]}], "+", 
        RowBox[{"4", " ", 
         RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"7", " ", 
            SuperscriptBox["m1", "4"]}], "+", 
           RowBox[{"14", " ", 
            SuperscriptBox["m1", "3"], " ", "m2"}], "+", 
           RowBox[{"30", " ", 
            SuperscriptBox["m1", "2"], " ", 
            SuperscriptBox["m2", "2"]}], "+", 
           RowBox[{"14", " ", "m1", " ", 
            SuperscriptBox["m2", "3"]}], "+", 
           RowBox[{"7", " ", 
            SuperscriptBox["m2", "4"]}]}], ")"}]}], "+", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["m1", "4"], "+", 
           RowBox[{"18", " ", 
            SuperscriptBox["m1", "3"], " ", "m2"}], "+", 
           RowBox[{"18", " ", 
            SuperscriptBox["m1", "2"], " ", 
            SuperscriptBox["m2", "2"]}], "+", 
           RowBox[{"18", " ", "m1", " ", 
            SuperscriptBox["m2", "3"]}], "+", 
           SuperscriptBox["m2", "4"]}], ")"}]}]}], ")"}]}], 
     RowBox[{"32", " ", "m1", " ", "m2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m1", "+", "m2"}], ")"}], "2"]}]], "+", 
    InterpretationBox[
     RowBox[{"O", "(", 
      SuperscriptBox["p", "4"], ")"}],
     SeriesData[$CellContext`p, 0, {}, -4, 4, 1],
     Editable->False]}],
   SeriesData[$CellContext`p, 0, {
    Rational[1, 
       4] $CellContext`G^2 $CellContext`m1^4 $CellContext`m2^4 \
($CellContext`m1 + $CellContext`m2)^(-2) 
     Csc[Rational[1, 2] $CellContext`\[Theta]]^4, 0, 
     Rational[1, 
       4] $CellContext`G^2 $CellContext`m1^2 $CellContext`m2^2 \
($CellContext`m1 + $CellContext`m2)^(-2) (4 $CellContext`m1^2 + 
      3 $CellContext`m1 $CellContext`m2 + 4 $CellContext`m2^2 + 
      4 $CellContext`m1 $CellContext`m2 Cos[$CellContext`\[Theta]]) 
     Csc[Rational[1, 2] $CellContext`\[Theta]]^4, 0, 
     Rational[1, 
       16] $CellContext`G^2 ($CellContext`m1 + $CellContext`m2)^(-2) (
      16 $CellContext`m1^4 + 25 $CellContext`m1^3 $CellContext`m2 + 
      58 $CellContext`m1^2 $CellContext`m2^2 + 
      25 $CellContext`m1 $CellContext`m2^3 + 16 $CellContext`m2^4 + 
      8 $CellContext`m1 $CellContext`m2 (5 $CellContext`m1^2 + 
        4 $CellContext`m1 $CellContext`m2 + 5 $CellContext`m2^2) 
       Cos[$CellContext`\[Theta]] + 
      8 $CellContext`m1^2 $CellContext`m2^2 Cos[2 $CellContext`\[Theta]]) 
     Csc[Rational[1, 2] $CellContext`\[Theta]]^4, 0, 
     Rational[1, 
       32] $CellContext`G^2 $CellContext`m1^(-1) $CellContext`m2^(-1) \
($CellContext`m1 + $CellContext`m2)^(-2) (
      3 ($CellContext`m1^4 + 18 $CellContext`m1^3 $CellContext`m2 + 
        18 $CellContext`m1^2 $CellContext`m2^2 + 
        18 $CellContext`m1 $CellContext`m2^3 + $CellContext`m2^4) + 
      4 (7 $CellContext`m1^4 + 14 $CellContext`m1^3 $CellContext`m2 + 
        30 $CellContext`m1^2 $CellContext`m2^2 + 
        14 $CellContext`m1 $CellContext`m2^3 + 7 $CellContext`m2^4) 
       Cos[$CellContext`\[Theta]] + 
      16 $CellContext`m1 $CellContext`m2 ($CellContext`m1^2 + $CellContext`m1 \
$CellContext`m2 + $CellContext`m2^2) Cos[2 $CellContext`\[Theta]]) 
     Csc[Rational[1, 2] $CellContext`\[Theta]]^4}, -4, 4, 1],
   Editable->False], TraditionalForm]], "Output",
